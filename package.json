{
  "name": "personal-projects-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit -p tsconfig.tests.json",
    "test": "bun test tests/lib",
    "test:monitoring": "bun test monitoring/exporter/tests",
    "test:built": "bun test tests/built",
    "coverage": "bun test tests/lib --coverage",
    "serve-dist": "bun run scripts/serve-dist.mjs",
    "verify:writing-filter": "bun run scripts/verify-writing-filter.mjs",
    "verify:glossary-filter": "bun run scripts/verify-glossary-filter.mjs",
    "verify:carousel": "bun run scripts/verify-carousel.mjs",
    "verify:views": "bun run scripts/verify-project-views.mjs",
    "verify:talks-mobile": "bun run scripts/verify-talks-mobile.mjs",
    "og": "bun run scripts/generate-og.mjs",
    "og:watch": "bun run --watch scripts/generate-og.mjs",
    "og:home": "bun run scripts/generate-home-og.mjs",
    "og:home:watch": "bun run --watch scripts/generate-home-og.mjs",
    "og:graph": "bun run scripts/generate-graph-og.mjs",
    "icons": "bun run scripts/generate-icons.mjs",
    "sync:gh": "bun run scripts/sync-github-projects.mjs",
    "sync:gh:apply": "bun run scripts/sync-github-projects.mjs --apply",
    "sync:gh:candidates": "bun run scripts/sync-github-projects.mjs --candidates",
    "sync:activity": "bun run scripts/sync-github-activity.mjs",
    "sync:contacts": "bun run scripts/sync-contact-log.mjs",
    "sync:contacts:apply": "bun run scripts/sync-contact-log.mjs --apply",
    "sync:analytics-content": "bun run scripts/sync-supabase-content.mjs",
    "sync:analytics-content:apply": "bun run scripts/sync-supabase-content.mjs --apply",
    "audit:content": "bun run scripts/content-drift-audit.mjs",
    "audit:content:snapshot": "bun run scripts/content-drift-audit.mjs --snapshot",
    "volta:map": "bun run scripts/gen-volta-map.mjs",
    "export:projects": "bun run scripts/export-projects-registry.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@oneworks/avatar": "1.0.0-rc.9",
    "@oneworks/avatar-web": "1.0.0-rc.9",
    "astro": "^7.2.9",
    "katex": "^0.19.0",
    "morphicons": "^1.7.0",
    "posthog-js": "^1.422.5",
    "shiki": "4.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "pagefind": "^1.6.0",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "@oneworks/avatar@1.0.0-rc.9": "patches/@oneworks%2Favatar@1.0.0-rc.9.patch"
