# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration
.env

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Virtual environment
.venv/

# Node / Astro
node_modules/
dist/
.astro/
.cache/

# Allow src/lib/ even though generic 'lib/' is ignored above
!src/lib/
# Allow tests/lib/ (vitest suites) too
!tests/lib/
# Allow scripts/lib/ (shared OG render helpers) too
!scripts/lib/
# LHCI local output
.lighthouseci/
lhci-reports/

# Claude Code local tooling (agent hooks/settings — not for public repo)
.claude/
.claude/hooks/

# Build cache (graphify-out) — generated, must not be tracked
src/graphify-out/cache/

# CI-only sibling checkouts (drift-guard evidence) — never committed
vendor/

