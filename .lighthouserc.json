{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview",
      "startServerReadyPattern": "localhost",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/en/",
        "http://localhost:4321/writing/",
        "http://localhost:4321/en/writing/",
        "http://localhost:4321/topics/",
        "http://localhost:4321/projects/",
        "http://localhost:4321/en/projects/",
        "http://localhost:4321/projects/volta/",
        "http://localhost:4321/posts/cohort-retention-guide/",
        "http://localhost:4321/about/",
        "http://localhost:4321/en/about/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/en/contact/",
        "http://localhost:4321/graph/",
        "http://localhost:4321/explorer/",
        "http://localhost:4321/en/explorer/",
        "http://localhost:4321/404.html",
        "http://localhost:4321/repo-audit/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/repo-audit/",
          "assertions": {
            "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
            "speed-index": ["warn", { "maxNumericValue": 3400 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "color-contrast": ["error", { "minScore": 1 }],
            "categories:pwa": "off",
            "valid-source-maps": "off",
            "categories:seo": "off"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*repo-audit).*$",
          "assertions": {
            "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
            "speed-index": ["warn", { "maxNumericValue": 3400 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:pwa": "off",
            "color-contrast": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-reports"
    }
  }
}
