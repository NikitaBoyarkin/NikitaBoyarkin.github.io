---
// Compact per-project knowledge subgraph. Renders the 1-hop neighborhood of a
// project node (computed at build time via subgraphAround) as a small
// force-directed SVG. It shares the main graph's visual language: per-type edge
// colors/dashes, hairline links trimmed at the node edge, always-on labels for
// anchor nodes (hover-only for posts), and the same precomputed tooltips.
// Labels appear on hover/focus; the center node's label is always visible as
// the anchor. Click a node to navigate to its page.
import { withBase } from '../lib/path';
import type { GraphNode, GraphLink } from '../lib/graph';
import { buildGraphTooltips } from '../lib/graph-tooltip';

interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
  centerId: string;
  lang?: 'ru' | 'en';
  /** Overridable copy so a non-project center (e.g. a glossary term page) can
   *  describe its own subgraph. Defaults keep every existing caller unchanged. */
  caption?: string;
  ariaLabel?: string;
}

const { nodes, links, centerId, lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
// Taller canvas for denser subgraphs (volta's hub pulls in ~20 nodes).
const height = Math.max(280, Math.min(460, 240 + nodes.length * 10));

// Precompute tooltip lines (node / edge, aligned by index) so the client only
// positions and renders them — same protocol as the main graph.
const tooltips = buildGraphTooltips(nodes, links, lang);

// Pre-resolve URLs with the base path so the client can navigate directly.
const data = {
  nodes: nodes.map((n) => ({ ...n, href: withBase(n.url) })),
  links,
  centerId,
  nodeT: tooltips.node,
  edgeT: tooltips.edge,
};
// Escape `<` so a label can never close the JSON script tag early.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
// Default copy describes a project center; a term (or other) page can pass its
// own caption/ariaLabel to stay accurate.
const ariaLabel = Astro.props.ariaLabel ?? (isEn ? 'Connections of this project' : 'Связи этого проекта');
const caption =
  Astro.props.caption ??
  (isEn
    ? 'Projects, posts and topics connected to this one. Hover a node to see its name; click to open.'
    : 'Проекты, записи и темы, связанные с этим проектом. Наведите на узел, чтобы увидеть название; клик — открыть.');
---

<div id="pg-root" class="pg-root">
  <svg id="pg-svg" class="pg-svg" style={`height:${height}px`} role="img" aria-label={ariaLabel}></svg>
  <div id="pg-tooltip" class="pg-tooltip" role="tooltip" hidden></div>
  <p class="pg-caption">{caption}</p>
</div>
<script is:inline type="application/json" id="pg-data" set:html={json}></script>

<script>
  import {
    GRAPH_GROUP_COLORS,
    GRAPH_EDGE_STYLE,
    GRAPH_EDGE_COLOR,
    edgeWidth,
    NODE_SIZE,
  } from '../lib/graph';

  const rootEl = document.getElementById('pg-root');
  const svgEl = document.getElementById('pg-svg');
  const dataEl = document.getElementById('pg-data');
  if (!rootEl || !svgEl || !dataEl) throw new Error('pg-root / pg-svg / pg-data not found');
  const root = rootEl as HTMLElement;
  const svg = svgEl as unknown as SVGSVGElement;
  const data = JSON.parse(dataEl.textContent || '{}');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';
  const el = (name: string) => document.createElementNS(NS, name);
  /** Tooltip lines are precomputed server-side; `<title>` keeps them available
   *  to no-JS / keyboard users, the DOM tooltip renders the hover case. */
  const titleLines = (lines: string[] | undefined) => (lines || []).join('\n');

  let world = { w: 600, h: 280 };
  let nodes: any[] = [];
  let nodeEls: SVGGElement[] = [];
  let links: { source: any; target: any; weight: number; type: string }[] = [];
  let edges: SVGLineElement[] = [];
  let edgeHits: SVGLineElement[] = [];
  let running = false;
  let frames = 0;
  let restart: (() => void) | null = null;
  let dragging: any = null;
  let dragStart: { x: number; y: number } | null = null;
  let moved = false;

  const adjacency = new Map<string, Set<string>>();

  function toWorld(clientX: number, clientY: number) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const pt = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
    return { x: pt.x, y: pt.y };
  }

  function rebuild() {
    svg.replaceChildren();
    world = { w: svg.clientWidth || 600, h: svg.clientHeight || 280 };

    nodes = data.nodes.map((n: any) => ({ ...n, x: 0, y: 0, vx: 0, vy: 0 }));
    const idx = new Map(nodes.map((n) => [n.id, n]));
    links = data.links
      .map((l: any) => ({
        source: idx.get(l.source),
        target: idx.get(l.target),
        weight: typeof l.weight === 'number' ? l.weight : 1,
        type: l.type || 'related',
      }))
      .filter((l: any) => l.source && l.target);

    adjacency.clear();
    for (const l of links) {
      if (!adjacency.has(l.source.id)) adjacency.set(l.source.id, new Set());
      if (!adjacency.has(l.target.id)) adjacency.set(l.target.id, new Set());
      adjacency.get(l.source.id)!.add(l.target.id);
      adjacency.get(l.target.id)!.add(l.source.id);
    }

    const edgeLayer = el('g');
    svg.appendChild(edgeLayer);
    edges = links.map((l, i) => {
      const line = el('line');
      line.setAttribute('class', 'pg-edge');
      // Same per-type palette and hairline weight as the main graph. Painted
      // inline (not via attribute) so it wins over the .pg-edge CSS fallback.
      line.style.stroke = GRAPH_EDGE_COLOR[l.type] || GRAPH_EDGE_COLOR.related;
      const dash = GRAPH_EDGE_STYLE[l.type];
      if (dash) line.setAttribute('stroke-dasharray', dash);
      line.style.strokeWidth = String(edgeWidth(l.weight || 1));
      const title = el('title');
      title.textContent = titleLines(data.edgeT?.[i]);
      line.appendChild(title);
      edgeLayer.appendChild(line);
      return line as SVGLineElement;
    });

    // Wide transparent hit areas (behind the nodes) so the thin links are
    // actually hoverable for the tooltip.
    edgeHits = edges.map((e) => {
      const hit = el('line');
      hit.setAttribute('class', 'pg-edge-hit');
      hit.setAttribute('stroke', 'transparent');
      hit.setAttribute('stroke-width', '12');
      hit.setAttribute('fill', 'none');
      hit.setAttribute('pointer-events', 'stroke');
      e.after(hit);
      return hit as SVGLineElement;
    });

    const nodeLayer = el('g');
    svg.appendChild(nodeLayer);
    nodeEls = nodes.map((n, i) => {
      const g = el('g');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'link');
      g.setAttribute('aria-label', n.label);
      g.style.cursor = 'pointer';
      if (n.id === data.centerId) g.classList.add('pg-center');
      const title = el('title');
      title.textContent = titleLines(data.nodeT?.[i]);
      g.appendChild(title);
      const r = (n.size || 6) * NODE_SIZE;
      const c = el('circle');
      c.setAttribute('r', String(r));
      c.setAttribute('fill', GRAPH_GROUP_COLORS[n.group] || 'var(--text-accent)');
      const txt = el('text');
      txt.setAttribute('x', String(r + 6));
      txt.setAttribute('y', '4');
      // Anchor nodes keep their label; post labels are hover/focus-only, same
      // rule as the main graph (a text cloud otherwise).
      txt.setAttribute('class', n.id.startsWith('post:') ? 'pg-label pg-label-hover' : 'pg-label');
      txt.textContent = n.label;
      g.appendChild(c);
      g.appendChild(txt);
      nodeLayer.appendChild(g);
      return g as SVGGElement;
    });

    // Keyboard: Enter/Space on a focused node navigates.
    nodeEls.forEach((g, i) => {
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          navigateTo(nodes[i]);
        }
      });
    });

    // Initial positions: center node at the middle, the rest on a ring around it.
    const cx = world.w / 2;
    const cy = world.h / 2;
    const ring = Math.min(world.w, world.h) * 0.3;
    const others = nodes.filter((n) => n.id !== data.centerId);
    nodes.forEach((n) => {
      if (n.id === data.centerId) {
        n.x = cx;
        n.y = cy;
        return;
      }
      const i = others.indexOf(n);
      const a = (i / Math.max(1, others.length)) * 2 * Math.PI - Math.PI / 2;
      n.x = cx + Math.cos(a) * ring;
      n.y = cy + Math.sin(a) * ring;
    });
  }

  /** Stop the line at the target's edge so it doesn't run under the circle —
   *  the same endpoint trim the main graph applies. */
  function drawEdges() {
    links.forEach((l, i) => {
      const dx = l.target.x - l.source.x;
      const dy = l.target.y - l.source.y;
      const d = Math.sqrt(dx * dx + dy * dy) || 1;
      const r = (l.target.size || 6) + 2;
      const x1 = l.source.x;
      const y1 = l.source.y;
      const x2 = l.target.x - (dx / d) * r;
      const y2 = l.target.y - (dy / d) * r;
      for (const e of [edges[i], edgeHits[i]]) {
        if (!e) continue;
        e.setAttribute('x1', String(x1));
        e.setAttribute('y1', String(y1));
        e.setAttribute('x2', String(x2));
        e.setAttribute('y2', String(y2));
      }
    });
  }

  function clearHighlight() {
    nodes.forEach((_, i) => (nodeEls[i].style.opacity = ''));
    edges.forEach((e) => (e.style.opacity = ''));
  }

  function highlight(id: string) {
    const neighbors = adjacency.get(id) || new Set<string>();
    neighbors.add(id);
    nodes.forEach((n, i) => {
      nodeEls[i].style.opacity = neighbors.has(n.id) ? '1' : '0.12';
    });
    edges.forEach((e, i) => {
      const l = links[i];
      const on = l.source.id === id || l.target.id === id;
      e.style.opacity = on ? String(Math.min(1, (l.weight || 1) * 0.9 + 0.2)) : '0.05';
    });
  }

  function navigateTo(n: any) {
    if (n?.href) window.location.href = n.href;
  }

  function renderStatic() {
    rebuild();
    drawEdges();
    nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`));
  }

  function renderForce() {
    rebuild();

    // Same alpha-based settling as the main graph, scaled to node count.
    const N = Math.max(1, nodes.length);
    const charge = 2200 * Math.sqrt(N);
    const gravity = 0.004 + 0.001 * Math.sqrt(N);
    const damp = 0.86;
    const margin = Math.min(80, 60 + N * 0.5);
    const alphaDecay = Math.max(0.015, 0.03 - 0.001 * Math.sqrt(N));
    const alphaMin = 0.01;
    const maxFrames = Math.max(400, N * 10);
    let alpha = 1;

    function tick() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          let dx = a.x - b.x, dy = a.y - b.y;
          let d2 = dx * dx + dy * dy || 1;
          let d = Math.sqrt(d2);
          const f = (charge / d2) * alpha;
          a.vx += (dx / d) * f; a.vy += (dy / d) * f;
          b.vx -= (dx / d) * f; b.vy -= (dy / d) * f;
        }
      }
      links.forEach((l) => {
        const dx = l.target.x - l.source.x, dy = l.target.y - l.source.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const ideal = 60 + 80 * (1 - (l.weight || 1));
        const f = (d - ideal) * 0.04 * (0.5 + 0.5 * (l.weight || 1)) * alpha;
        const fx = (dx / d) * f, fy = (dy / d) * f;
        l.source.vx += fx; l.source.vy += fy;
        l.target.vx -= fx; l.target.vy -= fy;
      });
      nodes.forEach((n) => {
        if (n.fx != null) { n.x = n.fx; n.y = n.fy; n.vx = 0; n.vy = 0; return; }
        n.vx += (world.w / 2 - n.x) * gravity * alpha;
        n.vy += (world.h / 2 - n.y) * gravity * alpha;
        n.vx *= damp; n.vy *= damp;
        n.x += n.vx; n.y += n.vy;
        n.x = Math.max(margin, Math.min(world.w - margin, n.x));
        n.y = Math.max(margin, Math.min(world.h - margin, n.y));
      });
      drawEdges();
      nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`));
    }

    function loop() {
      if (!running) return;
      tick();
      frames++;
      alpha *= 1 - alphaDecay;
      if (alpha < alphaMin || frames > maxFrames) running = false;
      requestAnimationFrame(loop);
    }

    restart = () => {
      running = true;
      frames = 0;
      alpha = 1;
      loop();
    };
    restart();
  }

  // Pointer: drag a node (click = navigate).
  function handlePointerDown(e: PointerEvent) {
    svg.setPointerCapture(e.pointerId);
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) return;
    const n = nodes[nodeEls.indexOf(target)];
    const p = toWorld(e.clientX, e.clientY);
    dragging = n;
    dragStart = { x: p.x, y: p.y };
    moved = false;
    n.fx = p.x;
    n.fy = p.y;
    target.style.cursor = 'grabbing';
  }

  function handlePointerMove(e: PointerEvent) {
    if (!dragging) return;
    const p = toWorld(e.clientX, e.clientY);
    const dx = p.x - (dragStart?.x ?? p.x);
    const dy = p.y - (dragStart?.y ?? p.y);
    if (dx * dx + dy * dy > 9) moved = true;
    dragging.fx = p.x;
    dragging.fy = p.y;
  }

  function handlePointerUp() {
    if (!dragging) return;
    const n = dragging;
    const wasClick = !moved;
    n.fx = null;
    n.fy = null;
    const g = nodeEls[nodes.indexOf(n)];
    if (g) g.style.cursor = 'pointer';
    dragging = null;
    dragStart = null;
    if (wasClick) navigateTo(n);
  }

  svg.addEventListener('pointerdown', handlePointerDown);
  svg.addEventListener('pointermove', handlePointerMove);
  svg.addEventListener('pointerup', handlePointerUp);
  svg.addEventListener('pointercancel', handlePointerUp);

  // --- Tooltip: content lines come precomputed (data.nodeT / data.edgeT) so
  // the client only positions and renders them. Hover-only; keyboard users get
  // the native SVG <title>. ---
  const tooltipEl = document.getElementById('pg-tooltip') as HTMLDivElement | null;
  function showTooltip(lines: string[] | undefined, clientX: number, clientY: number) {
    if (!tooltipEl || !lines || !lines.length) return;
    tooltipEl.replaceChildren();
    for (const line of lines) {
      const row = document.createElement('div');
      row.textContent = line;
      tooltipEl.appendChild(row);
    }
    tooltipEl.hidden = false;
    const rect = root.getBoundingClientRect();
    const w = tooltipEl.offsetWidth;
    const h = tooltipEl.offsetHeight;
    let x = clientX - rect.left + 14;
    let y = clientY - rect.top + 14;
    if (x + w > rect.width - 8) x = Math.max(8, clientX - rect.left - w - 14);
    if (y + h > rect.height - 8) y = Math.max(8, clientY - rect.top - h - 8);
    tooltipEl.style.transform = `translate(${x}px, ${y}px)`;
  }
  function hideTooltip() {
    if (tooltipEl) tooltipEl.hidden = true;
  }

  // Hover: highlight neighbors; the label appears via CSS on hover/focus.
  svg.addEventListener('pointerover', (e) => {
    const hitIdx = edgeHits.indexOf(e.target as unknown as SVGLineElement);
    if (hitIdx >= 0) {
      showTooltip(data.edgeT?.[hitIdx], e.clientX, e.clientY);
      return;
    }
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) {
      clearHighlight();
      hideTooltip();
      return;
    }
    const idx = nodeEls.indexOf(target);
    const n = nodes[idx];
    highlight(n.id);
    showTooltip(data.nodeT?.[idx], e.clientX, e.clientY);
  });
  svg.addEventListener('pointerout', (e) => {
    const stillIn = (e.relatedTarget as Node | null) && svg.contains(e.relatedTarget as Node);
    if (!stillIn) {
      clearHighlight();
      hideTooltip();
    }
  });

  reduced ? renderStatic() : renderForce();
</script>

<style is:global>
  .pg-root {
    position: relative;
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .pg-svg {
    width: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  .pg-edge {
    stroke: color-mix(in srgb, var(--text-muted) 50%, transparent);
    stroke-width: 1;
  }
  .pg-center circle {
    stroke: var(--text-accent);
    stroke-width: 2.5px;
  }
  .pg-label {
    fill: var(--text-normal);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-sans);
    paint-order: stroke;
    stroke: var(--background-secondary);
    stroke-width: 5px;
    stroke-opacity: 0.95;
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  /* Post labels are hover/focus-only; projects, topics and Volta parts stay
     labeled — the same rule as the main graph. */
  .pg-label-hover {
    opacity: 0;
  }
  .pg-root :is(g[tabindex]) {
    outline: none;
  }
  .pg-root :is(g[tabindex]:focus-visible) {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
  .pg-root :is(g[tabindex]:hover) .pg-label-hover,
  .pg-root :is(g[tabindex]:focus) .pg-label-hover {
    opacity: 1;
  }
  .pg-root :is(g[tabindex]:focus) text {
    fill: var(--text-accent);
  }
  .pg-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: var(--z-panel);
    pointer-events: none;
    background: var(--background-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
    padding: 0.4rem 0.55rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-normal);
    max-width: 240px;
    white-space: nowrap;
  }
  .pg-tooltip[hidden] {
    display: none;
  }
  .pg-caption {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: var(--space-2);
    text-align: center;
  }
</style>
