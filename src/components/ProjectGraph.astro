---
// Compact per-project knowledge subgraph. Renders the 1-hop neighborhood of a
// project node (computed at build time via subgraphAround) as a small
// force-directed SVG. It shares the main graph's visual language: per-type edge
// colors/dashes, hairline links trimmed at the node edge, always-on labels for
// anchor nodes (hover-only for posts), and the same precomputed tooltips.
// Labels appear on hover/focus; the center node's label is always visible as
// the anchor. Click a node to navigate to its page.
import { withBase } from '../lib/path';
import { GRAPH_SECTION_COLORS, type GraphNode, type GraphLink } from '../lib/graph';
import { buildGraphTooltips, tooltipCopy } from '../lib/graph-tooltip';

interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
  centerId: string;
  lang?: 'ru' | 'en';
  /** Overridable copy so a non-project center (e.g. a glossary term page) can
   *  describe its own subgraph. Defaults keep every existing caller unchanged. */
  caption?: string;
  ariaLabel?: string;
  /** Canvas height override. Dense graphs (a 91-talk programme) need more room
   *  than the default node-count formula gives. */
  height?: number;
  /** Id namespace for this instance. The component renders many times on one
   *  page (/talks/ draws an overview plus one graph per track), and every DOM
   *  lookup is scoped by this prefix — without it the second instance grabbed
   *  the first one's nodes and stayed an empty SVG. Callers with more than one
   *  instance must pass a unique value; single-instance pages keep the default. */
  idPrefix?: string;
  /** Opt-in analytics: when true, a node click or Space activation emits
   *  `graph_node_click` with this instance's `idPrefix` as `graph`. Enabled by
   *  /talks/, where "is the graph itself used, or does everyone read the
   *  lists?" is the question; the project pages leave it off and ship no
   *  analytics listener at all. */
  analytics?: boolean;
  /** Colour key below the canvas. One row per node section actually present;
   *  sections are painted from GRAPH_SECTION_COLORS, so the swatches and the
   *  nodes cannot drift. Empty (default) renders no legend. */
  legend?: { section: string; label: string }[];
  legendLabel?: string;
}

const {
  nodes,
  links,
  centerId,
  lang = 'ru',
  height: heightProp,
  idPrefix = 'pg',
  analytics = false,
  legend = [],
  legendLabel,
} = Astro.props;
// `uid('root')` → `pg-root`, or `<idPrefix>-root` for an instance that passed
// its own prefix.
const uid = (part: string) => `${idPrefix}-${part}`;
const isEn = lang === 'en';
// Taller canvas for denser subgraphs (volta's hub pulls in ~20 nodes).
const height = heightProp ?? Math.max(280, Math.min(460, 240 + nodes.length * 10));

// Labels that stay hover/focus-only (posts, else a text cloud; programme talks,
// 91 long titles): applied in the client builder below, which cannot read this
// scope.

// Precompute tooltip lines (node / edge, aligned by index) so the client only
// positions and renders them — same protocol as the main graph.
const tooltips = buildGraphTooltips(nodes, links, lang);

// Screen-reader text alternative. Every node in this graphic is built in the
// client, so without a server-rendered mirror a JS-off or AT visitor gets an
// empty box. Same contract as KnowledgeGraph: a per-node connection list in
// visually-hidden text, while the SVG itself stays a focusable group of real
// links rather than a single opaque image.
const edgeTypeLabel = tooltipCopy(lang).edgeType;
const nodeById = new Map(nodes.map((n) => [n.id, n]));
const connsByNode = new Map<string, string[]>();
for (const l of links) {
  const a = nodeById.get(l.source);
  const b = nodeById.get(l.target);
  if (!a || !b) continue;
  const ty = edgeTypeLabel[l.type] ?? l.type;
  if (!connsByNode.has(a.id)) connsByNode.set(a.id, []);
  if (!connsByNode.has(b.id)) connsByNode.set(b.id, []);
  connsByNode.get(a.id)!.push(`${b.label} (${ty})`);
  connsByNode.get(b.id)!.push(`${a.label} (${ty})`);
}
const srDesc = isEn
  ? `Interactive subgraph: ${nodes.length} nodes and ${links.length} links around this page. Each node is keyboard-focusable; press Enter or Space to open its page. A full list of nodes and their links follows the graphic.`
  : `Интерактивный подграф: ${nodes.length} узлов и ${links.length} связей вокруг этой страницы. Каждый узел доступен с клавиатуры; Enter или пробел открывают связанную страницу. Полный список узлов и их связей — после графика.`;

// Pre-resolve URLs with the base path so the client can navigate directly.
const data = {
  nodes: nodes.map((n) => ({ ...n, href: withBase(n.url) })),
  links,
  centerId,
  nodeT: tooltips.node,
  edgeT: tooltips.edge,
};
// Escape `<` so a label can never close the JSON script tag early.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
// Default copy describes a project center; a term (or other) page can pass its
// own caption/ariaLabel to stay accurate.
const ariaLabel = Astro.props.ariaLabel ?? (isEn ? 'Connections of this project' : 'Связи этого проекта');
const caption =
  Astro.props.caption ??
  (isEn
    ? 'Projects, posts and topics connected to this one. Tap or click opens a node.'
    : 'Проекты, записи и темы, связанные с этим проектом. Касание или клик открывают узел.');
---

<div id={uid('root')} class="pg-root" data-pg-root data-analytics-graph={analytics ? idPrefix : undefined}>
  {/* role="group", not "img": ARIA gives `img` presentational children, which
      would flatten the focusable link nodes this component builds into it out
      of the accessibility tree. A group keeps them real; the visually-hidden
      list below is the plain-text mirror. */}
  <svg id={uid('svg')} class="pg-svg" style={`height:${height}px`} role="group" aria-label={ariaLabel} aria-describedby={uid('sr-desc')}></svg>
  {/* Server-rendered controls: they work before the client module runs, and the
      buttons are real `<button>`s, so a JS-off visitor gets nothing broken. */}
  <div class="pg-controls" role="group" aria-label={isEn ? 'Graph controls' : 'Управление графом'}>
    <button type="button" class="pg-btn" data-pg-zoom="in" aria-label={isEn ? 'Zoom in' : 'Увеличить'}>+</button>
    <button type="button" class="pg-btn" data-pg-zoom="out" aria-label={isEn ? 'Zoom out' : 'Уменьшить'}>−</button>
    <button type="button" class="pg-btn" data-pg-zoom="reset" aria-label={isEn ? 'Reset view' : 'Сбросить вид'}>⟲</button>
    <button
      type="button"
      class="pg-btn"
      data-pg-labels
      aria-pressed="false"
      aria-label={isEn ? 'Show all labels' : 'Показать все подписи'}
    >Aa</button>
  </div>
  <div class="visually-hidden">
    <p id={uid('sr-desc')}>{srDesc}</p>
    <ul>
      {
        nodes.map((n) => {
          const conns = connsByNode.get(n.id) ?? [];
          return (
            <li>
              {/* The centre is this very page — a self-link is a wasted stop, so
                  it stays plain text. */}
              {n.id === centerId ? <span>{n.label}</span> : <a href={withBase(n.url)}>{n.label}</a>}
              {conns.length > 0 ? `: ${conns.join(', ')}` : ''}
            </li>
          );
        })
      }
    </ul>
  </div>
  <div id={uid('tooltip')} class="pg-tooltip" role="tooltip" hidden></div>
  <p class="pg-caption">{caption}</p>
  {
    legend.length > 0 && (
      <ul class="pg-legend" aria-label={legendLabel ?? (isEn ? 'Node colours' : 'Цвета узлов')}>
        {legend.map((item) => (
          <li>
            <span
              class="pg-swatch"
              style={`background:${GRAPH_SECTION_COLORS[item.section] || 'var(--text-accent)'}`}
              aria-hidden="true"
            />
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  {/* Inside the root on purpose: the client finds each instance's payload by
      querying its own subtree, never the document. */}
  <script is:inline type="application/json" id={uid('data')} class="pg-data" set:html={json}></script>
</div>

<script>
  import { localeFromPath, track } from '../lib/analytics';
  import {
    GRAPH_SECTION_COLORS,
    GRAPH_EDGE_STYLE,
    GRAPH_EDGE_COLOR,
    edgeWidth,
    NODE_SIZE,
  } from '../lib/graph';

  const NS = 'http://www.w3.org/2000/svg';
  const el = (name: string) => document.createElementNS(NS, name);
  /** Tooltip lines are precomputed server-side; `<title>` keeps them available
   *  to no-JS / keyboard users, the DOM tooltip renders the hover case. */
  const titleLines = (lines: string[] | undefined) => (lines || []).join('\n');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Wire one instance. Astro ships one `<script>` per page, so this module is
   *  evaluated once even when the component renders thirteen times (/talks/):
   *  every lookup below is scoped to `root`, never to the document. The old
   *  `document.getElementById('pg-root' | 'pg-svg' | 'pg-data')` always returned
   *  the first instance, so every other graph stayed an empty SVG. */
  function initGraph(root: HTMLElement, svg: SVGSVGElement, data: any, tooltipEl: HTMLDivElement | null) {
  let world = { w: 600, h: 280 };
  let nodes: any[] = [];
  let nodeEls: SVGGElement[] = [];
  let nodeTexts: SVGTextElement[] = [];
  /** Tap pads and visible radii, index-aligned with `nodes`; the pad radius is
   *  re-derived from the live layout (see `updatePads`). */
  let padEls: SVGCircleElement[] = [];
  let nodeRadii: number[] = [];
  /** Advance width per label, measured once per render pass. Kept out of the
   *  per-frame label layout: 91 labels re-measuring every tick would thrash
   *  layout for nothing, the text never changes. */
  let labelWidths: number[] = [];
  let links: { source: any; target: any; weight: number; type: string }[] = [];
  let edges: SVGLineElement[] = [];
  let edgeHits: SVGLineElement[] = [];
  let running = false;
  let frames = 0;
  let restart: (() => void) | null = null;
  let dragging: any = null;
  let dragStart: { x: number; y: number } | null = null;
  let dragPointerId: number | null = null;
  let dragRaf = 0;
  let moved = false;
  /** Set when a press turned into a drag: the compatibility click that follows
   *  the release must not reach the anchor. */
  let suppressClick = false;
  /** Pan/zoom lives on one `<g>` around both layers: the layout keeps working in
   *  SVG units, the transform is purely visual, and `getScreenCTM()` on this
   *  group is what maps a finger back into layout space. */
  let viewport: SVGGElement | null = null;
  let view = { k: 1, x: 0, y: 0 };
  const MIN_K = 0.6;
  const MAX_K = 3;
  const pointers = new Map<number, { x: number; y: number }>();
  let pinch: { dist: number; k: number; mx: number; my: number } | null = null;
  let pan: { x: number; y: number; vx: number; vy: number } | null = null;

  const adjacency = new Map<string, Set<string>>();

  /** Opt-in analytics for this instance (`analytics` prop → the root's
   *  `data-analytics-graph`). Empty when the caller did not ask for it. */
  const graphName = root.getAttribute('data-analytics-graph') || '';

  /** Prefix of a payload node id: `talk:277` → `talk`, `event:program` →
   *  `event`, an id without a prefix → `node`. */
  function nodeKind(id: string): string {
    const sep = id.indexOf(':');
    return sep > 0 ? id.slice(0, sep) : 'node';
  }

  function emitNodeClick(n: any) {
    if (!graphName || !n || typeof n.id !== 'string') return;
    track('graph_node_click', {
      graph: graphName,
      node_kind: nodeKind(n.id),
      node_id: n.id,
      locale: localeFromPath(window.location.pathname),
    });
  }

  /** Client coords → SVG user units, or null when the geometry cannot be read.
   *  Returning a made-up (0, 0) instead used to turn one bad sample into a fake
   *  200px drag: `moved` latched on, the node jumped to the top-left corner and
   *  the tap that produced it was swallowed. */
  function toWorld(clientX: number, clientY: number) {
    const ctm = (viewport ?? svg).getScreenCTM();
    if (!ctm) return null;
    const pt = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
    return { x: pt.x, y: pt.y };
  }

  const clampK = (k: number) => Math.max(MIN_K, Math.min(MAX_K, k));

  /** Zoom about the canvas centre, then pan by `view.x/y`. `touch-action:none`
   *  is only switched on while zoomed: at 1× a one-finger swipe must still
   *  scroll the page (verify-talks-mobile check (a)), and a graph that claims
   *  the whole surface traps the reader inside a 480px card. */
  function applyView() {
    if (viewport) {
      const cx = world.w / 2;
      const cy = world.h / 2;
      viewport.setAttribute(
        'transform',
        `translate(${cx + view.x},${cy + view.y}) scale(${view.k}) translate(${-cx},${-cy})`,
      );
    }
    root.classList.toggle('pg-zoomed', view.k > 1.001);
  }

  function setZoom(k: number) {
    view.k = clampK(k);
    applyView();
  }

  function resetView() {
    view = { k: 1, x: 0, y: 0 };
    applyView();
  }

  function rebuild() {
    svg.replaceChildren();
    // `clientWidth` is 0 while the host `SectionPanel` is `display:none` (the
    // graph lives in the «Связи» tab). The old code then silently laid the
    // world out for 600×280 and never re-measured, so on a phone the subgraph
    // was clipped and on desktop it was off-centre. `renderWhenVisible` now
    // refuses to lay anything out until the element has a real box, and the
    // ResizeObserver re-runs it when a tab opens or the window changes.
    const rect = svg.getBoundingClientRect();
    world = { w: rect.width || svg.clientWidth || 600, h: rect.height || svg.clientHeight || 280 };

    nodes = data.nodes.map((n: any) => ({ ...n, x: 0, y: 0, vx: 0, vy: 0 }));
    const idx = new Map(nodes.map((n) => [n.id, n]));
    links = data.links
      .map((l: any) => ({
        source: idx.get(l.source),
        target: idx.get(l.target),
        weight: typeof l.weight === 'number' ? l.weight : 1,
        type: l.type || 'related',
      }))
      .filter((l: any) => l.source && l.target);

    adjacency.clear();
    for (const l of links) {
      if (!adjacency.has(l.source.id)) adjacency.set(l.source.id, new Set());
      if (!adjacency.has(l.target.id)) adjacency.set(l.target.id, new Set());
      adjacency.get(l.source.id)!.add(l.target.id);
      adjacency.get(l.target.id)!.add(l.source.id);
    }

    viewport = el('g') as SVGGElement;
    viewport.setAttribute('class', 'pg-viewport');
    svg.appendChild(viewport);
    applyView();
    const edgeLayer = el('g');
    viewport.appendChild(edgeLayer);
    edges = links.map((l, i) => {
      const line = el('line');
      line.setAttribute('class', 'pg-edge');
      // Same per-type palette and hairline weight as the main graph. Painted
      // inline (not via attribute) so it wins over the .pg-edge CSS fallback.
      line.style.stroke = GRAPH_EDGE_COLOR[l.type] || GRAPH_EDGE_COLOR.related;
      const dash = GRAPH_EDGE_STYLE[l.type];
      if (dash) line.setAttribute('stroke-dasharray', dash);
      line.style.strokeWidth = String(edgeWidth(l.weight || 1));
      const title = el('title');
      title.textContent = titleLines(data.edgeT?.[i]);
      line.appendChild(title);
      edgeLayer.appendChild(line);
      return line as SVGLineElement;
    });

    // Wide transparent hit areas (behind the nodes) so the thin links are
    // actually hoverable for the tooltip.
    edgeHits = edges.map((e) => {
      const hit = el('line');
      hit.setAttribute('class', 'pg-edge-hit');
      hit.setAttribute('stroke', 'transparent');
      hit.setAttribute('stroke-width', '12');
      hit.setAttribute('fill', 'none');
      hit.setAttribute('pointer-events', 'stroke');
      e.after(hit);
      return hit as SVGLineElement;
    });

    const nodeLayer = el('g');
    viewport.appendChild(nodeLayer);
    const textEls: SVGTextElement[] = [];
    padEls = [];
    nodeRadii = [];
    nodeEls = nodes.map((n, i) => {
      const g = el('g');
      // A real SVG anchor inside the group (an `<a>` may not wrap a `<g>`). It
      // is the tab stop and the activation target, so Enter and a touch tap are
      // the browser's own link behaviour: a tap that drifted a couple of pixels
      // used to be dropped because Chrome kills navigation issued from a
      // pointerup handler inside a moving touch sequence, while the anchor's
      // compatibility click survives it.
      const a = el('a');
      a.setAttribute('href', n.href);
      a.setAttribute('tabindex', '0');
      a.setAttribute('aria-label', n.label);
      // The anchor's own click covers mouse, touch and Enter alike. A press
      // that ended a drag is suppressed by the SVG handler below
      // (`suppressClick`), and must not be counted as an open.
      if (graphName) {
        a.addEventListener('click', () => {
          if (suppressClick) return;
          emitNodeClick(n);
        });
      }
      g.style.cursor = 'pointer';
      if (n.id === data.centerId) g.classList.add('pg-center');
      const title = el('title');
      title.textContent = titleLines(data.nodeT?.[i]);
      g.appendChild(title);
      const r = (n.size || 6) * NODE_SIZE;
      // Invisible tap target, inside this same anchor so the browser grows the
      // anchor's own hit box. The visible radius follows the node's weight, so
      // a light node was a 10.6px dot — every node on /talks/ failed the 24px
      // minimum. A pad drawn outside the `<a>` would not have helped: the tap
      // target is the anchor, not the circle. The pad's radius is not fixed
      // here: `updatePads` re-derives it from the settled layout, because a
      // constant 44px pad on a dense ring covered the neighbour's dot and a tap
      // on one node opened another.
      const pad = el('circle');
      pad.setAttribute('class', 'pg-hit');
      pad.setAttribute('r', String(Math.max(r, 22)));
      pad.setAttribute('fill', 'transparent');
      pad.setAttribute('pointer-events', 'all');
      padEls.push(pad as SVGCircleElement);
      nodeRadii.push(r);
      // `.pg-center circle` paints a ring; the pad must not inherit one.
      pad.style.stroke = 'none';
      const c = el('circle');
      c.setAttribute('r', String(r));
      c.setAttribute('fill', GRAPH_SECTION_COLORS[n.section] || 'var(--text-accent)');
      const txt = el('text') as SVGTextElement;
      const isCenter = n.id === data.centerId;
      // The centre's label is the only always-on anchor text. Set to the right
      // of the circle it ran into the ring node at 3 o'clock, which painted
      // later and ate "…2026"'s last characters; the text was never clipped,
      // just covered. Centring it under the circle keeps it off that node.
      txt.setAttribute('x', isCenter ? '0' : String(r + 6));
      txt.setAttribute('y', isCenter ? String(r + 14) : '4');
      if (isCenter) txt.setAttribute('text-anchor', 'middle');
      // Anchor nodes keep their label; post labels are hover/focus-only, same
      // rule as the main graph (a text cloud otherwise) — posts and talks.
      txt.setAttribute(
        'class',
        n.id.startsWith('post:') || n.id.startsWith('talk:')
          ? 'pg-label pg-label-hover'
          : 'pg-label',
      );
      txt.textContent = n.label;
      textEls.push(txt);
      a.appendChild(pad);
      a.appendChild(c);
      a.appendChild(txt);
      g.appendChild(a);
      nodeLayer.appendChild(g);
      return g as SVGGElement;
    });
    nodeTexts = textEls;
    labelWidths = [];

    // Paint the centre last for the same reason: it must never be covered,
    // while the ring nodes only need their circles ordered among themselves.
    const centerIdx = nodes.findIndex((n) => n.id === data.centerId);
    if (centerIdx >= 0) nodeLayer.appendChild(nodeEls[centerIdx]);

    // Keyboard: the anchor is the tab stop, so Enter is the link's own
    // activation. Space is not an activation key for links in the spec, so it
    // is mapped by hand and the screen-reader copy below keeps promising it.
    // The event bubbles from the anchor up to the group.
    nodeEls.forEach((g, i) => {
      g.addEventListener('keydown', (e) => {
        if (e.key !== ' ') return;
        e.preventDefault();
        // A stale drag flag (a pointerup that never reached the SVG) would make
        // the click guard swallow the activation, so clear it first.
        suppressClick = false;
        // Go through the anchor's own click instead of navigating directly: the
        // click path is what emits `graph_node_click` and what TalkCard
        // intercepts to open the talk dialog — a direct `navigateTo` would emit
        // one layer and not the other.
        const anchor = g.querySelector('a');
        if (anchor) {
          anchor.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
        } else {
          navigateTo(nodes[i]);
        }
      });
    });

    // Initial positions: center node at the middle, the rest on a ring around it.
    const cx = world.w / 2;
    const cy = world.h / 2;
    const ring = Math.min(world.w, world.h) * 0.3;
    const others = nodes.filter((n) => n.id !== data.centerId);
    nodes.forEach((n) => {
      if (n.id === data.centerId) {
        n.x = cx;
        n.y = cy;
        return;
      }
      const i = others.indexOf(n);
      const a = (i / Math.max(1, others.length)) * 2 * Math.PI - Math.PI / 2;
      n.x = cx + Math.cos(a) * ring;
      n.y = cy + Math.sin(a) * ring;
    });
    measureLabels();
    layoutLabels();
    updatePads();
  }

  /** Tap-pad radius from the live layout: `max(visible r, min(22, 0.45·d))`,
   *  where `d` is the distance to the nearest other node. A flat 44px pad is
   *  fine on a sparse ring, but the dense `untracked` track packs 32 nodes at a
   *  ~15.6px step, so a 44px pad covered the neighbour's dot and a tap on the
   *  visible circle opened the wrong node. Half the neighbour distance is the
   *  largest pad that cannot swallow an adjacent centre; 24px stays the target
   *  wherever the geometry allows it. O(n²) over ≤ a few dozen nodes per frame. */
  function updatePads() {
    const n = nodes.length;
    for (let i = 0; i < n; i++) {
      const a = nodes[i];
      let nearest2 = Infinity;
      for (let j = 0; j < n; j++) {
        if (j === i) continue;
        const dx = a.x - nodes[j].x;
        const dy = a.y - nodes[j].y;
        const d2 = dx * dx + dy * dy;
        if (d2 < nearest2) nearest2 = d2;
      }
      const nearest = Math.sqrt(nearest2);
      const limit = Math.min(22, (Number.isFinite(nearest) ? nearest : 44) * 0.45);
      const r = nodeRadii[i] ?? 6;
      const pad = padEls[i];
      if (pad) pad.setAttribute('r', String(Math.max(r, limit)));
    }
  }

  /** Advance width of each label, measured once per render pass. `getComputed-
   *  TextLength` returns 0 when the SVG has no layout box yet, so a character
   *  estimate stands in until the element is really rendered. */
  function measureLabels() {
    labelWidths = nodeTexts.map((txt, i) => {
      if (txt.hasAttribute('textLength')) {
        txt.removeAttribute('textLength');
        txt.removeAttribute('lengthAdjust');
      }
      let w = 0;
      try {
        w = txt.getComputedTextLength();
      } catch {
        w = 0;
      }
      return w || (nodeTexts[i].textContent || '').length * 6.2;
    });
  }

  /** Keep every label inside the canvas. Labels are drawn to the right of the
   *  circle, and near the right edge that ran off the SVG — 6 of the 13 graphs
   *  on /talks/ lost the tail of a track name, clipped rather than covered.
   *  Such a label flips to the circle's left, is then shifted back inside the
   *  box, and a label wider than the canvas itself (a long talk title) is
   *  condensed with `textLength` instead of overflowing. The centre's label
   *  sits under its circle and is nudged horizontally the same way. */
  function layoutLabels() {
    if (!nodes.length) return;
    const pad = 4;
    const maxW = Math.max(24, world.w - pad * 2);
    // Approximate ascent/descent of an 11px, weight-600 label around its baseline.
    const ascend = 10;
    const descend = 4;
    const boxes: {
      x: number;
      top: number;
      w: number;
      anchor: 'start' | 'end' | 'middle';
      center: boolean;
    }[] = [];

    nodes.forEach((n, i) => {
      const txt = nodeTexts[i];
      if (!txt) return;
      const r = (n.size || 6) * NODE_SIZE;
      const isCenter = n.id === data.centerId;
      let w = labelWidths[i] || (txt.textContent || '').length * 6.2;
      if (w > maxW) {
        if (txt.getAttribute('textLength') !== String(maxW)) {
          txt.setAttribute('textLength', String(maxW));
          txt.setAttribute('lengthAdjust', 'spacingAndGlyphs');
        }
        w = maxW;
      } else if (txt.hasAttribute('textLength')) {
        txt.removeAttribute('textLength');
        txt.removeAttribute('lengthAdjust');
      }
      const y = isCenter ? r + 14 : 4;
      const anchor: 'start' | 'end' | 'middle' = isCenter
        ? 'middle'
        : n.x + r + 6 + w > world.w - pad
          ? 'end'
          : 'start';
      const x = isCenter ? 0 : anchor === 'end' ? -(r + 6) : r + 6;
      // Absolute baseline of the label box; local `y` arrives later.
      boxes[i] = { x, top: n.y + y - ascend, w, anchor, center: isCenter };
    });

    // Place top-down, pushing each label below any box it would cover. At
    // 390px the eleven track names used to stack in pairs («Без трека» on
    // «АРХИТЕКТУРА»): nothing compared one label to another, only to the canvas
    // edge. The centre's label is the anchor and never yields.
    const order = nodes
      .map((_, i) => i)
      .filter((i) => boxes[i])
      .sort((a, b) => boxes[a].top - boxes[b].top);
    const placed: { left: number; right: number; top: number; bottom: number }[] = [];
    const boxH = ascend + descend;

    for (const i of order) {
      const box = boxes[i];
      const n = nodes[i];
      const leftOf = (cx: number) =>
        box.anchor === 'end' ? cx - box.w : box.anchor === 'middle' ? cx - box.w / 2 : cx;
      // Clamp the whole label box, not just its origin: a label flipped to the
      // left of a node near the left edge overflows on that side instead.
      let absX = n.x + box.x;
      let left = leftOf(absX);
      if (left < pad) {
        absX += pad - left;
        left = pad;
      } else if (left + box.w > world.w - pad) {
        absX += world.w - pad - box.w - left;
        left = world.w - pad - box.w;
      }
      let top = Math.max(2, Math.min(world.h - 2 - boxH, box.top));
      if (!box.center) {
        // ≤ 33 labels per graph, so the quadratic scan is cheaper than sorting twice.
        const over = (t: number) =>
          placed.filter(
            (p) => left < p.right && left + box.w > p.left && t < p.bottom && t + boxH > p.top,
          );
        const maxTop = Math.max(2, world.h - 2 - boxH);
        // Downward first: the common case, and it keeps the reading order.
        for (let guard = 0; guard < 64; guard++) {
          const hit = over(top)[0];
          if (!hit) break;
          const next = Math.min(maxTop, hit.bottom + 2);
          if (next === top) break;
          top = next;
        }
        // Against the bottom edge the clamp above pins several labels to one
        // top, so "push down" can resolve nothing. Stack upward instead — that
        // is where the free space is for nodes hanging low in the ring.
        for (let guard = 0; guard < 64; guard++) {
          const hits = over(top);
          if (!hits.length) break;
          const ceiling = hits.reduce((m, p) => Math.min(m, p.top), Infinity) - 2 - boxH;
          const next = Math.max(2, ceiling);
          if (next === top) break;
          top = next;
        }
      }
      placed.push({ left, right: left + box.w, top, bottom: top + boxH });
      // `x`/`y` are local to the node group (the group carries translate(n.x,n.y)),
      // so absolute values come back into local space with `- n.x` / `- n.y`.
      nodeTexts[i].setAttribute('x', String(absX - n.x));
      nodeTexts[i].setAttribute('y', String(top + ascend - n.y));
      nodeTexts[i].setAttribute('text-anchor', box.anchor);
    }
  }

  /** Stop the line at the target's edge so it doesn't run under the circle —
   *  the same endpoint trim the main graph applies. */
  function drawEdges() {
    links.forEach((l, i) => {
      const dx = l.target.x - l.source.x;
      const dy = l.target.y - l.source.y;
      const d = Math.sqrt(dx * dx + dy * dy) || 1;
      const r = (l.target.size || 6) + 2;
      const x1 = l.source.x;
      const y1 = l.source.y;
      const x2 = l.target.x - (dx / d) * r;
      const y2 = l.target.y - (dy / d) * r;
      for (const e of [edges[i], edgeHits[i]]) {
        if (!e) continue;
        e.setAttribute('x1', String(x1));
        e.setAttribute('y1', String(y1));
        e.setAttribute('x2', String(x2));
        e.setAttribute('y2', String(y2));
      }
    });
  }

  function clearHighlight() {
    nodes.forEach((_, i) => (nodeEls[i].style.opacity = ''));
    edges.forEach((e) => (e.style.opacity = ''));
  }

  function highlight(id: string) {
    const neighbors = adjacency.get(id) || new Set<string>();
    neighbors.add(id);
    nodes.forEach((n, i) => {
      nodeEls[i].style.opacity = neighbors.has(n.id) ? '1' : '0.12';
    });
    edges.forEach((e, i) => {
      const l = links[i];
      const on = l.source.id === id || l.target.id === id;
      e.style.opacity = on ? String(Math.min(1, (l.weight || 1) * 0.9 + 0.2)) : '0.05';
    });
  }

  function navigateTo(n: any) {
    if (n?.href) window.location.href = n.href;
  }

  function renderStatic() {
    rebuild();
    drawEdges();
    nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`));
  }

  function renderForce() {
    rebuild();

    // Same alpha-based settling as the main graph, scaled to node count.
    const N = Math.max(1, nodes.length);
    const charge = 2200 * Math.sqrt(N);
    // Soften the 1/d² kernel so coincident nodes cannot blow up: the biggest
    // visible radius is size 13 × NODE_SIZE 1.06 ≈ 13.8px, so 2× of it (28px)
    // is the contact distance below which two circles would overlap anyway.
    const minD2 = 28 * 28;
    const gravity = 0.004 + 0.001 * Math.sqrt(N);
    const damp = 0.86;
    // A fixed margin eats the whole canvas on a 320px phone (75px of 254), the
    // settled ring then exceeds the perimeter and nodes collide on the clamp
    // corners, so the margin may never consume more than ~1/8 of the width.
    const margin = Math.min(80, 60 + N * 0.5, world.w * 0.12);
    const alphaDecay = Math.max(0.015, 0.03 - 0.001 * Math.sqrt(N));
    const alphaMin = 0.01;
    const maxFrames = Math.max(400, N * 10);
    let alpha = 1;

    function tick() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          let dx = a.x - b.x, dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1e-6) {
            // A coincident pair has no direction vector, so softening alone
            // would leave it stacked: give it a deterministic unit separation.
            const jig = (i + 1) * 1.618 + (j + 1) * 2.414;
            dx = Math.cos(jig); dy = Math.sin(jig); d2 = 1;
          }
          let d = Math.sqrt(d2);
          const f = (charge / Math.max(d2, minD2)) * alpha;
          a.vx += (dx / d) * f; a.vy += (dy / d) * f;
          b.vx -= (dx / d) * f; b.vy -= (dy / d) * f;
        }
      }
      links.forEach((l) => {
        const dx = l.target.x - l.source.x, dy = l.target.y - l.source.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const ideal = 60 + 80 * (1 - (l.weight || 1));
        const f = (d - ideal) * 0.04 * (0.5 + 0.5 * (l.weight || 1)) * alpha;
        const fx = (dx / d) * f, fy = (dy / d) * f;
        l.source.vx += fx; l.source.vy += fy;
        l.target.vx -= fx; l.target.vy -= fy;
      });
      nodes.forEach((n) => {
        if (n.fx != null) { n.x = n.fx; n.y = n.fy; n.vx = 0; n.vy = 0; return; }
        n.vx += (world.w / 2 - n.x) * gravity * alpha;
        n.vy += (world.h / 2 - n.y) * gravity * alpha;
        n.vx *= damp; n.vy *= damp;
        n.x += n.vx; n.y += n.vy;
        n.x = Math.max(margin, Math.min(world.w - margin, n.x));
        n.y = Math.max(margin, Math.min(world.h - margin, n.y));
      });
      drawEdges();
      nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`));
      updatePads();
      layoutLabels();
    }

    function loop() {
      if (!running) return;
      tick();
      frames++;
      alpha *= 1 - alphaDecay;
      if (alpha < alphaMin || frames > maxFrames) running = false;
      requestAnimationFrame(loop);
    }

    restart = () => {
      running = true;
      frames = 0;
      alpha = 1;
      loop();
    };
    restart();
  }

  // Pointer: drag a node (click = navigate).
  //
  // The settle loop stops for good once alpha < alphaMin (~2.5 s), and after
  // that nothing consumed the `fx/fy` a drag writes — so dragging a node was
  // dead for the rest of the page's life while the cursor still said
  // `grabbing`. A drag-only rAF applies the pin and redraws; it never restarts
  // the physics, so grabbing a settled graph does not make it jump.
  function dragFrame() {
    dragRaf = 0;
    if (!dragging) return;
    dragging.x = dragging.fx;
    dragging.y = dragging.fy;
    const i = nodes.indexOf(dragging);
    if (i >= 0 && nodeEls[i]) {
      nodeEls[i].setAttribute('transform', `translate(${dragging.x},${dragging.y})`);
    }
    drawEdges();
    updatePads();
    layoutLabels();
    dragRaf = requestAnimationFrame(dragFrame);
  }

  /** Two fingers: pinch scales about the midpoint and the midpoint's own drift
   *  pans, which is what every map on a phone does. `pinch.mx/my` is carried
   *  forward each move so the pan is relative, not cumulative. */
  function startPinch() {
    const [a, b] = [...pointers.values()];
    pinch = {
      dist: Math.hypot(a.x - b.x, a.y - b.y) || 1,
      k: view.k,
      mx: (a.x + b.x) / 2,
      my: (a.y + b.y) / 2,
    };
    dragging = null;
    pan = null;
  }

  function updatePinch() {
    const pts = [...pointers.values()];
    if (pts.length < 2 || !pinch) return;
    const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y) || 1;
    view.k = clampK(pinch.k * (dist / pinch.dist));
    const mx = (pts[0].x + pts[1].x) / 2;
    const my = (pts[0].y + pts[1].y) / 2;
    view.x += mx - pinch.mx;
    view.y += my - pinch.my;
    pinch.mx = mx;
    pinch.my = my;
    applyView();
  }

  function handlePointerDown(e: PointerEvent) {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      startPinch();
      return;
    }
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) {
      // Background drag pans with a mouse, or with a finger once the graph is
      // zoomed. At 1× on touch the vertical swipe must keep scrolling the page
      // (verify-talks-mobile check (a)).
      if (view.k > 1.001 || e.pointerType === 'mouse') {
        pan = { x: e.clientX, y: e.clientY, vx: view.x, vy: view.y };
      }
      return;
    }
    // Capture only when the press landed on a node — capturing on the whole
    // surface swallowed every gesture that started on the empty background,
    // and nothing ever released the capture. It is also taken later, at the
    // drag threshold: a captured pointer retargets the compatibility click to
    // the SVG, which would leave the anchor's own navigation unreachable.
    const p = toWorld(e.clientX, e.clientY);
    if (!p) return;
    dragging = nodes[nodeEls.indexOf(target)];
    dragStart = p;
    moved = false;
    suppressClick = false;
  }

  function handlePointerMove(e: PointerEvent) {
    if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch && pointers.size >= 2) {
      updatePinch();
      return;
    }
    if (pan) {
      view.x = pan.vx + (e.clientX - pan.x);
      view.y = pan.vy + (e.clientY - pan.y);
      applyView();
      return;
    }
    if (!dragging) return;
    const p = toWorld(e.clientX, e.clientY);
    if (!p) return;
    if (!moved) {
      const dx = p.x - (dragStart?.x ?? p.x);
      const dy = p.y - (dragStart?.y ?? p.y);
      // 10 CSS px, not 3: below that a hand tremor turned a tap into a drag and
      // a swipe into a lost tap. The node is not pinned before the threshold,
      // so a tap never makes it jump under the finger.
      if (dx * dx + dy * dy <= 100) return;
      moved = true;
      // A real drag now: take the pointer so it keeps tracking past the SVG
      // edge for the rest of the gesture.
      try {
        svg.setPointerCapture(e.pointerId);
        dragPointerId = e.pointerId;
      } catch {
        // The pointer went away between events; dragging still works inside.
      }
      const g = nodeEls[nodes.indexOf(dragging)];
      if (g) g.style.cursor = 'grabbing';
      if (!dragRaf) dragRaf = requestAnimationFrame(dragFrame);
    }
    dragging.fx = p.x;
    dragging.fy = p.y;
  }

  /** Finish a press. Navigation is the anchor's job now, so this only tears the
   *  drag down and arms the click guard: a press that moved must not follow the
   *  link on release. `cancelled` (pointercancel) is never a click — the browser
   *  took the pointer (the page started scrolling, a call arrived, a system
   *  gesture fired), and there is no compatibility click to suppress. */
  function endPress(cancelled: boolean, pointerId?: number) {
    if (pointerId != null) pointers.delete(pointerId);
    if (pointers.size < 2) pinch = null;
    pan = null;
    if (!dragging) return;
    const n = dragging;
    suppressClick = !cancelled && moved;
    n.fx = null;
    n.fy = null;
    if (dragRaf) {
      cancelAnimationFrame(dragRaf);
      dragRaf = 0;
    }
    if (dragPointerId != null) {
      try {
        svg.releasePointerCapture(dragPointerId);
      } catch {
        // The pointer is already gone; nothing to release.
      }
      dragPointerId = null;
    }
    const g = nodeEls[nodes.indexOf(n)];
    if (g) g.style.cursor = 'pointer';
    dragging = null;
    dragStart = null;
  }

  svg.addEventListener('pointerdown', handlePointerDown);
  svg.addEventListener('pointermove', handlePointerMove);
  svg.addEventListener('pointerup', (e) => endPress(false, e.pointerId));
  svg.addEventListener('pointercancel', (e) => endPress(true, e.pointerId));
  svg.addEventListener('click', (e) => {
    if (!suppressClick) return;
    suppressClick = false;
    e.preventDefault();
    e.stopPropagation();
  });

  // --- Zoom / pan controls ---------------------------------------------------
  // Wheel zooms only with Ctrl/Cmd held: a plain wheel over a 480px card has to
  // keep scrolling the document, or the graph swallows the page.
  svg.addEventListener(
    'wheel',
    (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      setZoom(view.k * (e.deltaY < 0 ? 1.15 : 1 / 1.15));
    },
    { passive: false },
  );

  root.querySelectorAll<HTMLButtonElement>('[data-pg-zoom]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-pg-zoom');
      if (mode === 'in') setZoom(view.k * 1.35);
      else if (mode === 'out') setZoom(view.k / 1.35);
      else resetView();
    });
  });

  // Talk labels are hover-only (a 91-title cloud otherwise), which on a phone
  // leaves an unlabelled dot cloud. This reveals them on demand.
  const labelsBtn = root.querySelector<HTMLButtonElement>('[data-pg-labels]');
  labelsBtn?.addEventListener('click', () => {
    const on = root.classList.toggle('pg-labels-on');
    labelsBtn.setAttribute('aria-pressed', String(on));
  });

  // --- Tooltip: content lines come precomputed (data.nodeT / data.edgeT) so
  // the client only positions and renders them. Hover-only; keyboard users get
  // the native SVG <title>. `tooltipEl` arrives from this instance's subtree. ---
  function showTooltip(lines: string[] | undefined, clientX: number, clientY: number) {
    if (!tooltipEl || !lines || !lines.length) return;
    tooltipEl.replaceChildren();
    for (const line of lines) {
      const row = document.createElement('div');
      row.textContent = line;
      tooltipEl.appendChild(row);
    }
    tooltipEl.hidden = false;
    const rect = root.getBoundingClientRect();
    const w = tooltipEl.offsetWidth;
    const h = tooltipEl.offsetHeight;
    let x = clientX - rect.left + 14;
    let y = clientY - rect.top + 14;
    if (x + w > rect.width - 8) x = Math.max(8, clientX - rect.left - w - 14);
    if (y + h > rect.height - 8) y = Math.max(8, clientY - rect.top - h - 8);
    tooltipEl.style.transform = `translate(${x}px, ${y}px)`;
  }
  function hideTooltip() {
    if (tooltipEl) tooltipEl.hidden = true;
  }

  // Hover: highlight neighbors; the label appears via CSS on hover/focus.
  svg.addEventListener('pointerover', (e) => {
    const hitIdx = edgeHits.indexOf(e.target as unknown as SVGLineElement);
    if (hitIdx >= 0) {
      showTooltip(data.edgeT?.[hitIdx], e.clientX, e.clientY);
      return;
    }
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) {
      clearHighlight();
      hideTooltip();
      return;
    }
    const idx = nodeEls.indexOf(target);
    const n = nodes[idx];
    highlight(n.id);
    showTooltip(data.nodeT?.[idx], e.clientX, e.clientY);
  });
  svg.addEventListener('pointerout', (e) => {
    const stillIn = (e.relatedTarget as Node | null) && svg.contains(e.relatedTarget as Node);
    if (!stillIn) {
      clearHighlight();
      hideTooltip();
    }
  });

  // Render only when the SVG has a real box, then keep it honest on resize.
  // Laid out for a 0-width panel, the graph was clipped on phones and
  // off-centre on desktop, and a later window resize never fixed it.
  let renderMode: (() => void) | null = null;
  let lastW = 0;
  let lastH = 0;
  let resizeRaf = 0;

  function renderWhenVisible(): boolean {
    const rect = svg.getBoundingClientRect();
    if (rect.width < 40 || rect.height < 40) return false;
    // Ignore sub-pixel churn and the scrollbar-width wobble.
    if (Math.abs(rect.width - lastW) < 24 && Math.abs(rect.height - lastH) < 24) return false;
    lastW = rect.width;
    lastH = rect.height;
    renderMode?.();
    return true;
  }

  const resizeObserver = new ResizeObserver(() => {
    if (resizeRaf) return;
    resizeRaf = requestAnimationFrame(() => {
      resizeRaf = 0;
      renderWhenVisible();
    });
  });
  resizeObserver.observe(svg);

  renderMode = reduced ? renderStatic : renderForce;
  renderWhenVisible();

  // Web-font metrics differ from the fallback the first measure used; re-take
  // the widths once the fonts are in, or a flipped label can still poke out.
  document.fonts?.ready
    .then(() => {
      if (!nodes.length) return;
      measureLabels();
      layoutLabels();
    })
    .catch(() => {});

  // Visible at load → render now. Hidden in the «Связи» tab (or below an
  // un-activated SectionPanel) → the observer above renders it when it opens.
  }

  for (const rootEl of Array.from(document.querySelectorAll<HTMLElement>('.pg-root'))) {
    const svgEl = rootEl.querySelector<SVGSVGElement>('svg.pg-svg');
    const dataEl = rootEl.querySelector<HTMLScriptElement>('script.pg-data');
    if (!svgEl || !dataEl) continue;
    let data: any;
    try {
      data = JSON.parse(dataEl.textContent || '{}');
    } catch {
      // A malformed payload must not take the other twelve graphs down.
      continue;
    }
    initGraph(rootEl, svgEl, data, rootEl.querySelector<HTMLDivElement>('.pg-tooltip'));
  }
</script>

<style is:global>
  .pg-root {
    position: relative;
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .pg-svg {
    width: 100%;
    display: block;
    /* A mouse owns the whole surface. A finger does not: with `none` a swipe
       that starts on the graph cannot scroll the page at all, and the card is
       up to 480px tall — most of a phone screen. Coarse pointers pan, so the
       touch that lands on a graph still scrolls the page. */
    touch-action: none;
    cursor: grab;
  }
  @media (pointer: coarse) {
    .pg-svg {
      touch-action: pan-y pinch-zoom;
    }
  }
  .pg-edge {
    stroke: color-mix(in srgb, var(--text-muted) 50%, transparent);
    stroke-width: 1;
  }
  .pg-center circle:not(.pg-hit) {
    stroke: var(--text-accent);
    stroke-width: 2.5px;
  }
  .pg-label {
    fill: var(--text-normal);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-sans);
    paint-order: stroke;
    stroke: var(--background-secondary);
    stroke-width: 3px;
    stroke-opacity: 0.95;
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  /* Post labels are hover/focus-only; projects, topics and Volta parts stay
     labeled — the same rule as the main graph. */
  .pg-label-hover {
    opacity: 0;
  }
  .pg-root :is(a[href]) {
    outline: none;
  }
  .pg-root :is(a[href]:focus-visible) {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
  .pg-root :is(a[href]:hover) .pg-label-hover,
  .pg-root :is(a[href]:focus) .pg-label-hover {
    opacity: 1;
  }
  .pg-root :is(a[href]:focus) text {
    fill: var(--text-accent);
  }
  .pg-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: var(--z-panel);
    pointer-events: none;
    background: var(--background-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
    padding: 0.4rem 0.55rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-normal);
    max-width: 240px;
    white-space: normal;
  }
  .pg-tooltip[hidden] {
    display: none;
  }
  /* Below the canvas, not floating over it: absolutely positioned, the cluster
     sat on top of the labels of whatever nodes the layout put in that corner. */
  .pg-controls {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    margin-top: var(--space-2);
  }
  .pg-btn {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1;
    color: var(--text-normal);
    background: var(--background-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .pg-btn:hover,
