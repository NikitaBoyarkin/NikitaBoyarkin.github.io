---
// Animated "live metrics" strip under the hero tagline. Numbers match the
// agreed Phase 7 message: years, projects, stack, business result.
// Respects prefers-reduced-motion (renders final values, no animation).
interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

import { METRICS as SIG } from "../lib/metrics";

type Metric = {
  value: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  label: string;
};

// Units are shared with the OG banners ("п.п." / "€656K"), so the strip and
// the banner read as one series rather than two conventions.
const METRICS: Metric[] = [
  { value: 5, label: isEn ? "years in data" : "лет в данных" },
  { value: SIG.portfolio.projects, label: isEn ? "portfolio projects" : "проектов в портфолио" },
  { value: SIG.abKyc.deltaPp, decimals: 2, prefix: "+", suffix: isEn ? " pp" : " п.п.", label: isEn ? "KYC conversion" : "KYC-конверсия" },
  { value: SIG.abKyc.annualEurK, prefix: "€", suffix: isEn ? "K/yr" : "K/год", label: isEn ? "annual fix impact" : "годовой эффект фикса" },
];

const fmt = (v: number, d: number) => (d > 0 ? v.toFixed(d) : String(Math.round(v)));
---

<div class="hero-metrics" role="group" aria-label={isEn ? "Key metrics" : "Ключевые метрики"}>
  {
    METRICS.map((m) => (
      <div class="hero-metric">
        <span
          class="hero-metric-value"
          data-value={m.value}
          data-decimals={m.decimals ?? 0}
          data-prefix={m.prefix ?? ""}
          data-suffix={m.suffix ?? ""}
        >
          {m.prefix ?? ""}{fmt(m.value, m.decimals ?? 0)}{m.suffix ?? ""}
        </span>
        <span class="hero-metric-label">{m.label}</span>
      </div>
    ))
  }
  <p class="hero-metrics-note">
    {isEn
      ? "Business figures: portfolio case Volta (synthetic data) — not employment results."
      : "Бизнес-цифры — кейс портфолио Volta (синтетические данные), не результаты найма."}
  </p>
</div>

<script>
  function init() {
    const strip = document.querySelector<HTMLElement>(".hero-metrics");
    if (!strip) return;
    const cells = Array.from(strip.querySelectorAll<HTMLElement>(".hero-metric-value"));
    if (!cells.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function format(v: number, decimals: number): string {
      return decimals > 0 ? v.toFixed(decimals) : String(Math.round(v));
    }

    function setFinal(cell: HTMLElement) {
      const value = Number(cell.dataset.value || 0);
      const decimals = Number(cell.dataset.decimals || 0);
      cell.textContent = `${cell.dataset.prefix ?? ""}${format(value, decimals)}${cell.dataset.suffix ?? ""}`;
    }

    function countUp(cell: HTMLElement) {
      const value = Number(cell.dataset.value || 0);
      const decimals = Number(cell.dataset.decimals || 0);
      const prefix = cell.dataset.prefix ?? "";
      const suffix = cell.dataset.suffix ?? "";
      const duration = 1200;
      const start = performance.now();

      function frame(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        cell.textContent = `${prefix}${format(value * eased, decimals)}${suffix}`;
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    if (reduceMotion) {
      cells.forEach(setFinal);
      return;
    }

    let started = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (started) return;
        if (entries.some((e) => e.isIntersecting)) {
          started = true;
          cells.forEach(countUp);
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(strip);
  }

  init();
</script>

<style>
  .hero-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    row-gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero-metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  /* Light separators between metrics — the banner scorecard has them too, so
     the strip and the banner read as the same component. */
  .hero-metric + .hero-metric {
    padding-left: var(--space-3);
    border-left: 1px solid color-mix(in srgb, var(--text-muted) 32%, transparent);
  }
  .hero-metric-value {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .hero-metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    max-width: 12ch;
    line-height: 1.35;
  }
  /* Honesty caveat: the KYC/euro figures come from a synthetic-data case
     study, and a recruiter must be able to see that without scrolling. */
  .hero-metrics-note {
    margin-top: var(--space-2);
    font-size: 0.72rem;
    color: var(--text-muted);
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .hero-metrics {
      gap: var(--space-3);
    }
    /* Stacked columns: a left rule on the first cell of a wrapped row would
       read as a stray mark, so the separators drop out and gap does the work. */
    .hero-metric + .hero-metric {
      padding-left: 0;
      border-left: none;
    }
    .hero-metric-value {
      font-size: 1.1rem;
    }
  }
</style>
