---
// Programme graph for the Matemarketing 2026 conference. The markup is shared by
// both locales (`/talks/` and `/en/talks/`) and branches only on `lang`, so the
// two pages cannot drift apart: same anchors, same sections, same graph.
//
// Data comes from the sibling mm-program-page project via
// scripts/sync-talks-data.mjs. The EN overlay only carries what the source
// project itself translates (track names, talk titles); halls, days and blurbs
// fall back to RU rather than disappearing.
//
// The five sections are grouped into a dashboard (SectionTabs + SectionPanel) so
// the page is not one 91-talk scroll. Deep links survive the regrouping —
// SectionTabs maps every `[id]` inside a panel back to that panel, so `#t123`,
// `#track-avito` and `#theme-ai` all open the tab that contains them.
//
// Copy lives in lib/talks-copy.ts, the programme panel in TalksProgram.astro.
import ProjectGraph from './ProjectGraph.astro';
import SectionTabs from './SectionTabs.astro';
import SectionPanel from './SectionPanel.astro';
import TalksProgram from './TalksProgram.astro';
import { withBase } from '../lib/path';
import rawData from '../data/talks.json';
import rawOverlay from '../data/talks-en.json';
import { talksCopy } from '../lib/talks-copy';
import {
  buildTalksGraph,
  overviewGraph,
  talkTitle,
  talksOfTrack,
  trackGraph,
  trackName,
  UNTRACKED,
  TRACK_LABEL,
  EVENT_ID,
  type TalksData,
  type TalksOverlay,
  type TalksTalk,
} from '../lib/talks-graph';

interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const data = rawData as unknown as TalksData;
const overlay = rawOverlay as TalksOverlay;
const graph = buildTalksGraph(data, lang, overlay);
// Two levels on purpose: the full 104-node star (event → tracks → talks) is
// beyond what ProjectGraph's force layout can place (see `overviewGraph` in
// lib/talks-graph.ts), so the top card draws the event, the eleven tracks and
// the synthetic «Без трека» hub, and each track section below draws its own
// talks and signature themes.
const overview = overviewGraph(graph);

const prefix = isEn ? 'en/' : '';
const href = (hash: string) => withBase(`${prefix}talks/${hash}`);

// Every talk's anchor is `#t<id>` in both locales, so a link written once works
// on either page and the graph nodes point at the same scroll targets.
const trackGroups = [
  ...data.tracks.map((t) => ({ slug: t.slug, name: t.name })),
  { slug: UNTRACKED, name: TRACK_LABEL[lang] },
]
  .map((t) => ({ ...t, talks: talksOfTrack(data, t.slug) }))
  .filter((t) => t.talks.length > 0)
  .sort((a, b) =>
    a.slug === UNTRACKED ? 1 : b.slug === UNTRACKED ? -1 : b.talks.length - a.talks.length,
  );

const themeGroups = data.themes
  .map((th) => ({ ...th, talks: data.talks.filter((t) => (t.themes ?? []).includes(th.id)) }))
  .filter((th) => th.talks.length > 0)
  .sort((a, b) => b.talks.length - a.talks.length);

// Speaker multiplicity, computed once: the stats card and the method note both
// read it, so the page cannot print "0" from one while the prose asserts
// something else. `data.talks[].lectors` is the only source.
const lectorTalks = new Map<string, number>();
for (const t of data.talks) {
  for (const l of t.lectors) lectorTalks.set(l.name, (lectorTalks.get(l.name) ?? 0) + 1);
}
const lectorCount = lectorTalks.size;
const repeatLectors = [...lectorTalks.values()].filter((n) => n >= 2).length;
// Talks that actually name a speaker. Ten of the 91 do not, so prose must not
// imply every talk has a lector.
const talksWithLector = data.talks.filter((t) => t.lectors.length > 0).length;
const talksWithoutLector = data.talks.length - talksWithLector;
// Breadth of the widest theme — the reason the theme layer sits below the
// track layer instead of inside the full graph. Computed, never hardcoded.
const widestTheme = themeGroups[0]?.talks.length ?? 0;
const hallCounts = data.halls
  .map((h) => ({ ...h, n: data.talks.filter((t) => t.hallSlug === h.slug).length }))
  .filter((h) => h.n > 0);
const dayCounts = data.days.map((d) => ({
  ...d,
  n: data.talks.filter((t) => t.dayId === d.id).length,
}));
// The source leaves ~30% of the programme without a track, so the bucket is a
// real part of the conference rather than noise: it gets a stat of its own and
// must not be counted as one of `data.tracks`.
const untrackedCount = talksOfTrack(data, UNTRACKED).length;

const label = (name: string) => trackName(name, lang, overlay);
const title = (talk: { id: number; title: string }) => talkTitle(talk, lang, overlay);
const timeOf = (t: { start: string; end: string }) => `${t.start}–${t.end}`;
const themeById = new Map(data.themes.map((th) => [th.id, th]));
const themeLabel = (id: string) => {
  const th = themeById.get(id);
  return th ? (isEn ? th.labelEn : th.label) : id;
};

const copy = talksCopy(lang, {
  event: data.event,
  tracks: data.tracks.length,
  untracked: untrackedCount,
  talks: data.talks.length,
  widestTheme,
  lectors: lectorCount,
  talksWithLector,
  talksWithoutLector,
});

// Programme panel: days in the source's own order (1 день → 2 день →
// Онлайн-день — chronological by date would put the online day first), talks
// inside a day sorted by start time. `data.days` is already in programme order,
// so the array index is the sort key.
const dayIndex = new Map(data.days.map((d, i) => [d.id, i]));
const sortTalks = (a: TalksTalk, b: TalksTalk) =>
  (dayIndex.get(a.dayId) ?? data.days.length) - (dayIndex.get(b.dayId) ?? data.days.length) ||
  a.start.localeCompare(b.start) ||
  a.title.localeCompare(b.title, 'ru');
const dayGroups = data.days.map((d) => ({
  ...d,
  talks: data.talks.filter((t) => t.dayId === d.id).sort(sortTalks),
}));
const unassignedTalks = data.talks.filter((t) => !dayIndex.has(t.dayId));
const searchBlob = (talk: TalksTalk) =>
  [
    title(talk),
    talk.hall,
    talk.trackName ? label(talk.trackName) : '',
    ...talk.lectors.map((l) => l.name),
    ...(talk.themes ?? []).map(themeLabel),
  ]
    .join(' ')
    .toLowerCase()
    .replace(/ё/g, 'е');

const tabs = [
  { id: 'overview', label: copy.tabOverview },
  { id: 'program', label: copy.tabProgram },
  { id: 'tracks', label: copy.tabTracks },
  { id: 'themes', label: copy.tabThemes },
  { id: 'halls', label: copy.tabHalls },
];
---

<section class="talks-board reveal">
  <header class="talks-head">
    <h1 class="page-title">{copy.h1}</h1>
    <p class="talks-note">{copy.headNote}</p>
  </header>

  <div class="talks-stats">
    <div><b>{data.talks.length}</b><span>{copy.statTalks}</span></div>
    <div><b>{data.tracks.length}</b><span>{copy.statTracks}</span></div>
    <div><b>{untrackedCount}</b><span>{copy.statUntracked}</span></div>
    <div><b>{themeGroups.length}</b><span>{copy.statThemes}</span></div>
    <div><b>{hallCounts.length}</b><span>{copy.statHalls}</span></div>
    <div><b>{lectorCount}</b><span>{copy.statLectors}</span></div>
    <div><b>{repeatLectors}</b><span>{copy.statRepeat}</span></div>
  </div>

  <SectionTabs tabs={tabs} label={copy.tablistLabel}>
    <SectionPanel id="overview" active={true}>
      <p class="talks-note">{copy.methodNote}</p>

      <ProjectGraph
        nodes={overview.nodes}
        links={overview.links}
        centerId={EVENT_ID}
        lang={lang}
        height={480}
        idPrefix="talks-overview"
        caption={copy.graphCaption}
        ariaLabel={copy.graphAria}
      />

      <p class="talks-note">
        {copy.sourceNote} <a href="https://github.com/NikitaBoyarkin/mm-program-page">mm-program-page</a>;
        {copy.generatorNote} <code>src/lib/talks-graph.ts</code>.
      </p>
    </SectionPanel>

    <SectionPanel id="program">
      <TalksProgram
        copy={copy}
        dayGroups={dayGroups}
        unassigned={unassignedTalks}
        href={href}
        label={label}
        title={title}
        timeOf={timeOf}
        searchBlob={searchBlob}
      />
    </SectionPanel>

    <SectionPanel id="tracks">
      <h2 class="talks-h2">{copy.tracksH2}</h2>
      <p class="talks-note">{copy.tracksNote}</p>

      <nav class="talks-tracknav" aria-label={copy.trackNavLabel}>
        {trackGroups.map((t) => (
          <a class="talks-chip" href={href(`#track-${t.slug}`)}>
            {t.slug === UNTRACKED ? t.name : label(t.name)}
            <span class="talks-chip-n">{t.talks.length}</span>
          </a>
        ))}
      </nav>

      {trackGroups.map((t) => {
        const sub = trackGraph(graph, data, t.slug, lang);
        const name = t.slug === UNTRACKED ? t.name : label(t.name);
        const themeHubs = sub.nodes.filter((n) => n.section === 'theme').length;
        return (
          <section class="talks-track" id={`track-${t.slug}`}>
            <h3 class="talks-h3">
              {name} <span class="talks-count">{t.talks.length}</span>
            </h3>
            <ProjectGraph
              nodes={sub.nodes}
              links={sub.links}
              centerId={`track:${t.slug}`}
              lang={lang}
              idPrefix={`talks-track-${t.slug}`}
              caption={copy.trackCaption(name, t.talks.length, themeHubs)}
              ariaLabel={copy.trackAria(name)}
            />
            <ol class="talks-list">
              {t.talks.map((talk) => (
                <li id={`t${talk.id}`}>
                  <a class="talks-title" href={href(`#t${talk.id}`)}>
                    {title(talk)}
                  </a>
                  <p class="talks-meta">
                    {timeOf(talk)} · {talk.hall} · {talk.lectors.map((l) => l.name).join(', ') ||
                      copy.noLector}
                  </p>
                  {talk.short && (
                    /* The source project translates only titles and track names, so
                       on the EN page the blurb is the RU original: declare its
                       language rather than let a screen reader read Cyrillic in an
                       English voice. */
                    <p class="talks-short" lang={isEn ? 'ru' : undefined}>
                      {talk.short}
                    </p>
                  )}
                  {(talk.themes ?? []).length > 0 && (
                    <ul class="talks-tags" aria-label={copy.themeOnTalk}>
                      {(talk.themes ?? []).map((th) => (
                        <li>
                          <a href={href(`#theme-${th}`)}>{themeLabel(th)}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </SectionPanel>

    <SectionPanel id="themes">
      <h2 class="talks-h2">{copy.themesH2}</h2>
      <p class="talks-note">{copy.themesNote}</p>

      {themeGroups.map((th) => (
        <section class="talks-track" id={`theme-${th.id}`}>
          <h3 class="talks-h3">
            {isEn ? th.labelEn : th.label} <span class="talks-count">{th.talks.length}</span>
          </h3>
          <ul class="talks-themes">
            {th.talks.map((talk) => (
              <li>
                <a href={href(`#t${talk.id}`)}>{title(talk)}</a>
                {talk.trackName ? ` · ${label(talk.trackName)}` : ''}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </SectionPanel>

    <SectionPanel id="halls">
      <h2 class="talks-h2">{copy.hallsDaysH2}</h2>
      <div class="talks-grid">
        <table>
          <thead><tr><th>{copy.thHall}</th><th>{copy.thTalks}</th></tr></thead>
          <tbody>
            {hallCounts.map((h) => <tr><td>{h.name}</td><td>{h.n}</td></tr>)}
          </tbody>
        </table>
        <table>
          <thead><tr><th>{copy.thDay}</th><th>{copy.thDate}</th><th>{copy.thTalks}</th></tr></thead>
          <tbody>
            {dayCounts.map((d) => <tr><td>{d.name}</td><td>{d.date}</td><td>{d.n}</td></tr>)}
          </tbody>
        </table>
      </div>
    </SectionPanel>
  </SectionTabs>
</section>

<style is:global>
  .talks-board { max-width: 1040px; margin: 0 auto; padding: var(--space-6) var(--space-4); }
  .talks-head { margin-bottom: var(--space-4); }
  .talks-note { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: var(--space-3) 0; }
  .talks-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--space-3); margin: var(--space-4) 0; }
  .talks-stats div { background: var(--background-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-3); display: flex; flex-direction: column; gap: 2px; }
  .talks-stats b { font-size: 1.5rem; color: var(--text-accent); }
  .talks-stats span { color: var(--text-muted); font-size: 0.8rem; }
  .talks-h2 { font-size: 1.35rem; margin: var(--space-4) 0 var(--space-2); }
  .talks-h3 { font-size: 1.05rem; margin: var(--space-5) 0 var(--space-2); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .talks-count { font-size: 0.75rem; color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 999px; padding: 1px 8px; }
  .talks-track { margin-bottom: var(--space-5); }
  .talks-list { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: var(--space-3); }
  .talks-list li { border-left: 2px solid var(--border-color); padding-left: var(--space-3); scroll-margin-top: 80px; }
  .talks-title { font-weight: 600; }
  .talks-meta { color: var(--text-muted); font-size: 0.82rem; margin: 2px 0; }
  .talks-short { font-size: 0.88rem; line-height: 1.55; margin: 4px 0 0; }

  /* Theme tags under a talk: muted chips, not buttons — they are cross-panel
     anchors into the themes tab. */
  .talks-tags { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; margin: 6px 0 0; padding: 0; }
  .talks-tags a { display: inline-block; font-size: 0.72rem; color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 999px; padding: 1px 8px; text-decoration: none; }
  .talks-tags a:hover, .talks-tags a:focus-visible { color: var(--text-accent); border-color: var(--border-active); }

  /* Shared chip: day filter buttons (TalksProgram) and the track jump nav. */
  .talks-chips { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .talks-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-muted); background: var(--background-secondary); border: 1px solid var(--border-color); border-radius: 999px; text-decoration: none; cursor: pointer; white-space: nowrap; }
  .talks-chip:hover, .talks-chip:focus-visible { color: var(--text-accent); border-color: var(--border-active); }
  .talks-chip[aria-pressed='true'] { color: var(--text-accent); border-color: var(--border-active); background: color-mix(in srgb, var(--text-accent) 8%, transparent); }
  .talks-chip-n { font-size: 0.7rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .talks-tracknav { display: flex; flex-wrap: wrap; gap: var(--space-1); margin: var(--space-2) 0 var(--space-4); }

  .talks-themes { margin: var(--space-2) 0 0; padding-left: 1.1rem; columns: 2; column-gap: var(--space-5); font-size: 0.88rem; }
  @media (max-width: 640px) { .talks-themes { columns: 1; } }
  .talks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); }
  .talks-grid table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .talks-grid th, .talks-grid td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border-color); }
</style>
