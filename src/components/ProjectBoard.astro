---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectFilter from './ProjectFilter.astro';
import ProjectTrackFilter from './ProjectTrackFilter.astro';
import { flattenByTrack, projectTracks, sortByProjectOrder, trackCounts } from '../lib/projects';

interface Props {
  collection?: 'projects' | 'projects-en';
  linkPrefix?: string;
}
const { collection = 'projects', linkPrefix = '' } = Astro.props;
const lang: 'ru' | 'en' = linkPrefix.startsWith('en/') ? 'en' : 'ru';

const projects = sortByProjectOrder(await getCollection(collection, (p) => !p.data.draft));

// One flat grid, cards grouped track by track. The track is a badge on the card,
// not a section heading — the card carries `data-track` so the controller can
// filter and reorder within it.
const entries = flattenByTrack(
  projects.map((project) => ({ ...project, track: project.data.track })),
  lang,
);
const counts = trackCounts(
  projects.map((project) => ({ track: project.data.track })),
  lang,
);
const tracks = projectTracks(lang).map((track) => ({ ...track, count: counts[track.key] ?? 0 }));
---

<section id="projects" class="reveal reveal-delay-2">
  <div class="project-filter-bar">
    <ProjectTrackFilter lang={lang} tracks={tracks} total={projects.length} />
    <ProjectFilter lang={lang}>
      <button class="filter-tag" id="board-reset" data-analytics="projects_reset" type="button">
        {lang === 'en' ? 'Reset order' : 'Сбросить порядок'}
      </button>
      <span
        id="board-hint"
        class="board-hint"
        role="status"
        aria-live="polite"
        data-saved={lang === 'en' ? 'Order saved' : 'Порядок сохранён'}
        data-reset={lang === 'en' ? 'Reset to default' : 'Порядок сброшен'}></span>
    </ProjectFilter>
  </div>

  <span class="visually-hidden" role="status" id="project-filter-status"></span>
  <p id="project-empty" class="project-empty" hidden>
    {lang === 'en'
      ? 'No projects with this tool in this category.'
      : 'В этой категории нет проектов с этим инструментом.'}
  </p>

  <div id="project-list" class="project-track-grid">
    {
      entries.map(({ project, trackLabel }) => (
        <ProjectCard
          slug={project.id.replace(/\.md$/, '')}
          title={project.data.title}
          description={project.data.description}
          image={project.data.hero}
          star={project.data.star}
          impact={project.data.impact}
          tools={project.data.tools}
          github={project.data.github}
          demo={project.data.demo}
          private={project.data.private}
          linkPrefix={linkPrefix}
          lang={lang}
          track={project.data.track}
          trackLabel={trackLabel}
          draggable
          compact
        />
      ))
    }
  </div>
</section>

<script>
  import { track } from '../lib/analytics';
  import { ALL_TOOLS, ALL_TRACKS, emptyToolKeys, matchesTool } from '../lib/projects';

  // One controller for the whole board: category tabs + tool chips share the
  // same state, so they filter, sync the URL and toggle empty/disabled states
  // together. Reorder (drag / keyboard / reset) is layered on top — and is
  // confined to a card's own track, since the grid is flat.
  const board = document.getElementById('project-list');
  if (board) {
    const root = board as HTMLElement;
    const lang: 'ru' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const storageKey = `project-order-${lang}`;
    const hintEl = document.getElementById('board-hint');
    const resetBtn = document.getElementById('board-reset');
    const emptyEl = document.getElementById('project-empty');
    const statusEl = document.getElementById('project-filter-status');

    const trackBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-track-filter [data-track-filter]'),
    );
    const toolBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-filter [data-tool-filter]'),
    );

    // Read fresh every time: reordering moves nodes, so a cached list goes stale.
    const cards = (): HTMLElement[] => Array.from(root.querySelectorAll<HTMLElement>('.project'));
    const cardsOfTrack = (key: string): HTMLElement[] =>
      cards().filter((card) => card.dataset.track === key);
    const trackKeys = (): string[] =>
      [...new Set(cards().map((card) => card.dataset.track || ''))].filter(Boolean);
    const toolsOf = (card: HTMLElement): string[] =>
      (card.dataset.tools || '').split(',').filter(Boolean);

    let activeTrack = ALL_TRACKS;
    let activeTool = ALL_TOOLS;

    function statusText(n: number): string {
      return lang === 'en' ? `${n} projects shown` : `Показано проектов: ${n}`;
    }

    // Apply both filters; returns the number of visible cards.
    function apply(): number {
      let visible = 0;
      for (const card of cards()) {
        const inTrack = activeTrack === ALL_TRACKS || card.dataset.track === activeTrack;
        const ok = inTrack && matchesTool(toolsOf(card), activeTool);
        card.classList.toggle('is-hidden', !ok);
        if (ok) visible += 1;
      }

      for (const btn of trackBtns) {
        const isActive = (btn.dataset.trackFilter || ALL_TRACKS) === activeTrack;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      }
      for (const btn of toolBtns) {
        const isActive = (btn.dataset.toolFilter || ALL_TOOLS) === activeTool;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      }

      // Disable tool chips that cannot match inside the active category so a
      // click never lands on an empty board. The active chip stays operable.
      const scope = activeTrack === ALL_TRACKS ? cards() : cardsOfTrack(activeTrack);
      const emptyKeys = emptyToolKeys(
        scope.map((card) => ({ tools: toolsOf(card) })),
        lang,
      );
      for (const btn of toolBtns) {
        const key = btn.dataset.toolFilter || ALL_TOOLS;
        const disabled = key !== ALL_TOOLS && key !== activeTool && emptyKeys.includes(key);
        btn.disabled = disabled;
        btn.setAttribute('aria-disabled', String(disabled));
      }

      if (emptyEl) emptyEl.hidden = visible > 0;
      if (statusEl) statusEl.textContent = statusText(visible);
      return visible;
    }

    let fadeTimer: ReturnType<typeof setTimeout> | undefined;
    function flash(): void {
      root.classList.remove('is-filtering');
      void root.offsetWidth; // restart the animation on every change
      root.classList.add('is-filtering');
      if (fadeTimer) clearTimeout(fadeTimer);
      fadeTimer = setTimeout(() => root.classList.remove('is-filtering'), 220);
    }

    // --- URL: category in #track-<key>, tool in ?tool=<key> ---
    function readUrl(): void {
      const params = new URLSearchParams(location.search);
      const tool = params.get('tool') || ALL_TOOLS;
      activeTool = toolBtns.some((btn) => btn.dataset.toolFilter === tool) ? tool : ALL_TOOLS;

      const hash = location.hash.replace(/^#/, '');
      const track = hash.startsWith('track-') ? hash.slice('track-'.length) : '';
      activeTrack = trackBtns.some((btn) => btn.dataset.trackFilter === track)
        ? track
        : ALL_TRACKS;
    }

    function urlFor(track: string, tool: string): string {
      const params = new URLSearchParams(location.search);
      if (tool === ALL_TOOLS) params.delete('tool');
      else params.set('tool', tool);
      const query = params.toString();
      const hash = track === ALL_TRACKS ? '' : `#track-${track}`;
      return `${location.pathname}${query ? `?${query}` : ''}${hash}`;
    }

    for (const btn of trackBtns) {
      btn.addEventListener('click', () => {
        const next = btn.dataset.trackFilter || ALL_TRACKS;
        if (next === activeTrack) return;
        activeTrack = next;
        const visible = apply();
        flash();
        history.pushState({ track: activeTrack }, '', urlFor(activeTrack, activeTool));
        track('projects_track_filter', {
          track: activeTrack,
          results_count: visible,
          locale: lang,
        });
      });
    }

    for (const btn of toolBtns) {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const next = btn.dataset.toolFilter || ALL_TOOLS;
        if (next === activeTool) return;
        activeTool = next;
        apply();
        flash();
        history.replaceState(null, '', urlFor(activeTrack, activeTool));
      });
    }

    window.addEventListener('popstate', () => {
      readUrl();
      apply();
      flash();
    });

    // --- Reorder: drag, keyboard (ArrowUp/Down) and reset, within one track ---
    function readOrder(): Record<string, string[]> {
      try {
        const raw = localStorage.getItem(storageKey);
        if (!raw) return {};
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? (parsed as Record<string, string[]>) : {};
      } catch {
        return {};
      }
    }

    function writeOrder(order: Record<string, string[]>): void {
      try {
        localStorage.setItem(storageKey, JSON.stringify(order));
      } catch {
        /* storage unavailable */
      }
    }

    function currentOrder(): Record<string, string[]> {
      const order: Record<string, string[]> = {};
      for (const key of trackKeys()) {
        order[key] = cardsOfTrack(key)
          .map((card) => card.dataset.slug || '')
          .filter(Boolean);
      }
      return order;
    }

    // Put one track's cards back in `slugs` order without leaving the grid.
    // `ref` walks the block: a card already sitting where it belongs advances
    // the cursor, any other card is moved in front of it. Never moves a node
    // out of the tree, so `ref` is always still attached.
    function reorderTrackTo(key: string, slugs: string[]): void {
      const peers = cardsOfTrack(key);
      if (!peers.length) return;
      const bySlug = new Map(peers.map((card) => [card.dataset.slug || '', card]));
      const ordered = slugs
        .map((slug) => bySlug.get(slug))
        .filter((card): card is HTMLElement => Boolean(card));
      // Cards not listed in `slugs` (e.g. a new project) keep their DOM order.
      for (const card of peers) if (!ordered.includes(card)) ordered.push(card);

      let ref: ChildNode | null = peers[0];
      for (const card of ordered) {
        if (card === ref) {
          ref = ref.nextSibling;
          continue;
        }
        root.insertBefore(card, ref);
      }
    }

    // Capture the Astro-rendered order before applying any saved order, so
    // "Reset" can restore it without a page reload.
    const canonicalOrder = currentOrder();
    const savedOrder = readOrder();
    for (const key of trackKeys()) {
      const slugs = savedOrder[key];
      if (slugs && slugs.length) reorderTrackTo(key, slugs);
    }

    let hintTimer: ReturnType<typeof setTimeout> | undefined;
    function showHint(msg: string): void {
      if (!hintEl) return;
      hintEl.textContent = msg;
      hintEl.style.opacity = '1';
      if (hintTimer) clearTimeout(hintTimer);
      hintTimer = setTimeout(() => {
        hintEl.style.opacity = '0';
      }, 1600);
    }

    let dragEl: HTMLElement | null = null;
    let dragTrack = '';

    const sameTrack = (card: HTMLElement): boolean => card.dataset.track === dragTrack;

    function clearDrag(): void {
      if (dragEl) dragEl.classList.remove('dragging');
      root.querySelectorAll('.project.drag-over').forEach((card) => card.classList.remove('drag-over'));
      dragEl = null;
      dragTrack = '';
    }

    root.addEventListener('dragstart', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.project');
      if (!card || !root.contains(card)) return;
      // Don't hijack clicks on links/buttons.
      if ((e.target as HTMLElement).closest('a, button')) {
        e.preventDefault();
        return;
      }
      dragEl = card;
      dragTrack = card.dataset.track || '';
      try {
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', dragTrack);
        }
      } catch {
        /* dataTransfer unavailable */
      }
      card.classList.add('dragging');
    });

    root.addEventListener('dragover', (e) => {
      if (!dragEl) return;
      e.preventDefault();
      const card = (e.target as HTMLElement).closest<HTMLElement>('.project');
      if (card && card !== dragEl && sameTrack(card)) {
        card.classList.add('drag-over');
      }
    });

    root.addEventListener('dragleave', (e) => {
      (e.target as HTMLElement).closest<HTMLElement>('.project')?.classList.remove('drag-over');
    });

    root.addEventListener('drop', (e) => {
      if (!dragEl) return;
      e.preventDefault();
      const target = (e.target as HTMLElement).closest<HTMLElement>('.project');
      if (target && target !== dragEl && sameTrack(target)) {
        const rect = target.getBoundingClientRect();
        const after = e.clientY > rect.top + rect.height / 2;
        root.insertBefore(dragEl, after ? target.nextSibling : target);
        writeOrder(currentOrder());
        showHint(hintEl?.dataset.saved || 'Saved');
      }
      clearDrag();
    });

    root.addEventListener('dragend', clearDrag);

    // Keyboard reorder (WCAG 2.1.1 / 2.5.7): ArrowUp/ArrowDown moves the focused
    // card one slot within its own track. Drag stays the pointer enhancement.
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const target = e.target as HTMLElement;
      const card = target.closest<HTMLElement>('.project');
      if (!card || !root.contains(card) || target !== card) return;
      const peers = cardsOfTrack(card.dataset.track || '');
      const idx = peers.indexOf(card);
      if (idx < 0) return;
      const next = peers[idx + (e.key === 'ArrowDown' ? 1 : -1)];
      if (!next) return;
      e.preventDefault();
      root.insertBefore(card, e.key === 'ArrowDown' ? next.nextSibling : next);
      writeOrder(currentOrder());
      showHint(hintEl?.dataset.saved || 'Saved');
      card.focus(); // stay on the card so repeated moves work
    });

    resetBtn?.addEventListener('click', () => {
      try {
        localStorage.removeItem(storageKey);
      } catch {
        /* ignore */
      }
      for (const key of trackKeys()) reorderTrackTo(key, canonicalOrder[key] || []);
      showHint(hintEl?.dataset.reset || 'Reset');
    });

    readUrl();
    apply();
  }
</script>
