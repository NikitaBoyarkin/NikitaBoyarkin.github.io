---
import { getCollection } from 'astro:content';
import CarouselNav from './CarouselNav.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectFilter from './ProjectFilter.astro';
import ProjectSphereFilter from './ProjectSphereFilter.astro';
import ProjectTrackFilter from './ProjectTrackFilter.astro';
import {
  flattenByTrack,
  projectSphere,
  projectSphereFilters,
  projectTracks,
  sortByProjectOrder,
  stripExt,
  trackCounts,
} from '../lib/projects';
import type { StarPreview } from '../lib/projects';

interface Props {
  collection?: 'projects' | 'projects-en';
  linkPrefix?: string;
  /** Role-landing subset: render only these slugs, in this order. */
  slugs?: readonly string[];
  /** Keep the `slugs` order instead of regrouping by track. A role board is a
   *  curated reading sequence; the full catalogue stays grouped so the track
   *  filter still reads as a taxonomy. */
  ordered?: boolean;
  /** Card teaser rows: `result` (outcome only), `task-result` (the manager
   *  landing, which reads a case as brief → outcome) or `none` (no STAR — the
   *  card shows its `description`; the catalogue board). */
  starPreview?: StarPreview;
  /** Show the card cover above the body at every width. `/projects/` reads as a
   *  catalogue, so the cover is the preview; the role boards keep the horizontal
   *  cover the board's CSS gives them (hidden at ≥1140px to buy width for STAR). */
  cover?: boolean;
  /** Render the sphere (business domain) chips. The catalogue opts in; role
   *  landings do not — they are curated sequences, not a browse surface. */
  sphereFilter?: boolean;
}
const { collection = 'projects', linkPrefix = '', slugs, ordered = false, starPreview = 'result', cover = false, sphereFilter = false } = Astro.props;
const lang: 'ru' | 'en' = linkPrefix.startsWith('en/') ? 'en' : 'ru';

const all = sortByProjectOrder(await getCollection(collection, (p) => !p.data.draft));
// `slugs` picks the membership, not the rendering order: the grid below is
// grouped track by track (`flattenByTrack`), exactly as the full board is, so a
// role subset reads as the same board with fewer cards rather than a second
// layout. Absent `slugs`, the board is the whole catalogue — what `/projects/`
// rendered before.
const projects = slugs
  ? slugs
      .map((slug) => all.find((project) => stripExt(project.id) === slug))
      .filter((project): project is (typeof all)[number] => Boolean(project))
  : all;

// One flat grid, cards grouped track by track. The track is a badge on the card,
// not a section heading — the card carries `data-track` so the controller can
// filter and reorder within it.
const trackLabels = new Map(projectTracks(lang).map((track) => [track.key, track.label]));
const entries =
  ordered && slugs
    ? projects.map((project) => ({
        project,
        trackLabel: trackLabels.get(project.data.track) ?? project.data.track,
      }))
    : flattenByTrack(
        projects.map((project) => ({ ...project, track: project.data.track })),
        lang,
      );
const counts = trackCounts(
  projects.map((project) => ({ track: project.data.track })),
  lang,
);
const tracks = projectTracks(lang).map((track) => ({ ...track, count: counts[track.key] ?? 0 }));
// Counters are bucket sizes, not intersection results — same rule as the track
// tabs (PRD projects-category-view, R6). A chip that would show 0 under the
// active tool still names a real group.
const sphereChips = sphereFilter ? projectSphereFilters(projects.map(({ id }) => ({ id })), lang) : [];
---

<section id="projects" class="reveal reveal-delay-2" aria-labelledby="projects-heading">
  {/* The cards are h3, so the section needs its own h2: without one the outline
      jumps h1 (page title) -> h3 and the Lighthouse heading-order audit fails. */}
  <h2 id="projects-heading" class="visually-hidden">{lang === 'en' ? 'All projects' : 'Все проекты'}</h2>

  <div class="project-filter-bar">
    <ProjectTrackFilter lang={lang} tracks={tracks} total={projects.length} />
    {sphereFilter && <ProjectSphereFilter lang={lang} spheres={sphereChips} />}
    <ProjectFilter lang={lang}>
      <span class="board-controls">
        {
          /* Ordering is the catalogue's alone. A role landing renders a curated
             reading sequence (`ordered`), so it has neither the select nor its
             undo: a control that cannot change anything is worse than no
             control, and `?sort=new` on such a board used to scramble the
             interleaved order the page exists to show. */
          !ordered && (
            <>
              <span class="board-sort">
                <label class="visually-hidden" for="board-sort">
                  {lang === 'en' ? 'Project order' : 'Порядок проектов'}
                </label>
                <select id="board-sort" class="board-sort-select">
                  <option value="curated">
                    {lang === 'en' ? 'Curated order' : 'Кураторский порядок'}
                  </option>
                  <option value="new">{lang === 'en' ? 'Newest first' : 'Сначала новые'}</option>
                </select>
              </span>
              <button class="filter-tag" id="board-reset" data-analytics="projects_reset" type="button">
                {lang === 'en' ? 'Reset order' : 'Сбросить порядок'}
              </button>
            </>
          )
        }
        <span
          id="board-hint"
          class="board-hint"
          role="status"
          aria-live="polite"
          data-saved={lang === 'en' ? 'Order saved' : 'Порядок сохранён'}
          data-reset={lang === 'en' ? 'Reset to default' : 'Порядок сброшен'}></span>
      </span>
    </ProjectFilter>
  </div>

  <span class="visually-hidden" role="status" id="project-filter-status"></span>
  <p id="project-empty" class="project-empty" hidden>
    {lang === 'en' ? 'No projects match these filters.' : 'Под выбранные фильтры нет проектов.'}{' '}
    <button class="filter-tag" id="project-empty-reset" type="button">
      {lang === 'en' ? 'Reset filters' : 'Сбросить фильтры'}
    </button>
  </p>

  <div
    id="project-list"
    data-carousel-track="projects"
    class:list={['project-track-grid', cover && 'project-board-cover']}
  >
    {
      entries.map(({ project, trackLabel }) => (
        <ProjectCard
          slug={project.id.replace(/\.md$/, '')}
          title={project.data.title}
          description={project.data.description}
          image={project.data.hero}
          star={project.data.star}
          impact={project.data.impact}
          tools={project.data.tools}
          github={project.data.github}
          demo={project.data.demo}
          private={project.data.private}
          linkPrefix={linkPrefix}
          lang={lang}
          track={project.data.track}
          trackLabel={trackLabel}
          sphere={projectSphere(project.id)}
          date={(project.data.date ?? project.data.updated)?.toISOString().slice(0, 10)}
          compact
          starPreview={starPreview}
        />
      ))
    }
  </div>

  {/* The board is a snap row at every width (`global.css`, keyed on
      `.project-board-cover`), so the arrows are the pointer-less path through
      it. A short row that fits needs no nav: the module measures the overflow
      and keeps itself `hidden`. */}
  <CarouselNav track="projects" label={lang === 'en' ? 'Projects' : 'Проекты'} lang={lang} />
</section>

<script>
  import { track } from '../lib/analytics';
  import {
    ALL_SPHERES,
    ALL_TOOLS,
    ALL_TRACKS,
    emptyToolKeys,
    matchesSphere,
    matchesTool,
    sortSlugsByNewest,
  } from '../lib/projects';

  // One controller for the whole board: category tabs, sphere chips and tool
  // chips share the same state, so they filter, sync the URL and toggle
  // empty/disabled states together. Ordering is the sort select's alone: the
  // board is a horizontal row, and a hand-picked order cannot live in it —
  // `board-reorder` reads a row as one column and picks the drop side by
  // vertical midpoint, which here names the wrong neighbour every time.
  // No analytics event for the sphere or tool facet: `docs/analytics-dead-events.md`
  // rules out new events at this traffic, and `$autocapture` already shows the
  // chip clicks.
  const board = document.getElementById('project-list');
  if (board) {
    const root = board as HTMLElement;
    const lang: 'ru' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const noToolInTrack =
      lang === 'en'
        ? 'No projects use this tool in this category'
        : 'Нет проектов с этим инструментом в этой категории';
    const hintEl = document.getElementById('board-hint');
    const resetBtn = document.getElementById('board-reset');
    const emptyEl = document.getElementById('project-empty');
    const emptyResetBtn = document.getElementById('project-empty-reset');
    const statusEl = document.getElementById('project-filter-status');
    const sortSelect = document.getElementById('board-sort') as HTMLSelectElement | null;

    const trackBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-track-filter [data-track-filter]'),
    );
    const sphereBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-sphere-filter [data-sphere-filter]'),
    );
    const toolBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-filter [data-tool-filter]'),
    );

    // Read fresh every time: reordering moves nodes, so a cached list goes stale.
    const cards = (): HTMLElement[] => Array.from(root.querySelectorAll<HTMLElement>('.project'));
    const cardsOfTrack = (key: string): HTMLElement[] =>
      cards().filter((card) => card.dataset.track === key);
    const trackKeys = (): string[] =>
      [...new Set(cards().map((card) => card.dataset.track || ''))].filter(Boolean);
    const toolsOf = (card: HTMLElement): string[] =>
      (card.dataset.tools || '').split(',').filter(Boolean);

    let activeTrack = ALL_TRACKS;
    let activeSphere = ALL_SPHERES;
    let activeTool = ALL_TOOLS;
    const CURATED = 'curated';
    const NEWEST = 'new';
    let activeSort: string = CURATED;

    function statusText(n: number): string {
      return lang === 'en' ? `${n} projects shown` : `Показано проектов: ${n}`;
    }

    // Apply all three facets; returns the number of visible cards.
    function apply(): number {
      let visible = 0;
      for (const card of cards()) {
        const inTrack = activeTrack === ALL_TRACKS || card.dataset.track === activeTrack;
        const ok =
          inTrack &&
          matchesSphere(card.dataset.sphere, activeSphere) &&
          matchesTool(toolsOf(card), activeTool);
        card.classList.toggle('is-hidden', !ok);
        if (ok) visible += 1;
      }

      for (const btn of trackBtns) {
        const isActive = (btn.dataset.trackFilter || ALL_TRACKS) === activeTrack;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-checked', String(isActive));
      }
      for (const btn of sphereBtns) {
        const isActive = (btn.dataset.sphereFilter || ALL_SPHERES) === activeSphere;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-checked', String(isActive));
      }
      for (const btn of toolBtns) {
        const isActive = (btn.dataset.toolFilter || ALL_TOOLS) === activeTool;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      }

      // Disable tool chips that cannot match inside the active category so a
      // click never lands on an empty board. The active chip stays operable.
      // `aria-disabled`, not `disabled`: a real disabled button leaves the tab
      // order and announces nothing, so a screen reader user never learns why
      // the chip cannot be picked. The click handler below honours the state.
      const scope = cards().filter(
        (card) =>
          (activeTrack === ALL_TRACKS || card.dataset.track === activeTrack) &&
          matchesSphere(card.dataset.sphere, activeSphere),
      );
      const emptyKeys = emptyToolKeys(
        scope.map((card) => ({ tools: toolsOf(card) })),
        lang,
      );
      for (const btn of toolBtns) {
        const key = btn.dataset.toolFilter || ALL_TOOLS;
        const disabled = key !== ALL_TOOLS && key !== activeTool && emptyKeys.includes(key);
        btn.setAttribute('aria-disabled', String(disabled));
        if (disabled) btn.title = noToolInTrack;
        else btn.removeAttribute('title');
      }

      if (emptyEl) emptyEl.hidden = visible > 0;
      if (statusEl) statusEl.textContent = statusText(visible);
      // Filtering changes `scrollWidth` without resizing the track, so the
      // carousel's ResizeObserver never fires and its arrows keep a stale
      // disabled state. `carousel:refresh` is the module's own re-measure hook.
      document.dispatchEvent(new CustomEvent('carousel:refresh'));
      return visible;
    }

    let fadeTimer: ReturnType<typeof setTimeout> | undefined;
    function flash(): void {
      root.classList.remove('is-filtering');
      void root.offsetWidth; // restart the animation on every change
      root.classList.add('is-filtering');
      if (fadeTimer) clearTimeout(fadeTimer);
      fadeTimer = setTimeout(() => root.classList.remove('is-filtering'), 220);
    }

    // --- URL: category in #track-<key>, sphere in ?sphere=, tool in ?tool= ---
    function readUrl(): void {
      const params = new URLSearchParams(location.search);
      const tool = params.get('tool') || ALL_TOOLS;
      activeTool = toolBtns.some((btn) => btn.dataset.toolFilter === tool) ? tool : ALL_TOOLS;

      const sphere = params.get('sphere') || ALL_SPHERES;
      activeSphere = sphereBtns.some((btn) => btn.dataset.sphereFilter === sphere)
        ? sphere
        : ALL_SPHERES;

      // No select means a role landing: its order is curated, and `?sort=` in a
      // shared URL must not override it.
      activeSort = sortSelect && params.get('sort') === NEWEST ? NEWEST : CURATED;
      if (sortSelect) sortSelect.value = activeSort;

      const hash = location.hash.replace(/^#/, '');
      const track = hash.startsWith('track-') ? hash.slice('track-'.length) : '';
      activeTrack = trackBtns.some((btn) => btn.dataset.trackFilter === track)
        ? track
        : ALL_TRACKS;
    }

    function urlFor(track: string, tool: string, sphere: string): string {
      const params = new URLSearchParams(location.search);
      if (tool === ALL_TOOLS) params.delete('tool');
      else params.set('tool', tool);
      if (sphere === ALL_SPHERES) params.delete('sphere');
      else params.set('sphere', sphere);
      if (activeSort === NEWEST) params.set('sort', NEWEST);
      else params.delete('sort');
      const query = params.toString();
      const hash = track === ALL_TRACKS ? '' : `#track-${track}`;
      return `${location.pathname}${query ? `?${query}` : ''}${hash}`;
    }

    for (const btn of trackBtns) {
      btn.addEventListener('click', () => {
        const next = btn.dataset.trackFilter || ALL_TRACKS;
        if (next === activeTrack) return;
        activeTrack = next;
        const visible = apply();
        flash();
        history.pushState({ track: activeTrack }, '', urlFor(activeTrack, activeTool, activeSphere));
        track('projects_track_filter', {
          track: activeTrack,
          results_count: visible,
          locale: lang,
        });
      });
    }

    for (const btn of sphereBtns) {
      btn.addEventListener('click', () => {
        const next = btn.dataset.sphereFilter || ALL_SPHERES;
        if (next === activeSphere) return;
        activeSphere = next;
        apply();
        flash();
        history.replaceState(null, '', urlFor(activeTrack, activeTool, activeSphere));
      });
    }

    for (const btn of toolBtns) {
      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-disabled') === 'true') return;
        const next = btn.dataset.toolFilter || ALL_TOOLS;
        if (next === activeTool) return;
        activeTool = next;
        apply();
        flash();
        history.replaceState(null, '', urlFor(activeTrack, activeTool, activeSphere));
      });
    }

    sortSelect?.addEventListener('change', () => {
      activeSort = sortSelect.value === NEWEST ? NEWEST : CURATED;
      applySort();
      // Reordering moves the cards under a stationary viewport, so from the
      // third screenful the reader lands on the tail of the new order and the
      // change looks like it did nothing. The row is a sequence: go back to its
      // first card.
      root.scrollTo({ left: 0, behavior: 'auto' });
      history.replaceState(null, '', urlFor(activeTrack, activeTool, activeSphere));
    });

    window.addEventListener('popstate', () => {
      readUrl();
      apply();
      applySort();
      flash();
    });

    // The empty state's only offer: clear all three facets together, then hand
    // focus back to the "All" tab — the Reset button is about to be hidden along
    // with the empty block it sits in.
    emptyResetBtn?.addEventListener('click', () => {
      activeTrack = ALL_TRACKS;
      activeSphere = ALL_SPHERES;
      activeTool = ALL_TOOLS;
      apply();
      flash();
      history.replaceState(null, '', urlFor(ALL_TRACKS, ALL_TOOLS, ALL_SPHERES));
      trackBtns[0]?.focus();
    });

    // --- Order: newest-first re-sort, and the reset back to the curated one ---

    // Put one track's cards back in `slugs` order without leaving the row.
    // `ref` walks the block: a card already sitting where it belongs advances
    // the cursor, any other card is moved in front of it. Never moves a node
    // out of the tree, so `ref` is always still attached.
    function reorderTrackTo(key: string, slugs: string[]): void {
      const peers = cardsOfTrack(key);
      if (!peers.length) return;
      const bySlug = new Map(peers.map((card) => [card.dataset.slug || '', card]));
      const ordered = slugs
        .map((slug) => bySlug.get(slug))
        .filter((card): card is HTMLElement => Boolean(card));
      // Cards not listed in `slugs` (e.g. a new project) keep their DOM order.
      for (const card of peers) if (!ordered.includes(card)) ordered.push(card);

      let ref: ChildNode | null = peers[0];
      for (const card of ordered) {
        if (card === ref) {
          ref = ref.nextSibling;
          continue;
        }
        root.insertBefore(card, ref);
      }
    }

    // Capture the Astro-rendered order, so "Reset order" can restore it without
    // a page reload.
    const canonicalOrder: Record<string, string[]> = {};
    for (const key of trackKeys()) {
      canonicalOrder[key] = cardsOfTrack(key)
        .map((card) => card.dataset.slug || '')
        .filter(Boolean);
    }

    // Newest-first is a view mode: it re-sorts inside each track, and the reset
    // puts the curated order back. Nothing hand-picked survives, so there is no
    // stored order to prefer over `canonicalOrder`.
    function applySort(): void {
      // A role landing has no sort control and a fixed reading order.
      if (!sortSelect) return;
      if (activeSort !== NEWEST) {
        for (const key of trackKeys()) reorderTrackTo(key, canonicalOrder[key] || []);
        return;
      }
      for (const key of trackKeys()) {
        reorderTrackTo(
          key,
          sortSlugsByNewest(
            cardsOfTrack(key).map((card) => ({
              slug: card.dataset.slug || '',
              date: card.dataset.date,
            })),
          ),
        );
      }
    }

    let hintTimer: ReturnType<typeof setTimeout> | undefined;
    function showHint(msg: string): void {
      if (!hintEl) return;
      hintEl.textContent = msg;
      hintEl.style.opacity = '1';
      if (hintTimer) clearTimeout(hintTimer);
      hintTimer = setTimeout(() => {
        hintEl.style.opacity = '0';
      }, 1600);
    }


    resetBtn?.addEventListener('click', () => {
      // "Reset order" is the sort control's undo: back to the curated sequence.
      activeSort = CURATED;
      if (sortSelect) sortSelect.value = CURATED;
      for (const key of trackKeys()) reorderTrackTo(key, canonicalOrder[key] || []);
      root.scrollTo({ left: 0, behavior: 'auto' });
      showHint(hintEl?.dataset.reset || 'Reset');
      history.replaceState(null, '', urlFor(activeTrack, activeTool, activeSphere));
    });

    readUrl();
    apply();
    applySort();
  }
</script>
