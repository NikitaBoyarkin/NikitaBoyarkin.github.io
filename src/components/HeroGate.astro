---
// The persona gate as a static, in-flow hero — the non-canvas replacement for
// `PersonaCanvas` on `/` and `/en/`.
//
// Why it exists: the canvas hero fitted its 1440×900 world with a synchronous
// pre-paint measurement (`CanvasStage.astro`, the inline script). On the
// dashboard homepage the `.dash-hero` band has no resolved block-size at that
// moment, so `clientHeight` read 0: zoom collapsed to `MIN_ZOOM` (0.6) and the
// vertical offset resolved to `-270px`, pushing the identity and the HR card
// above the fold. The composition is content, not a pan/zoom surface — three
// routes and a heading — so the fix is to stop laying it out on a canvas at
// all. `PersonaCanvas` / `CanvasStage` / `canvas-layout` stay on disk; this
// component is what the homepage mounts.
//
// Reading order is the visual order now (identity → three routes), so there is
// no layout box, no world, no transform — and therefore no fit to get wrong.
import { ICON } from '../lib/icons';
import { withBase } from '../lib/path';
import type { Audience } from '../lib/projects';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

// The hero says who → what → how they work: the name, the role, and the claim.
// The CV/Contact CTA row stays off the gate by the owner's call (PRD §13,
// second wave) — the rail, nav and footer carry them.
const t = isEn
  ? {
      name: 'Nikita Boyarkin',
      h1: 'Product Analyst',
      role: 'Experiments, retention and segmentation',
      claim:
        'I help product teams decide from data: which fix to ship, whom to win back, where the hypothesis did not hold.',
      label: 'Who this is for',
    }
  : {
      name: 'Никита Бояркин',
      h1: 'Продуктовый аналитик',
      role: 'Эксперименты, retention и сегментация',
      claim:
        'Помогаю продуктовым командам решать по данным: какой фикс включать, кого возвращать, где гипотеза не подтвердилась.',
      label: 'Для кого этот сайт',
    };

const CARDS: Array<{ role: Audience; label: string; title: string; blurb: string; cta: string }> = [
  {
    role: 'hr',
    label: isEn ? 'HR' : 'HR',
    title: isEn ? 'Hiring / recruiter' : 'HR / рекрутер',
    blurb: isEn
      ? 'Role, stack, numbers — for screening against a vacancy.'
      : 'Роль, стек, метрики — под скрининг по вакансии.',
    cta: isEn ? 'Screening view' : 'Версия для скрининга',
  },
  {
    role: 'manager',
    label: isEn ? 'Manager' : 'Менеджер',
    title: isEn ? 'Hiring manager' : 'Нанимающий менеджер',
    blurb: isEn
      ? 'STAR cases: the task, the decision, what changed as a result.'
      : 'Кейсы STAR: задача, решение, что изменилось в результате.',
    cta: isEn ? 'Impact view' : 'Версия про результат',
  },
  {
    role: 'colleague',
    label: isEn ? 'Colleague' : 'Коллега',
    title: isEn ? 'Analyst / engineer' : 'Коллега-аналитик',
    blurb: isEn
      ? 'How it is made: code, data, method, the knowledge graph.'
      : 'Как это сделано: код, данные, метод, граф знаний.',
    cta: isEn ? 'Everything' : 'Полная версия',
  },
];
---

<section class="hero-gate" aria-label={t.label}>
  <header class="gate-identity">
    <p class="hero-person">{t.name}</p>
    <h1 class="hero-name">{t.h1}</h1>
    <p class="hero-role">{t.role}</p>
    <p class="hero-claim">{t.claim}</p>
  </header>

  <ol class="gate-cards">
    {
      CARDS.map((card, i) => (
        <li>
          <a
            class="gate-card"
            href={withBase(isEn ? `en/${card.role}/` : `${card.role}/`)}
            data-persona={card.role}
            data-source="gate"
          >
            <span class="gate-card-eyebrow">
              <span class="gate-card-step" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <svg
                class="gate-card-icon"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={ICON[card.role]}
              />
              {card.label}
            </span>
            <span class="gate-card-title">{card.title}</span>
            <span class="gate-card-blurb">{card.blurb}</span>
            <span class="gate-card-cta">
              {card.cta}
              <svg
                class="gate-card-arrow"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={ICON['arrow-right']}
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { firstTouch, readAudience, track, writeAudience, type ReferrerClass } from '../lib/analytics';
  import type { Audience } from '../lib/projects';

  // Referrer → the entry most visitors from that source actually want. GitHub
  // traffic is analysts and engineers, LinkedIn is recruiters. `google`, `other`
  // and `direct` get no hint — the gate stays neutral rather than guessing.
  const REFERRER_ROLE: Partial<Record<ReferrerClass, Audience>> = {
    github: 'colleague',
    linkedin: 'hr',
  };

  const root = document.querySelector<HTMLElement>('.hero-gate');
  if (root) {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const stored = readAudience();
    // The visitor's own pick outranks the source guess: a returning recruiter who
    // happened to arrive from GitHub still gets `hr`. The guess only fills the gap
    // where there is no choice to honour (Q11 — neither redirects).
    const suggested = stored ? null : (REFERRER_ROLE[firstTouch().referrer_class] ?? null);
    const highlighted = stored ?? suggested;

    if (highlighted) {
      root
        .querySelector<HTMLElement>(`[data-persona="${highlighted}"]`)
        ?.classList.add(stored ? 'is-stored' : 'is-suggested');
    }

    track('persona_gate_view', { lang, has_stored_choice: Boolean(stored) });

    // No preventDefault: the write and the capture both run before the plain
    // `<a href>` navigation commits.
    for (const card of root.querySelectorAll<HTMLElement>('[data-persona]')) {
      card.addEventListener('click', () => {
        const persona = card.dataset.persona as Audience;
        writeAudience(persona);
        track('persona_selected', { persona, lang, source: 'gate' });
      });
    }
  }
</script>

<style>
  /* In flow: the gate is as tall as its content, and the dashboard below it is
     reachable by scrolling — no one-screen band, no queued fit. */
  .hero-gate {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-12) var(--space-8);
  }

  .gate-identity {
    display: flex;
    flex-direction: column;
    max-inline-size: 62ch;
  }

  .hero-person {
    margin: 0 0 var(--space-2);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* `--type-page-title` comes from global.css (`.hero-name` is one of the
     registered h1 selectors), so the page <h1> can never compute smaller than
     the section <h2> under it at any viewport. */
  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.08;
    text-wrap: balance;
  }

  .hero-role {
    margin: var(--space-2) 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-accent);
  }

  .hero-claim {
    margin: var(--space-3) 0 0;
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--text-normal);
    text-wrap: pretty;
  }

  .gate-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .gate-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Same card recipe as `.blog-card` — the site's `--radius-lg` card: the
     `--gradient-surface` ramp over `--card-background`, NOT the zinc
     `--surface-secondary` the canvas board used. That token is the 30% neutral
     bucket, so the three cards read as grey panels beside every other card on
     the site; on cream it was the clearest tell (a lavender-grey block on a warm
     page). DESIGN.md's card band already lists `.featured-card`, `.project` and
     `.blog-card` for this treatment — reusing it is the point. */
  .gate-card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    gap: var(--space-2);
    padding: var(--card-padding);
    border: 1px solid var(--border-color);
    border-radius: var(--card-radius);
    background: var(--gradient-surface);
    color: inherit;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .gate-card:hover,
  .gate-card:focus-visible {
    border-color: color-mix(in srgb, var(--text-accent) 30%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px var(--shadow-color);
  }

  .gate-card:focus-visible {
    outline: 2px solid var(--border-active);
    outline-offset: 2px;
  }

  /* The stored/source-suggested route is marked with the border only — the same
     contract the canvas used. */
  .gate-card.is-stored,
  .gate-card.is-suggested {
    border-color: var(--border-active);
  }

  .gate-card-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Neutral, not `--text-accent`: the step marks a position in a route, it is
     not the action itself (DESIGN.md:120). */
  .gate-card-step {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text-normal);
  }

  .gate-card-icon,
  .gate-card-arrow {
    flex: none;
    display: block;
  }

  .gate-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  /* Prose inside a card is still prose — `--text-muted` is for metadata, and a
     card is not an exception to that (DESIGN.md:124). */
  .gate-card-blurb {
    flex: 1;
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--text-normal);
    text-wrap: pretty;
  }

  .gate-card-cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-color);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .gate-card:hover .gate-card-cta,
  .gate-card:focus-visible .gate-card-cta {
    color: var(--text-accent);
  }

  /* Right gutter for the fixed action rail on `/` (≥1860px). The inset lives
     here, on the surface that would otherwise run under the rail, rather than on
     the page — it must not leak onto /en/, which renders no rail. */
  @media (min-width: 1860px) {
    .hero-gate {
      padding-inline-end: var(--rail-total);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-card {
      transition: none;
    }

    .gate-card:hover,
    .gate-card:focus-visible {
      transform: none;
    }
  }
</style>
