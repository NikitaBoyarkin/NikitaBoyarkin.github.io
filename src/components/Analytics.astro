---
// Privacy-friendly analytics. Inert until env vars are set at build time.
// Set in CI secrets (baked into static HTML at build) or a local .env.
//
// Plausible:
//   PUBLIC_PLAUSIBLE_DOMAIN  e.g. "nikitaboyarkin.github.io"
//   PUBLIC_PLAUSIBLE_SRC     optional custom/self-hosted script URL
//                            (default https://plausible.io/js/script.js)
// PostHog:
//   PUBLIC_POSTHOG_KEY       project token (<ph_project_token>)
//   PUBLIC_POSTHOG_HOST      default https://us.i.posthog.com (EU: https://eu.i.posthog.com)
//
// PostHog is lazy: nothing is fetched from `posthog-js` until the first user
// interaction (or an idle/timeout fallback), so the SDK stays off the critical
// path and out of the Lighthouse measurement window. All custom capture still
// goes through `src/lib/analytics.ts` (REQ-A01–A03).
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc =
  import.meta.env.PUBLIC_PLAUSIBLE_SRC || 'https://plausible.io/js/script.js';
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
---

{plausibleDomain && <script defer data-domain={plausibleDomain} src={plausibleSrc} is:inline></script>}

{posthogKey && (
  <script>
    // Never instrument local development. Dev sessions (localhost / 127.0.0.1
    // / ::1 / 0.0.0.0) would pollute the PostHog project and skew funnels.
    const IS_LOCAL = /^(localhost|127\.0\.0\.1|::1|0\.0\.0\.0)$/.test(
      window.location.hostname,
    );

    if (!IS_LOCAL) {
      let started = false;

      // The delegated click listener only exists after the lazy imports below
      // resolve. Buffer click events from the very first interaction (the one
      // that triggered init, plus anything during the import window) and
      // replay them once the listener is wired, so the session's first CTA
      // click is not silently lost.
      const pendingClicks: Event[] = [];
      const bufferClick = (e: Event) => {
        if (pendingClicks.length < 100) pendingClicks.push(e);
      };
      document.addEventListener('click', bufferClick, { capture: true });
      const stopBuffering = () =>
        document.removeEventListener('click', bufferClick, { capture: true });
      // Chunk load blocked (ad-blocker, CSP): stop buffering and drop the
      // buffered events — their `target` DOM refs would otherwise stay
      // alive for the rest of the page.
      const failInit = () => {
        stopBuffering();
        pendingClicks.length = 0;
      };

      const TRIGGERS = ['pointerdown', 'keydown', 'scroll', 'touchstart'] as const;

      function teardownTriggers() {
        for (const type of TRIGGERS) {
          window.removeEventListener(type, onFirstInteraction);
        }
      }

      function onFirstInteraction() {
        // If the lazy import fails, at least stop buffering clicks that
        // nobody will ever replay.
        void start().catch(failInit);
      }

      // Lazy entry point: fetch the SDK + canonical module on demand, init, then
      // wire every listener exactly as before. Idempotent.
      async function start() {
        if (started) return;
        started = true;
        teardownTriggers();

        const [
          { posthog },
          {
            attachPosthog,
            flushAnalyticsQueue,
            localeFromPath,
            registerSuperProperties,
            track,
          },
          { contentInfo, READ_DEPTH_THRESHOLDS, scrollDepthPct },
        ] = await Promise.all([
          import('posthog-js'),
          import('../lib/analytics'),
          import('../lib/scroll-depth'),
        ]);

        posthog.init(import.meta.env.PUBLIC_POSTHOG_KEY, {
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com',
          defaults: '2026-05-30',
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: true,
          session_recording: { maskAllInputs: true },
        });

        // Hand the instance to the canonical module, register super properties
        // (REQ-A03), then flush anything buffered before init.
        attachPosthog(posthog);
        registerSuperProperties();
        flushAnalyticsQueue();

        const base = import.meta.env.BASE_URL || '/';
        const norm = base.replace(/\/$/, '');

        function pathUnderBase(): string {
          const p = window.location.pathname;
          if (p.startsWith(norm + '/')) return p.slice(norm.length);
          if (p === norm) return '/';
          return p;
        }

        const path = pathUnderBase();
        const locale = localeFromPath(path);

        // Content page-view events (in addition to autocapture $pageview).
        // Unanchored on purpose: `/projects/volta/<part>/` is still a view of
        // the `volta` project — same notion of content page as `contentInfo`,
        // which matches `/projects/<slug>/…`.
        const projectMatch = path.match(/^\/(?:en\/)?projects\/([^/]+)/);
        if (projectMatch) {
          track('project_viewed', { slug: projectMatch[1], locale, surface: 'page' });
        }
        const postMatch = path.match(/^\/(?:en\/)?posts\/([^/]+)/);
        if (postMatch) {
          track('post_read', { slug: postMatch[1], locale });
        }

        // Read depth (REQ-A09): one `read_depth` per threshold per page load, for
        // every content type. Replaces the case-study-only `case_study_read`.
        const info = contentInfo(path);
        if (info) {
          const fired = new Set<number>();
          const checkDepth = () => {
            const pct =
              scrollDepthPct(
                window.scrollY,
                document.documentElement.scrollHeight,
                window.innerHeight,
              ) * 100;
            // Some browsers land 1–2px short of the true bottom (elastic
            // scroll, fractional DPR): credit depth 100 at ≤2px from the end.
            const atBottom =
              // scrollY > 0: a page only 1–2px taller than the viewport is
              // "at bottom" before any scrolling — credit 100 only after a
              // real scroll.
              window.scrollY > 0 &&
              window.scrollY + window.innerHeight >=
              document.documentElement.scrollHeight - 2;
            for (const threshold of READ_DEPTH_THRESHOLDS) {
              if (fired.has(threshold)) continue;
              if (pct < threshold && !(threshold === 100 && atBottom)) continue;
              fired.add(threshold);
              track('read_depth', {
                content_type: info.content_type,
                slug: info.slug,
                depth: threshold,
                locale,
              });
            }
            if (fired.size >= READ_DEPTH_THRESHOLDS.length) {
              window.removeEventListener('scroll', checkDepth);
            }
          };
          window.addEventListener('scroll', checkDepth, { passive: true });
          // Short pages are fully visible on load, so check once immediately.
          checkDepth();
        }

        // Section views (REQ-A07): `/about` anchor sections entering the viewport
        // at 50%, once per section per load.
        const sections = document.querySelectorAll<HTMLElement>('[data-analytics-section]');
        if (sections.length && 'IntersectionObserver' in window) {
          const seen = new Set<string>();
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const section = (entry.target as HTMLElement).dataset.analyticsSection;
                if (!section || seen.has(section)) continue;
                seen.add(section);
                track('section_viewed', { section, path });
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.5 },
          );
          sections.forEach((el) => observer.observe(el));

          // Lazy-init gap: sections scrolled past before the observer existed
          // never cross the threshold while it is live — their
          // isIntersecting stays false. Credit any section whose top has
          // already passed mid-viewport (it was seen while the SDK loaded).
          sections.forEach((el) => {
            const section = el.dataset.analyticsSection;
            if (!section || seen.has(section)) return;
            if (el.getBoundingClientRect().top < window.innerHeight / 2) {
              seen.add(section);
              track('section_viewed', { section, path });
              observer.unobserve(el);
            }
          });
        }

        function isExternal(href: string): boolean {
          try {
            const url = new URL(href, window.location.href);
            if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;
            return url.hostname !== window.location.hostname;
          } catch {
            return false;
          }
        }

        // Delegated click capture:
        // - `[data-analytics-project]` → canonical `project_viewed {slug, surface}`
        // - `[data-analytics]`         → the element's frozen event name
        // - external `<a>`             → `outbound_click {domain, …}`
        const handleClick = (e: Event) => {
          const target = e.target as Element | null;
          if (!target) return;

          const projectEl = target.closest<HTMLElement>('[data-analytics-project]');
          if (projectEl?.dataset.analyticsProject) {
            track('project_viewed', {
              slug: projectEl.dataset.analyticsProject,
              surface: projectEl.dataset.analyticsSurface || 'unknown',
              locale,
            });
          }

          const named = target.closest<HTMLElement>('[data-analytics]');
          if (named) {
            const kind = named.getAttribute('data-analytics') || '';
            if (kind.startsWith('lang_switch_')) {
              track('lang_switched', {
                from: locale === 'en' ? 'en' : 'ru',
                to: kind.replace('lang_switch_', ''),
                path,
              });
            } else if (kind) {
              // REQ-038: carry the page path so contact events (cv_download_pdf,
              // telegram_*, github_footer, …) are attributable to the page they
              // were clicked on, not just the event name.
              track(kind, { path });
            }
          }

          const anchor = target.closest<HTMLAnchorElement>('a[href]');
          if (anchor && isExternal(anchor.href)) {
            let domain = '';
            try {
              domain = new URL(anchor.href).hostname;
            } catch {
              domain = '';
            }
            track('outbound_click', {
              domain,
              url: anchor.href,
              surface:
                anchor.closest('[data-analytics]')?.getAttribute('data-analytics') || 'content',
              path,
            });
          }
        };

        document.addEventListener('click', handleClick);

        // Replay clicks buffered while the SDK was still loading — the first
        // interaction of the session included — then stop buffering. (A click
        // that navigates away before init finishes is unrecoverable: the page
        // unloads with the buffer.)
        stopBuffering();
        for (const e of pendingClicks.splice(0)) {
          handleClick(e);
        }
      }

      // First interaction wins; a passive visitor still initialises on idle (or
      // after a short fallback timeout) so funnel data is complete.
      for (const type of TRIGGERS) {
        window.addEventListener(type, onFirstInteraction, { passive: true });
      }

      const idle = (
        window as Window & {
          requestIdleCallback?: (callback: () => void) => number;
        }
      ).requestIdleCallback;

      if (idle) idle(() => void start().catch(failInit));
      else window.setTimeout(() => void start().catch(failInit), 3500);
    }
  </script>
)}
