---
// The homepage: who → what to do, then the new-tab surface below it (search).
// It replaces `HeroGate` (three persona cards) on
// `/` and `/en/` by the owner's call — the persona landings stay reachable from
// the header's `NavRoles` group, from the drawer and from the tiles in this band.
//
// History, because the shape reads arbitrary otherwise: an earlier pass made the
// page a literal new-tab — an 8rem clock, a search field and nothing else. A
// recruiter landing there got no answer to "who is this", "what did they prove"
// and "what do I do next", so the clock was demoted to a status line and the
// identity, the flagship figure and two CTAs took the fold. The search is kept:
// it serves the second visitor, the one already convinced.
//
// 2026-11-08: the method line, the Volta proof card and the «Смотреть кейсы /
// Оставить запрос» pair left the fold on the owner's call, and the shortcut
// chips («Проекты · Статьи · Словарь · Граф · Обозреватель · Обо мне») left the
// new-tab surface the same day. The Telegram action stays —
// `docs/cta-inventory.md` makes it the hero's one primary ask and
// `tests/lib/persona.test.ts` guards it — and every removed destination keeps a
// row in the drawer, so nothing became unreachable.
//
// The search is deliberately its own small island rather than a second mount of
// `SearchBox`: that component owns the drawer's panel and keys off fixed ids
// (`#search-toggle`, `#search-panel`), so a second instance on the same page
// would collide. This one reads the same `search-index.json` and hands a longer
// query off to the Explorer surface, which already accepts `?q=`.
import { ICON } from '../lib/icons';
import { withBase } from '../lib/path';
// Persona promise lines come from ROLE_COPY so the homepage cannot drift from
// the landings it points at.
import { ROLE_COPY } from '../lib/projects';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const indexUrl = withBase('search-index.json');
const explorerUrl = withBase(isEn ? 'en/explorer/' : 'explorer/');

const t = isEn
  ? {
      clockLabel: 'Current time',
      placeholder: 'Search projects, writing, glossary…',
      empty: 'Nothing found',
      all: 'All results',
      found: 'Results',
      searchLabel: 'Site search',
      personasLabel: 'Three ways in',
      name: 'Nikita Boyarkin',
      role: 'Product Analyst',
    }
  : {
      clockLabel: 'Текущее время',
      placeholder: 'Поиск по проектам, статьям, словарю…',
      empty: 'Ничего не найдено',
      all: 'Все результаты',
      found: 'Найдено',
      searchLabel: 'Поиск по сайту',
      personasLabel: 'Три способа читать сайт',
      name: 'Никита Бояркин',
      role: 'Продуктовый аналитик',
    };

// The CV download button was removed on the owner's call (2026-11-01) — the PDF
// is no longer offered from the site, so there is nothing here to point at.
const TELEGRAM_URL = 'https://t.me/lofinibo';

const roleCopy = ROLE_COPY[isEn ? 'en' : 'ru'];

// One vocabulary for the three audiences: `label` repeats the header's
// `NavRoles` wording verbatim, so the bar and this band name the same three
// things. `task` is the second, quieter line the header has no room for.
// Equal weight by construction: same markup, same width, no numbering.
const PERSONAS = [
  {
    href: withBase(isEn ? 'en/hr/' : 'hr/'),
    label: 'HR',
    task: isEn ? 'Hiring' : 'Найм',
    line: roleCopy.hr.lead,
  },
  {
    href: withBase(isEn ? 'en/manager/' : 'manager/'),
    label: isEn ? 'Manager' : 'Менеджер',
    task: isEn ? 'Impact' : 'Результат',
    line: roleCopy.manager.lead,
  },
  {
    href: withBase(isEn ? 'en/colleague/' : 'colleague/'),
    label: isEn ? 'Colleague' : 'Коллега',
    task: isEn ? 'How it is made' : 'Как сделано',
    line: roleCopy.colleague.lead,
  },
];

---


<section
  class="newtab"
  data-nt
  data-index-url={indexUrl}
  data-explorer-url={explorerUrl}
  data-empty={t.empty}
  data-all={t.all}
  data-found={t.found}
  data-type-project={isEn ? 'Project' : 'Проект'}
  data-type-post={isEn ? 'Post' : 'Запись'}
  data-type-term={isEn ? 'Glossary' : 'Словарь'}
  data-type-source={isEn ? 'Library' : 'Библиотека'}
  data-type-part={isEn ? 'Module' : 'Модуль'}
  data-type-topic={isEn ? 'Topic' : 'Тема'}
>
  <div class="nt-center">
    {/* The clock kept its `id` (the built gate reads it) but lost its scale: it
        is a status line now, saying "this page is live" above the identity
        instead of owning the first screen. The date rode along with it — a
        new-tab page needs no calendar when the reason to be here is a CV. */}
    <p class="nt-now">
      <time class="nt-clock" id="nt-clock" aria-label={t.clockLabel}>--:--</time>
      <span class="nt-now-sep" aria-hidden="true">·</span>
      <span class="nt-date" id="nt-date"></span>
    </p>

    {/* who → what to do. The portrait is a plain 64px <img>:
        `HeroAvatar` next door mounts a ~960 KB 3D bundle on demand, which has no
        business on the page a recruiter lands on first. */}
    <div class="nt-intro">
      {/* `alt=""`: the name is the `<h1>` right beside this image, so a described
          alt would make a screen reader announce the same identity twice. The
          portrait is decoration that builds recognition, not information. */}
      <img
        class="nt-portrait"
        src={withBase('images/00_profile.webp')}
        alt=""
        width="64"
        height="64"
        loading="eager"
        decoding="async"
      />
      <h1 class="nt-id">
        <span class="nt-name">{t.name}</span>
        <span class="nt-role">{t.role}</span>
      </h1>
    </div>

    <div class="nt-ctas">
      <a class="button" href={TELEGRAM_URL} data-analytics="telegram_hero"> Telegram </a>
    </div>

    <form class="nt-form" id="nt-form" role="search" aria-label={t.searchLabel} autocomplete="off">
      <svg
        class="nt-form-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={ICON.search}
      />
      <input
        class="nt-input"
        id="nt-input"
        type="search"
        name="q"
        placeholder={t.placeholder}
        aria-label={t.searchLabel}
        aria-expanded="false"
        aria-controls="nt-results"
        aria-autocomplete="list"
        role="combobox"
      />
    </form>
    <ul class="nt-results" id="nt-results" role="listbox" aria-label={t.searchLabel} hidden></ul>
    {/* Announces the result count as the query changes; the listbox itself is
        silent until an option is focused. */}
    <p class="visually-hidden" id="nt-status" aria-live="polite"></p>

    <div class="nt-content">
      <nav class="nt-personas-wrap" aria-label={t.personasLabel}>
        <ul class="nt-personas">
          {
            PERSONAS.map((p) => (
              <li>
                <a class="nt-persona" href={p.href}>
                  <span class="nt-persona-head">
                    <span class="nt-persona-label">{p.label}</span>
                    <span class="nt-persona-task">{p.task}</span>
                  </span>
                  <span class="nt-persona-line">{p.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

  </div>
</section>

<script>
  import {
    prepareIndex,
    rankEntries,
    tokenize,
    type PreparedIndex,
    type SearchEntry,
  } from '../lib/search-rank';
  import { track, whenAnalyticsReady } from '../lib/analytics';

  const MAX_ROWS = 6;

  function init() {
    const root = document.querySelector<HTMLElement>('[data-nt]');
    if (!root) return;

    const locale = document.documentElement.lang === 'en' ? 'en-GB' : 'ru-RU';
    const clock = document.getElementById('nt-clock') as HTMLTimeElement | null;
    const dateEl = document.getElementById('nt-date');

    // Minute precision, so a 10s tick only exists to catch the rollover without
    // a busy loop.
    const timeFmt = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const dateFmt = new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    if (clock && dateEl) {
      const tick = () => {
        const now = new Date();
        clock.textContent = timeFmt.format(now);
        clock.dateTime = now.toISOString();
        dateEl.textContent = dateFmt.format(now).replace(/^\p{Ll}/u, (c) => c.toUpperCase());
      };
      tick();
      setInterval(tick, 10_000);
    }

    const form = document.getElementById('nt-form') as HTMLFormElement | null;
    const input = document.getElementById('nt-input') as HTMLInputElement | null;
    const results = document.getElementById('nt-results');
    const status = document.getElementById('nt-status');
    const indexUrl = root.dataset.indexUrl;
    if (!form || !input || !results || !indexUrl) return;

    const explorerUrl = root.dataset.explorerUrl || '/';
    const typeOf = (tp: string) => root.dataset[`type${tp[0].toUpperCase()}${tp.slice(1)}`] || tp;

    const lang: 'ru' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'ru';

    let index: PreparedIndex | null = null;
    let rows: SearchEntry[] = [];
    let active = -1;
    let lastReported = '';

    async function getIndex(): Promise<void> {
      if (!index) {
        try {
          const res = await fetch(indexUrl!);
          if (res.ok) index = prepareIndex((await res.json()) as SearchEntry[]);
        } catch {
          // Leave `index` null: one flaky fetch used to disable the hero search
          // for the rest of the page session, with no way to recover.
        }
      }
    }

    function close() {
      results!.hidden = true;
      results!.innerHTML = '';
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      if (status) status.textContent = '';
      active = -1;
    }

    function render() {
      const raw = input!.value.trim();
      const tokens = tokenize(raw);
      if (!tokens.length) {
        close();
        return;
      }

      rows = rankEntries(index || [], tokens, lang, MAX_ROWS);

      results!.innerHTML = '';
      if (!rows.length) {
        const empty = document.createElement('li');
        empty.className = 'nt-result nt-result-empty';
        empty.textContent = root!.dataset.empty || '';
        results!.append(empty);
      } else {
        rows.forEach((r, i) => {
          const li = document.createElement('li');
          li.className = 'nt-result';
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          li.dataset.idx = String(i);
          li.id = `nt-option-${i}`;

          const a = document.createElement('a');
          a.href = r.href;

          const type = document.createElement('span');
          type.className = 'nt-result-type';
          type.textContent = typeOf(r.type);

          const title = document.createElement('span');
          title.className = 'nt-result-title';
          title.textContent = r.title;
          a.append(type, title);

          if (r.desc) {
            const desc = document.createElement('span');
            desc.className = 'nt-result-desc';
            desc.textContent = r.desc;
            a.append(desc);
          }
          li.append(a);
          results!.append(li);
        });

        // The Explorer handoff only helps when the hero list has something;
        // offering "all results" over an empty state was a dead end.
        const more = document.createElement('li');
        more.className = 'nt-result nt-result-all';
        const moreLink = document.createElement('a');
        moreLink.href = `${explorerUrl}?q=${encodeURIComponent(raw)}`;
        moreLink.textContent = root!.dataset.all || '';
        more.append(moreLink);
        results!.append(more);
      }

      results!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
      input!.removeAttribute('aria-activedescendant');
      active = -1;
      if (status) {
        status.textContent = rows.length
          ? `${root!.dataset.found || ''}: ${rows.length}`
          : root!.dataset.empty || '';
      }

      if (raw !== lastReported) {
        lastReported = raw;
        track(rows.length ? 'search_used' : 'search_no_results', {
          query: raw.slice(0, 100),
          results_count: rows.length,
          locale: lang,
          surface: 'hero',
        });
      }
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(async () => {
        await getIndex();
        render();
      }, 120);
    });

    function move(delta: number) {
      const items = results!.querySelectorAll<HTMLElement>('.nt-result[data-idx]');
      if (!items.length) return;
      active = (active + delta + items.length) % items.length;
      items.forEach((it, i) => {
        it.classList.toggle('is-active', i === active);
        it.setAttribute('aria-selected', String(i === active));
      });
      const current = items[active];
      if (current?.id) input!.setAttribute('aria-activedescendant', current.id);
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Escape') {
        close();
        input.blur();
      }
    });

    // `/` and `⌘K` belong to the hero on this page. Capture phase plus
    // `stopPropagation` keeps SearchBox's bubble-phase handler from opening the
    // drawer panel at the same time; once the drawer is open, that handler wins.
    document.addEventListener(
      'keydown',
      (e) => {
        if (document.body.classList.contains('nav-open')) return;
        const el = document.activeElement;
        const typing = !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA');
        const slash = e.key === '/' && !typing;
        const cmdK = (e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey);
        if (!slash && !cmdK) return;
        e.preventDefault();
        e.stopPropagation();
        input!.focus();
      },
      true,
    );

    // The capture causes the navigation, so it must wait for the SDK (bounded)
    // — an in-flight capture dies with the page otherwise. Same as SearchBox.
    function go(href: string, rank: number, type: string) {
      whenAnalyticsReady(() => {
        track('search_result_click', {
          query: input!.value.trim().slice(0, 100),
          rank,
          href,
          type,
          locale: lang,
          surface: 'hero',
        });
        window.location.href = href;
      });
    }

    results!.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest('a');
      // Modified clicks (new tab, download) keep native behaviour.
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      const idx = a.closest('.nt-result')?.getAttribute('data-idx');
      e.preventDefault();
      if (idx == null) {
        go(a.href, rows.length + 1, 'all');
        return;
      }
      go(a.href, Number(idx) + 1, rows[Number(idx)].type);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      const i = active >= 0 && rows[active] ? active : 0;
      const target = rows[i];
      go(
        target ? target.href : `${explorerUrl}?q=${encodeURIComponent(query)}`,
        target ? i + 1 : rows.length + 1,
        target ? target.type : 'all',
      );
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  init();
</script>

<style>
  /* Centred in the viewport minus the sticky bar, so the clock sits where the
     eye expects a new-tab page's clock to sit. `align-content: center` keeps it
     centred without the overflow clipping `place-items` causes on short phones. */
  .newtab {
    display: grid;
    align-content: center;
    min-block-size: calc(100dvh - var(--nav-mobile-h) - var(--space-12));
    padding-block: var(--space-10);
  }

  /* Ground drift — the only animated gradient on the site, and only here.
     `--gradient-page` is the page ground itself, so drifting a copy of it
     slides the ground's own diagonal across the fold instead of adding a
     foreign colour: no new token, no new stop, nothing the contrast pass has
     not already sampled. It sits at `z-index: -2`, i.e. under the honeycomb
     lattice (`body::before`, `--z-decor: -1`) and above the static ground on
     `html` it covers. The motion is a `transform` on an oversized layer,
     compositor-only: animating `background-position` instead would repaint the
     viewport every frame — the trap the lattice layer avoids by not using
     `background-attachment: fixed`. */
  .newtab::before {
    content: "";
    position: fixed;
    inset: -60%;
    z-index: -2;
    pointer-events: none;
    background-image: var(--gradient-page);
    background-size: 160% 160%;
    animation: nt-drift 12s ease-in-out infinite alternate;
  }

  @keyframes nt-drift {
    from {
      transform: translate3d(-27%, -20%, 0);
    }
    to {
      transform: translate3d(27%, 20%, 0);
    }
  }

  /* Accent drift — the colour that makes the ground's own movement legible.
     `--gradient-page` cannot supply it: its stops are one near-identical step
     apart by design (cyberpunk's are literally the same value), so sliding it
     reads as a brightness shift, not as flowing colour. A full-strength
     `--text-accent` stop carries the colour; `opacity` is the only strength
     lever. `mix-blend-mode` was tried first and measured inert here — four
     modes (soft-light, overlay, screen, multiply) each changed the frame by
     ≤2/255 against 46/255 for `normal`, because a `z-index: -2` fixed layer
     blurs against a backdrop it cannot tint in Chrome. Counter-phase and a
     different period from the ground (17s vs 12s) is what the eye reads as
     flow rather than as one moving sheet. */
  .newtab::after {
    content: "";
    position: fixed;
    inset: -60%;
    z-index: -2;
    pointer-events: none;
    background-image: radial-gradient(
      55% 70% at 70% 30%,
      var(--text-accent),
      transparent 72%
    );
    opacity: 0.22;
    animation: nt-drift-accent 17s ease-in-out infinite alternate;
  }

  @keyframes nt-drift-accent {
    from {
      transform: translate3d(27%, 20%, 0) scale(1.1);
    }
    to {
      transform: translate3d(-27%, -20%, 0) scale(0.9);
    }
  }

  /* Cream has the least headroom for a blend wash: soft-light over a near-white
     ground eats most of the tint, so the light theme gets a stronger source. */
  /* Cream has less headroom than the saturated themes: the same opacity there
     is a weaker wash, so the light theme carries a touch more. */
  [data-theme="light"] .newtab::after {
    opacity: 0.28;
  }

  /* Decoration, like the gradient family itself: a printed page, a user-chosen
     high-contrast palette or a flat-surface request gets nothing moving. */
  @media print, (forced-colors: active), (prefers-contrast: more) {
    .newtab::before,
    .newtab::after {
      display: none;
    }
  }

  .nt-center {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    inline-size: 100%;
  }

  /* Status line, not a display number: the clock used to be the largest thing
     on the page (clamp 3.5–8rem) and answered a question nobody asked. At 0.875rem
     it still says the page is live without spending the fold. */
  .nt-now {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .nt-clock {
    font: inherit;
    letter-spacing: 0.02em;
  }

  .nt-now-sep {
    color: var(--text-muted);
  }

  /* A <span>, not a <p>: it shares the status line with the clock. */
  .nt-date {
    font: inherit;
    color: var(--text-muted);
  }

  .nt-intro {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
    text-align: start;
  }

  /* 64px on purpose: big enough to read as a face, small enough that the
     portrait never becomes the LCP element the <head> does not preload. */
  .nt-portrait {
    flex: none;
    inline-size: 64px;
    block-size: 64px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background-color: var(--background-secondary);
    object-fit: cover;
  }

  .nt-id {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
    margin: 0;
  }

  .nt-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-normal);
    text-wrap: balance;
  }

  /* The role is the one line the built gate greps for — kept as real text in
     the <h1>, in accent ink, at a size that reads as a subtitle. */
  .nt-role {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-accent);
  }

  .nt-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-1);
  }

  .nt-form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    inline-size: min(38rem, 100%);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--card-background) 92%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .nt-form:focus-within {
    border-color: var(--border-active);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-accent) 18%, transparent);
  }

  .nt-form-icon {
    flex: none;
    color: var(--text-muted);
  }

  .nt-input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    color: var(--text-normal);
    font: inherit;
    font-size: 1rem;
  }

  .nt-input::placeholder {
    color: var(--text-muted);
  }

  .nt-input:focus {
    outline: none;
  }

  .nt-results {
    inline-size: min(38rem, 100%);
    margin: var(--space-2) 0 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: 0 18px 40px var(--shadow-color);
    text-align: start;
  }

  /* Content band: aligned to the search island so the eye reads one column.
     The persona tiles are outlined cards, not bare text: on a phone there is no
     hover to reveal that they are links, so the border and the fill have to
     carry it. */
  .nt-content {
    inline-size: min(38rem, 100%);
    margin-block-start: var(--space-5);
    text-align: start;
  }

  .nt-personas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nt-persona {
    display: grid;
    align-content: start;
    block-size: 100%;
