---
// The homepage: who → what is proven → what to do, then the new-tab surface
// below it (search + shortcuts). It replaces `HeroGate` (three persona cards) on
// `/` and `/en/` by the owner's call — the persona landings stay reachable from
// the header's `NavRoles` group, from the drawer and from the tiles in this band.
//
// History, because the shape reads arbitrary otherwise: an earlier pass made the
// page a literal new-tab — an 8rem clock, a search field and nothing else. A
// recruiter landing there got no answer to "who is this", "what did they prove"
// and "what do I do next", so the clock was demoted to a status line and the
// identity, the flagship figure and two CTAs took the fold. The search and the
// shortcuts are kept: they serve the second visitor, the one already convinced.
//
// The search is deliberately its own small island rather than a second mount of
// `SearchBox`: that component owns the drawer's panel and keys off fixed ids
// (`#search-toggle`, `#search-panel`), so a second instance on the same page
// would collide. This one reads the same `search-index.json` and hands a longer
// query off to the Explorer surface, which already accepts `?q=`.
import { ICON } from '../lib/icons';
import { formatNumber } from '../lib/format';
import { METRICS } from '../lib/metrics';
import { withBase } from '../lib/path';
import FigureText from './FigureText.astro';
// Persona promise lines come from ROLE_COPY so the homepage cannot drift from
// the landings it points at.
import { ROLE_COPY } from '../lib/projects';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const indexUrl = withBase('search-index.json');
const explorerUrl = withBase(isEn ? 'en/explorer/' : 'explorer/');

const t = isEn
  ? {
      clockLabel: 'Current time',
      placeholder: 'Search projects, writing, glossary…',
      empty: 'Nothing found',
      all: 'All results',
      searchLabel: 'Site search',
      shortcutsLabel: 'Shortcuts',
      personasLabel: 'Three ways in',
      name: 'Nikita Boyarkin',
      role: 'Product Analyst',
      // One line, the work rather than the job title: what a recruiter scans
      // for in the first three seconds is the method, not the noun.
      value: 'I test hypotheses with experiments: A/B tests, retention, segmentation',
      cases: 'See the cases',
    }
  : {
      clockLabel: 'Текущее время',
      placeholder: 'Поиск по проектам, статьям, словарю…',
      empty: 'Ничего не найдено',
      all: 'Все результаты',
      searchLabel: 'Поиск по сайту',
      shortcutsLabel: 'Быстрые ссылки',
      personasLabel: 'Три способа читать сайт',
      name: 'Никита Бояркин',
      role: 'Продуктовый аналитик',
      value: 'Проверяю гипотезы экспериментами: A/B-тесты, retention, сегментация',
      cases: 'Смотреть кейсы',
    };

// The CV download button was removed on the owner's call (2026-11-01) — the PDF
// is no longer offered from the site, so there is nothing here to point at.
const TELEGRAM_URL = 'https://t.me/lofinibo';
const casesUrl = withBase(isEn ? 'en/projects/' : 'projects/');

const roleCopy = ROLE_COPY[isEn ? 'en' : 'ru'];

// One vocabulary for the three audiences: `label` repeats the header's
// `NavRoles` wording verbatim, so the bar and this band name the same three
// things. `task` is the second, quieter line the header has no room for.
// Equal weight by construction: same markup, same width, no numbering.
const PERSONAS = [
  {
    href: withBase(isEn ? 'en/hr/' : 'hr/'),
    label: 'HR',
    task: isEn ? 'Hiring' : 'Найм',
    line: roleCopy.hr.lead,
  },
  {
    href: withBase(isEn ? 'en/manager/' : 'manager/'),
    label: isEn ? 'Manager' : 'Менеджер',
    task: isEn ? 'Impact' : 'Результат',
    line: roleCopy.manager.lead,
  },
  {
    href: withBase(isEn ? 'en/colleague/' : 'colleague/'),
    label: isEn ? 'Colleague' : 'Коллега',
    task: isEn ? 'How it is made' : 'Как сделано',
    line: roleCopy.colleague.lead,
  },
];

// The hero's proof line reads from `METRICS`, not from a copy: the whole point
// of `src/lib/metrics.ts` is that a headline number has one home, and this block
// was the last place that still restated one (it said €208,5K correctly by hand,
// which is why nothing caught the €656K drift next door for a release).
const FLAGSHIP = {
  href: withBase(isEn ? 'en/projects/volta/' : 'projects/volta/'),
  title: 'Volta Neobank — Product Analytics',
  metric: [
    isEn
      ? `+${formatNumber(METRICS.abKyc.deltaPp, undefined, 'en')} pp KYC conversion`
      : `+${formatNumber(METRICS.abKyc.deltaPp, undefined, 'ru')} п.п. KYC-конверсии`,
    isEn
      ? `€${formatNumber(METRICS.abKyc.annualEurK, undefined, 'en')}K in 12 mo`
      : `€${formatNumber(METRICS.abKyc.annualEurK, undefined, 'ru')}K за 12 мес`,
    isEn
      ? `${formatNumber(METRICS.abKyc.roiX, undefined, 'en')}× ROI`
      : `${formatNumber(METRICS.abKyc.roiX, undefined, 'ru')}× ROI`,
  ],
};

const SHORTCUTS = [
  {
    icon: ICON.projects,
    href: withBase(isEn ? 'en/projects/' : 'projects/'),
    label: isEn ? 'Projects' : 'Проекты',
  },
  {
    icon: ICON.writing,
    href: withBase(isEn ? 'en/writing/' : 'writing/'),
    label: isEn ? 'Writing' : 'Статьи',
  },
  {
    icon: ICON.glossary,
    href: withBase(isEn ? 'en/glossary/' : 'glossary/'),
    label: isEn ? 'Glossary' : 'Словарь',
  },
  {
    icon: ICON.graph,
    href: withBase(isEn ? 'en/graph/' : 'graph/'),
    label: isEn ? 'Graph' : 'Граф',
  },
  {
    icon: ICON.explorer,
    href: explorerUrl,
    label: isEn ? 'Explorer' : 'Обозреватель',
  },
  {
    icon: ICON.about,
    href: withBase(isEn ? 'en/about/' : 'about/'),
    label: isEn ? 'About' : 'Обо мне',
  },
];
---

<section
  class="newtab"
  data-nt
  data-index-url={indexUrl}
  data-explorer-url={explorerUrl}
  data-empty={t.empty}
  data-all={t.all}
  data-type-project={isEn ? 'Project' : 'Проект'}
  data-type-post={isEn ? 'Post' : 'Запись'}
  data-type-term={isEn ? 'Glossary' : 'Словарь'}
  data-type-source={isEn ? 'Library' : 'Библиотека'}
  data-type-part={isEn ? 'Module' : 'Модуль'}
  data-type-topic={isEn ? 'Topic' : 'Тема'}
>
  <div class="nt-center">
    {/* The clock kept its `id` (the built gate reads it) but lost its scale: it
        is a status line now, saying "this page is live" above the identity
        instead of owning the first screen. The date rode along with it — a
        new-tab page needs no calendar when the reason to be here is a CV. */}
    <p class="nt-now">
      <time class="nt-clock" id="nt-clock" aria-label={t.clockLabel}>--:--</time>
      <span class="nt-now-sep" aria-hidden="true">·</span>
      <span class="nt-date" id="nt-date"></span>
    </p>

    {/* who → what is proven → what to do. The portrait is a plain 64px <img>:
        `HeroAvatar` next door mounts a ~960 KB 3D bundle on demand, which has no
        business on the page a recruiter lands on first. */}
    <div class="nt-intro">
      {/* `alt=""`: the name is the `<h1>` right beside this image, so a described
          alt would make a screen reader announce the same identity twice. The
          portrait is decoration that builds recognition, not information. */}
      <img
        class="nt-portrait"
        src={withBase('images/00_profile.webp')}
        alt=""
        width="64"
        height="64"
        loading="eager"
        decoding="async"
      />
      <h1 class="nt-id">
        <span class="nt-name">{t.name}</span>
        <span class="nt-role">{t.role}</span>
      </h1>
    </div>

    <p class="nt-value">{t.value}</p>

    {/* The proof line: the flagship figure set, reused verbatim from FLAGSHIP
        (and therefore from volta.md) rather than re-typed here. It is also the
        link to the case it comes from. */}
    <a class="nt-flagship" href={FLAGSHIP.href} data-analytics="flagship_case">
      <span class="nt-flagship-title">{FLAGSHIP.title}</span>
      <span class="nt-flagship-metric">
        {FLAGSHIP.metric.map((m) => (
          <span>
            <FigureText text={m} />
          </span>
        ))}
      </span>
    </a>

    <div class="nt-ctas">
      <a class="button" href={TELEGRAM_URL} data-analytics="telegram_hero"> Telegram </a>
      <a class="nt-cases" href={casesUrl}>
        {t.cases} <span class="nt-cases-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <form class="nt-form" id="nt-form" role="search" aria-label={t.searchLabel} autocomplete="off">
      <svg
        class="nt-form-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={ICON.search}
      />
      <input
        class="nt-input"
        id="nt-input"
        type="search"
        name="q"
        placeholder={t.placeholder}
        aria-label={t.searchLabel}
        aria-expanded="false"
        aria-controls="nt-results"
        aria-autocomplete="list"
        role="combobox"
      />
    </form>
    <ul class="nt-results" id="nt-results" role="listbox" aria-label={t.searchLabel} hidden></ul>

    <div class="nt-content">
      <nav class="nt-personas-wrap" aria-label={t.personasLabel}>
        <ul class="nt-personas">
          {
            PERSONAS.map((p) => (
              <li>
                <a class="nt-persona" href={p.href}>
                  <span class="nt-persona-head">
                    <span class="nt-persona-label">{p.label}</span>
                    <span class="nt-persona-task">{p.task}</span>
                  </span>
                  <span class="nt-persona-line">{p.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <ul class="nt-shortcuts" aria-label={t.shortcutsLabel}>
      {
        SHORTCUTS.map((s) => (
          <li>
            <a class="nt-shortcut" href={s.href}>
              <span
                class="nt-shortcut-icon"
                aria-hidden="true"
                set:html={`<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">${s.icon}</svg>`}
              />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  type Entry = {
    type: string;
    locale: string;
    title: string;
    desc: string;
    tags?: string[];
    tools?: string[];
    href: string;
  };

  function init() {
    const root = document.querySelector<HTMLElement>('[data-nt]');
    if (!root) return;

    const locale = document.documentElement.lang === 'en' ? 'en-GB' : 'ru-RU';
    const clock = document.getElementById('nt-clock') as HTMLTimeElement | null;
    const dateEl = document.getElementById('nt-date');

    // Minute precision, so a 10s tick only exists to catch the rollover without
    // a busy loop.
    const timeFmt = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const dateFmt = new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    if (clock && dateEl) {
      const tick = () => {
        const now = new Date();
        clock.textContent = timeFmt.format(now);
        clock.dateTime = now.toISOString();
        dateEl.textContent = dateFmt.format(now).replace(/^\p{Ll}/u, (c) => c.toUpperCase());
      };
      tick();
      setInterval(tick, 10_000);
    }

    const form = document.getElementById('nt-form') as HTMLFormElement | null;
    const input = document.getElementById('nt-input') as HTMLInputElement | null;
    const results = document.getElementById('nt-results');
    const indexUrl = root.dataset.indexUrl;
    if (!form || !input || !results || !indexUrl) return;

    const explorerUrl = root.dataset.explorerUrl || '/';
    const typeOf = (tp: string) => root.dataset[`type${tp[0].toUpperCase()}${tp.slice(1)}`] || tp;

    let index: Entry[] | null = null;
    let rows: Entry[] = [];
    let active = -1;

    async function getIndex() {
      if (!index) {
        try {
          const res = await fetch(indexUrl!);
          index = res.ok ? ((await res.json()) as Entry[]) : [];
        } catch {
          index = [];
        }
      }
      return index;
    }

    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';

    function score(entry: Entry, tokens: string[]) {
      const title = entry.title.toLowerCase();
      const desc = (entry.desc || '').toLowerCase();
      const tags = (entry.tags || []).map((x) => x.toLowerCase());
      const tools = (entry.tools || []).map((x) => x.toLowerCase());
      let s = 0;
      for (const token of tokens) {
        const hit =
          title.includes(token) ||
          desc.includes(token) ||
          tags.some((x) => x === token) ||
          tools.some((x) => x === token);
        if (!hit) return -1;
        s += title.includes(token) ? 3 : 0;
        s += tags.includes(token) || tools.includes(token) ? 2 : 0;
        s += 1;
      }
      if (entry.locale === lang) s += 5;
      return s;
    }

    function close() {
      results!.hidden = true;
      results!.innerHTML = '';
      input!.setAttribute('aria-expanded', 'false');
      active = -1;
    }

    function render() {
      const query = input!.value.trim().toLowerCase();
      const tokens = query ? query.split(/\s+/).filter(Boolean) : [];
      if (!tokens.length) {
        close();
        return;
      }

      rows = (index || [])
        .map((e) => ({ e, s: score(e, tokens) }))
        .filter((x) => x.s >= 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 6)
        .map((x) => x.e);

      results!.innerHTML = '';
      if (!rows.length) {
        const empty = document.createElement('li');
        empty.className = 'nt-result nt-result-empty';
        empty.textContent = root!.dataset.empty || '';
        results!.append(empty);
      } else {
        rows.forEach((r, i) => {
          const li = document.createElement('li');
          li.className = 'nt-result';
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          li.dataset.idx = String(i);

          const a = document.createElement('a');
          a.href = r.href;

          const type = document.createElement('span');
          type.className = 'nt-result-type';
          type.textContent = typeOf(r.type);

          const title = document.createElement('span');
          title.className = 'nt-result-title';
          title.textContent = r.title;
          a.append(type, title);

          if (r.desc) {
            const desc = document.createElement('span');
            desc.className = 'nt-result-desc';
            desc.textContent = r.desc;
            a.append(desc);
          }
          li.append(a);
          results!.append(li);
        });
      }

      const more = document.createElement('li');
      more.className = 'nt-result nt-result-all';
      const moreLink = document.createElement('a');
      moreLink.href = `${explorerUrl}?q=${encodeURIComponent(input!.value.trim())}`;
      moreLink.textContent = root!.dataset.all || '';
      more.append(moreLink);
      results!.append(more);

      results!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
      active = -1;
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(async () => {
        await getIndex();
        render();
      }, 120);
    });

    function move(delta: number) {
      const items = results!.querySelectorAll<HTMLElement>('.nt-result[data-idx]');
      if (!items.length) return;
      active = (active + delta + items.length) % items.length;
      items.forEach((it, i) => {
        it.classList.toggle('is-active', i === active);
        it.setAttribute('aria-selected', String(i === active));
      });
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Escape') {
        close();
        input.blur();
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      if (active >= 0 && rows[active]) {
        window.location.href = rows[active].href;
        return;
      }
      window.location.href = rows[0] ? rows[0].href : `${explorerUrl}?q=${encodeURIComponent(query)}`;
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  init();
</script>

<style>
  /* Centred in the viewport minus the sticky bar, so the clock sits where the
     eye expects a new-tab page's clock to sit. `align-content: center` keeps it
     centred without the overflow clipping `place-items` causes on short phones. */
  .newtab {
    display: grid;
    align-content: center;
    min-block-size: calc(100dvh - var(--nav-mobile-h) - var(--space-12));
    padding-block: var(--space-10);
  }

  .nt-center {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    inline-size: 100%;
  }

  /* Status line, not a display number: the clock used to be the largest thing
     on the page (clamp 3.5–8rem) and answered a question nobody asked. At 0.875rem
     it still says the page is live without spending the fold. */
  .nt-now {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .nt-clock {
    font: inherit;
    letter-spacing: 0.02em;
  }

  .nt-now-sep {
    color: var(--text-muted);
  }

  /* A <span>, not a <p>: it shares the status line with the clock. */
  .nt-date {
    font: inherit;
    color: var(--text-muted);
  }

  .nt-intro {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
    text-align: start;
  }

  /* 64px on purpose: big enough to read as a face, small enough that the
     portrait never becomes the LCP element the <head> does not preload. */
  .nt-portrait {
    flex: none;
    inline-size: 64px;
    block-size: 64px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background-color: var(--background-secondary);
    object-fit: cover;
  }

  .nt-id {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
    margin: 0;
  }

  .nt-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-normal);
    text-wrap: balance;
  }

  /* The role is the one line the built gate greps for — kept as real text in
     the <h1>, in accent ink, at a size that reads as a subtitle. */
  .nt-role {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-accent);
  }

  .nt-value {
    /* 40rem, so the sentence holds on one line at desktop width instead of
       breaking on the colon; it still wraps to two below ~700px. */
    max-inline-size: 40rem;
    margin: var(--space-3) 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--text-normal);
    text-align: center;
    text-wrap: balance;
  }

  .nt-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-1);
  }

  /* Tertiary: a text link beside the two buttons, never a third filled shape —
     three buttons in a row read as three equal asks. */
  .nt-cases {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .nt-cases:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nt-cases:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .nt-form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    inline-size: min(38rem, 100%);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--card-background) 92%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .nt-form:focus-within {
    border-color: var(--border-active);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-accent) 18%, transparent);
  }

  .nt-form-icon {
    flex: none;
    color: var(--text-muted);
  }

  .nt-input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    color: var(--text-normal);
    font: inherit;
    font-size: 1rem;
  }

  .nt-input::placeholder {
    color: var(--text-muted);
  }

  .nt-input:focus {
    outline: none;
  }

  .nt-results {
    inline-size: min(38rem, 100%);
    margin: var(--space-2) 0 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: 0 18px 40px var(--shadow-color);
    text-align: start;
  }

  .nt-shortcuts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Content band: aligned to the search island so the eye reads one column.
     The persona tiles are outlined cards, not bare text: on a phone there is no
     hover to reveal that they are links, so the border and the fill have to
     carry it. The shortcut pills below are demoted to plain links in exchange —
     the content outranks the secondary navigation. */
  .nt-content {
    inline-size: min(38rem, 100%);
    margin-block-start: var(--space-5);
    text-align: start;
  }

  .nt-personas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nt-persona,
  .nt-flagship {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
