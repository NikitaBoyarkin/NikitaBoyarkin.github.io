---
// Scatter plot. Build-time static SVG with native <title> tooltips.
// Points may carry a `label` (a group); when two or more groups are present the
// points are coloured by group and a legend is drawn. Single-group scatters
// keep the original one-colour rendering.
import type { ChartObject } from '../../lib/charts';
import { CHART_PALETTE } from '../../lib/charts';
import { area, ticksFor, linearScale, fmt } from '../../lib/chart-svg';

interface Props {
  chart: ChartObject & { type: 'scatter' };
  lang: 'ru' | 'en';
}

const { chart, lang } = Astro.props;
const data = chart.data;
const points = data.points;

const groups = [...new Set(points.map((p) => p.label).filter((l): l is string => Boolean(l)))];
const hasLegend = groups.length > 1;

const a = area(640, 300, 54, 14, hasLegend ? 34 : 18, 54);
const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);
const padX = (Math.max(...xs) - Math.min(...xs)) * 0.08 || 1;
const padY = (Math.max(...ys) - Math.min(...ys)) * 0.08 || 1;
const xMin = Math.min(...xs) - padX;
const xMax = Math.max(...xs) + padX;
const yMin = Math.min(...ys) - padY;
const yMax = Math.max(...ys) + padY;

const xTicks = ticksFor(xMax - xMin, 4).map((t) => xMin + t);
const yTicks = ticksFor(yMax - yMin, 4).map((t) => yMin + t);
const sx = linearScale(xMin, xMax, a.ml, a.ml + a.pw);
const sy = linearScale(yMin, yMax, a.ml + a.ph, a.ml);

const colorFor = (label?: string) => {
  if (!hasLegend || !label) return 'var(--text-accent-dataviz)';
  const gi = groups.indexOf(label);
  return CHART_PALETTE[gi % CHART_PALETTE.length];
};

const ariaLabel = `${chart.title[lang]}. ${chart.description[lang]}`;
const xLabel = chart.xLabel?.[lang];
const yLabel = chart.yLabel?.[lang];
---

<svg
  viewBox={`0 0 ${a.w} ${a.h}`}
  width={a.w}
  height={a.h}
  role="img"
  aria-label={ariaLabel}
  preserveAspectRatio="xMidYMid meet"
>
  <g class="v-grid">
    {xTicks.map((t) => (
      <line x1={sx(t)} y1={a.ml} x2={sx(t)} y2={a.ml + a.ph} class="gridline" />
    ))}
  </g>
  <g class="h-grid">
    {yTicks.map((t) => (
      <line x1={a.ml} y1={sy(t)} x2={a.ml + a.pw} y2={sy(t)} class="gridline" />
    ))}
  </g>

  <g class="x-axis">
    {xTicks.map((t) => (
      <text x={sx(t)} y={a.ml + a.ph + 18} text-anchor="middle" class="axis-label">
        {fmt(t)}
      </text>
    ))}
  </g>
  <g class="y-axis">
    {yTicks.map((t) => (
      <text x={a.ml - 8} y={sy(t) + 3} text-anchor="end" class="axis-label">
        {fmt(t)}
      </text>
    ))}
  </g>

  <g class="points">
    {points.map((p) => (
      <g>
        <title>{`${p.label ?? ''} x=${fmt(p.x)}, y=${fmt(p.y)}`}</title>
        <circle cx={sx(p.x)} cy={sy(p.y)} r={4.5} fill={colorFor(p.label)} class="dot" />
      </g>
    ))}
  </g>

  {xLabel && (
    <text x={a.ml + a.pw / 2} y={a.h - 6} text-anchor="middle" class="axis-caption">
      {xLabel}
    </text>
  )}
  {yLabel && (
    <text x={10} y={a.ml + 10} class="axis-caption" transform={`rotate(-90 10 ${a.ml + 10})`}>
      {yLabel}
    </text>
  )}

  {hasLegend && (
    <g class="legend">
      {groups.map((g, j) => (
        <g transform={`translate(${a.ml + j * 150}, 12)`}>
          <circle cx={6} cy={-2} r={5} fill={CHART_PALETTE[j % CHART_PALETTE.length]} />
          <text x={16} y={2} class="legend-label">
            {g}
          </text>
        </g>
      ))}
    </g>
  )}
</svg>

<style>
  .gridline {
    stroke: var(--border-color);
    stroke-opacity: 0.4;
    stroke-width: 1;
  }
  .axis-label {
    fill: var(--text-muted);
    font-size: 11px;
    font-family: var(--font-sans);
  }
  .axis-caption {
    fill: var(--text-muted);
    font-size: 11px;
    font-family: var(--font-sans);
  }
  .legend-label {
    fill: var(--text-normal);
    font-size: 12px;
    font-family: var(--font-sans);
  }
  .dot {
    transition: r 120ms ease;
  }
  .dot:hover {
    r: 6;
  }
</style>
