---
// Server-rendered knowledge graph. The force layout runs at build time
// (src/lib/graph-layout.ts) so the SVG ships static; the client script is a
// thin layer that only wires up zoom/pan, cosmetic node drag, hover, search,
// legend, color/arrow toggles and fullscreen. No fetch, no simulation.
import { withBase } from '../lib/path';
import { getGraphLayouts } from '../lib/graph-data';
import {
  GRAPH_GROUP_COLORS,
  GRAPH_EDGE_STYLE,
  GRAPH_EDGE_COLOR,
  NODE_SIZE,
  LINK_THICKNESS,
  type GraphLink,
  type GraphNode,
} from '../lib/graph';
import { buildGraphTooltips } from '../lib/graph-tooltip';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const ariaLabel = isEn
  ? 'Knowledge graph of portfolio content'
  : 'Граф контента портфолио';

const t = {
  zoomIn: isEn ? 'Zoom in' : 'Приблизить',
  zoomOut: isEn ? 'Zoom out' : 'Отдалить',
  reset: isEn ? 'Reset zoom and position' : 'Сбросить масштаб и положение',
  fullscreen: isEn ? 'Fullscreen' : 'Во весь экран',
  fullscreenExit: isEn ? 'Exit fullscreen' : 'Выйти из полноэкранного режима',
  open: isEn ? 'Open page' : 'Открыть страницу',
  searchPlaceholder: isEn ? 'Find a project or topic…' : 'Найти проект или тему…',
  searchLabel: isEn ? 'Search graph nodes' : 'Поиск по узлам графа',
  searchEmpty: isEn ? 'No matches' : 'Ничего не найдено',
  searchHint: isEn ? '↑↓ to navigate, Enter to center' : '↑↓ — навигация, Enter — центрировать',
  searchClear: isEn ? 'Clear search' : 'Очистить поиск',
  colorByGroup: isEn ? 'Track/Category' : 'Трек/Категория',
  colorByCommunity: isEn ? 'Community' : 'Комьюнити',
  colorMode: isEn ? 'Switch node colors: track/category or community' : 'Переключить цвет узлов: трек/категория или комьюнити',
  arrows: isEn ? 'Arrows' : 'Стрелки',
  arrowsLabel: isEn ? 'Show link direction' : 'Показать направление ссылок',
  focus: isEn ? 'Focus' : 'Фокус',
  focusLabel: isEn ? 'Highlight 1-hop neighbors on click (Esc clears)' : 'Подсветить соседей по клику (Esc снимает)',
  edges: isEn ? 'Edges' : 'Рёбра',
  edgesLabel: isEn ? 'Filter by link type' : 'Фильтр по типу связей',
  edgeType: {
    related: isEn ? 'Explicit' : 'Явные',
    children: isEn ? 'Volta' : 'Volta',
    topic: isEn ? 'Thematic' : 'Тематические',
    shared: isEn ? 'Lateral' : 'Латеральные',
    core: isEn ? 'Hubs' : 'Хабы',
  } as Record<string, string>,
  presetLabel: isEn ? 'Quick filters' : 'Быстрые фильтры',
  presetAll: isEn ? 'All' : 'Все',
  presetProject: isEn ? 'Projects' : 'Проекты',
  presetPost: isEn ? 'Posts' : 'Записи',
  presetTopic: isEn ? 'Topics' : 'Темы',
  presetVolta: isEn ? 'Volta' : 'Volta',
  presetGlossary: isEn ? 'Glossary' : 'Словарь',
};

// Both layouts ran at build time. The SVG ships the group layout (so every
// node carries a concrete x/y); the community layout is embedded for the
// client's color toggle, which swaps positions along with the colors.
const { group, community } = await getGraphLayouts(lang);
const nodes = group.nodes as (GraphNode & { x: number; y: number })[];
const communityNodes = community.nodes as (GraphNode & { x: number; y: number })[];
const links = group.links;
const nodeById = new Map(nodes.map((n) => [n.id, n]));
// Tooltip lines (per node / per edge, aligned by index) rendered into the SVG
// <title> elements and embedded for the interactive tooltip below.
const tooltips = buildGraphTooltips(nodes, links, lang);

// Screen-reader text alternative: per-node connection lines ("label (edge
// type)"), rendered into the visually-hidden list below the SVG. The SVG
// itself stays a focusable group of real links; this list is the plain-text
// mirror of the data for SR users browsing in reading order.
const connsByNode = new Map<string, string[]>();
for (const l of links) {
  const a = nodeById.get(l.source);
  const b = nodeById.get(l.target);
  if (!a || !b) continue;
  const ty = t.edgeType[l.type] ?? l.type;
  if (!connsByNode.has(a.id)) connsByNode.set(a.id, []);
  if (!connsByNode.has(b.id)) connsByNode.set(b.id, []);
  connsByNode.get(a.id)!.push(`${b.label} (${ty})`);
  connsByNode.get(b.id)!.push(`${a.label} (${ty})`);
}
const srDesc = isEn
  ? `Interactive knowledge graph: ${nodes.length} nodes and ${links.length} links between portfolio pages. Each node is keyboard-focusable; press Enter or Space to open its page. A full list of nodes and their links follows the graphic.`
  : `Интерактивный граф знаний: ${nodes.length} узлов и ${links.length} связей между страницами портфолио. Каждый узел доступен с клавиатуры; Enter или пробел открывают связанную страницу. Полный список узлов и их связей — после графика.`;

// Obsidian-style graph settings (match the vault's graph view).

/** Stop each line at the target's edge so arrowheads (and lines) don't hide
 *  under the node circle. */
function edgeEndpoints(l: GraphLink) {
  const a = nodeById.get(l.source);
  const b = nodeById.get(l.target);
  if (!a || !b) return null;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const d = Math.sqrt(dx * dx + dy * dy) || 1;
  const r = (b.size || 6) + 2;
  return { x1: a.x, y1: a.y, x2: b.x - (dx / d) * r, y2: b.y - (dy / d) * r };
}

// Client data: nodes get an absolute href (base-prefixed) for navigation; the
// rest is the raw graph so search/legend/hover can read it from the DOM.
const clientData = {
  nodes: nodes.map((n) => ({ ...n, href: withBase(n.url) })),
  links,
  // Parallel to `nodes`: the community-mode build-time positions, so the
  // client can swap layouts without running any simulation.
  communityPos: communityNodes.map((n) => ({ x: n.x, y: n.y })),
  // Parallel tooltip lines (node / edge), aligned by index.
  nodeT: tooltips.node,
  edgeT: tooltips.edge,
};
const json = JSON.stringify(clientData).replace(/</g, '\\u003c');
---

<div id="kg-root" class="kg-root" data-search-empty={isEn ? 'No matches' : 'Ничего не найдено'} data-search-reset={isEn ? 'Clear search' : 'Очистить поиск'}>
  <div class="kg-topbar">
    <div class="kg-search" role="search">
      <input
        id="kg-search-input"
        class="kg-search-input"
        type="search"
        placeholder={t.searchPlaceholder}
        aria-label={t.searchLabel}
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="kg-search-results"
        aria-autocomplete="list"
      />
      <div id="kg-search-results" class="kg-search-results" role="listbox" hidden></div>
    </div>
    <div class="kg-legend" id="kg-legend" role="list" aria-label={isEn ? 'Graph color legend' : 'Легенда цветов графа'}></div>
    <div class="kg-controls" role="group" aria-label={isEn ? 'Graph controls' : 'Управление графом'}>
      <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-color" aria-pressed="false" aria-label={t.colorMode} title={t.colorByGroup} data-label-group={t.colorByGroup} data-label-community={t.colorByCommunity}>{t.colorByGroup}</button>
      <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-arrows" aria-pressed="false" aria-label={t.arrowsLabel} title={t.arrowsLabel}>{t.arrows}</button>
      <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-focus" aria-pressed="false" aria-label={t.focusLabel} title={t.focusLabel}>{t.focus}</button>
      <div class="kg-popover">
        <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-edge-panel" aria-haspopup="true" aria-expanded="false" aria-label={t.edgesLabel} title={t.edgesLabel}>{t.edges}</button>
        <div id="kg-edge-panel" class="kg-edge-panel" role="group" aria-label={t.edgesLabel} hidden>
          {(['related', 'children', 'topic', 'shared', 'core'] as const).map((ty) => (
            <label class="kg-edge-toggle">
              <span class="kg-edge-swatch" data-kg-swatch={ty}></span>
              <input type="checkbox" data-kg-type={ty} checked />
              {t.edgeType[ty]}
            </label>
          ))}
        </div>
      </div>
      <button type="button" class="kg-btn" data-kg-action="zoom-in" aria-label={t.zoomIn} title={t.zoomIn}>+</button>
      <button type="button" class="kg-btn" data-kg-action="zoom-out" aria-label={t.zoomOut} title={t.zoomOut}>−</button>
      <button type="button" class="kg-btn" data-kg-action="reset" aria-label={t.reset} title={t.reset}>⟲</button>
      <button type="button" class="kg-btn" data-kg-action="fullscreen" aria-label={t.fullscreen} title={t.fullscreen} data-label-fs={t.fullscreen} data-label-fs-exit={t.fullscreenExit}>⛶</button>
    </div>
  </div>
  <div class="kg-presets" role="group" aria-label={t.presetLabel}>
    <button type="button" class="kg-chip" data-kg-preset="" aria-pressed="true" data-label={t.presetAll}>{t.presetAll}</button>
    <button type="button" class="kg-chip" data-kg-preset="project" aria-pressed="false" data-label={t.presetProject}>{t.presetProject}</button>
    <button type="button" class="kg-chip" data-kg-preset="post" aria-pressed="false" data-label={t.presetPost}>{t.presetPost}</button>
    <button type="button" class="kg-chip" data-kg-preset="topic" aria-pressed="false" data-label={t.presetTopic}>{t.presetTopic}</button>
    <button type="button" class="kg-chip" data-kg-preset="volta" aria-pressed="false" data-label={t.presetVolta}>{t.presetVolta}</button>
    <button type="button" class="kg-chip" data-kg-preset="glossary" aria-pressed="false" data-label={t.presetGlossary}>{t.presetGlossary}</button>
  </div>
  <!-- role="group" (not "img"): ARIA "img" has presentational children, which
       would flatten the 75 focusable node links inside the SVG out of the
       accessibility tree. A group keeps them real, focusable links; the
       visually-hidden list below carries the plain-text data alternative. -->
  <svg id="kg-svg" class="kg-svg" viewBox="0 0 900 560" preserveAspectRatio="xMidYMid meet" role="group" aria-label={ariaLabel} aria-describedby="kg-sr-desc">
    <defs>
      <marker id="kg-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--text-muted)"></path>
      </marker>
    </defs>
    <g class="kg-edges">
      {links.map((l, i) => {
        const e = edgeEndpoints(l);
        if (!e) return null;
        const dash = GRAPH_EDGE_STYLE[l.type];
        return (
          <line
            class="kg-edge"
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            stroke={GRAPH_EDGE_COLOR[l.type] || GRAPH_EDGE_COLOR.related}
            stroke-dasharray={dash || undefined}
            style={`stroke-width:${LINK_THICKNESS * (0.6 + 1.6 * (l.weight || 1)) + 0.4}`}
          >
            <title>{tooltips.edge[i].join('\n')}</title>
          </line>
        );
      })}
    </g>
    <g class="kg-nodes">
      {nodes.map((n, i) => {
        const r = (n.size || 6) * NODE_SIZE;
        // Post labels are hover/focus-only: with ~50 nodes always-on labels
        // read as a text cloud. Projects, topics, cores and Volta parts stay
        // labeled — they're the graph's anchors.
        const labelClass = n.id.startsWith('post:') ? 'kg-label kg-label-hover' : 'kg-label';
        return (
          <g
            tabindex="0"
            role="link"
            aria-label={n.label}
            transform={`translate(${n.x},${n.y})`}
            style="cursor:pointer"
          >
            <title>{tooltips.node[i].join('\n')}</title>
            <circle r={r} fill={GRAPH_GROUP_COLORS[n.group] || 'var(--text-muted)'} />
            <text x={r + 6} y="4" class={labelClass}>{n.label}</text>
          </g>
        );
      })}
    </g>
  </svg>
  <div class="visually-hidden">
    <p id="kg-sr-desc">{srDesc}</p>
    <ul>
      {nodes.map((n) => {
        const conns = connsByNode.get(n.id);
        return <li>{conns && conns.length ? `${n.label}: ${conns.join(', ')}` : n.label}</li>;
      })}
    </ul>
  </div>
  <div id="kg-tooltip" class="kg-tooltip" role="tooltip" hidden></div>
</div>

<script is:inline type="application/json" id="kg-data" set:html={json}></script>

<script>
  import { GRAPH_GROUP_COLORS, GRAPH_COMMUNITY_COLORS, isDirected } from '../lib/graph';
  import { clampZoom, viewBoxOf, zoomAt, panBy, centerOn } from '../lib/graph-zoom';
  import { decodeGraphState, encodeGraphState } from '../lib/graph-url';
  import { nodeKindOf } from '../lib/graph-tooltip';

  const rootEl = document.getElementById('kg-root');
  const svgEl = document.getElementById('kg-svg');
  const dataEl = document.getElementById('kg-data');
  if (!rootEl || !svgEl || !dataEl) throw new Error('kg-root / kg-svg / kg-data not found');
  const root = rootEl as HTMLElement;
  const svg = svgEl as unknown as SVGSVGElement;
  const data = JSON.parse(dataEl.textContent || '{}');

  // World size must match the SSR viewBox (see the template above).
  const world = { w: 900, h: 560 };
  const groupList = Object.keys(GRAPH_GROUP_COLORS);
  // Color mode: fixed track/category taxonomy vs emergent communities.
  let mode: 'group' | 'community' = 'group';
  // Obsidian "Arrows": show link direction on directed edge types.
  let showArrows = false;
  // Obsidian "Tags" filter: per-mode hidden sets (groups in group mode,
  // communities in community mode), preserved across mode switches.
  let hiddenGroups = new Set<string | number>();
  let hiddenCommunities = new Set<string | number>();
  const hiddenSet = () => (mode === 'community' ? hiddenCommunities : hiddenGroups);
  const keyOf = (n: any) => (mode === 'community' ? (n.community ?? 0) : n.group);
  // Edge-type filter (mode-independent): hidden link types, kept in the URL.
  let hiddenEdgeTypes = new Set<string>();
  // Focus mode: clicking a node keeps its 1-hop neighborhood highlighted.
  let focusMode = false;
  let focusedId: string | null = null;
  // Quick-view preset: filter the whole graph to a single node kind — the
  // second grouping axis ("only projects / only posts / only topics / only
  // Volta"), orthogonal to the legend checkboxes.
  let preset: string | null = null;
  /** Node kind from the id prefix (the same helper the tooltips use). */
  const kindOf = (n: any) => nodeKindOf(n.id);
  /** A node is hidden by the group/community checkboxes OR by an active preset
   *  that excludes its kind. Reads the live hidden set each call. */
  const nodeHidden = (n: any) => hiddenSet().has(keyOf(n)) || (preset !== null && kindOf(n) !== preset);

  const nodes: any[] = data.nodes;
  const links: any[] = data.links;
  const nodeById = new Map(nodes.map((n: any) => [n.id, n]));
  const nodeEls = Array.from(svg.querySelectorAll<SVGGElement>('g[tabindex]'));
  const edgeEls = Array.from(svg.querySelectorAll<SVGLineElement>('.kg-edge'));
  // Per-type edge color, sampled from the server-rendered lines so the filter
  // panel swatches always match the SSR edge styling.
  const edgeColor = new Map<string, string>();
  edgeEls.forEach((e, i) => {
    const ty = links[i].type;
    if (!edgeColor.has(ty)) edgeColor.set(ty, e.getAttribute('stroke') || 'var(--text-muted)');
  });
  // Wide transparent hit areas (behind the nodes) so the thin links are
  // actually hoverable for the tooltip. Static — node dragging is cosmetic and
  // edges don't follow anyway.
  const edgeHitEls = edgeEls.map((e) => {
    const hit = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    for (const attr of ['x1', 'y1', 'x2', 'y2']) {
      hit.setAttribute(attr, e.getAttribute(attr)!);
    }
    hit.setAttribute('stroke', 'transparent');
    hit.setAttribute('stroke-width', '12');
    hit.setAttribute('fill', 'none');
    hit.setAttribute('pointer-events', 'stroke');
    e.after(hit);
    return hit;
  });
  // Build-time positions per mode — reset restores these (node drag is
  // cosmetic). `groupPos` starts where the SSR rendered; `communityPos` is the
  // second layout embedded in the data blob. `pristine` snapshots both so reset
  // always returns to the untouched build-time layout, and `posFor` points at
  // the live array for the current mode.
  const groupPos = nodes.map((n: any) => ({ x: n.x, y: n.y }));
  const communityPos: { x: number; y: number }[] = data.communityPos;
  const pristine = {
    group: groupPos.map((p: any) => ({ ...p })),
    community: communityPos.map((p: any) => ({ ...p })),
  };
  const posFor = (m: 'group' | 'community') => (m === 'community' ? communityPos : groupPos);

  const communities = [...new Set(nodes.map((n: any) => n.community ?? 0))].sort((a, b) => a - b);
  const communityLabels = new Map<number, string>();
  for (const n of nodes) {
    const c = n.community ?? 0;
    if (!communityLabels.has(c)) communityLabels.set(c, n.communityLabel ?? `#${c}`);
  }
  const colorFor = (n: any) =>
    mode === 'community'
      ? GRAPH_COMMUNITY_COLORS[(n.community ?? 0) % GRAPH_COMMUNITY_COLORS.length]
      : GRAPH_GROUP_COLORS[n.group] || 'var(--text-muted)';

  /** Move every node onto the current mode's build-time positions and recolor
   *  (used by the color toggle and by URL restore — the SVG ships the group
   *  layout, so community mode has to relocate nodes). */
  function applyModeLayout() {
    const incoming = posFor(mode);
    nodes.forEach((n, i) => {
      n.x = incoming[i].x;
      n.y = incoming[i].y;
      nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`);
      const circle = nodeEls[i].querySelector('circle');
      if (circle) circle.setAttribute('fill', colorFor(n));
    });
  }

  // Adjacency for hover highlighting.
  const adjacency = new Map<string, Set<string>>();
  for (const l of links) {
    if (!adjacency.has(l.source)) adjacency.set(l.source, new Set());
    if (!adjacency.has(l.target)) adjacency.set(l.target, new Set());
    adjacency.get(l.source)!.add(l.target);
    adjacency.get(l.target)!.add(l.source);
  }

  // --- Legend ---
  const legendEl = document.getElementById('kg-legend') as HTMLDivElement | null;
  function renderLegend() {
    if (!legendEl) return;
    legendEl.replaceChildren();
    const isCommunity = mode === 'community';
    const items = isCommunity
      ? communities.map((c) => ({
          key: c,
          label: communityLabels.get(c) ?? `#${c}`,
          color: GRAPH_COMMUNITY_COLORS[c % GRAPH_COMMUNITY_COLORS.length],
        }))
      : groupList.map((g) => ({ key: g, label: g, color: GRAPH_GROUP_COLORS[g] }));
    const hidden = hiddenSet();
    const total = items.length;
    // Per-chip node counts, so the legend shows how much each group/community
    // contributes to the graph (counted across all nodes).
    const counts = new Map<string | number, number>();
    for (const n of nodes) {
      const k = isCommunity ? (n.community ?? 0) : n.group;
      counts.set(k, (counts.get(k) ?? 0) + 1);
    }
    for (const it of items) {
      const span = document.createElement('span');
      span.className = 'kg-legend-item';
      span.setAttribute('role', 'listitem');
      const i = document.createElement('i');
      i.style.background = it.color;
      span.appendChild(i);
      // Obsidian "Tags" filter: checkbox chips show/hide a whole group
      // (or community in community mode).
      const label = document.createElement('label');
      label.className = 'kg-legend-toggle';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = !hidden.has(it.key);
      cb.setAttribute('aria-label', it.label);
      cb.addEventListener('change', () => {
        if (cb.checked) {
          hidden.delete(it.key);
        } else {
          // Never hide the last visible group — an empty graph is noise.
          if (hidden.size + 1 >= total) {
            cb.checked = true;
            return;
          }
          hidden.add(it.key);
        }
        applyFilter();
        syncURL();
      });
      label.appendChild(cb);
      label.appendChild(document.createTextNode(`${it.label} `));
      const count = document.createElement('span');
      count.className = 'kg-legend-count';
      count.textContent = String(counts.get(it.key) ?? 0);
      label.appendChild(count);
      span.appendChild(label);
      legendEl.appendChild(span);
    }
  }

  /** Obsidian "Tags"-style filter: hide whole groups (or communities), edges
   *  touching a hidden node or of a hidden edge type, and anything an active
   *  quick-view preset excludes. */
  function applyFilter() {
    nodes.forEach((n, i) => {
      nodeEls[i].style.display = nodeHidden(n) ? 'none' : '';
    });
    edgeEls.forEach((e, i) => {
      const l = links[i];
      const s = nodeById.get(l.source);
      const t = nodeById.get(l.target);
      const nodeHiddenEdge = (s && nodeHidden(s)) || (t && nodeHidden(t));
      const typeHidden = hiddenEdgeTypes.has(l.type);
      const isHidden = nodeHiddenEdge || typeHidden;
      e.style.display = isHidden ? 'none' : '';
      edgeHitEls[i].style.display = isHidden ? 'none' : '';
    });
  }

  /** Keep the view shareable: mode + hidden sets live in the URL query string,
   *  updated in place (no history spam) and merged with any existing params. */
  function syncURL() {
    const q = encodeGraphState(
      {
        mode,
        hiddenGroups: [...hiddenGroups] as string[],
        hiddenCommunities: [...hiddenCommunities].map(Number),
        hiddenEdges: [...hiddenEdgeTypes],
        // Runtime value comes from a data attribute / URL; the encoder only
        // accepts the known preset kinds (anything else serializes as
        // absent), so narrowing here is safe.
        preset: preset as 'project' | 'post' | 'topic' | 'volta' | 'glossary' | null,
      },
      window.location.search,
    );
    history.replaceState(null, '', `${window.location.pathname}${q}${window.location.hash}`);
  }

  // --- Viewport ---
  let vp = { x: 0, y: 0, k: 1 };
  function applyViewport() {
    const vb = viewBoxOf(vp, world);
    svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
  }

  function resetViewport() {
    vp = centerOn({ x: 0, y: 0, k: 1 }, { x: world.w / 2, y: world.h / 2 }, 1, world);
    applyViewport();
  }

  /** Convert a client (screen) point into world/viewBox coordinates. */
  function toWorld(clientX: number, clientY: number) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const pt = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
    return { x: pt.x, y: pt.y };
  }

  // --- Hover: highlight neighbors; the label appears via CSS on hover/focus ---
  let hoveredId: string | null = null;
  function clearHighlight() {
    hoveredId = null;
    // A persistent 1-hop focus survives the transient hover fading.
    if (focusMode && focusedId) {
      highlight(focusedId);
      return;
    }
    nodes.forEach((_, i) => nodeEls[i].style.opacity = '');
    edgeEls.forEach((e) => (e.style.opacity = ''));
  }

  function highlight(id: string) {
    const neighbors = adjacency.get(id) || new Set<string>();
    neighbors.add(id);
    nodes.forEach((n, i) => {
      nodeEls[i].style.opacity = neighbors.has(n.id) ? '1' : '0.12';
    });
    edgeEls.forEach((e, i) => {
      const l = links[i];
      const on = l.source === id || l.target === id;
      e.style.opacity = on ? String(Math.min(1, (l.weight || 1) * 0.9 + 0.2)) : '0.05';
    });
  }

  function navigateTo(n: any) {
    if (n?.href) window.location.href = n.href;
  }

  // --- Tooltip: content lines come precomputed (data.nodeT / data.edgeT) so
  // the client only positions and renders them. Hover-only; keyboard users get
  // the native SVG <title>. ---
  const tooltipEl = document.getElementById('kg-tooltip') as HTMLDivElement | null;
  function showTooltip(lines: string[] | undefined, clientX: number, clientY: number) {
    if (!tooltipEl || !lines || !lines.length) return;
    tooltipEl.replaceChildren();
    for (const line of lines) {
      const row = document.createElement('div');
      row.textContent = line;
      tooltipEl.appendChild(row);
    }
    tooltipEl.hidden = false;
    const rect = root.getBoundingClientRect();
    const w = tooltipEl.offsetWidth;
    const h = tooltipEl.offsetHeight;
    let x = clientX - rect.left + 14;
    let y = clientY - rect.top + 14;
    if (x + w > rect.width - 8) x = Math.max(8, clientX - rect.left - w - 14);
    if (y + h > rect.height - 8) y = Math.max(8, clientY - rect.top - h - 8);
    tooltipEl.style.transform = `translate(${x}px, ${y}px)`;
  }
  function hideTooltip() {
    if (tooltipEl) tooltipEl.hidden = true;
  }

  // --- Pointer handling: node drag (click = navigate), canvas pan, pinch ---
  let dragging: any = null;
  let dragStart: { x: number; y: number } | null = null;
  let moved = false;
  let panning: { startX: number; startY: number; vpX: number; vpY: number } | null = null;
  let pinch: { startDist: number; vp0: typeof vp; mid0: { x: number; y: number } } | null = null;
  const pointers = new Map<number, { x: number; y: number }>();

  function handlePointerDown(e: PointerEvent) {
    hideTooltip();
    svg.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pointers.size === 2) {
      dragging = null;
      panning = null;
      const [a, b] = [...pointers.values()];
      const startDist = Math.hypot(a.x - b.x, a.y - b.y);
      pinch = {
        startDist: Math.max(1, startDist),
        vp0: { ...vp },
        mid0: toWorld((a.x + b.x) / 2, (a.y + b.y) / 2),
      };
      return;
    }

    // Single pointer: node drag if it hit a node, else canvas pan.
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (target) {
      const n = nodes[nodeEls.indexOf(target)];
      const p = toWorld(e.clientX, e.clientY);
      dragging = n;
      dragStart = { x: p.x, y: p.y };
      moved = false;
      target.style.cursor = 'grabbing';
      return;
    }
    panning = { startX: e.clientX, startY: e.clientY, vpX: vp.x, vpY: vp.y };
    svg.style.cursor = 'grabbing';
  }

  function handlePointerMove(e: PointerEvent) {
    if (!pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pinch && pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      const factor = clampZoom((pinch.vp0.k * dist) / pinch.startDist) / pinch.vp0.k;
      vp = zoomAt(pinch.vp0, pinch.mid0, factor, world);
      applyViewport();
      return;
    }

    if (dragging) {
      const p = toWorld(e.clientX, e.clientY);
      const dx = p.x - (dragStart?.x ?? p.x);
      const dy = p.y - (dragStart?.y ?? p.y);
      if (dx * dx + dy * dy > 9) moved = true;
      // Cosmetic drag: move the node and remember the position (in the active
      // mode's layout) so search centers on where the user actually put it.
      dragging.x = p.x;
      dragging.y = p.y;
      const di = nodes.indexOf(dragging);
      if (di >= 0) posFor(mode)[di] = { x: p.x, y: p.y };
      const g = nodeEls[di];
      if (g) g.setAttribute('transform', `translate(${p.x},${p.y})`);
      return;
    }

    if (panning) {
      const p = toWorld(e.clientX, e.clientY);
      const start = toWorld(panning.startX, panning.startY);
      // Keep the world point grabbed at start under the cursor.
      vp = panBy({ x: panning.vpX, y: panning.vpY, k: vp.k }, start.x - p.x, start.y - p.y);
      applyViewport();
    }
  }

  function handlePointerUp(e: PointerEvent) {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinch = null;
    if (dragging) {
      const n = dragging;
      const wasClick = !moved;
      const g = nodeEls[nodes.indexOf(n)];
      if (g) g.style.cursor = 'pointer';
      dragging = null;
      dragStart = null;
      if (wasClick) {
        if (focusMode) {
          // Focus mode: click toggles a persistent 1-hop highlight instead of
          // navigating; clicking the focused node again (or Esc) clears it.
          if (focusedId === n.id) {
            focusedId = null;
            clearHighlight();
          } else {
            focusedId = n.id;
            highlight(n.id);
          }
        } else {
          navigateTo(n);
        }
      }
      return;
    }
    if (panning) {
      panning = null;
      svg.style.cursor = '';
      // Clicking or dragging the empty canvas dismisses a focus.
      if (focusMode && focusedId) {
        focusedId = null;
        clearHighlight();
      }
    }
  }

  svg.addEventListener('pointerdown', handlePointerDown);
  svg.addEventListener('pointermove', handlePointerMove);
  svg.addEventListener('pointerup', handlePointerUp);
  svg.addEventListener('pointercancel', handlePointerUp);

  // Hover: highlight neighbors and show a tooltip. Links get their own hit
  // areas (nodes render above them, so a node wins when they overlap).
  svg.addEventListener('pointerover', (e) => {
    const hitIdx = edgeHitEls.indexOf(e.target as unknown as SVGLineElement);
    if (hitIdx >= 0) {
      showTooltip(data.edgeT[hitIdx], e.clientX, e.clientY);
      return;
    }
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) {
      clearHighlight();
      hideTooltip();
      return;
    }
    const idx = nodeEls.indexOf(target);
    const n = nodes[idx];
    hoveredId = n.id;
    highlight(n.id);
    showTooltip(data.nodeT[idx], e.clientX, e.clientY);
  });
  svg.addEventListener('pointerout', (e) => {
    const stillIn = (e.relatedTarget as Node | null) && svg.contains(e.relatedTarget as Node);
    if (!stillIn) {
      clearHighlight();
      hideTooltip();
    }
  });

  // Keyboard: Enter/Space on a focused node navigates — or, in focus mode,
  // toggles the 1-hop highlight.
  nodeEls.forEach((g, i) => {
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (focusMode) {
          if (focusedId === nodes[i].id) {
            focusedId = null;
            clearHighlight();
          } else {
            focusedId = nodes[i].id;
            highlight(nodes[i].id);
          }
        } else {
          navigateTo(nodes[i]);
        }
      }
    });
  });

  // Wheel zoom around the cursor.
  svg.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      hideTooltip();
      const p = toWorld(e.clientX, e.clientY);
      const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
      vp = zoomAt(vp, p, factor, world);
      applyViewport();
    },
    { passive: false },
  );

  // --- Search: filter nodes by label, center on a match ---
  const searchInput = document.getElementById('kg-search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('kg-search-results') as HTMLDivElement | null;
  let searchActive = -1;

  function applySearchFilter(query: string) {
    const q = query.trim().toLowerCase();
    nodes.forEach((n, i) => {
      const match = !q || n.label.toLowerCase().includes(q);
      nodeEls[i].style.opacity = match ? '' : '0.08';
    });
  }

  function renderSearchResults(query: string) {
    if (!searchResults) return;
    const q = query.trim().toLowerCase();
    searchResults.innerHTML = '';
    if (!q) {
      searchResults.hidden = true;
      return;
    }
    const matches = nodes.filter((n) => n.label.toLowerCase().includes(q)).slice(0, 12);
    searchResults.hidden = false;
    searchActive = -1;
    if (matches.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'kg-search-empty';
      empty.textContent = root.dataset.searchEmpty || 'No matches';
      // Empty state needs one clear next action: a button that clears the
      // query and restores the full graph.
      const reset = document.createElement('button');
      reset.type = 'button';
      reset.className = 'kg-search-empty-btn';
      reset.textContent = root.dataset.searchReset || 'Clear search';
      reset.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        searchInput.setAttribute('aria-expanded', 'false');
        applySearchFilter('');
        searchResults.hidden = true;
        searchInput.focus();
      });
      empty.appendChild(reset);
      searchResults.appendChild(empty);
      return;
    }
    matches.forEach((n, _i) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'kg-search-item';
      item.setAttribute('role', 'option');
      item.textContent = n.label;
      item.addEventListener('click', () => {
        centerOnNode(n.id);
        searchInput?.blur();
      });
      searchResults.appendChild(item);
    });
  }

  function centerOnNode(id: string) {
    const n = nodes.find((x) => x.id === id);
    if (!n) return;
    // Un-hide the node's group/community so a search hit is always visible.
    const hidden = hiddenSet();
    const key = keyOf(n);
    // A preset excluding this node would keep it hidden even after the group
    // is un-checked — drop the preset so the hit actually shows.
    const presetChanged = preset !== null && kindOf(n) !== preset;
    if (presetChanged) {
      preset = null;
      syncPresetButtons();
    }
    if (hidden.has(key) || presetChanged) {
      if (hidden.has(key)) {
        hidden.delete(key);
        renderLegend();
      }
      applyFilter();
      syncURL();
    }
    // Recenter the viewport on the node's current position with a comfortable zoom.
    vp = centerOn(vp, { x: n.x, y: n.y }, Math.max(1.5, vp.k), world);
    applyViewport();
    clearSearch();
    // Flash highlight so the user sees which node was found.
    hoveredId = n.id;
    highlight(n.id);
    const g = nodeEls[nodes.indexOf(n)];
    if (g) g.focus();
    window.setTimeout(() => {
      if (hoveredId === n.id) clearHighlight();
    }, 2500);
  }

  function clearSearch() {
    if (searchInput) {
      searchInput.value = '';
      searchInput.setAttribute('aria-expanded', 'false');
    }
    if (searchResults) searchResults.hidden = true;
    applySearchFilter('');
  }

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value;
      searchInput.setAttribute('aria-expanded', 'true');
      renderSearchResults(q);
      applySearchFilter(q);
    });
    searchInput.addEventListener('keydown', (e) => {
      const items = Array.from(searchResults.querySelectorAll<HTMLButtonElement>('.kg-search-item'));
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        searchActive = (searchActive + 1) % Math.max(1, items.length);
        items[searchActive]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        searchActive = (searchActive - 1 + items.length) % Math.max(1, items.length);
        items[searchActive]?.focus();
      } else if (e.key === 'Enter') {
        if (items[Math.max(0, searchActive)]) {
          e.preventDefault();
          items[Math.max(0, searchActive)].click();
        }
      } else if (e.key === 'Escape') {
        clearSearch();
        searchInput.blur();
      }
    });
    searchInput.addEventListener('blur', () => {
      // Allow click on a result to land before hiding.
      window.setTimeout(() => {
        if (!root.contains(document.activeElement)) {
          searchResults.hidden = true;
          applySearchFilter('');
        }
      }, 120);
    });
  }

  // --- Edge-type filter panel: swatches sampled from the SSR edge strokes,
  // checked state synced from hiddenEdgeTypes at init, closes on outside
  // pointerdown or Esc. ---
  const edgePanel = document.getElementById('kg-edge-panel') as HTMLDivElement | null;
  if (edgePanel) {
    edgePanel.querySelectorAll<HTMLInputElement>('input[data-kg-type]').forEach((cb) => {
      const ty = cb.dataset.kgType!;
      const swatch = edgePanel.querySelector<HTMLElement>(`[data-kg-swatch="${ty}"]`);
      if (swatch) swatch.style.color = edgeColor.get(ty) ?? 'var(--text-muted)';
      cb.addEventListener('change', () => {
        if (cb.checked) hiddenEdgeTypes.delete(ty);
        else hiddenEdgeTypes.add(ty);
        applyFilter();
        syncURL();
      });
    });
    document.addEventListener('pointerdown', (e) => {
      if (edgePanel.hidden) return;
      const t = e.target as Node;
      if (edgePanel.contains(t)) return;
      if ((t as Element | null)?.closest?.('[data-kg-action="toggle-edge-panel"]')) return;
      edgePanel.hidden = true;
      root
        .querySelector<HTMLButtonElement>('[data-kg-action="toggle-edge-panel"]')
        ?.setAttribute('aria-expanded', 'false');
    });
  }
  /** Reflect hiddenEdgeTypes in the panel checkboxes (called at init after
   *  the URL state is restored). */
  function syncEdgePanel() {
    edgePanel?.querySelectorAll<HTMLInputElement>('input[data-kg-type]').forEach((cb) => {
      cb.checked = !hiddenEdgeTypes.has(cb.dataset.kgType!);
    });
  }

  // --- Quick-view presets: chips filter the graph to a single node kind ---
  const presetBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-kg-preset]'));
  /** Reflect `preset` in the chips' pressed state — exactly one active. */
  function syncPresetButtons() {
    presetBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kgPreset === (preset ?? ''))));
  }
  presetBtns.forEach((b) => {
    const kind = b.dataset.kgPreset ? b.dataset.kgPreset : null;
    // Append the live node count so each chip shows how much it reveals.
    const count = nodes.filter((n) => kind === null || kindOf(n) === kind).length;
    b.textContent = `${b.dataset.label} (${count})`;
    b.addEventListener('click', () => {
      // Clicking the active chip again (or "All") clears the preset; any other
      // chip swaps in. Combines with the legend checkboxes, which stay intact.
      preset = preset === kind ? null : kind;
      syncPresetButtons();
      applyFilter();
      syncURL();
    });
  });

  // Control buttons.
  const fsBtn = root.querySelector<HTMLButtonElement>('[data-kg-action="fullscreen"]');
  root.querySelectorAll<HTMLButtonElement>('[data-kg-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.kgAction;
      const center = { x: world.w / 2, y: world.h / 2 };
      if (action === 'zoom-in') {
        vp = zoomAt(vp, center, 1.35, world);
        applyViewport();
      } else if (action === 'zoom-out') {
        vp = zoomAt(vp, center, 1 / 1.35, world);
        applyViewport();
      } else if (action === 'reset') {
        resetViewport();
        // Restore the active mode's untouched build-time positions (drag is
        // cosmetic); the other mode's layout is left alone but stays pristine.
        const pristinePos = pristine[mode];
        nodes.forEach((n, i) => {
          n.x = pristinePos[i].x;
          n.y = pristinePos[i].y;
          nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`);
        });
        const live = posFor(mode);
        for (let i = 0; i < live.length; i++) live[i] = { ...pristinePos[i] };
      } else if (action === 'fullscreen') {
        toggleFullscreen();
      } else if (action === 'toggle-color') {
        mode = mode === 'group' ? 'community' : 'group';
        const isCommunity = mode === 'community';
        btn.setAttribute('aria-pressed', String(isCommunity));
        btn.textContent = isCommunity ? btn.dataset.labelCommunity! : btn.dataset.labelGroup!;
        btn.title = btn.textContent;
        // Each mode has its own build-time layout and its own filter, so the
        // switch swaps in the incoming mode's positions, colors and hidden set.
        applyModeLayout();
        renderLegend();
        applyFilter();
        syncURL();
      } else if (action === 'toggle-arrows') {
        showArrows = !showArrows;
        btn.setAttribute('aria-pressed', String(showArrows));
        edgeEls.forEach((e, i) => {
          const l = links[i];
          if (showArrows && isDirected(l.type)) {
            e.setAttribute('marker-end', 'url(#kg-arrow)');
          } else {
            e.removeAttribute('marker-end');
          }
        });
      } else if (action === 'toggle-focus') {
        focusMode = !focusMode;
        btn.setAttribute('aria-pressed', String(focusMode));
        if (!focusMode) {
          focusedId = null;
          clearHighlight();
        }
      } else if (action === 'toggle-edge-panel') {
        const wasHidden = edgePanel ? edgePanel.hidden : true;
        if (edgePanel) edgePanel.hidden = !wasHidden;
        btn.setAttribute('aria-expanded', String(wasHidden));
      }
    });
  });

  function setFullscreen(isFs: boolean) {
    root.classList.toggle('kg-fullscreen', isFs);
    if (fsBtn) {
      fsBtn.setAttribute('aria-label', isFs ? fsBtn.dataset.labelFsExit! : fsBtn.dataset.labelFs!);
      fsBtn.title = isFs ? fsBtn.dataset.labelFsExit! : fsBtn.dataset.labelFs!;
    }
    if (isFs) {
      // Move focus into the overlay so keyboard users land inside it.
      (root.querySelector<HTMLElement>('g[tabindex]') ?? searchInput)?.focus();
    } else {
      fsBtn?.focus();
    }
    requestAnimationFrame(resetViewport);
  }

  function toggleFullscreen() {
    setFullscreen(!root.classList.contains('kg-fullscreen'));
  }

  // Fullscreen: Escape exits; Tab is trapped within the overlay.
  document.addEventListener('keydown', (e) => {
    if (!root.classList.contains('kg-fullscreen')) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      setFullscreen(false);
      return;
    }
    if (e.key !== 'Tab') return;
    const focusables = Array.from(
      root.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), g[tabindex]'),
    ).filter((el) => el.checkVisibility?.() ?? true);
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // --- Esc clears a focus and closes the edge panel. (The fullscreen trap
  // above handles its own Escape while fullscreen; this listener runs always.)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (focusMode && focusedId) {
      focusedId = null;
      clearHighlight();
    }
    if (edgePanel && !edgePanel.hidden) {
      edgePanel.hidden = true;
      root
        .querySelector<HTMLButtonElement>('[data-kg-action="toggle-edge-panel"]')
        ?.setAttribute('aria-expanded', 'false');
    }
  });

  // --- Init: restore any shared/URL state (the SVG ships the group layout;
  // community mode repositions nodes and recolors), then wire up the viewport.
  const urlState = decodeGraphState(window.location.search);
  mode = urlState.mode;
  hiddenGroups = new Set(urlState.hiddenGroups);
  hiddenCommunities = new Set(urlState.hiddenCommunities);
  hiddenEdgeTypes = new Set(urlState.hiddenEdges);
  preset = urlState.preset;
  syncPresetButtons();
  const restoredCommunity = mode === 'community';
  const colorBtn = root.querySelector<HTMLButtonElement>('[data-kg-action="toggle-color"]');
  if (colorBtn) {
    colorBtn.setAttribute('aria-pressed', String(restoredCommunity));
    colorBtn.textContent = restoredCommunity
      ? colorBtn.dataset.labelCommunity!
      : colorBtn.dataset.labelGroup!;
    colorBtn.title = colorBtn.textContent;
  }
  if (restoredCommunity) applyModeLayout();
  renderLegend();
  syncEdgePanel();
  applyFilter();
  resetViewport();
</script>

<style>
  .kg-root {
    position: relative;
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  .kg-root.kg-fullscreen {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: 0;
  }
  .kg-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .kg-presets {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .kg-chip {
    appearance: none;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.22rem 0.7rem;
    font-size: 0.78rem;
    font-family: var(--font-sans);
    cursor: pointer;
    line-height: 1.4;
    white-space: nowrap;
  }
  .kg-chip:hover {
    border-color: var(--text-accent);
    color: var(--text-normal);
  }
  .kg-chip[aria-pressed='true'] {
    background: var(--text-accent);
    border-color: var(--text-accent);
    color: #1a1a1a; /* dark ink on the coral accent — 7.3:1, AA */
    font-weight: 600;
  }
  /* Light theme's --text-accent is dark sienna (#a8331a), where the dark ink
     above drops to 2.61:1. `:global()` keeps Astro from scoping the ancestor —
     without it the compiled selector demands `data-theme` on the button itself
     and never matches. White ink on sienna is 6.66:1. */
  :global([data-theme='light']) .kg-chip[aria-pressed='true'] {
    color: #ffffff;
  }
  .kg-chip:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
  .kg-svg {
    width: 100%;
    height: auto;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  .kg-fullscreen .kg-svg {
    flex: 1 1 auto;
    height: auto;
    min-height: 0;
  }
  .kg-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .kg-btn {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    background: var(--background-primary);
    color: var(--text-normal);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    cursor: pointer;
    line-height: 1;
  }
  .kg-btn:hover {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }
  .kg-btn-toggle {
    width: auto;
    padding: 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .kg-btn-toggle[aria-pressed='true'] {
    border-color: var(--text-accent);
