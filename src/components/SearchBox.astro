---
// Site-wide search island. Bundled (type-checked) script — no framework, no
// client directive. The index URL, i18n strings and topic suggestions are
// stamped server-side via data attributes so the client never touches
// import.meta.env. Styles live in global.css (.search-*).
import { withBase } from "../lib/path";
import { TOPICS } from "../lib/topics";
import Icon from "./Icon.astro";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const indexUrl = withBase("search-index.json");
// Pagefind runtime + index live under `<base>/pagefind/`. Stamped like
// `indexUrl`: the client must not resolve the base itself.
const pagefindUrl = withBase("pagefind/");
// The addressable Explorer surface the "show all" row hands off to (see
// design-plans/explorer-surface.md §4). Stamped server-side like `indexUrl`, so
// the client never resolves the locale itself.
const explorerUrl = withBase(isEn ? "en/explorer/" : "explorer/");
const topicLinks = TOPICS.map((t) => ({ l: isEn ? t.labelEn : t.label, h: withBase(`topics/${t.key}/`) }));

const i18n = {
  placeholder: isEn ? "Search projects & writing…" : "Поиск по проектам и записям…",
  hint: isEn ? "↑↓ navigate · Enter open · Esc close" : "↑↓ навигация · Enter перейти · Esc закрыть",
  all: isEn ? "All" : "Все",
  projects: isEn ? "Projects" : "Проекты",
  posts: isEn ? "Posts" : "Записи",
  terms: isEn ? "Glossary" : "Словарь",
  sources: isEn ? "Library" : "Библиотека",
  empty: isEn ? "Nothing found" : "Ничего не найдено",
  topicsLabel: isEn ? "Browse topics:" : "Смотрите темы:",
  allResults: isEn ? "All results →" : "Все результаты →",
  toggleLabel: isEn ? "Open search" : "Открыть поиск",
  closeLabel: isEn ? "Close search" : "Закрыть поиск",
  facetsLabel: isEn ? "Filter by type" : "Фильтр по типу",
  resultsLabel: isEn ? "Search results" : "Результаты поиска",
};

// Search toggle icons (stroke, 24×24): magnifier ↔ close. Raw `d` strings so
// the bundled script can morph between them without a lucide dependency.
const SEARCH_D = "M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14M21 21l-4.35-4.35";
const X_D = "M6 6l12 12M6 18L18 6";
---

<div
  class="search"
  data-index-url={indexUrl}
  data-pagefind-url={pagefindUrl}
  data-explorer-url={explorerUrl}
  data-topics={JSON.stringify(topicLinks)}
  data-i18n={JSON.stringify(i18n)}
>
  <button
    id="search-toggle"
    class="search-toggle"
    data-analytics="search_open"
    type="button"
    aria-label={i18n.toggleLabel}
    aria-expanded="false"
    aria-controls="search-panel"
  >
    {/* Magnifier ↔ close, swapped by CSS on the button's own `aria-expanded`
        (see `.glyph` rules in global.css). Was a `morphicons` element, which
        pulled a 20 KB path parser into every page for a 16×16 icon. */}
    <svg class="glyph glyph-search" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={SEARCH_D} /></svg>
    <svg class="glyph glyph-x" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={X_D} /></svg>
  </button>

  <div id="search-panel" class="search-panel" hidden>
    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder={i18n.placeholder}
      aria-label={i18n.placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-describedby="search-hint"
    />
    <div class="search-facets" role="group" aria-label={i18n.facetsLabel}>
      <button class="search-facet is-active" data-facet="all" type="button" aria-pressed="true">
        <Icon name="filter" size={14} class="pill-icon" />{i18n.all}
      </button>
      <button class="search-facet" data-facet="project" type="button" aria-pressed="false">
        <Icon name="filter" size={14} class="pill-icon" />{i18n.projects}
      </button>
      <button class="search-facet" data-facet="post" type="button" aria-pressed="false">
        <Icon name="filter" size={14} class="pill-icon" />{i18n.posts}
      </button>
      <button class="search-facet" data-facet="term" type="button" aria-pressed="false">
        <Icon name="filter" size={14} class="pill-icon" />{i18n.terms}
      </button>
      <button class="search-facet" data-facet="source" type="button" aria-pressed="false">
        <Icon name="filter" size={14} class="pill-icon" />{i18n.sources}
      </button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label={i18n.resultsLabel}></ul>
    <div id="search-status" role="status" aria-live="polite" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"></div>
    <p class="search-hint" id="search-hint">{i18n.hint}</p>
  </div>
</div>

<script>
  import { ldWithin } from "../lib/fuzzy";
  import { track, whenAnalyticsReady } from "../lib/analytics";
  import { ICON } from "../lib/icons";

  // Wrap in init() — ES module top-level `return` is illegal, so all early
  // bail-outs live inside a function.
  function init() {
    const root = document.querySelector<HTMLElement>(".search");
    if (!root) return;
    const indexUrl = root.dataset.indexUrl!;
    const pagefindUrl = root.dataset.pagefindUrl!;
    const explorerUrl = root.dataset.explorerUrl!;
    const topics: { l: string; h: string }[] = JSON.parse(root.dataset.topics || "[]");
    type I18n = {
      placeholder: string;
      hint: string;
      all: string;
      projects: string;
      posts: string;
      terms: string;
      sources: string;
      empty: string;
      topicsLabel: string;
      allResults: string;
      toggleLabel: string;
      closeLabel: string;
      facetsLabel: string;
      resultsLabel: string;
    };
    const t: I18n = JSON.parse(root.dataset.i18n || "{}");
    const toggleEl = document.getElementById("search-toggle");
    const panelEl = document.getElementById("search-panel");
    const inputEl = document.getElementById("search-input") as HTMLInputElement | null;
    const resultsElEl = document.getElementById("search-results");
    const facetEls = root.querySelectorAll<HTMLButtonElement>(".search-facet");
    if (!toggleEl || !panelEl || !inputEl || !resultsElEl || !indexUrl) return;
    // Reassign to const so TS keeps the non-null narrowing inside closures.
    const toggle = toggleEl;
    const panel = panelEl;
    const input = inputEl;
    const resultsEl = resultsElEl;

    const lang = document.documentElement.lang === "en" ? "en" : "ru";
    const typeLabel = (tp: string) => {
      if (tp === "post") return lang === "en" ? "Post" : "Запись";
      if (tp === "term") return lang === "en" ? "Glossary" : "Словарь";
      if (tp === "source") return lang === "en" ? "Library" : "Библиотека";
      if (tp === "part") return lang === "en" ? "Module" : "Модуль";
      if (tp === "topic") return lang === "en" ? "Topic" : "Тема";
      return lang === "en" ? "Project" : "Проект";
    };

    /** A facet matches a record type. Volta sub-parts are project pages, so the
     *  "Projects" chip covers them; topic hubs are only reachable from "All"
     *  rather than earning a sixth chip that would not fit a phone. */
    const inFacet = (entryType: string, active: string) => {
      if (active === "all") return true;
      if (active === "project") return entryType === "project" || entryType === "part";
      return entryType === active;
    };

    type Entry = {
      type: string;
      locale: string;
      title: string;
      desc: string;
      tags?: string[];
      tools?: string[];
      href: string;
      date?: string;
      /** Pagefind's highlighted excerpt — already `<mark>`ed, used as-is. */
      html?: string;
    };
    let index: Entry[] | null = null;
    let activeIndex = -1;
    let facet = "all";
    // Dropdown cap. When a query has more matches, the last row hands the whole
    // set off to the Explorer surface instead of truncating silently.
    const MAX_ROWS = 8;
    // Last query already sent to analytics — a refinement is a new query.
    let lastReported = "";

    async function getIndex() {
      if (!index) {
        try {
          const res = await fetch(indexUrl);
          // A 404 (or an HTML error page) must not throw into a floating
          // promise and re-fetch on every keystroke — fall through to an
          // empty index so the panel renders "no results", not nothing.
          if (!res.ok) throw new Error(`search index ${res.status}`);
          index = (await res.json()) as Entry[];
        } catch {
          index = [];
        }
      }
      return index;
    }

    function open() {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", t.closeLabel);
      input.focus();
    }

    function close() {
      // Capture focus *before* hiding: hiding the panel blurs its active
      // descendant, so checking afterwards always saw <body> and never returned
      // focus to the trigger — every close dropped the keyboard user.
      const hadFocus = !!root?.contains(document.activeElement);
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", t.toggleLabel);
      input.value = "";
      resultsEl.innerHTML = "";
      document.querySelector(".search-sibling")?.remove();
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIndex = -1;
      setFacet("all");
      lastReported = "";
      // Return focus to the trigger so keyboard users aren't dropped to <body> —
      // but only if focus was inside this widget (don't steal it from a sibling).
      if (hadFocus) toggle.focus();
    }

    function setFacet(next: string) {
      facet = next;
      facetEls.forEach((b) => {
        const active = b.dataset.facet === next;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });
    }

    function escapeHtml(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function highlight(text: string, tokens: string[]): string {
      const esc = escapeHtml(text);
      const toks = tokens.filter(Boolean);
      if (!toks.length) return esc;
      const re = new RegExp(
        "(" + toks.map((tk) => tk.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|") + ")",
        "gi",
      );
      return esc.replace(re, "<mark>$1</mark>");
    }

    // ── Pagefind (primary engine) ─────────────────────────────────────────
    // The index is built by `pagefind --site dist` in `package.json` `build`:
    // full page bodies, RU/EN indexes separated by `<html lang>`, chunks loaded
    // on demand. Pagefind has no fuzzy matching, so `fuzzyFallback()` keeps the
    // old `ldWithin` typo recovery, and `getIndex()` still answers the
    // browse-by-facet mode (Pagefind needs a term).
    type PagefindResult = {
      results: Array<{
        data: () => Promise<{
          url: string;
          excerpt: string;
          meta: { title?: string };
          filters: Record<string, string[]>;
        }>;
      }>;
    };
    type Pagefind = {
      init?: () => Promise<void>;
      search: (q: string, opts?: Record<string, unknown>) => Promise<PagefindResult>;
    };
    let pf: Pagefind | null = null;
    async function getPagefind(): Promise<Pagefind> {
      if (!pf) {
        pf = (await import(/* @vite-ignore */ `${pagefindUrl}pagefind.js`)) as Pagefind;
        await pf.init?.();
      }
      return pf;
    }

    async function fuzzyFallback(tokens: string[], active: string): Promise<Entry[]> {
      const idx = await getIndex();
      return idx
        .filter((e) => e.locale === lang && inFacet(e.type, active))
        .filter((e) => tokens.some((tk) => tk.length >= 5 && ldWithin(tk, e.title.toLowerCase())))
        .slice(0, MAX_ROWS);
    }

    function render(rows: Entry[], tokens: string[], more: boolean, query: string) {
      resultsEl.innerHTML = "";
      const statusEl = document.getElementById("search-status");
      if (statusEl) {
        statusEl.textContent = rows.length
          ? `${rows.length} — ${t.resultsLabel}`
          : t.empty;
      }
      document.querySelector(".search-sibling")?.remove();
      if (!rows.length) {
        // Empty state lives OUTSIDE the listbox: a listbox may only contain
        // option/group children, and the topic chips are real links (Tab-ready)
        // that would break the combobox key model inside role="listbox"
        // (WCAG 4.1.2). Render it as a sibling block after the list instead.
        const block = document.createElement("div");
        block.className = "search-empty search-sibling";
        const label = document.createElement("span");
        label.textContent = t.empty;
        block.appendChild(label);
        if (topics.length) {
          const wrap = document.createElement("div");
          wrap.className = "search-topics";
          const cap = document.createElement("span");
          cap.className = "search-topics-label";
          cap.textContent = t.topicsLabel;
          wrap.appendChild(cap);
          topics.forEach((tp) => {
            const a = document.createElement("a");
            a.href = tp.h;
            a.className = "search-topic-chip";
            // Leading glyph comes from the frozen contract, interpolated (not
            // re-typed) into the client-built chip. `pill-icon` is the shared
            // alignment class (blog.css).
            a.innerHTML =
              `<svg class="pill-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${ICON.tag}</svg>` +
              escapeHtml(tp.l);
            wrap.appendChild(a);
          });
          block.appendChild(wrap);
        }
        resultsEl.insertAdjacentElement("afterend", block);
        input.setAttribute("aria-expanded", "false");
        activeIndex = -1;
        return;
      }
      input.setAttribute("aria-expanded", "true");
      rows.forEach((r, i) => {
        const li = document.createElement("li");
        li.className = "search-result";
        li.setAttribute("role", "option");
        li.id = "search-result-" + i;
        li.setAttribute("aria-selected", "false");
        li.dataset.idx = String(i);

        const a = document.createElement("a");
        a.href = r.href;
        a.tabIndex = -1;
        a.addEventListener("click", (ev) => {
          // Modified clicks (new tab, download) keep native behaviour.
          if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
          ev.preventDefault();
          const href = a.href;
          // The capture causes the navigation, so it must wait for the SDK
          // (bounded) — an in-flight capture dies with the page otherwise.
          whenAnalyticsReady(() => {
            track("search_result_click", {
              query: input.value.trim().slice(0, 100),
              rank: i + 1,
              href: r.href,
              type: r.type,
              locale: lang,
              surface: "header",
            });
            window.location.href = href;
          });
        });

        const type = document.createElement("span");
        type.className = "search-result-type";
        type.textContent = typeLabel(r.type);

        const title = document.createElement("span");
        title.className = "search-result-title";
        title.innerHTML = highlight(r.title, tokens);

        a.appendChild(type);
        a.appendChild(title);

        if (r.desc) {
          const d = document.createElement("span");
          d.className = "search-result-desc";
          // The CSS clamps this to two lines; without a title the cut text is
          // unreachable without opening the result.
          d.title = r.desc;
          d.innerHTML = r.html ?? highlight(r.desc, tokens);
          a.appendChild(d);
        }

        li.appendChild(a);
        resultsEl.appendChild(li);
      });

      // Handoff row: the dropdown shows at most MAX_ROWS rows, so when the query
      // has more matches, the whole set is one click away on the addressable
      // Explorer surface (`/explorer/?q=…`, RU or EN). Rendered as a sibling
      // after the listbox — role="listbox" may only contain option children
      // (WCAG 4.1.2), the same reason the empty state lives outside it. It reuses
      // the row recipe (`.search-result a`), so the dropdown's look is unchanged.
      if (more && query) {
        const block = document.createElement("div");
        block.className = "search-result search-more search-sibling";
        const a = document.createElement("a");
        a.href = `${explorerUrl}?q=${encodeURIComponent(query)}`;
        a.textContent = t.allResults;
        block.appendChild(a);
        resultsEl.insertAdjacentElement("afterend", block);
      }

      activeIndex = -1;
      input.removeAttribute("aria-activedescendant");
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    async function runSearch() {
      const rawQuery = input.value.trim();
      const tokens = rawQuery ? rawQuery.toLowerCase().split(/\s+/).filter(Boolean) : [];
      let rows: Entry[] = [];
      let more = false;

      if (!rawQuery) {
        // Browse mode: Pagefind needs a term, so the lightweight index answers
        // "what is recent in this facet" (unchanged UX).
        if (facet === "all") {
          resultsEl.innerHTML = "";
          input.setAttribute("aria-expanded", "false");
          activeIndex = -1;
          return;
        }
        const idx = await getIndex();
        rows = idx
          .filter((e) => e.locale === lang && inFacet(e.type, facet))
          .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
          .slice(0, MAX_ROWS);
      } else {
        // Only `type` is a Pagefind filter; the locale is enforced on the URLs
        // below (the `lang` filter indexed empty for content pages).
        const filters: Record<string, string[]> = {};
        if (facet !== "all") filters.type = facet === "project" ? ["project", "part"] : [facet];
        try {
          const engine = await getPagefind();
          const found = await engine.search(rawQuery, { filters });
          // Pagefind's own `lang` filter is not honoured through the JS API
          // here, so the locale is enforced on the returned URLs (it is the
          // same signal the index was split by). Ask for a wider page first.
          const data = await Promise.all(found.results.slice(0, 60).map((r) => r.data()));
          const wantedEn = lang === "en";
          const local = data.filter((d) => /\/en\//.test(d.url) === wantedEn);
          more = local.length > MAX_ROWS;
          rows = local.slice(0, MAX_ROWS).map((d) => ({
            type: d.filters?.type?.[0] ?? "project",
            locale: /\/en\//.test(d.url) ? "en" : "ru",
            title: d.meta?.title ?? d.url,
            desc: (d.excerpt ?? "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim(),
            html: d.excerpt ?? "",
            href: d.url,
          }));
        } catch (err) {
          // Never silent: a missing/failed index must be visible, or the box
          // degrades to the fuzzy title fallback and looks like "no results".
          console.error("[search] pagefind failed", err);
          rows = [];
        }
        // No typo tolerance in Pagefind — `ldWithin` over titles covers the miss.
        if (!rows.length) rows = await fuzzyFallback(tokens, facet);
      }
      render(rows, tokens, more, rawQuery);

      // Report every distinct query: before this, only the first query of a
      // panel session was visible, so refinements and dead ends were invisible.
      if (rawQuery && rawQuery !== lastReported) {
        lastReported = rawQuery;
        track(rows.length > 0 ? "search_used" : "search_no_results", {
          query: rawQuery.slice(0, 100),
          results_count: rows.length,
          locale: lang,
          surface: "header",
        });
      }
    }

    input.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(runSearch, 120);
    });

    facetEls.forEach((b) => {
      b.addEventListener("click", () => {
        setFacet(b.dataset.facet || "all");
        runSearch();
        input.focus();
      });
    });

    // Escape closes from anywhere inside the panel. It used to be bound to the
    // input alone, so once focus moved to a facet button the only ways out were
    // the pointer or the toggle.
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        e.preventDefault();
        close();
      }
    });

    function move(delta: number) {
      const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
      if (!items.length) return;
      activeIndex = (activeIndex + delta + items.length) % items.length;
      items.forEach((it, i) => {
        const isActive = i === activeIndex;
        it.classList.toggle("active", isActive);
        it.setAttribute("aria-selected", String(isActive));
      });
      // Announce the active option to screen readers via the combobox.
      input.setAttribute("aria-activedescendant", items[activeIndex].id);
      items[activeIndex].scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
        if (activeIndex >= 0 && items[activeIndex]) {
          const a = items[activeIndex].querySelector("a");
          if (a) {
            e.preventDefault();
            // `.click()` so the analytics handler on the anchor runs; a bare
            // `location.href` assignment skipped it.
            a.click();
          }
        }
      } else if (e.key === "Escape") {
        close();
      }
    });

    toggle.addEventListener("click", () => {
      panel.hidden ? open() : close();
    });

    document.addEventListener("click", (e) => {
      // Only react when this panel is actually open — otherwise a click on a
      // sibling widget (e.g. the AskMe toggle) would call close() and steal
      // focus back to the search toggle.
      if (!root.contains(e.target as Node) && !panel.hidden) close();
    });

    document.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing = el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA");
      if (e.key === "/" && !typing) {
        e.preventDefault();
        // This panel lives inside the off-canvas drawer, which Base.astro keeps
        // `inert` and translated off-screen while closed. Focusing an input
        // inside an inert subtree is a spec no-op, so without this the shortcut
        // revealed nothing at all — no panel, no caret, no explanation. Open
        // the drawer first; `/` then behaves like the toggle it mirrors.
        if (!document.body.classList.contains("nav-open")) {
          (document.getElementById("nav-toggle") as HTMLButtonElement | null)?.click();
        }
        open();
      } else if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
        // `⌘K`/`Ctrl+K` is the shortcut people now expect a site search to answer
        // to, and `/` alone reaches for the browser's own quick-find in enough
        // browsers to be worth an alias. Same path as `/`, including the `typing`
        // guard — but no `!typing` condition: from inside a field, `⌘K` should
        // still open the panel rather than be swallowed.
        e.preventDefault();
        if (!document.body.classList.contains("nav-open")) {
          (document.getElementById("nav-toggle") as HTMLButtonElement | null)?.click();
        }
        open();
      }
    });
  }

  init();
</script>