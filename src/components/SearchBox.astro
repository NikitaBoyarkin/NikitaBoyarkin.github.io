---
// Site-wide search island. Bundled (type-checked) script — no framework, no
// client directive. The index URL, i18n strings and topic suggestions are
// stamped server-side via data attributes so the client never touches
// import.meta.env. Styles live in global.css (.search-*).
import { withBase } from "../lib/path";
import { TOPICS } from "../lib/topics";
import MorphIcon from "morphicons/astro";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const indexUrl = withBase("search-index.json");
const topicLinks = TOPICS.map((t) => ({ l: t.label, h: withBase(`topics/${t.key}/`) }));

const i18n = {
  placeholder: isEn ? "Search projects & writing…" : "Поиск по проектам и записям…",
  hint: isEn ? "↑↓ navigate · Enter open · Esc close" : "↑↓ навигация · Enter перейти · Esc закрыть",
  all: isEn ? "All" : "Все",
  projects: isEn ? "Projects" : "Проекты",
  posts: isEn ? "Posts" : "Записи",
  empty: isEn ? "Nothing found" : "Ничего не найдено",
  topicsLabel: isEn ? "Browse topics:" : "Смотрите темы:",
  toggleLabel: isEn ? "Open search" : "Открыть поиск",
  closeLabel: isEn ? "Close search" : "Закрыть поиск",
  facetsLabel: isEn ? "Filter by type" : "Фильтр по типу",
  resultsLabel: isEn ? "Search results" : "Результаты поиска",
};

// Search toggle icons (stroke, 24×24): magnifier ↔ close. Raw `d` strings so
// the bundled script can morph between them without a lucide dependency.
const SEARCH_D = "M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14M21 21l-4.35-4.35";
const X_D = "M6 6l12 12M6 18L18 6";
---

<div
  class="search"
  data-index-url={indexUrl}
  data-topics={JSON.stringify(topicLinks)}
  data-i18n={JSON.stringify(i18n)}
  data-icon-search={SEARCH_D}
  data-icon-close={X_D}
>
  <button
    id="search-toggle"
    class="search-toggle"
    data-analytics="search_open"
    type="button"
    aria-label={i18n.toggleLabel}
    aria-expanded="false"
    aria-controls="search-panel"
  >
    <MorphIcon id="search-icon" icon={SEARCH_D} spring="snappy" reducedMotion="user" size={16} />
  </button>

  <div id="search-panel" class="search-panel" hidden>
    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder={i18n.placeholder}
      aria-label={i18n.placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-describedby="search-hint"
    />
    <div class="search-facets" role="group" aria-label={i18n.facetsLabel}>
      <button class="search-facet is-active" data-facet="all" type="button">{i18n.all}</button>
      <button class="search-facet" data-facet="project" type="button">{i18n.projects}</button>
      <button class="search-facet" data-facet="post" type="button">{i18n.posts}</button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label={i18n.resultsLabel}></ul>
    <p class="search-hint" id="search-hint">{i18n.hint}</p>
  </div>
</div>

<script>
  import { defineMorphIcon, type MorphIconElement } from "morphicons/element";
  import { ldWithin } from "../lib/fuzzy";
  import { track } from "../lib/analytics";

  // Same stroke paths as the SSR render (see frontmatter). Morphing the
  // toggle magnifier ↔ close is a pure animation on the custom element.
  defineMorphIcon();
  let searchIcon: MorphIconElement | null = null;
  async function morphSearch(to: string) {
    if (!searchIcon) {
      await customElements.whenDefined("morph-icon");
      searchIcon = document.getElementById("search-icon") as MorphIconElement | null;
      if (!searchIcon) return;
    }
    searchIcon.morphTo(to);
  }

  // Wrap in init() — ES module top-level `return` is illegal, so all early
  // bail-outs live inside a function.
  function init() {
    const root = document.querySelector<HTMLElement>(".search");
    if (!root) return;
    const searchD = root.dataset.iconSearch!;
    const closeD = root.dataset.iconClose!;
    const indexUrl = root.dataset.indexUrl!;
    const topics: { l: string; h: string }[] = JSON.parse(root.dataset.topics || "[]");
    type I18n = {
      placeholder: string;
      hint: string;
      all: string;
      projects: string;
      posts: string;
      empty: string;
      topicsLabel: string;
      toggleLabel: string;
      closeLabel: string;
      facetsLabel: string;
      resultsLabel: string;
    };
    const t: I18n = JSON.parse(root.dataset.i18n || "{}");
    const toggleEl = document.getElementById("search-toggle");
    const panelEl = document.getElementById("search-panel");
    const inputEl = document.getElementById("search-input") as HTMLInputElement | null;
    const resultsElEl = document.getElementById("search-results");
    const facetEls = root.querySelectorAll<HTMLButtonElement>(".search-facet");
    if (!toggleEl || !panelEl || !inputEl || !resultsElEl || !indexUrl) return;
    // Reassign to const so TS keeps the non-null narrowing inside closures.
    const toggle = toggleEl;
    const panel = panelEl;
    const input = inputEl;
    const resultsEl = resultsElEl;

    const lang = document.documentElement.lang === "en" ? "en" : "ru";
    const typeLabel = (tp: string) =>
      lang === "en" ? (tp === "post" ? "Post" : "Project") : (tp === "post" ? "Запись" : "Проект");

    type Entry = {
      type: string;
      locale: string;
      title: string;
      desc: string;
      tags?: string[];
      tools?: string[];
      href: string;
      date?: string;
    };
    let index: Entry[] | null = null;
    let activeIndex = -1;
    let facet = "all";
    // One `search_used` / `search_no_results` per open panel (REQ-A08).
    let searchReported = false;

    async function getIndex() {
      if (!index) {
        try {
          const res = await fetch(indexUrl);
          // A 404 (or an HTML error page) must not throw into a floating
          // promise and re-fetch on every keystroke — fall through to an
          // empty index so the panel renders "no results", not nothing.
          if (!res.ok) throw new Error(`search index ${res.status}`);
          index = (await res.json()) as Entry[];
        } catch {
          index = [];
        }
      }
      return index;
    }

    function open() {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", t.closeLabel);
      input.focus();
      morphSearch(closeD);
    }

    function close() {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", t.toggleLabel);
      input.value = "";
      resultsEl.innerHTML = "";
      document.querySelector(".search-empty-sibling")?.remove();
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIndex = -1;
      setFacet("all");
      searchReported = false;
      // Return focus to the trigger so keyboard users aren't dropped to <body> —
      // but only if focus was inside this widget (don't steal it from a sibling).
      if (root?.contains(document.activeElement)) toggle.focus();
      morphSearch(searchD);
    }

    function setFacet(next: string) {
      facet = next;
      facetEls.forEach((b) => b.classList.toggle("is-active", b.dataset.facet === next));
    }

    function escapeHtml(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function highlight(text: string, tokens: string[]): string {
      const esc = escapeHtml(text);
      const toks = tokens.filter(Boolean);
      if (!toks.length) return esc;
      const re = new RegExp(
        "(" + toks.map((tk) => tk.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|") + ")",
        "gi",
      );
      return esc.replace(re, "<mark>$1</mark>");
    }

    function score(entry: Entry, tokens: string[]): number {
      const title = entry.title.toLowerCase();
      const desc = entry.desc.toLowerCase();
      const tags = (entry.tags ?? []).map((t) => t.toLowerCase());
      const tools = (entry.tools ?? []).map((t) => t.toLowerCase());
      const words = [title, desc, ...tags, ...tools].join(" ").split(/\s+/);
      let s = 0;
      for (const tk of tokens) {
        const inTitle = title.includes(tk);
        const inDesc = desc.includes(tk);
        const tagHit = tags.some((t) => t === tk);
        const toolHit = tools.some((t) => t === tk);
        // Fuzzy prefix: "ret" matches "retention" (word-boundary aware, so
        // Cyrillic works too — \b is ASCII-only in JS).
        const prefixHit = words.some((w) => w.startsWith(tk));
        // Typo recovery: ≤2 edits against any index word, only for tokens long
        // enough to be meaningful (early-exit LD, zero-dep — see lib/fuzzy).
        // Threshold 5: 4-char tokens with max=2 edit distance match almost every
        // index word (e.g. "data" ~ "hat") → noise in the top-8 results.
        const fuzzyHit = tk.length >= 5 && words.some((w) => ldWithin(tk, w));
        if (!inTitle && !inDesc && !tagHit && !toolHit && !prefixHit && !fuzzyHit) return -1;
        s += inTitle ? 3 : 0;
        s += tagHit ? 2 : 0;
        s += toolHit ? 2 : 0;
        s += prefixHit ? 1 : 0;
        s += fuzzyHit ? 1 : 0;
        s += 1;
      }
      // Locale boost: current-locale entries rank above cross-locale matches
      // instead of being hard-filtered out (see runSearch).
      if (entry.locale === lang) s += 5;
      return s;
    }

    function render(rows: Entry[], tokens: string[]) {
      resultsEl.innerHTML = "";
      document.querySelector(".search-empty-sibling")?.remove();
      if (!rows.length) {
        // Empty state lives OUTSIDE the listbox: a listbox may only contain
        // option/group children, and the topic chips are real links (Tab-ready)
        // that would break the combobox key model inside role="listbox"
        // (WCAG 4.1.2). Render it as a sibling block after the list instead.
        const block = document.createElement("div");
        block.className = "search-empty search-empty-sibling";
        const label = document.createElement("span");
        label.textContent = t.empty;
        block.appendChild(label);
        if (topics.length) {
          const wrap = document.createElement("div");
          wrap.className = "search-topics";
          const cap = document.createElement("span");
          cap.className = "search-topics-label";
          cap.textContent = t.topicsLabel;
          wrap.appendChild(cap);
          topics.forEach((tp) => {
            const a = document.createElement("a");
            a.href = tp.h;
            a.className = "search-topic-chip";
            a.textContent = tp.l;
            wrap.appendChild(a);
          });
          block.appendChild(wrap);
        }
        resultsEl.insertAdjacentElement("afterend", block);
        input.setAttribute("aria-expanded", "false");
        activeIndex = -1;
        return;
      }
      input.setAttribute("aria-expanded", "true");
      rows.forEach((r, i) => {
        const li = document.createElement("li");
        li.className = "search-result";
        li.setAttribute("role", "option");
        li.id = "search-result-" + i;
        li.setAttribute("aria-selected", "false");
        li.dataset.idx = String(i);

        const a = document.createElement("a");
        a.href = r.href;
        a.tabIndex = -1;

        const type = document.createElement("span");
        type.className = "search-result-type";
        type.textContent = typeLabel(r.type);

        const title = document.createElement("span");
        title.className = "search-result-title";
        title.innerHTML = highlight(r.title, tokens);

        a.appendChild(type);
        a.appendChild(title);

        if (r.desc) {
          const d = document.createElement("span");
          d.className = "search-result-desc";
          d.innerHTML = highlight(r.desc, tokens);
          a.appendChild(d);
        }

        li.appendChild(a);
        resultsEl.appendChild(li);
      });
      activeIndex = -1;
      input.removeAttribute("aria-activedescendant");
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    async function runSearch() {
      const idx = await getIndex();
      if (!idx) return;
      const q = input.value.trim().toLowerCase();
      const rawQuery = input.value.trim();
      const tokens = q ? q.split(/\s+/).filter(Boolean) : [];
      let rows: Entry[];
      if (!q) {
        // No query + active facet → browse recent items of that type.
        if (facet === "all") {
          resultsEl.innerHTML = "";
          input.setAttribute("aria-expanded", "false");
          activeIndex = -1;
          return;
        }
        rows = idx
          .filter((e) => e.locale === lang && e.type === facet)
          .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
          .slice(0, 8);
      } else {
        // No hard locale filter — score() boosts the current locale so
        // cross-locale results still surface when they match better.
        rows = idx
          .filter((e) => facet === "all" || e.type === facet)
          .map((e) => ({ e, s: score(e, tokens) }))
          .filter((x) => x.s >= 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 8)
          .map((x) => x.e);
      }
      render(rows, tokens);

      // Emit once per panel session, when the first real query runs (REQ-A08).
      if (rawQuery && !searchReported) {
        searchReported = true;
        track(rows.length > 0 ? "search_used" : "search_no_results", {
          query: rawQuery.slice(0, 100),
          results_count: rows.length,
          locale: lang,
        });
      }
    }

    input.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(runSearch, 120);
    });

    facetEls.forEach((b) => {
      b.addEventListener("click", () => {
        setFacet(b.dataset.facet || "all");
        runSearch();
        input.focus();
      });
    });

    function move(delta: number) {
      const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
      if (!items.length) return;
      activeIndex = (activeIndex + delta + items.length) % items.length;
      items.forEach((it, i) => {
        const isActive = i === activeIndex;
        it.classList.toggle("active", isActive);
        it.setAttribute("aria-selected", String(isActive));
      });
      // Announce the active option to screen readers via the combobox.
      input.setAttribute("aria-activedescendant", items[activeIndex].id);
      items[activeIndex].scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
        if (activeIndex >= 0 && items[activeIndex]) {
          const a = items[activeIndex].querySelector("a");
          if (a) {
            e.preventDefault();
            window.location.href = a.href;
          }
        }
      } else if (e.key === "Escape") {
        close();
      }
    });

    toggle.addEventListener("click", () => {
      panel.hidden ? open() : close();
    });

    document.addEventListener("click", (e) => {
      // Only react when this panel is actually open — otherwise a click on a
      // sibling widget (e.g. the AskMe toggle) would call close() and steal
      // focus back to the search toggle.
      if (!root.contains(e.target as Node) && !panel.hidden) close();
    });

    document.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing = el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA");
      if (e.key === "/" && !typing) {
        e.preventDefault();
        open();
      }
    });
  }

  init();
</script>