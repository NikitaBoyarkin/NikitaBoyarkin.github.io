---
// "Fresh materials" strip — horizontal scroll-snap of latest writing, inspired
// by podbiratel's material strip. This is the homepage "editorial top"
// (editorial top + bento bottom). Projects moved to HeadlineCases (PRD v6 S2.6);
// EN uses the (small) posts-en collection until more posts are translated (S3.1).
import { getCollection } from "astro:content";
import { withBase } from "../lib/path";
import { formatDate } from "../lib/date";
import { categoryLabel } from "../lib/categories";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const postCollection = isEn ? "posts-en" : "posts";
const postLinkPrefix = isEn ? "en/" : "";
const heading = isEn ? "Fresh materials" : "Свежие материалы";
const footLabel = isEn ? "All writing" : "Все записи";

const posts = (await getCollection(postCollection, (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const slugOf = (id: string) => id.replace(/\.md$/, "");
// WebP sibling for lazy previews (PNG stays for OG meta tags).
const webpOf = (src: string) => src.replace(/\.png$/, ".webp");
---

<section id="materials" class="reveal reveal-delay-1" aria-label={heading}>
  <h2>{heading}</h2>
  <div class="material-strip">
    {
      posts.map((post) => (
        <a class="strip-card" href={withBase(`${postLinkPrefix}posts/${slugOf(post.id)}/`)}>
          {post.data.image && (
            <picture>
              <source type="image/webp" srcset={withBase(webpOf(post.data.image))} />
              <img
                src={withBase(post.data.image)}
                alt={post.data.title}
                width="600"
                height="200"
                loading="lazy"
              />
            </picture>
          )}
          <div class="strip-card-body">
            <span class="strip-badge strip-badge-post">
              {categoryLabel(post.data.category, lang)}
            </span>
            <span class="strip-title">{post.data.title}</span>
            <span class="strip-meta">{formatDate(post.data.date)}</span>
          </div>
        </a>
      ))
    }
  </div>

  <p class="strip-foot">
    <a href={withBase(`${isEn ? 'en/' : ''}writing/`)}>{footLabel} →</a>
  </p>
</section>

<style>
  /* The section heading was unstyled (browser default h2) — align it with the
     other editorial section headings: Cormorant at the shared scale. */
  #materials > h2 {
    font-family: var(--font-display);
    font-size: var(--type-section-h2);
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-normal);
  }
</style>
