---
// The catalogue as a table — the site's equivalent of a Bases table view. The
// card board answers "what is this case?"; the table answers "how do these cases
// compare?", which a grid cannot: track, provenance, dates and repo visibility
// line up as columns. Rows arrive ready to render (localized labels, formatted
// dates, resolved hrefs), so this component owns layout and nothing else.
import { withBase } from '../lib/path';
import type { ProjectTableRow } from '../lib/projects';

interface Props {
  rows: ProjectTableRow[];
  lang?: 'ru' | 'en';
}

const { rows, lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const i18n = {
  caption: isEn ? 'Project catalogue' : 'Каталог проектов',
  scroll: isEn ? 'Project table, scrolls horizontally' : 'Таблица проектов, прокручивается по горизонтали',
  case: isEn ? 'Case' : 'Кейс',
  track: isEn ? 'Track' : 'Трек',
  data: isEn ? 'Data' : 'Данные',
  published: isEn ? 'Published' : 'Опубликован',
  updated: isEn ? 'Updated' : 'Обновлён',
  github: 'GitHub',
  repo: isEn ? 'Repository' : 'Репозиторий',
  stack: isEn ? 'Stack' : 'Стек',
  publicRepo: isEn ? 'public' : 'публичный',
  privateRepo: isEn ? 'private' : 'приватный',
  // An empty cell prints an em dash, which a screen reader announces as a
  // punctuation mark rather than as "nothing here". A hidden label states the
  // absence; the dash stays for the eye. `synthetic` is its own wording because
  // an absent dataset badge means synthetic rows, not missing metadata.
  notApplicable: isEn ? 'not applicable' : 'не применимо',
  synthetic: isEn ? 'synthetic data' : 'синтетические данные',
  // Names the new-tab behaviour on the row's only outbound link (WCAG 3.2.5).
  newTab: isEn ? 'opens in a new tab' : 'открывается в новой вкладке',
};
---

{/* The wrapper scrolls, not the page: eight columns cannot fit 375px, and a
    table allowed to widen the document makes every section below it scroll
    sideways too. `role="region"` + `tabindex="0"` is what lets a keyboard user
    reach that overflow (WCAG 2.1.1) — a bare scrolling div is unreachable — and
    the region needs a name or the tab stop is unexplained. */}
<div class="project-table-scroll" role="region" tabindex="0" aria-label={i18n.scroll}>
  <table class="project-table">
    <caption class="visually-hidden">{i18n.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{i18n.case}</th>
        <th scope="col">{i18n.track}</th>
        <th scope="col">{i18n.data}</th>
        <th scope="col">{i18n.published}</th>
        <th scope="col">{i18n.updated}</th>
        <th scope="col">{i18n.github}</th>
        <th scope="col">{i18n.repo}</th>
        <th scope="col">{i18n.stack}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="cell-title">
              <a href={withBase(row.href)} data-analytics-project={row.slug} data-analytics-surface="table">
                {row.title}
              </a>
            </td>
            <td>{row.track}</td>
            {/* A badge only where provenance is the exception; a synthetic case
                gets no label, because labelling the default turns a marker into
                noise (ProjectCard's `dataset` makes the same call). */}
            <td>
              {row.dataset ? (
                <span class="project-dataset-badge">{row.dataset}</span>
              ) : (
                <span class="table-empty"><span aria-hidden="true">—</span><span class="visually-hidden">{i18n.synthetic}</span></span>
              )}
            </td>
            <td class="cell-num">{row.published ?? <span class="table-empty"><span aria-hidden="true">—</span><span class="visually-hidden">{i18n.notApplicable}</span></span>}</td>
            <td class="cell-num">{row.updated ?? <span class="table-empty"><span aria-hidden="true">—</span><span class="visually-hidden">{i18n.notApplicable}</span></span>}</td>
            <td>
              {row.github && !row.isPrivate ? (
                <a href={row.github} target="_blank" rel="noopener noreferrer" aria-label={`${i18n.github}: ${row.title}, ${i18n.newTab}`} data-analytics={`project_github_${row.slug}`}>
                  {i18n.github}
                </a>
              ) : (
                <span class="table-empty"><span aria-hidden="true">—</span><span class="visually-hidden">{i18n.notApplicable}</span></span>
              )}
            </td>
            <td class="cell-repo">{row.isPrivate ? i18n.privateRepo : i18n.publicRepo}</td>
            <td class="cell-stack">{row.tools.length > 0 ? row.tools.join(' · ') : <span class="table-empty"><span aria-hidden="true">—</span><span class="visually-hidden">{i18n.notApplicable}</span></span>}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* The border lives on the scrollport, not the table: a border on a table
     wider than its wrapper scrolls away with the first columns. */
  .project-table-scroll {
    overflow-x: auto;
    /* `position: relative` is load-bearing, not styling: without it Chrome's
       `documentElement.scrollWidth` counts this scroller's clipped content and
       reports a 790px-wide document at a 375px viewport (measured) — the page
       cannot actually scroll, but Lighthouse's content-width check believes the
       number, and any future sibling that widens would then overflow for real.
       The wrapper as containing block stops the root from inheriting the
       overflow. */
    position: relative;
    border: 1px solid color-mix(in srgb, var(--border-color) 45%, transparent);
    border-radius: var(--card-radius);
  }

  /* Explicit outline: the UA ring on a focusable scroll container gets clipped
     at the scrollport edge, which makes the tab stop look like nothing. */
  .project-table-scroll:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  /* `global.css` turns every `main table` into its own horizontal scroller
     (`display: block; overflow-x: auto`, plus edge shadows). That is right for a
     prose table and wrong here twice over: `display: block` stops the table from
     sizing its columns, and the rule would nest a second scroller inside this
     component's named `role="region"` — the page then measured 790px wide on a
     375px viewport, because the inner scroller is 832px inside a 345px box.
     External scroller only: this table is a table again. */
  .project-table-scroll > .project-table {
    display: table;
    max-width: none;
    overflow: visible;
    background: none;
  }

  .project-table {
    width: 100%;
    /* Eight columns need ~52rem before dates and badges stack into two lines
       each. Below that the wrapper scrolls; the page never does. */
    min-width: 52rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .project-table th,
  .project-table td {
    padding: 0.55rem 0.75rem;
    text-align: start;
    vertical-align: top;
    color: var(--text-normal);
  }

  /* Same eyebrow recipe as `.project-year-heading`: it marks a column, not a
     value. */
  .project-table thead th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-muted);
    border-bottom: 1px solid var(--surface-secondary);
  }

  /* No rule under the last row — the scrollport's own border is the edge. */
  .project-table tbody tr:not(:last-child) {
    border-bottom: 1px solid var(--surface-secondary);
  }

  /* Titles are the one cell allowed to wrap: a 40-character case name is the
     row's identity, and truncating it makes two cases look alike. */
  .cell-title {
    min-width: 14rem;
    white-space: normal;
  }

  .cell-title a {
    color: var(--text-normal);
    text-decoration: none;
  }

  .cell-title a:hover {
    color: var(--text-accent);
    text-decoration: underline;
  }

  .cell-title a:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  /* Dates read as a column only with fixed-width digits. */
  .cell-num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cell-repo,
  .cell-stack {
    color: var(--text-muted);
  }

  /* The stack is the longest value and the one that may wrap mid-token
     ("statsmodels"), so it keeps a floor; repo visibility is one word. */
  .cell-stack {
    min-width: 12rem;
  }

  /* The global `.project .project-dataset-badge` rule is scoped to `.project`,
     and a table cell is not a card. Restating the pill keeps one look for one
     meaning: accent colour, hairline, full radius. */
  .project-dataset-badge {
    display: inline-block;
    padding: 0.05rem var(--space-2);
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    color: var(--text-accent);
    letter-spacing: 0.06em;
  }

  .table-empty {
    color: var(--text-muted);
  }
</style>
