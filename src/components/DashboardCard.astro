---
// One curated card. Every row is a real `<a>`, so the card works with JS off —
// which is the acceptance criterion, not a nicety: today a visitor without JS
// reaches three persona pages from `/` and nothing else.
//
// The tools card is the one card whose rows do not fit inline, and the one card
// with no index behind it (design-plans/home-dashboard.md §4), so its 46 rows are
// all present but folded into a `<details>` — native disclosure, no JavaScript.
import type { DashboardSection, Lang } from '../lib/dashboard';
import { DASHBOARD_COPY } from '../lib/dashboard';
import Icon from './Icon.astro';

interface Props {
  section: DashboardSection;
  locale: Lang;
}

const { section, locale } = Astro.props;
const copy = DASHBOARD_COPY[locale];

// Content cards are clipped to CHILDREN_LIMIT with the section index behind them,
// so the remainder is only ever non-zero for them; the tools card ships every row.
const remainder = section.count - section.children.length;
const folded = section.id === 'tools';
---

<article class="dash-card">
  <h3 class="dash-card-title">
    {section.href ? <a href={section.href}>{section.title}</a> : section.title}
  </h3>
  <p class="dash-card-count">{section.countLabel}</p>
  <p class="dash-card-desc">{section.desc}</p>

  {
    section.children.length === 0 ? (
      <p class="dash-empty">{copy.empty}</p>
    ) : folded ? (
      <details class="dash-rows-group">
        <summary>
          {copy.showAll(section.children.length)}
          <Icon name="chevron-down" size={16} class="dash-ico" />
        </summary>
        <ul class="dash-rows">
          {section.children.map((row) => (
            <li>
              <a href={row.href}>
                {row.title}
                <Icon name="external" size={16} class="dash-ico" />
              </a>
              {row.count !== undefined && <span class="dash-row-count">{row.count}</span>}
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <ul class="dash-rows">
        {section.children.map((row) => (
          <li>
            <a href={row.href}>
              {row.title}
              <Icon name="external" size={16} class="dash-ico" />
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    section.href && remainder > 0 && (
      <a class="dash-card-more" href={section.href}>
        {copy.seeAll(section.count)}
        <Icon name="arrow-right" size={16} class="dash-ico" />
      </a>
    )
  }
</article>
