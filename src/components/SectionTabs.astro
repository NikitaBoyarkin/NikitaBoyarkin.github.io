---
// Generic section dashboard: groups a page's sections into a small set of
// client-side switchable panels so a project page reads on one URL.
//
// Deliberately a sibling of about/AboutTabs.astro, not a shared component: the
// /about one has its ids ("start"), classes (.about-*) and panel ids frozen by
// tests/built/about.test.ts. This one owns the `data-section-tabs` root and the
// `.section-*` classes, so the two tab widgets on the site never collide.
//
// Contract, mirroring the /about dashboard:
//   · the tablist carries role="tablist" with one <button role="tab"> per tab;
//   · every panel is a <SectionPanel> (this directory) with data-panel;
//   · the first tab is selected and focusable server-side — the rest is
//     progressive enhancement, so there is no flash and no tab is required.
//   · no JS: a <noscript> rule reveals every panel and hides the tablist, so the
//     page degrades to the previous long-scroll layout.
//   · with JS: the controller (`src/lib/section-tabs-controller.ts`) reveals one
//     panel, wires the ARIA tab pattern (click + arrows/Home/End), maps any
//     anchor inside a panel to that panel (so #heading deep-links open the right
//     tab), reveals `.reveal` nodes in the freshly shown panel, and — when
//     `railId` points at a fixed table-of-contents rail — shows that rail only
//     while a panel marked `ownsRail` is active (otherwise a hidden panel's TOC
//     would sit over the section that replaced it).
//
// Markup is untyped on purpose: a page assembles the panels as children.
interface TabDef {
  id: string;
  label: string;
  // Hash set in the URL on switch. Defaults to the tab id, which needs no
  // element of its own — the controller maps it back to the panel.
  anchor?: string;
}
interface Props {
  tabs: TabDef[];
  label: string;
  // Element id to keep in sync with the `ownsRail` panel (e.g. "inner-toc").
  railId?: string;
  // With one section the tablist is noise; the page passes this so it is not
  // rendered and its panel drops the tabpanel role.
  single?: boolean;
  // A nested dashboard (tracks inside the talks page) is a second tablist in the
  // same document: same contract, less visual weight than the page-level tabs.
  size?: 'sm';
  // Opt-in analytics: when set, every user-initiated tab activation emits
  // `tab_selected { tab, group, locale }` with this value as `group`. Left unset
  // on the project pages, whose tab switches stay uninstrumented.
  analytics?: string;
}
const {
  tabs = [],
  label,
  railId = '',
  single = false,
  size = '',
  analytics = '',
} = Astro.props;

// set:html, not a literal <style>: Astro would scope a nested style to this
// component, and the panels it must reveal live in SectionPanel.
const noScriptFallback =
  '<style>.section-panel[hidden]{display:block !important}.section-tablist{display:none !important}.section-select{display:none !important}</style>';
---

<div class="section-tabs" class:list={[size && `section-tabs--${size}`]} data-section-tabs data-rail-id={railId} data-analytics-group={analytics || undefined}>
  <div class="section-tablist" role="tablist" aria-label={label} {...(single ? { hidden: true } : {})}>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          class="section-tab"
          id={`tab-${tab.id}`}
          data-tab={tab.id}
          data-anchor={tab.anchor ?? tab.id}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    size === 'sm' && (
      <div class="section-select" data-section-select>
        <select class="section-select__input" aria-label={label}>
          {tabs.map((tab) => (
            <option value={tab.id}>{tab.label}</option>
          ))}
        </select>
        <span class="section-select__chevron" aria-hidden="true" />
      </div>
    )
  }

  <div class="section-panels">
    <slot />
  </div>

  <noscript set:html={noScriptFallback} />

  {/* Bundled module, not `is:inline`: Astro emits one module per imported URL, so
      the controller executes exactly once per page even though this component
      mounts three times on /talks/ (page dashboard + tracks + themes). Inline, it
      shipped a second copy per mount and relied on a boot guard to stop the
      repeat work; the `data-section-tabs-ready` marker stays as belt-and-braces
      for HMR/dev. */}
  <script>
    import '../lib/section-tabs-controller';
  </script>
</div>

<style>
  .section-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0 0 var(--space-4);
    border-bottom: 1px solid var(--border-color);
  }
  /* Segmented control, matching .filter-tag / .about-tab: muted at rest, accent
     as a signal only (text + border + underline), never as a surface fill. */
  .section-tab {
    appearance: none;
    cursor: pointer;
    position: relative;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  /* Hover is a desktop signal only: on a touch screen the emulated hover sticks
     to the last tapped tab (the pointer never leaves), so the chip that was
     pressed keeps the accent colour as if it were still active. Focus and
     [aria-selected] carry the touch states instead. */
  @media (hover: hover) and (pointer: fine) {
    .section-tab:hover {
      color: var(--text-accent);
      border-color: var(--border-active);
    }
  }
  .section-tab[aria-selected='true'] {
    color: var(--text-accent);
    border-color: var(--border-active);
    background: color-mix(in srgb, var(--text-accent) 8%, transparent);
  }
  /* Non-color cue (WCAG 1.4.1): the selected tab keeps a shape change, so the
     state is not signalled by hue alone. */
  .section-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: calc(var(--space-4) * -1 - 1px);
    height: 2px;
    background: var(--text-accent);
  }
  .section-tab:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
  /* Deep-link anchors and TOC jumps land under the sticky nav without this.
     Applies to any element with an id inside a panel, and to the panel itself:
     a hash that names a tab (`#tracks`) resolves to `panel-<id>`, which no
     descendant selector reaches. */
  :global(.section-panel [id]),
  :global(.section-panel[data-panel]) {
    scroll-margin-top: calc(var(--nav-mobile-h) + var(--space-4));
  }
  /* Nested dashboard: same pattern, one step quieter than the page-level tabs
     that contain it. */
  .section-tabs--sm .section-tablist {
    gap: var(--space-1);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
  }
  .section-tabs--sm .section-tab {
    padding: 2px var(--space-3);
    font-size: 0.82rem;
  }
  .section-tabs--sm .section-tab[aria-selected='true']::after {
    left: var(--space-2);
    right: var(--space-2);
    bottom: calc(var(--space-2) * -1 - 1px);
  }
  /* Phone-only replacement for the nested chip strip. Hidden everywhere else:
     on a desktop the chips are the control and the select does not exist in
     the layout at all. */
  .section-select {
    display: none;
  }
  /* Phone: every tab in view, nothing to swipe. The tabs share the row width
     instead (`flex: 1 1 auto`), so the five page tabs sit on one line and the
     twelve track / eleven theme chips wrap two or three per line. The panel's
     own <h3> repeats a long name in full, so the ellipsis here costs nothing. */
  @media (max-width: 767px) {
    .section-tablist {
      flex-wrap: wrap;
      gap: var(--space-1);
    }
    .section-tab {
      /* Natural width, allowed to shrink — not `1 1 auto`: growing stretched the
         tabs to fill the line, which left the fifth page tab alone on a second
         row at full width. At this padding and size the five fit one row. */
      flex: 0 1 auto;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      padding: var(--space-1) 6px;
      font-size: 0.78rem;
      text-align: center;
    }
    /* The tab clips its own text for the ellipsis above, and the strip clips
       vertically — so the desktop underline, which sits outside the tab's
       padding box, vanished on a phone. Draw the non-color cue inside the
       padding box instead: same 2px rule, nothing left to clip. */
    .section-tab[aria-selected='true']::after,
    .section-tabs--sm .section-tab[aria-selected='true']::after {
      left: var(--space-2);
      right: var(--space-2);
      bottom: 0;
    }
  }

  /* Page-level strip on a phone: the five page tabs keep wrapping (one row at
     390px, two at 320px), but the strip also pins under the site nav, so the
     dashboard's own navigation stays reachable at any depth of a long panel.
     It must be opaque — the page has a honeycomb wallpaper behind it — and must
     sit one layer *below* the nav, which is itself sticky at `top: 0` with
     `z-index: var(--z-dialog)` and `min-height: var(--nav-mobile-h)`; the nav's
     measured height and the token move together (Base.astro overwrites the
     token from the real bar). `--z-sticky: 100` < `--z-dialog: 1200`.
     This is the page's second and last sticky layer: the programme's day
     headers stay in flow on purpose. */
  @media (max-width: 767px) {
    .section-tabs:not(.section-tabs--sm) > .section-tablist {
      position: sticky;
      top: var(--nav-mobile-h);
      z-index: var(--z-sticky);
      background: var(--background-primary);
      padding-block-start: var(--space-2);
      padding-block-end: var(--space-2);
      margin-bottom: var(--space-3);
    }
  }

  /* Nested (`--sm`) dashboard on a phone: the chip strip is replaced by one
     native <select>. Twelve Russian track names measure 2147px against a 358px
     row, so the chips were either 175-289px of wrapped rows or a sideways
     scroller the owner does not want. One 44px control needs no swipe and hands
     the full option list to the OS picker.
     The tablist stays in the DOM — a built test counts its tablists, tabs,
     `aria-controls` and `data-anchor`s, and `aria-labelledby` still resolves an
     accessible name through a `display:none` node — it only leaves the phone
     layout. Keyed on `--sm`, so any nested dashboard inherits it. */
  @media (max-width: 767px) {
    .section-tabs--sm .section-select {
      display: block;
      position: relative;
      margin-bottom: var(--space-3);
    }
    .section-tabs--sm .section-tablist {
      display: none;
    }
    /* 44px is the thumb floor, 1rem the iOS no-zoom floor, 999px matches the
       chips' capsule silhouette. `appearance: none` drops the native arrow so
       the chevron below is the only affordance, and the field never takes a
       width above its 100% so the document cannot widen at 320px. */
    .section-select__input {
      appearance: none;
      -webkit-appearance: none;
      width: 100%;
      min-height: 44px;
      padding: 0 40px 0 var(--space-4);
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.3;
      color: var(--text-normal);
      background: var(--background-secondary);
      border: 1px solid var(--border-color);
      border-radius: 999px;
      text-overflow: ellipsis;
    }
    /* Accent as a signal on focus only, like the chips: never a surface fill. */
    .section-select__input:focus-visible {
      outline: 2px solid var(--text-accent);
      outline-offset: 2px;
      border-color: var(--border-active);
    }
    .section-select__chevron {
      position: absolute;
      right: var(--space-4);
      top: 50%;
      translate: 0 -50%;
      pointer-events: none;
      color: var(--text-muted);
    }
    .section-select__chevron::before {
      content: '▾';
    }
  }

  /* The sticky page strip covers the top of a panel, so an anchor jump has to
     clear it: nav + the strip. 84px, not the 44px a single row needs — at 320px
     the five tabs wrap to two rows and the strip is ~76px tall. Desktop keeps
     the value above (nav + one space step). */
  @media (max-width: 767px) {
    :global(.section-panel [id]),
    :global(.section-panel[data-panel]) {
      scroll-margin-top: calc(var(--nav-mobile-h) + 84px);
    }
  }
</style>
