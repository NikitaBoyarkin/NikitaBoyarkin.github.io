---
// Generic section dashboard: groups a page's sections into a small set of
// client-side switchable panels so a project page reads on one URL.
//
// Deliberately a sibling of about/AboutTabs.astro, not a shared component: the
// /about one has its ids ("start"), classes (.about-*) and panel ids frozen by
// tests/built/about.test.ts. This one owns the `data-section-tabs` root and the
// `.section-*` classes, so the two tab widgets on the site never collide.
//
// Contract, mirroring the /about dashboard:
//   · the tablist carries role="tablist" with one <button role="tab"> per tab;
//   · every panel is a <SectionPanel> (this directory) with data-panel;
//   · the first tab is selected and focusable server-side — the rest is
//     progressive enhancement, so there is no flash and no tab is required.
//   · no JS: a <noscript> rule reveals every panel and hides the tablist, so the
//     page degrades to the previous long-scroll layout.
//   · with JS: the inline controller below reveals one panel, wires the ARIA tab
//     pattern (click + arrows/Home/End), maps any anchor inside a panel to that
//     panel (so #heading deep-links open the right tab), reveals `.reveal`
//     nodes in the freshly shown panel, and — when `railId` points at a fixed
//     table-of-contents rail — shows that rail only while a panel marked
//     `ownsRail` is active (otherwise a hidden panel's TOC would sit over the
//     section that replaced it).
//
// Markup is untyped on purpose: a page assembles the panels as children.
interface TabDef {
  id: string;
  label: string;
  // Hash set in the URL on switch. Defaults to the tab id, which needs no
  // element of its own — the controller maps it back to the panel.
  anchor?: string;
}
interface Props {
  tabs: TabDef[];
  label: string;
  // Element id to keep in sync with the `ownsRail` panel (e.g. "inner-toc").
  railId?: string;
  // With one section the tablist is noise; the page passes this so it is not
  // rendered and its panel drops the tabpanel role.
  single?: boolean;
  // A nested dashboard (tracks inside the talks page) is a second tablist in the
  // same document: same contract, less visual weight than the page-level tabs.
  size?: 'sm';
  // Opt-in analytics: when set, every user-initiated tab activation emits
  // `tab_selected { tab, group, locale }` with this value as `group`. Left unset
  // on the project pages, whose tab switches stay uninstrumented.
  analytics?: string;
}
const {
  tabs = [],
  label,
  railId = '',
  single = false,
  size = '',
  analytics = '',
} = Astro.props;

// set:html, not a literal <style>: Astro would scope a nested style to this
// component, and the panels it must reveal live in SectionPanel.
const noScriptFallback =
  '<style>.section-panel[hidden]{display:block !important}.section-tablist{display:none !important}</style>';
---

<div class="section-tabs" class:list={[size && `section-tabs--${size}`]} data-section-tabs data-rail-id={railId} data-analytics-group={analytics || undefined}>
  <div class="section-tablist" role="tablist" aria-label={label} {...(single ? { hidden: true } : {})}>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          class="section-tab"
          id={`tab-${tab.id}`}
          data-tab={tab.id}
          data-anchor={tab.anchor ?? tab.id}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="section-panels">
    <slot />
  </div>

  <noscript set:html={noScriptFallback} />

  <script is:inline>
    (function () {
      // One controller per root, because a page may nest a second dashboard
      // inside a panel of the first (/talks/ does: tracks inside the tracks
      // panel). `closest` keeps each root to its own tabs and its own panels —
      // a nested panel belongs to the inner root, not to the outer one.
      function init(root) {
        function owned(selector) {
          return Array.prototype.filter.call(root.querySelectorAll(selector), function (el) {
            return el.closest('[data-section-tabs]') === root;
          });
        }

        var tabs = owned('[role="tab"]');
        var panels = owned('[data-panel]');
        if (!panels.length) return;

        var railId = root.getAttribute('data-rail-id') || '';
        var rail = railId ? document.getElementById(railId) : null;
        var first = panels[0].getAttribute('data-panel');

        // Anchor id -> panel id. Derived from the DOM, so a new heading inside a
        // panel (or a new panel) needs no change here.
        var anchors = {};
        panels.forEach(function (panel) {
          var id = panel.getAttribute('data-panel');
          anchors[id] = id;
          Array.prototype.forEach.call(panel.querySelectorAll('[id],[data-panel]'), function (el) {
            if (el.id) anchors[el.id] = id;
            // A nested dashboard's tab ids (`#avito`) exist only as its panels'
            // `data-panel`, so without this line a shared /talks/#avito falls
            // back to the first page tab instead of opening the tracks panel.
            var nested = el.getAttribute('data-panel');
            if (nested) anchors[nested] = id;
          });
        });

        function fromHash() {
          var hash = (location.hash || '').replace(/^#/, '');
          return anchors[hash] || first;
        }

        function activate(id, focus) {
          if (!id) id = first;
          var ownsRail = false;
          panels.forEach(function (panel) {
            var on = panel.getAttribute('data-panel') === id;
            panel.hidden = !on;
            if (on) {
              if (panel.hasAttribute('data-owns-rail')) ownsRail = true;
              // `.reveal` nodes start at opacity 0; an IntersectionObserver cannot
              // see a panel that was display:none at parse time, so reveal them
              // here or a switched-to panel (charts, graph) stays blank.
              Array.prototype.forEach.call(panel.querySelectorAll('.reveal'), function (el) {
                el.classList.add('visible');
              });
              // A nested dashboard in this panel centred its selected tab while
              // the panel had no layout, so the centring was a no-op. Redo it now
              // that the strip has a width.
              Array.prototype.forEach.call(panel.querySelectorAll('[data-section-tabs]'), function (nested) {
                var selTab = nested.querySelector('[role="tab"][aria-selected="true"]');
                if (selTab) revealTab(selTab);
              });
            }
          });
          tabs.forEach(function (tab) {
            var on = tab.dataset.tab === id;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            if (on) revealTab(tab);
            if (on && focus) tab.focus();
          });
          // The fixed TOC rail belongs to the case-study panel: hide it with the
          // panel it describes, or its links scroll to headings nobody can see.
          if (rail) rail.hidden = !ownsRail;
          root.setAttribute('data-active', id);
        }

        // On a phone the tablist is one horizontal strip, so the selected tab can
        // sit outside the scrollport. Centre it there by moving the strip's own
        // scrollLeft: `scrollIntoView` would also move the document, undoing the
        // jump the reader just made.
        function revealTab(tab) {
          var list = tab.parentElement;
          if (!list || list.scrollWidth <= list.clientWidth) return;
          var listBox = list.getBoundingClientRect();
          var tabBox = tab.getBoundingClientRect();
          var left = list.scrollLeft + (tabBox.left - listBox.left) - (list.clientWidth - tabBox.width) / 2;
          list.scrollLeft = Math.max(0, Math.min(left, list.scrollWidth - list.clientWidth));
        }

        function scrollToAnchor(id) {
          if (!id) return;
          // A hash may name a heading inside a panel (`#theme-ai`, `#t288`) or a
          // tab, which has no element of its own — its node is `panel-<id>`. Without
          // the fallback `#tracks` opened the right panel and left the page on top.
          var el = document.getElementById(id) || document.getElementById('panel-' + id);
          if (el) el.scrollIntoView({ block: 'start' });
        }

        function setAnchor(anchor) {
          if (anchor && location.hash !== '#' + anchor) {
            history.replaceState(null, '', '#' + anchor);
          }
        }

        var initial = (location.hash || '').replace(/^#/, '');
        activate(fromHash(), false);
        if (initial) requestAnimationFrame(function () {
          scrollToAnchor(initial);
        });

        root.addEventListener('click', function (event) {
          var tab = event.target.closest('[role="tab"]');
          if (!tab || !root.contains(tab) || tabs.indexOf(tab) < 0) return;
          event.preventDefault();
          activate(tab.dataset.tab, false);
          setAnchor(tab.dataset.anchor);
        });

        root.addEventListener('keydown', function (event) {
          var tab = event.target.closest('[role="tab"]');
          if (!tab) return;
          var i = tabs.indexOf(tab);
          if (i < 0) return;
          var n = -1;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') n = (i + 1) % tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') n = 0;
          else if (event.key === 'End') n = tabs.length - 1;
          else return;
          event.preventDefault();
          var next = tabs[n];
          activate(next.dataset.tab, true);
          setAnchor(next.dataset.anchor);
        });

        window.addEventListener('hashchange', function () {
          var hash = (location.hash || '').replace(/^#/, '');
          activate(fromHash(), false);
          scrollToAnchor(hash);
        });
      }

      // This script is emitted once per mounted instance, so /talks/ ships it
      // twice (page-level dashboard + nested tracks one). Wait for the whole
      // document, then let the first copy initialise every root and mark it —
      // otherwise the inner copy would build the outer root's anchor map from a
      // half-parsed DOM and register a second set of listeners.
      function boot() {
        Array.prototype.forEach.call(document.querySelectorAll('[data-section-tabs]'), function (root) {
          if (root.dataset.sectionTabsReady) return;
          root.dataset.sectionTabsReady = '1';
          init(root);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>
</div>

<style>
  .section-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0 0 var(--space-4);
    border-bottom: 1px solid var(--border-color);
  }
  /* Segmented control, matching .filter-tag / .about-tab: muted at rest, accent
     as a signal only (text + border + underline), never as a surface fill. */
  .section-tab {
    appearance: none;
    cursor: pointer;
    position: relative;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .section-tab:hover {
    color: var(--text-accent);
    border-color: var(--border-active);
  }
  .section-tab[aria-selected='true'] {
    color: var(--text-accent);
    border-color: var(--border-active);
    background: color-mix(in srgb, var(--text-accent) 8%, transparent);
  }
  /* Non-color cue (WCAG 1.4.1): the selected tab keeps a shape change, so the
     state is not signalled by hue alone. */
  .section-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: calc(var(--space-4) * -1 - 1px);
    height: 2px;
    background: var(--text-accent);
  }
  .section-tab:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
  /* Deep-link anchors and TOC jumps land under the sticky nav without this.
     Applies to any element with an id inside a panel, and to the panel itself:
     a hash that names a tab (`#tracks`) resolves to `panel-<id>`, which no
     descendant selector reaches. */
  :global(.section-panel [id]),
  :global(.section-panel[data-panel]) {
    scroll-margin-top: calc(var(--nav-mobile-h) + var(--space-4));
  }
  /* Nested dashboard: same pattern, one step quieter than the page-level tabs
     that contain it. */
  .section-tabs--sm .section-tablist {
    gap: var(--space-1);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
  }
  .section-tabs--sm .section-tab {
    padding: 2px var(--space-3);
    font-size: 0.82rem;
  }
  .section-tabs--sm .section-tab[aria-selected='true']::after {
    left: var(--space-2);
    right: var(--space-2);
    bottom: calc(var(--space-2) * -1 - 1px);
  }
  /* Phone: one swipeable row instead of a wrap. Twelve tracks or eleven themes
     wrapped three-to-four deep is a 200px block of chrome above every panel —
     taller than the panel's own first screen. `proximity`, not `mandatory`: the
     strip has no end padding, and mandatory snapping parks a short drag back
     where it started, so the last tab would need a second swipe to reach. */
  @media (max-width: 767px) {
    .section-tablist {
      flex-wrap: nowrap;
      gap: var(--space-1);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .section-tablist::-webkit-scrollbar {
      display: none;
    }
    .section-tab {
      flex: 0 0 auto;
      /* A track name runs to a sentence; uncapped it makes a tab wider than the
         strip, so the selected tab could never be fully on screen and the next
         one never peeked. The panel's own <h3> repeats the name in full, so the
         ellipsis costs nothing. */
      max-width: 75%;
      overflow: hidden;
      text-overflow: ellipsis;
      scroll-snap-align: start;
      white-space: nowrap;
      padding: var(--space-1) var(--space-3);
      font-size: 0.82rem;
    }
    /* The tab clips its own text for the ellipsis above, and the strip clips
       vertically — so the desktop underline, which sits outside the tab's
       padding box, vanished on a phone. Draw the non-color cue inside the
       padding box instead: same 2px rule, nothing left to clip. */
    .section-tab[aria-selected='true']::after,
    .section-tabs--sm .section-tab[aria-selected='true']::after {
      left: var(--space-2);
      right: var(--space-2);
      bottom: 0;
    }
  }
</style>
