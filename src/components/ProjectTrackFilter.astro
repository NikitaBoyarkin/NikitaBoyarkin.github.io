---
// Category (track) tabs for the projects board. Markup only — the behaviour
// (filtering, hash sync, analytics) lives in ProjectBoard's controller script,
// which owns both filters so their state stays in one place.
import { ALL_TRACKS } from '../lib/projects';
import Icon from './Icon.astro';

interface Track {
  key: string;
  label: string;
  count: number;
}

interface Props {
  lang?: 'ru' | 'en';
  tracks: Track[];
  total: number;
}

const { lang = 'ru', tracks, total } = Astro.props;
const allLabel = lang === 'en' ? 'All' : 'Все';
---

<div
  class="filter-row project-track-filter reveal reveal-delay-1"
  role="radiogroup"
  aria-label={lang === 'en' ? 'Project category' : 'Категория проектов'}
>
  <button
    class="filter-tag active"
    data-track-filter={ALL_TRACKS}
    role="radio"
    aria-checked="true"
    type="button"
  >
    <Icon name="filter" size={14} class="pill-icon" />
    {allLabel} <span class="filter-count">{total}</span>
  </button>
  {
    tracks.map((track) => (
      <button
        class="filter-tag"
        data-track-filter={track.key}
        role="radio"
        aria-checked="false"
        type="button"
      >
        <Icon name="filter" size={14} class="pill-icon" />
        {track.label} <span class="filter-count">{track.count}</span>
      </button>
    ))
  }
</div>
