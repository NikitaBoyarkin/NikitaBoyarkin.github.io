---
// The shelf. Presentational: it renders the sources it is handed and does no
// loading of its own, so the same component serves the /library/ index and the
// bento cell on the homepage without either one guessing at the other's shape.
// `src/lib/library.ts` owns the loading, the ordering and the tile path.
//
// A tile carries only verifiable facts — title, author, status, destination; the
// monogram stands in for cover art rather than fabricating it.
import type { SourceEntry } from "../lib/library";
import { KIND_LABELS, STATUS_LABELS, sourceHref, shelfHref } from "../lib/library";
import type { Lang } from "../lib/library";

interface Props {
  sources: SourceEntry[];
  lang?: Lang;
  /** Standalone /library/ page: the heading is the page <h1>, not a section <h2>. */
  standalone?: boolean;
  /** Bento cell: the host supplies its own heading and link, so render tiles only. */
  variant?: "page" | "cell";
}
const { sources, lang = "ru", standalone = false, variant = "page" } = Astro.props;
const isEn = lang === "en";
const Heading = standalone ? "h1" : "h2";
const showChrome = variant === "page";

const I18N = {
  heading: isEn ? "Library" : "Библиотека",
  lead: isEn
    ? "Books, courses and papers the methodology here is built on — and where each one landed."
    : "Книги, курсы и статьи, на которых стоит методология, — и где каждый источник применился.",
  footLabel: isEn ? "All writing" : "Все записи",
  external: isEn ? "Source" : "Источник",
};
---

<section
  id="library"
  class:list={["library", "reveal", variant === "cell" && "library-cell"]}
  aria-label={I18N.heading}
>
  {
    showChrome && (
      <>
        <Heading>{I18N.heading}</Heading>
        <p class="library-lead">{I18N.lead}</p>
      </>
    )
  }

  <ul class="library-books">
    {
      sources.map((s) => (
        <li class="book">
          <a
            class="book-tile"
            href={sourceHref(lang, s.id)}
            data-analytics="library_tile"
          >
            <span class="book-mono" aria-hidden="true">
              {s.data.mono}
            </span>
            <span class="book-info">
              <span class="book-tag">
                {KIND_LABELS[lang][s.data.kind]} · {STATUS_LABELS[lang][s.data.status]}
              </span>
              <span class="book-title">{s.data.title}</span>
              <span class="book-author">{s.data.author}</span>
            </span>
          </a>
          {s.data.url && (
            <a
              class="book-source"
              href={s.data.url}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="source_external"
            >
              {I18N.external} ↗
            </a>
          )}
        </li>
      ))
    }
  </ul>

  {
    showChrome && (
      <p class="library-foot">
        <a href={shelfHref(lang)}>{I18N.footLabel} →</a>
      </p>
    )
  }
</section>

<style>
  .library {
    margin: var(--space-16) 0;
  }
  /* Inside a bento cell the host owns the surrounding rhythm. */
  .library-cell {
    margin: 0;
  }
  .library h1,
  .library h2 {
    font-family: var(--font-display);
    font-size: var(--type-section-h2);
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-normal);
  }
  .library-lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-10);
  }

  /* A grid, not a wrapped flex row: tiles line up in columns, which is what
     makes a shelf of ten readable at a glance. */
  .library-books {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .book {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .book-tile {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--background-secondary);
    text-decoration: none;
    color: var(--text-normal);
    transition:
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .book-tile:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--text-accent) 40%, transparent);
    box-shadow: 0 14px 30px var(--shadow-color);
  }

  .book-mono {
    flex: 0 0 56px;
    height: 56px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1a1a; /* dark ink on coral accent; button ink is now white */
    background: var(--text-accent);
    border-radius: var(--radius-md, 8px);
  }
  .book-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .book-tag {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.12rem 0.5rem;
    border-radius: var(--radius-full);
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-accent) 22%, transparent);
  }
  .book-title {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .book-author {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .book-source {
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-accent);
    text-decoration: none;
  }
  .book-source:hover {
    color: var(--text-accent-hover);
    text-decoration: underline;
  }

  .library-foot {
    margin-top: var(--space-2);
  }
  .library-foot a {
    color: var(--text-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .library-foot a:hover {
    color: var(--text-accent-hover);
  }
</style>
