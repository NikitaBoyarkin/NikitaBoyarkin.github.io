---
// «Библиотека / сейчас» — book tiles built only from verifiable facts:
// DMLS is backed by the /now page (RU) ; Kohavi's "Trustworthy Online
// Controlled Experiments" is the reference behind the A/B Methodology Toolkit
// project page. Monogram tiles instead of covers — nothing fabricated.
import { withBase } from "../lib/path";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const I18N = {
  heading: isEn ? "Library" : "Библиотека",
  lead: isEn
    ? "What's on the desk and what I keep as a working reference."
    : "Что на столе и что держу как рабочий справочник.",
  footLabel: isEn ? "All writing" : "Все записи",
};

const books = [
  {
    mono: "D",
    title: "Designing Machine Learning Systems",
    author: "Chip Huyen",
    tag: isEn ? "Now reading" : "Читаю сейчас",
    href: withBase("now/"),
  },
  {
    mono: "K",
    title: "Trustworthy Online Controlled Experiments",
    author: "Ron Kohavi · Diane Tang · Ya Xu",
    tag: isEn ? "Reference" : "Справочник",
    href: withBase(isEn ? "en/projects/ab/" : "projects/ab/"),
  },
];
---

<section id="library" class="library reveal" aria-label={I18N.heading}>
  <h2>{I18N.heading}</h2>
  <p class="library-lead">{I18N.lead}</p>

  <div class="library-books">
    {
      books.map((b) => (
        <a class="book-tile" href={b.href}>
          <span class="book-mono" aria-hidden="true">{b.mono}</span>
          <span class="book-info">
            <span class="book-tag">{b.tag}</span>
            <span class="book-title">{b.title}</span>
            <span class="book-author">{b.author}</span>
          </span>
        </a>
      ))
    }
  </div>

  <p class="library-foot">
    <a href={withBase(isEn ? "en/writing/" : "writing/")}>{I18N.footLabel} →</a>
  </p>
</section>

<style>
  .library {
    margin: var(--space-16) 0;
  }
  .library h2 {
    font-family: var(--font-display);
    font-size: var(--type-section-h2);
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-normal);
  }
  .library-lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-10);
  }

  .library-books {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .book-tile {
    flex: 1 1 280px;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--background-secondary);
    text-decoration: none;
    color: var(--text-normal);
    transition:
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .book-tile:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--text-accent) 40%, transparent);
    box-shadow: 0 14px 30px var(--shadow-color);
  }

  .book-mono {
    flex: 0 0 56px;
    height: 56px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1a1a; /* dark ink on coral accent; button ink is now white */
    background: var(--text-accent);
    border-radius: var(--radius-md, 8px);
  }
  .book-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .book-tag {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.12rem 0.5rem;
    border-radius: var(--radius-full);
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-accent) 22%, transparent);
  }
  .book-title {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .book-author {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .library-foot {
    margin-top: var(--space-2);
  }
  .library-foot a {
    color: var(--text-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .library-foot a:hover {
    color: var(--text-accent-hover);
  }
</style>
