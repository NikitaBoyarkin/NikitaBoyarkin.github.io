---
// PRD v6 S2.6 — three deep case-study cards + a compressed list of the rest.
// Every headline project must have a reachable public artifact; the list keeps
// the breadth signal without repeating the three above (see HEADLINE_PROJECTS).
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';
import { PROJECT_ORDER, HEADLINE_PROJECTS, projectTracks } from '../lib/projects';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const collection = isEn ? 'projects-en' : 'projects';
const linkPrefix = isEn ? 'en/' : '';

const slugOf = (id: string) => id.replace(/\.md$/, '');
const rank = (slug: string) => {
  const i = PROJECT_ORDER.indexOf(slug);
  return i === -1 ? PROJECT_ORDER.length : i;
};

const projects = (await getCollection(collection, (p) => !p.data.draft)).sort(
  (a, b) => rank(slugOf(a.id)) - rank(slugOf(b.id)),
);
const bySlug = new Map(projects.map((p) => [slugOf(p.id), p]));
const headline = HEADLINE_PROJECTS.map((s) => bySlug.get(s)).filter(
  (p): p is (typeof projects)[number] => Boolean(p),
);
const headlineSlugs = new Set<string>(HEADLINE_PROJECTS);
const rest = projects.filter((p) => !headlineSlugs.has(slugOf(p.id)));

const tracks = new Map(projectTracks(lang).map((t) => [t.key, t.label]));

const i18n = {
  eyebrow: isEn ? 'Selected work' : 'Избранные кейсы',
  heading: isEn ? 'Three case studies' : 'Три кейса',
  intro: isEn
    ? 'Each one proves a different part of the job — experimentation, analytics engineering, product metrics. Every claim has a reachable artifact.'
    : 'Каждый доказывает свою часть работы — эксперименты, инженерию данных, продуктовые метрики. У каждого вывода есть достижимый артефакт.',
  openCase: isEn ? 'Open case' : 'Открыть кейс',
  demo: isEn ? 'Live demo' : 'Демо',
  repo: 'GitHub',
  privateNote: isEn ? 'Private repo — available on request' : 'Приватный репозиторий — доступ по запросу',
  restHeading: isEn ? 'More projects' : 'Остальные проекты',
  restLink: isEn ? 'Full catalogue' : 'Каталог проектов',
};

const demoHref = (d: string) => (d.startsWith('http') ? d : withBase(d));
const projectHref = (slug: string) => withBase(`${linkPrefix}projects/${slug}/`);
const shortLine = (p: (typeof projects)[number]) =>
  p.data.description.length > 120 ? `${p.data.description.slice(0, 117).trimEnd()}…` : p.data.description;
---

<section id="cases" class="cases reveal" aria-labelledby="cases-heading">
  <div class="cases-head">
    <p class="cases-eyebrow">{i18n.eyebrow}</p>
    <h2 id="cases-heading">{i18n.heading}</h2>
    <p class="cases-intro">{i18n.intro}</p>
  </div>

  <div class="cases-grid">
    {
      headline.map((p, i) => {
        const slug = slugOf(p.id);
        return (
          <article class="case-card">
            <a
              class="case-card-media"
              href={projectHref(slug)}
              data-analytics-project={slug} data-analytics-surface="headline"
              aria-label={p.data.title}
            >
              <img src={withBase(p.data.hero)} alt="" loading="lazy" width="600" height="200" />
              <span class="case-card-num">{String(i + 1).padStart(2, '0')}</span>
            </a>
            <div class="case-card-body">
              <span class="case-card-track">{tracks.get(p.data.track) ?? p.data.track}</span>
              <h3>
                <a href={projectHref(slug)} data-analytics-project={slug} data-analytics-surface="headline">
                  {p.data.title}
                </a>
              </h3>
              <p class="case-card-desc">{p.data.description}</p>

              <div class="case-card-actions">
                <a
                  class="case-card-open"
                  href={projectHref(slug)}
                  data-analytics-project={slug} data-analytics-surface="headline"
                >
                  {i18n.openCase} →
                </a>
                {p.data.demo && (
                  <a
                    class="case-card-chip"
                    href={demoHref(p.data.demo)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-analytics={`headline_demo_${slug}`}
                  >
                    {i18n.demo}
                  </a>
                )}
                {p.data.github && !p.data.private && (
                  <a
                    class="case-card-chip"
                    href={p.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-analytics={`headline_github_${slug}`}
                  >
                    {i18n.repo}
                  </a>
                )}
              </div>

              {p.data.private && <p class="case-card-private">{i18n.privateNote}</p>}
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="cases-rest">
    <div class="cases-rest-head">
      <h3>{i18n.restHeading}</h3>
      <a href={withBase(`${linkPrefix}projects/`)} data-analytics="headline_all_projects">
        {i18n.restLink} →
      </a>
    </div>
    <ul class="cases-rest-list">
      {
        rest.map((p) => {
          const slug = slugOf(p.id);
          return (
            <li>
              <a href={projectHref(slug)} data-analytics={`more_project_${slug}`}>
                <span class="rest-track">{tracks.get(p.data.track) ?? p.data.track}</span>
                <span class="rest-title">{p.data.title}</span>
                <span class="rest-line">{shortLine(p)}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cases {
    margin: var(--space-16) auto;
    max-width: 1100px;
    padding: 0 var(--space-5);
  }
  .cases-head {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }
  .cases-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-accent);
    margin: 0 0 var(--space-2);
  }
  .cases-head h2 {
    margin: 0 0 var(--space-3);
  }
  .cases-intro {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }
  .case-card {
    display: flex;
    flex-direction: column;
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .case-card:hover {
    border-color: var(--text-accent);
    transform: translateY(-2px);
  }
  .case-card-media {
    position: relative;
    display: block;
    background: var(--background-primary);
  }
  .case-card-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 1;
    object-fit: contain;
  }
  .case-card-num {
    position: absolute;
    top: var(--space-2);
    left: var(--space-3);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--background-primary) 80%, transparent);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-full);
  }
  .case-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1 1 auto;
  }
  .case-card-track {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-full);
  }
  .case-card-body h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .case-card-body h3 a {
    color: var(--text-normal);
    text-decoration: none;
  }
  .case-card-body h3 a:hover {
    color: var(--text-accent);
  }
  .case-card-desc {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
    font-size: 0.92rem;
  }
  .case-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
  }
  .case-card-open {
    font-weight: 600;
    color: var(--text-accent);
    text-decoration: none;
  }
  .case-card-open:hover {
    color: var(--text-accent-hover);
  }
  .case-card-chip {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
  }
  .case-card-chip:hover {
    color: var(--text-normal);
    border-color: var(--text-accent);
  }
  .case-card-private {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.85;
  }

  .cases-rest {
    margin-top: var(--space-10);
  }
  .cases-rest-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .cases-rest-head h3 {
    margin: 0;
    font-size: 1rem;
  }
  .cases-rest-head a {
    font-size: 0.85rem;
    color: var(--text-accent);
    text-decoration: none;
  }
  .cases-rest-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-color);
  }
  .cases-rest-list li {
    border-bottom: 1px solid var(--border-color);
  }
  .cases-rest-list a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 14rem) 1fr;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .cases-rest-list a:hover {
    background: color-mix(in srgb, var(--text-accent) 6%, transparent);
  }
  .rest-track {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rest-title {
    color: var(--text-normal);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .rest-line {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .cases-rest-list a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
