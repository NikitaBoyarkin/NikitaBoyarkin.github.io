---
import { withBase } from '../lib/path';
import { formatDate } from '../lib/date';
import { categoryLabel } from '../lib/categories';

interface Props {
  slug: string;
  title: string;
  category: string;
  date: Date;
  excerpt: string;
  updated?: Date;
  readTime?: number;
  lang?: 'ru' | 'en';
  /**
   * On the writing index the category badge is a filter control: it renders as
   * a real <button> wired to BlogFilter's `[data-card-category]` handler. The
   * card itself is an <article> whose title link stretches over it, so the
   * badge is never an interactive element nested inside an anchor. Everywhere
   * else it stays a decorative <span>.
   */
  filterableTag?: boolean;
}

const {
  slug,
  title,
  category,
  date,
  excerpt,
  updated,
  readTime,
  lang = 'ru',
  filterableTag = false,
} = Astro.props;
const minLabel = lang === 'en' ? 'min' : 'мин';
// EN posts live at /en/posts/<slug>/ (their own collection); RU at /posts/<slug>/.
const postHref = lang === 'en' ? withBase(`en/posts/${slug}/`) : withBase(`posts/${slug}/`);
const updatedText = updated
  ? lang === 'en'
    ? `updated ${formatDate(updated)}`
    : `обновлено ${formatDate(updated)}`
  : null;
const tagLabel = categoryLabel(category, lang);
---

<article class="blog-card" data-category={category}>
  {/* The cover is gone (2026-10-14): the card is a text entry now. The per-post
      banner stays in the repo and in `og:image` on the post itself — it was only
      ever a 140px strip here, duplicating a title that is already a link two
      lines below it, and it made the index pay for 10 image requests per page. */}
  <div class="blog-card-body">
    {
      filterableTag ? (
        <button class="blog-card-tag" type="button" data-card-category={category}>
          {tagLabel}
        </button>
      ) : (
        <span class="blog-card-tag">{tagLabel}</span>
      )
    }
    <a class="blog-card-link blog-card-title" href={postHref}>{title}</a>
    <div class="blog-card-meta">
      {formatDate(date)}{readTime ? ` · ${readTime} ${minLabel}` : ''}
    </div>
    {
      updatedText && (
        <span class="blog-card-updated" aria-label={updatedText}>
          {updatedText}
        </span>
      )
    }
    <div class="blog-card-excerpt">{excerpt}</div>
  </div>
</article>
