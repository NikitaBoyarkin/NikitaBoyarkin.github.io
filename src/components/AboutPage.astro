---
// Shell for /about. The body copy lives in src/content/about/{ru,en}.mdx so it
// is editable without touching this file.
//
// Contract kept by tests/built/about.test.ts: the 7 redirects in
// astro.config.mjs point at #who / #work / #now / #start, and Analytics.astro
// observes [data-analytics-section] to emit `section_viewed`. Do not rename an
// anchor or drop a data-analytics-section without updating that test.
//
// Numbers are never typed anywhere: CareerSnapshot and HeroMetrics both read
// src/lib/metrics.ts (CV-authoritative), so the strip, the bullets and the OG
// banners cannot drift apart.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import AskMe from './AskMe.astro';
import CareerSnapshot from './CareerSnapshot.astro';
import GithubActivity from './GithubActivity.astro';
import HeroMetrics from './HeroMetrics.astro';
import TelegramCta from './about/TelegramCta.astro';
import ValueOffers from './about/ValueOffers.astro';
import { withBase } from '../lib/path';

interface Props {
  entry: CollectionEntry<'about'>;
}
const { entry } = Astro.props;
const lang = entry.data.lang;
const isEn = lang === 'en';

// Rendered here, not in the pages: `components` resolves the MDX tags
// (<HeroMetrics /> etc.) so the .mdx files import nothing.
const { Content } = await render(entry);
---

<section class="container container-content reveal about-body">
  <header class="about-head">
    <img
      class="about-portrait"
      src={withBase('images/00_profile.webp')}
      alt={isEn ? 'Nikita Boyarkin' : 'Никита Бояркин'}
      width="96"
      height="115"
      loading="lazy"
      decoding="async"
    />
    <div>
      <h1>{isEn ? 'About Me' : 'Обо мне'}</h1>
      <p class="about-sub">Data Analyst / Product Analyst</p>
    </div>
  </header>

  <Content components={{ HeroMetrics, CareerSnapshot, GithubActivity, TelegramCta, ValueOffers }} />
</section>

<style>
  /* Bento layout. HTML produced by <Content /> carries no data-astro-cid-*, so
     every rule that targets MDX output goes through `.about-body :global(...)`;
     the header is shell markup and keeps plain scoped selectors. Accent is used
     only as a signal (bars, tick, dots), never as a surface — DESIGN.md 60-30-10. */

  /* ── Hero panel ─────────────────────────────────────────────── */
  .about-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    background: var(--card-background);
    overflow: hidden;
  }
  .about-head::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--text-accent) 0%, transparent 65%);
  }
  .about-head h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.9rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  /* 1229×1469 source; the declared 96×115 keeps the intrinsic ratio so a CSS
     failure degrades to a correctly proportioned box instead of a jump. */
  .about-portrait {
    flex: none;
    width: 96px;
    height: 115px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    background: var(--background-secondary);
  }
  .about-sub {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  /* ── Jump-nav → chips ───────────────────────────────────────── */
  .about-body :global(.about-jump) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0;
    padding: 0;
    border: 0;
    background: none;
  }
  .about-body :global(.about-jump a) {
    padding: var(--space-1) var(--space-3);
    font-size: 0.8rem;
    color: var(--text-normal);
    text-decoration: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background: var(--background-secondary);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .about-body :global(.about-jump a:hover) {
    color: var(--text-accent);
    border-color: var(--border-active);
    background: color-mix(in srgb, var(--text-accent) 8%, transparent);
  }

  /* ── Section headings: Cormorant + coral tick ───────────────── */
  .about-body :global(h2) {
    margin: var(--space-10) 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 4px solid var(--text-accent);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem);
    letter-spacing: -0.01em;
  }

  /* ── Prose rhythm (DESIGN.md: 65ch, 1.05rem) ────────────────── */
  .about-body :global(p) {
    max-width: 65ch;
    margin: var(--space-3) 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .about-body :global(.now-updated) {
    margin: calc(var(--space-4) * -1 + var(--space-2)) 0 var(--space-3);
    color: var(--text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .about-body :global(.now-reading) {
    color: var(--text-muted);
    font-style: italic;
  }
  .about-body :global(.wwm-sub) {
    margin-top: calc(var(--space-4) * -1);
    color: var(--text-muted);
  }

  /* ── Location list → panel with coral dots ──────────────────── */
  .about-body :global(.location-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0;
    padding: var(--space-5);
    color: var(--text-muted);
    line-height: 1.5;
    list-style: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--card-background);
  }
  .about-body :global(.location-list li) {
    padding-left: var(--space-4);
    border-left: 2px solid color-mix(in srgb, var(--text-accent) 55%, transparent);
  }

  /* ── Bento grid: the five "how to work with me" cards ───────── */
  .about-body :global(.bento-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }
  .about-body :global(.bento-grid .wwm-block) {
    position: relative;
    margin: 0;
    max-width: none;
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--card-background);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .about-body :global(.bento-grid .wwm-block)::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--text-accent);
  }
  .about-body :global(.bento-grid .wwm-block:hover) {
    transform: translateY(-3px);
    border-color: var(--border-active);
    box-shadow: 0 10px 24px var(--shadow-color);
  }
  .about-body :global(.wwm-block h3) {
    margin: 0 0 var(--space-3);
    font-size: 1rem;
    letter-spacing: 0.01em;
  }
  .about-body :global(.wwm-block ul) {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* ── Stack: auto-fit cards ──────────────────────────────────── */
  .about-body :global(.stack-groups) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--space-4);
  }
  /* global.css:1208 lays .stack-group out as an inline label+chips row for a
     bento cell; a card needs the label stacked above the chips instead. */
  .about-body :global(.stack-group) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--background-secondary);
  }
  /* .skills only has a scoped rule under `.intro-content`; here it needs its
     own wrap so chips flow instead of collapsing to one line. */
  .about-body :global(.stack-group .skills) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .about-body :global(.stack-group h3) {
    margin: 0 0 var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about-body :global(.about-links) {
    line-height: 2.2;
  }

  @media (max-width: 640px) {
    .about-head {
      gap: var(--space-4);
      padding: var(--space-4);
    }
    .about-portrait {
      width: 72px;
      height: 86px;
    }
    .about-head h1 {
      font-size: 1.7rem;
    }
    .about-body :global(.bento-grid),
    .about-body :global(.stack-groups) {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- AI-ассистент «Спроси меня» (static, client-side) -->
<AskMe lang={lang} />
