---
// Inline language switcher. Renders only when a counterpart URL is provided.
// `counterpartHref` must already be base-path-aware (withBase'd) and point to
// the same page in the OTHER locale.
interface Props {
  locale: 'ru' | 'en';
  counterpartHref: string;
}
const { locale, counterpartHref } = Astro.props;
const ruActive = locale === 'ru';
const ariaLabel = ruActive ? 'Переключатель языка' : 'Language switcher';
---

<span class="lang-switch" role="group" aria-label={ariaLabel}>
  {ruActive ? <b aria-current="true">RU</b> : <a href={counterpartHref} hreflang="ru" data-analytics="lang_switch_ru">RU</a>}
  <span class="lang-switch-sep" aria-hidden="true">/</span>
  {ruActive ? <a href={counterpartHref} hreflang="en" data-analytics="lang_switch_en">EN</a> : <b aria-current="true">EN</b>}
</span>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .lang-switch a {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.1rem 0.2rem;
    border-radius: 4px;
  }
  .lang-switch a:hover {
    color: var(--text-normal);
    background: var(--background-secondary);
  }
  .lang-switch b {
    color: var(--text-normal);
    padding: 0.1rem 0.2rem;
  }
  .lang-switch-sep {
    opacity: 0.5;
  }
  /* RU and EN sit 25×24 apart; on a phone the two are one thumb-width and the
     inactive one is the only target, so a tap that misses does nothing at all. */
  @media (pointer: coarse) {
    .lang-switch a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>

<script>
  // Language on this site is URL-based (/ vs /en/), so a page outside the paired
  // routes — public/repo-audit/ — has nothing to read the choice from. Record it
  // on the switch itself; the audit pages read `siteLang` and fall back to
  // `navigator.language`. Written on click only: landing on a shared link is not
  // a choice.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '.lang-switch a[hreflang]',
  )) {
    link.addEventListener('click', () => {
      const lang = link.getAttribute('hreflang');
      if (lang !== 'ru' && lang !== 'en') return;
      try {
        localStorage.setItem('siteLang', lang);
      } catch {
        // Storage blocked (private mode / quota): the audit page falls back to
        // the browser language, which is the same answer for most visitors.
      }
    });
  }
</script>
