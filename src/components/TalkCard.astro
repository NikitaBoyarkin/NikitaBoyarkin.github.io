---
// The talk card: one <dialog> for the whole programme, filled in the browser
// from a JSON island. 91 talks are too many for 91 server-rendered dialogs, and
// a detail route per talk would add 182 thin pages; the payload is the same
// data the tracks panel already prints, in programme order, so prev/next is an
// array index.
//
// Without JS the links stay `#t<id>` and land on the talk's own list entry —
// nothing is lost, the card is an enhancement.
//
// The island escapes `<`, so a title containing `</script>` cannot close it
// early.
import type { TalksCopy } from '../lib/talks-copy';
import type { TalkCardItem } from '../lib/talk-cards';

interface Props {
  copy: TalksCopy;
  cards: TalkCardItem[];
}

const { copy, cards } = Astro.props as Props;
const payload = JSON.stringify(cards).replace(/</g, '\\u003c');
---

<dialog class="talk-card" id="talk-card" aria-labelledby="talk-card-title">
  <div class="talk-card__box">
    <button type="button" class="talk-card__close" data-talk-card-close aria-label={copy.cardClose}>
      ×
    </button>
    <p class="talk-card__eyebrow" data-talk-card-when></p>
    <h2 class="talk-card__title" id="talk-card-title" data-talk-card-title aria-live="polite"></h2>
    <dl class="talk-card__facts">
      <dt>{copy.cardTime}</dt><dd data-talk-card-time></dd>
      <dt>{copy.cardHall}</dt><dd data-talk-card-hall></dd>
      <dt>{copy.cardTrack}</dt><dd data-talk-card-track></dd>
      <dt>{copy.cardLectors}</dt><dd data-talk-card-lectors></dd>
    </dl>
    <p class="talk-card__short" data-talk-card-short></p>
    <ul class="talk-card__themes" data-talk-card-themes aria-label={copy.cardThemes}></ul>
    <div class="talk-card__related" data-talk-card-related-box hidden>
      <h3 class="talk-card__related-title">{copy.cardRelated}</h3>
      <ul class="talk-card__related-list" data-talk-card-related aria-label={copy.cardRelated}></ul>
    </div>
    <div class="talk-card__nav">
      <button type="button" class="talk-card__step" data-talk-card-prev>{copy.cardPrev}</button>
      <button type="button" class="talk-card__step" data-talk-card-next>{copy.cardNext}</button>
    </div>
  </div>
</dialog>

<script type="application/json" id="talk-cards-data" is:inline set:html={payload} />

<script is:inline>
  (function () {
    var dialog = document.getElementById('talk-card');
    var island = document.getElementById('talk-cards-data');
    // `showModal` is the whole enhancement; without it the links keep working.
    if (!dialog || !island || typeof dialog.showModal !== 'function') return;

    var cards;
    try {
      cards = JSON.parse(island.textContent || '[]');
    } catch (error) {
      return;
    }
    if (!cards.length) return;

    var index = {};
    cards.forEach(function (card, i) {
      index[card.id] = i;
    });

    var el = {
      when: dialog.querySelector('[data-talk-card-when]'),
      title: dialog.querySelector('[data-talk-card-title]'),
      time: dialog.querySelector('[data-talk-card-time]'),
      hall: dialog.querySelector('[data-talk-card-hall]'),
      track: dialog.querySelector('[data-talk-card-track]'),
      lectors: dialog.querySelector('[data-talk-card-lectors]'),
      short: dialog.querySelector('[data-talk-card-short]'),
      themes: dialog.querySelector('[data-talk-card-themes]'),
      related: dialog.querySelector('[data-talk-card-related]'),
      relatedBox: dialog.querySelector('[data-talk-card-related-box]'),
      prev: dialog.querySelector('[data-talk-card-prev]'),
      next: dialog.querySelector('[data-talk-card-next]'),
    };

    var current = -1;
    var opener = null;
    // The hash the reader was on before the card took it over. Closing puts it
    // back, so a card opened from the theme tables does not leave `#t277` behind
    // and silently reopen itself (on the Треки panel) on the next reload.
    var prevHash = '';

    function show(i) {
      var card = cards[i];
      current = i;
      el.when.textContent = card.day;
      el.title.textContent = card.title;
      el.time.textContent = card.time;
      el.hall.textContent = card.hall;
      el.track.textContent = card.track || '—';
      el.lectors.textContent =
        card.lectors
          .map(function (lector) {
            return lector.role ? lector.name + ' — ' + lector.role : lector.name;
          })
          .join(', ') || '—';
      el.short.textContent = card.short;
      el.short.hidden = !card.short;
      el.themes.textContent = '';
      card.themes.forEach(function (theme) {
        var item = document.createElement('li');
        item.textContent = theme.label;
        el.themes.appendChild(item);
      });
      // Related talks: the island carries ids + reasons only, so the title is
      // resolved from the cards array. The links stay `#t<id>`, which the
      // document delegate below already turns into "open that talk's card".
      el.related.textContent = '';
      var related = card.related || [];
      related.forEach(function (rel) {
        var target = cards[index[rel.id]];
        if (!target) return;
        var item = document.createElement('li');
        var link = document.createElement('a');
        link.href = '#t' + rel.id;
        link.textContent = target.title;
        item.appendChild(link);
        if (rel.why) {
          var why = document.createElement('span');
          why.className = 'talk-card__related-why';
          why.textContent = rel.why;
          item.appendChild(why);
        }
        el.related.appendChild(item);
      });
      el.relatedBox.hidden = related.length === 0;
      el.prev.disabled = i === 0;
      el.next.disabled = i === cards.length - 1;
      // The hash stays a real deep link: #t277 is shareable and reopens the card.
      history.replaceState(null, '', '#t' + card.id);
    }

    function open(id, trigger) {
      var i = index[id];
      if (i === undefined) return false;
      opener = trigger || null;
      if (!dialog.open) prevHash = location.hash;
      show(i);
      if (!dialog.open) dialog.showModal();
      return true;
    }

    function fromHash() {
      var match = (location.hash || '').match(/^#t(\d+)$/);
      if (match) open(match[1], null);
    }

    // Every talk link on the page — programme rows, track lists, theme tables —
    // is `…/talks/#t<id>`. The trailing-digits test keeps #theme-* and
    // #track-* out: they both start with "#t".
    document.addEventListener('click', function (event) {
      // Cmd/Ctrl/Shift/middle-click keeps its native meaning: open the talk
      // page in a new tab instead of hijacking it into the modal.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      var link = event.target.closest ? event.target.closest('a[href]') : null;
      if (!link) return;
      var match = (link.getAttribute('href') || '').match(/#t(\d+)$/);
      if (!match) return;
      if (!open(match[1], link)) return;
      event.preventDefault();
    });

    dialog.querySelector('[data-talk-card-close]').addEventListener('click', function () {
      dialog.close();
    });
    dialog.addEventListener('click', function (event) {
      // The `::backdrop` is a child of <dialog>, so a backdrop click targets the
      // dialog itself — and so does a click on the card's own padding, which now
      // carries the safe-area inset. Only a point outside the card's box is a
      // backdrop click. `detail === 0` is a scripted/keyboard click; it never
      // means "I tapped outside".
      if (event.target !== dialog || event.detail === 0) return;
      var rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      ) {
        dialog.close();
      }
    });
    dialog.addEventListener('close', function () {
      history.replaceState(null, '', location.pathname + location.search + prevHash);
      if (opener && opener.focus) opener.focus();
      opener = null;
    });
    el.prev.addEventListener('click', function () {
      if (current > 0) show(current - 1);
    });
    el.next.addEventListener('click', function () {
      if (current < cards.length - 1) show(current + 1);
    });

    fromHash();
    window.addEventListener('hashchange', fromHash);
  })();
</script>

<style>
  .talk-card {
    /* `* { margin: 0 }` in global.css beats the UA `dialog { margin: auto }`,
       so the modal pinned itself to the top-left corner. Both properties are
       restated here: `inset: 0` + `margin: auto` is what centers a modal. */
    position: fixed;
    inset: 0;
    margin: auto;
    /* Never wider than the viewport: `inset: 0` sizes the frame, the width
       just has to stay inside it at 320px. */
    width: min(640px, calc(100vw - 2 * var(--space-4)));
    /* `vh` first, then `dvh`: on a phone `vh` is the viewport with the browser
       toolbars hidden, so 85vh put the card's bottom edge under the toolbar.
       `dvh` follows the visible strip; the 780px cap keeps a tall card from
       becoming a full-page sheet on a tablet. */
    max-height: 92vh;
    max-height: min(92dvh, 780px);
    /* The dialog is the frame, not the scroller: it clips, `.talk-card__box`
       scrolls (below). `visible` here would let the sticky close button drift
       out over the rounded corners. */
    overflow: hidden;
    /* The card's own inset plus the notch / home-indicator strip. This padding
       sits on the NON-scrolling element, so the safe area cannot scroll away
       from under the close button or the prev/next row. */
    padding: max(var(--space-4), env(safe-area-inset-top))
      max(var(--space-4), env(safe-area-inset-right))
      max(var(--space-4), env(safe-area-inset-bottom))
      max(var(--space-4), env(safe-area-inset-left));
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--card-background);
    color: var(--text-normal);
    font-family: var(--font-sans);
  }
  /* Only while open: the UA hides a closed dialog with
     `dialog:not([open]) { display: none }`, and an unconditional author
     `display` would beat it and leave an empty open-looking card on the page. */
  .talk-card[open] {
    display: flex;
    flex-direction: column;
  }
  .talk-card::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  .talk-card__box {
    position: relative;
    /* The one scroll container of the card. The dialog frame does not scroll;
       this box does, and its two sticky children (close at the top, nav at the
       bottom) stay on screen however long the talk body is. */
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    /* Without this the flex item refuses to shrink below its content, the
       dialog overflows its own max-height and the nav row ends up off-screen. */
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* A focused related-talk link must not scroll up under the sticky close. */
    scroll-padding-top: calc(44px + var(--space-2));
  }
  /* Chrome makes a scrollable region keyboard-focusable, so the body box takes
     the UA's bright blue `outline: auto` ring on open — and after a tap it reads
     as a red frame around the content, indistinguishable from an error state.
     The box is a container, not a control: its close and prev/next buttons carry
     their own focus rings, so the container draws none in either state. */
  .talk-card__box:focus,
  .talk-card__box:focus-visible {
    outline: none;
  }
  /* 44 px hit area: the × glyph is 1.25rem, the box is the target (DESIGN.md).
     Sticky, not absolute: the body scrolls, and an absolute control scrolled
     away with the content. `flex: none` keeps the 44×44 box from being
     squeezed by the column, and the opaque background stops the title/body
     from reading through it while it is stuck. The box is already exactly
     44×44, so no `::after` hit pad is needed. It stays the first focusable
     element in the dialog. */
  .talk-card__close {
    position: sticky;
    top: 0;
    z-index: 1;
    align-self: flex-end;
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text-muted);
    background: var(--card-background);
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .talk-card__close:hover,
  .talk-card__close:focus-visible {
    color: var(--text-accent);
  }
  .talk-card__eyebrow {
    margin: 0 0 4px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .talk-card__title {
    /* The 1.25rem right inset used to reserve room for the absolute close
       button; the close is now in flow above the title, so the title gets the
       full width at 320px. */
    margin: 0 0 var(--space-3);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .talk-card__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px var(--space-3);
    margin: 0 0 var(--space-3);
    font-size: 0.85rem;
  }
  .talk-card__facts dt {
    color: var(--text-muted);
  }
  .talk-card__facts dd {
    margin: 0;
  }
  .talk-card__short {
    margin: 0 0 var(--space-3);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .talk-card__themes {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  /* The chips are created in the browser, so they carry no Astro scope
     attribute — a scoped selector would never match them. */
  :global(.talk-card__themes li) {
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 1px 8px;
  }
  /* Related talks: same rule as the themes — the list is built in the browser. */
  .talk-card__related {
    margin: 0 0 var(--space-4);
  }
  .talk-card__related-title {
    margin: 0 0 4px;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  :global(.talk-card__related-list) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 3px;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  :global(.talk-card__related-why) {
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  :global(.talk-card__related-why)::before {
    content: ' — ';
  }
  .talk-card__nav {
    /* Sticky to the bottom of the scrollport: the nav is the last row of the
       body, so on a long card it was reachable only after scrolling past every
       theme chip and related talk. The opaque background stops body text from
       reading through the buttons while it is stuck. */
    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap; /* 320 px: two long labels wrap instead of running off */
    gap: var(--space-2);
    justify-content: space-between;
    background: var(--card-background);
  }
  .talk-card__step {
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .talk-card__step:hover:not(:disabled),
  .talk-card__step:focus-visible {
    color: var(--text-accent);
    border-color: var(--border-active);
  }
  .talk-card__step:disabled {
    opacity: 0.45;
    cursor: default;
  }
  /* Thumb floor: the default step is ~33px tall, below the 44px tap target.
     Both buttons share the row evenly, so neither can be squeezed at 320px. */
  @media (pointer: coarse) {
    .talk-card__step {
      flex: 1 1 0;
      min-height: 44px;
    }
  }
</style>
