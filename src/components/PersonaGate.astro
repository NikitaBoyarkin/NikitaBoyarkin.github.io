---
// Persona gate — `/` and `/en/` (PRD §9). Hero-first: the page states what the
// owner does and offers one primary action, then the three role cards sit below
// them as a secondary fork ("prefer another way in"). No server logic, no
// redirect (Q11): a returning visitor with a stored choice still sees the gate,
// with their card highlighted and a "continue as …" line.
//
// Cards carry `data-persona` / `data-source`, deliberately NOT `data-analytics`:
// the delegated handler in `Analytics.astro` turns every `[data-analytics]` click
// into `track(kind, { path })`, which would emit `persona_selected` a second
// time with the wrong props. The component-local script below owns the event.
import { withBase } from '../lib/path';
import { PROJECT_ORDER, type Audience } from '../lib/projects';
import { CAL_BOOKING_URL } from '../lib/contact';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const t = isEn
  ? {
      h1: 'Product Analyst',
      role: 'A/B Testing & Retention',
      phd: 'PhD in work psychology — I measure behaviour and causal effects, not correlations.',
      claim:
        'I turn data into decisions: which fix to ship, whom to win back, where the hypothesis did not hold.',
      book: 'Book 30 minutes',
      lead: 'Prefer another way in? Pick your entry point.',
      showAll: `Show all ${PROJECT_ORDER.length} projects →`,
      continueAs: 'Continue as',
    }
  : {
      h1: 'Продуктовый аналитик',
      role: 'A/B-тесты и retention',
      phd: 'PhD по психологии труда — измеряю поведение и причинные эффекты, а не корреляции.',
      claim: 'Считаю не отчёты, а решения: какой фикс включать, кого вернуть, где гипотеза не подтвердилась.',
      book: 'Забронировать 30 минут',
      lead: 'Удобнее иначе — выберите вход по роли',
      showAll: `Показать все ${PROJECT_ORDER.length} проектов →`,
      continueAs: 'Продолжить как',
    };

const CARDS: Array<{ role: Audience; label: string; title: string; blurb: string; cta: string }> = [
  {
    role: 'hr',
    label: isEn ? 'HR' : 'HR',
    title: isEn ? 'Hiring / recruiter' : 'HR / рекрутер',
    blurb: isEn
      ? 'Role, stack, numbers, CV — for screening against a vacancy.'
      : 'Роль, стек, метрики, CV — под скрининг по вакансии.',
    cta: isEn ? 'Screening view' : 'Версия для скрининга',
  },
  {
    role: 'manager',
    label: isEn ? 'Manager' : 'Менеджер',
    title: isEn ? 'Hiring manager' : 'Нанимающий менеджер',
    blurb: isEn
      ? 'STAR cases: the task, the decision, what changed as a result.'
      : 'Кейсы STAR: задача, решение, что изменилось в результате.',
    cta: isEn ? 'Impact view' : 'Версия про результат',
  },
  {
    role: 'colleague',
    label: isEn ? 'Colleague' : 'Коллега',
    title: isEn ? 'Analyst / engineer' : 'Коллега-аналитик',
    blurb: isEn
      ? 'How it is made: code, data, method, the knowledge graph.'
      : 'Как это сделано: код, данные, метод, граф знаний.',
    cta: isEn ? 'Everything' : 'Полная версия',
  },
];
---

<section id="intro" class="persona-gate">
  <div class="intro-container persona-gate-inner">
    <header class="persona-hero">
      <h1 class="hero-name">{t.h1}</h1>
      <p class="hero-role">{t.role}</p>
      <p class="hero-phd">{t.phd}</p>
      <p class="persona-claim">{t.claim}</p>
      <div class="persona-actions">
        <a class="button" href={CAL_BOOKING_URL} data-analytics="booking_click">{t.book}</a>
        {/* Secondary, not a rival: the same `cv_download_pdf` name the nav rail
            and the footer fire, so one event sums every CV download on the site
            and the hero does not need an event of its own. */}
        <a
          class="button button-secondary"
          href={withBase('CV-Nikita-Boyarkin.pdf')}
          download
          data-analytics="cv_download_pdf">CV</a
        >
      </div>
    </header>

    <div class="persona-fork">
      <h2 class="persona-lead">{t.lead}</h2>

      <ul class="persona-cards">
        {
          CARDS.map((card) => (
            <li>
              <a
                class="persona-card"
                href={withBase(isEn ? `en/${card.role}/` : `${card.role}/`)}
                data-persona={card.role}
                data-source="gate"
                data-continue={`${t.continueAs} ${card.label}`}
              >
                <span class="persona-card-eyebrow">{card.label}</span>
                <span class="persona-card-title">{card.title}</span>
                <span class="persona-card-blurb">{card.blurb}</span>
                <span class="persona-card-cta">{card.cta} →</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="audience-note" data-persona-continue hidden></p>

      <a class="persona-all" href={withBase(isEn ? 'en/projects/' : 'projects/')}>{t.showAll}</a>
    </div>
  </div>
</section>

<style>
  /* `#intro` is shared with the old two-column hero: it clips at 75vh and centres
     its children. The gate is a column of full-width blocks, so both must go —
     otherwise the cards are squeezed into a 492px centred column and the last
     card's CTA plus the "show all" link fall below the clip. `overflow: hidden`
     stays: it is what keeps the section's oversized hero decoration from
     widening the document. */
  #intro.persona-gate {
    max-height: none;
  }
  .persona-gate-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-6);
  }
  /* The assertion sits between the credentials and the action: it is the one
     line that says what the visitor gets, so it carries body size rather than
     the muted role/phd styling. Margin is stated outright — the element is new
     and no global `p` rule is known to reset the UA default. */
  .persona-claim {
    max-inline-size: 62ch;
    margin: var(--space-3) 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .persona-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .persona-lead {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }
  .persona-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .persona-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    block-size: 100%;
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    /* Depth from a near-flat sheen rather than a second hue: the mix endpoint
       is teal in the dark theme, so it stays at 14% and only ever tints. */
    background: linear-gradient(
      180deg,
      var(--surface-secondary),
      color-mix(in srgb, var(--surface-secondary) 86%, var(--background-secondary))
    );
    color: inherit;
    text-decoration: none;
    /* Clips the accent spine to the corner radius. */
    overflow: hidden;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  /* Accent spine. Three cards at full coral would spend the 10% accent budget
     three times over, so it rests dim and the pointed-at card carries it. */
  .persona-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    block-size: 2px;
    background: var(--border-active);
    opacity: 0.4;
    transition: opacity 0.15s ease;
  }
  .persona-card:hover,
  .persona-card:focus-visible {
    border-color: var(--border-active);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -10px var(--shadow-color);
  }
  .persona-card:hover::before,
  .persona-card:focus-visible::before {
    opacity: 1;
  }
  /* A keyboard visitor gets the same affordance as a pointer one. */
  .persona-card:focus-visible {
    outline: 2px solid var(--border-active);
    outline-offset: 2px;
  }
  /* The stored choice, applied by the script below: the returning visitor sees
     which card they already took, and it stays lit rather than only hovered.
     `.is-suggested` shares the lit state but is the *source* guess, not a
     choice — same affordance, no "continue as" line (the script gates that). */
  .persona-card.is-stored,
  .persona-card.is-suggested {
    border-color: var(--border-active);
  }
  .persona-card.is-stored::before,
  .persona-card.is-suggested::before {
    opacity: 1;
  }
  .persona-card-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .persona-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }
  .persona-card-blurb {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  /* CTA as the card's footer: a hairline separates the pitch from the action,
     and `flex: 1` on the blurb keeps the three footers on one baseline. */
  .persona-card-cta {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-color);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .persona-card:hover .persona-card-cta,
  .persona-card:focus-visible .persona-card-cta {
    color: var(--text-accent);
  }
  .persona-all {
    align-self: flex-start;
    font-size: 0.9375rem;
  }
  /* The fork is one block: the lead, its three cards and the escape hatch share
     the gap below the hero, not three separate ones. */
  .persona-fork {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .persona-card,
    .persona-card::before {
      transition: none;
    }
    .persona-card:hover,
    .persona-card:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  import { firstTouch, readAudience, track, writeAudience, type ReferrerClass } from '../lib/analytics';
  import type { Audience } from '../lib/projects';

  // Referrer → the entry most visitors from that source actually want. The
  // benchmark behind the mapping: GitHub traffic (~70 pv/30d) is analysts and
  // engineers, LinkedIn (~4) is recruiters. `google`, `other` and `direct` get
  // no hint — the hero stays neutral rather than guessing at the visitor.
  const REFERRER_ROLE: Partial<Record<ReferrerClass, Audience>> = {
    github: 'colleague',
    linkedin: 'hr',
  };

  const root = document.querySelector<HTMLElement>('.persona-gate');
  if (root) {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const stored = readAudience();
    // The visitor's own pick outranks the source guess: a returning recruiter
    // who happened to arrive from GitHub still gets `hr`. The guess only fills
    // the gap where there is no choice to honour (Q11 — neither redirects).
    const suggested = stored ? null : (REFERRER_ROLE[firstTouch().referrer_class] ?? null);
    const highlighted = stored ?? suggested;

    if (highlighted) {
      const card = root.querySelector<HTMLElement>(`[data-persona="${highlighted}"]`);
      card?.classList.add(stored ? 'is-stored' : 'is-suggested');
      const note = root.querySelector<HTMLElement>('[data-persona-continue]');
      // Only a real, stored choice gets the "continue as …" line — a source
      // guess is a suggestion, and claiming continuity the visitor never
      // chose would be a lie in the UI.
      if (note && card && stored) {
        note.hidden = false;
        note.textContent = card.dataset.continue || '';
      }
    }

    track('persona_gate_view', { lang, has_stored_choice: Boolean(stored) });

    // Exposure — the denominator of the exposure→click rate (D3). Fired once
    // per load, unconditionally: a rate whose denominator only counts some
    // views is not a rate.
    const primaryCta = root.querySelector<HTMLElement>('[data-analytics="booking_click"]');
    if (primaryCta) track('cta_exposure', { surface: 'home_hero', lang });

    // No preventDefault: the write and the capture both run before the plain
    // `<a href>` navigation commits.
    for (const card of root.querySelectorAll<HTMLElement>('[data-persona]')) {
      card.addEventListener('click', () => {
        const persona = card.dataset.persona as Audience;
        writeAudience(persona);
        track('persona_selected', { persona, lang, source: 'gate' });
      });
    }
  }
</script>
