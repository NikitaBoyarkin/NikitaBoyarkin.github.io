---
import { withBase } from '../lib/path';
import ArrowMorph from './ArrowMorph.astro';
import StarBlock from './StarBlock.astro';

interface Star {
  situation: string;
  task: string;
  action: string;
  result: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  image?: string;
  impact?: string[];
  /** STAR skeleton (D21) — when present it replaces the legacy `impact` line. */
  star?: Star;
  tools?: string[];
  github?: string;
  demo?: string;
  private?: boolean;
  linkPrefix?: string;
  lang?: 'ru' | 'en';
  /** Enable HTML5 drag on the card (kanban board reorder). */
  draggable?: boolean;
}

const { slug, title, description, image, impact, star, tools, github, demo, private: isPrivate = false, linkPrefix = '', lang = 'ru', draggable = false } = Astro.props;
const isEn = lang === 'en';
const impactText = impact?.join(', ');
const i18n = {
  impact: isEn ? 'Impact' : 'Эффект',
  view: isEn ? 'View Project' : 'Открыть проект',
  demo: isEn ? 'Live demo' : 'Демо',
  privateNote: isEn ? 'Repo is private — available on request' : 'Репозиторий приватный — доступ по запросу',
};
---

<article class="project reveal" data-tools={(tools ?? []).join(',').toLowerCase()} data-slug={slug} draggable={draggable ? 'true' : undefined} tabindex={draggable ? '0' : undefined}>
  <span class="project-grip" aria-hidden="true"><span></span><span></span><span></span></span>
  {draggable && (
    <span class="visually-hidden">
      {isEn ? ' — reorder with Arrow Up/Down' : ' — перемещение стрелками ↑/↓'}
    </span>
  )}
  {image && <img src={withBase(image)} alt={title} loading="lazy" width="600" height="200" />}
  <h3>{title}</h3>
  <p>{description}</p>

  {
    tools && tools.length > 0 && (
      <div class="project-tools">
        {tools.map((tool) => (
          <span class="project-tool">{tool}</span>
        ))}
      </div>
    )
  }

  {
    star ? (
      <StarBlock star={star} lang={lang} compact />
    ) : impactText ? (
      <p class="Impact">{i18n.impact}: {impactText}</p>
    ) : null
  }

  <div class="project-actions">
    <a class="button" href={withBase(`${linkPrefix}projects/${slug}/`)} style="flex: 1 1 auto; justify-content: center;" data-analytics-project={slug} data-analytics-surface="card">{i18n.view} <ArrowMorph /></a>
    {
      demo && (
        <a
          class="button button-demo"
          href={demo.startsWith('http') ? demo : withBase(demo)}
          target="_blank"
          rel="noopener noreferrer"
          style="flex: 1 1 auto; justify-content: center;"
          data-analytics={`project_demo_${slug}`}
        >
          {i18n.demo} <ArrowMorph />
        </a>
      )
    }
    {
      github && (
        <a
          class="button button-secondary"
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          style="flex: 1 1 auto; justify-content: center;"
          data-analytics={`project_github_${slug}`}
        >
          GitHub <ArrowMorph />
        </a>
      )
    }
  </div>

  {isPrivate && <p class="repo-private-note" style="font-size:.8rem;color:var(--text-normal);opacity:.75;margin:.5rem 0 0;">{i18n.privateNote}</p>}
</article>
