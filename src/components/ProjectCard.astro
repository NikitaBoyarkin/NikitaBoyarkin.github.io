---
import { withBase } from '../lib/path';
import type { StarPreview } from '../lib/projects';
import ArrowMorph from './ArrowMorph.astro';
import StarBlock from './StarBlock.astro';

interface Star {
  situation: string;
  task: string;
  action: string;
  result: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  image?: string;
  /** STAR skeleton — when present it replaces the card's prose (`description`). */
  star?: Star;
  impact?: string[];
  tools?: string[];
  github?: string;
  demo?: string;
  private?: boolean;
  linkPrefix?: string;
  lang?: 'ru' | 'en';
  /** Track key — the board's filter scope and the bound of a reorder drag. */
  track?: string;
  /** Localized track name, printed as the card's eyebrow badge. */
  trackLabel?: string;
  /**
   * Where the numbers come from (`synthetic` | `real` | `mixed`), from the
   * project's frontmatter. Only the non-synthetic values print a badge: the two
   * cases on real UCI rows are the strongest evidence on the site, and they used
   * to be visually identical to the twenty-five synthetic ones. Absent means
   * synthetic, and no synthetic card gets a badge — labelling the default is
   * noise, labelling the exception is information.
   */
  dataset?: 'synthetic' | 'real' | 'mixed';
  /**
   * Above-the-fold card: its cover is the LCP candidate on `/projects/`.
   * Without this every cover shipped `loading="lazy"`, including card 1, so the
   * browser deferred the one image the page is measured on.
   */
  priority?: boolean;
  /** Sphere key (business domain) — the board's third matcher. Not printed:
   *  the filter chip already names the group, and the badge line stays short. */
  sphere?: string;
  /** Publication date, ISO `YYYY-MM-DD` — the board's newest-first sort key.
   *  Not printed: the date belongs to the project page, not the teaser. */
  date?: string;
  /** Make the card reorderable. Renders `data-reorder` (styling + the grip);
   *  the board's script turns on native HTML5 drag only where the pointer is
   *  fine, and drives a long-press gesture everywhere else. */
  draggable?: boolean;
  /** Board teaser: clamps the description, the impact line and the tool chips,
   *  so a row of cards stays level. The full text lives on the project page. */
  compact?: boolean;
  /** Which STAR rows the compact teaser keeps (`result` by default); `none`
   *  leaves the card with its `description`. */
  starPreview?: StarPreview;
}

const { slug, title, description, image, star, impact, tools, github, demo, private: isPrivate = false, linkPrefix = '', lang = 'ru', track, trackLabel, sphere, date, draggable = false, compact = false, priority = false, starPreview = 'result', dataset = 'synthetic' } = Astro.props;
const isEn = lang === 'en';
const impactText = impact?.join(', ');
// The compact (board) card shows the first few tools and counts the rest, so
// the chip row is one line tall; the project page lists them all. Two, not
// three: at a ~324px card width two compound labels ("pandas / NumPy",
// "SciPy / Statsmodels") already fill the row, and a third forces a wrap.
const TOOL_LIMIT = 2;
const shownTools = compact && tools && tools.length > TOOL_LIMIT ? tools.slice(0, TOOL_LIMIT) : tools;
const hiddenTools = tools && shownTools ? tools.length - shownTools.length : 0;
const i18n = {
  impact: isEn ? 'Impact' : 'Эффект',
  view: isEn ? 'View Project' : 'Открыть проект',
  demo: isEn ? 'Live demo' : 'Демо',
  // Names the ↗ arrow on the target="_blank" links: without it the new-tab
  // behaviour is a visual-only cue (WCAG 3.2.5).
  newTab: isEn ? 'opens in a new tab' : 'открывается в новой вкладке',
  privateNote: isEn ? 'Repo is private — available on request' : 'Репозиторий приватный — доступ по запросу',
  // The badge answers the question a hiring manager asks about every number on
  // this site, before they ask it: is this real or made up? «Real data» is the
  // claim; the full provenance is one click away on the case page.
  datasetReal: isEn ? 'Real data' : 'Реальные данные',
  datasetMixed: isEn ? 'Real + synthetic' : 'Реальные + синтетика',
};
const datasetLabel = dataset === 'real' ? i18n.datasetReal : dataset === 'mixed' ? i18n.datasetMixed : null;
---

<article class={`project reveal${compact ? ' compact' : ''}`} data-tools={(tools ?? []).join(',').toLowerCase()} data-track={track} data-sphere={sphere} data-date={date} data-slug={slug} data-reorder={draggable ? 'true' : undefined} tabindex={draggable ? '0' : undefined}>
  <span class="project-grip" aria-hidden="true"><span></span><span></span><span></span></span>
  {draggable && (
    <span class="visually-hidden">
      {isEn ? ' — reorder with Arrow Up/Down' : ' — перемещение стрелками ↑/↓'}
    </span>
  )}
  {image && (
    <img
      src={withBase(image)}
      alt=""
      width={1200}
      height={600}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  )}
  <div class="project-body">
  {trackLabel || datasetLabel ? (
    <p class="project-track-badge">
      {trackLabel}
      {datasetLabel && <span class="project-dataset-badge">{datasetLabel}</span>}
    </p>
  ) : null}
  <h3>{title}</h3>

  {star && starPreview !== 'none' ? (
    <StarBlock star={star} lang={lang} compact preview={starPreview} />
  ) : (
    <p title={description}>{description}</p>
  )}

  {
    tools && tools.length > 0 && (
      <div class="project-tools">
        {shownTools?.map((tool) => (
          <span class="project-tool">{tool}</span>
        ))}
        {hiddenTools > 0 && <span class="project-tool">+{hiddenTools}</span>}
      </div>
    )
  }

  {!star && impactText && <p class="Impact">{i18n.impact}: {impactText}</p>}

  <div class="project-actions">
    <a class="button" href={withBase(`${linkPrefix}projects/${slug}/`)} aria-label={`${i18n.view}: ${title}`} data-analytics-project={slug} data-analytics-surface="card">{i18n.view} <ArrowMorph /></a>
    {
      (demo || github) && (
        <div class="project-action-links">
          {demo && (
            <a
              class="project-action-link"
              href={demo.startsWith('http') ? demo : withBase(demo)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${i18n.demo}: ${title}, ${i18n.newTab}`}
              data-analytics={`project_demo_${slug}`}
            >
              {i18n.demo} <ArrowMorph label={i18n.newTab} />
            </a>
          )}
          {github && !isPrivate && (
            <a
              class="project-action-link"
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`GitHub: ${title}`}
              data-analytics={`project_github_${slug}`}
            >
              GitHub <ArrowMorph label={i18n.newTab} />
            </a>
          )}
        </div>
      )
    }
    {compact && isPrivate && <p class="repo-private-note">{i18n.privateNote}</p>}
  </div>

  {!compact && isPrivate && <p class="repo-private-note">{i18n.privateNote}</p>}
  </div>
</article>
