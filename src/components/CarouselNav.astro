---
// Arrow + dot controls for a horizontal snap track. The track itself is styled
// in CSS and needs none of this to work; see `src/lib/carousel.ts`.
//
// Rendered `hidden` on purpose: the server cannot know whether the track
// overflows (card width and container width are viewport facts), so the module
// reveals the nav once it has measured one and hides it again on the widths
// where the same markup is a plain grid.
interface Props {
  /** Must match the track's `data-carousel-track` value. */
  track: string;
  lang?: 'ru' | 'en';
  /** Accessible name for the control group, e.g. "Статьи". */
  label: string;
}

const { track, lang = 'ru', label } = Astro.props;
const isEn = lang === 'en';
const prevLabel = isEn ? 'Scroll back' : 'Назад';
const nextLabel = isEn ? 'Scroll forward' : 'Вперёд';
---

<div class="carousel-nav" data-carousel={track} role="group" aria-label={label} hidden>
  <button class="carousel-arrow" type="button" data-carousel-prev aria-label={prevLabel}>
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
    >
  </button>
  <div class="carousel-dots" data-carousel-dots></div>
  <button class="carousel-arrow" type="button" data-carousel-next aria-label={nextLabel}>
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
    >
  </button>
</div>

<script>
  import '../lib/carousel';
</script>

<style>
  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* An author `display` beats the UA `[hidden] { display: none }` rule — the
     same trap `.blog-list[hidden]` documents in blog.css. */
  .carousel-nav[hidden],
  .carousel-dots[hidden] {
    display: none;
  }

  .carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex: none;
    padding: 0;
    border: 1px solid var(--text-muted);
    border-radius: 50%;
    background: var(--card-background);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .carousel-arrow:hover:not(:disabled) {
    color: var(--text-accent);
    border-color: var(--text-accent);
  }

  .carousel-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  /* The dots carry up to twelve targets. At 24px apart they no longer fit on one
     line beside the two 36px arrows on a 390px phone, so they wrap instead of
     pushing the row out of the viewport. */
  .carousel-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  /* The dots are built in `carousel.ts`, not rendered here, so Astro's scoping
     attribute never lands on them and a plain `.carousel-dot` selector would
     match nothing — the UA's grey button showed through instead. `:global()` is
     the supported escape inside a scoped component `<style>`; it must not be
     used in `global.css`, where the browser drops the rule.

     The visible mark stays an 8px dot, the *target* is 24x24 (WCAG 2.5.8 —
     8px dots 8px apart fail the spacing exception too, since the circles a
     scorer draws around them overlap). `box-sizing: content-box` is explicit
     because the global reset is `border-box`, which would collapse the 8px
     content box to nothing; `background-clip: content-box` paints the colour
     into that box only, and a 4px corner radius on an 8px square is a circle. */
  /* `background-color`, never the `background` shorthand: the shorthand resets
     `background-clip` to `border-box`, which painted the active dot at the full
     24px while the inactive ones stayed 8px. */
  :global(.carousel-dot) {
    box-sizing: content-box;
    width: 8px;
    height: 8px;
    padding: 8px;
    border: none;
    border-radius: 50%;
    background-color: var(--text-muted);
    background-clip: content-box;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  /* Not colour alone (WCAG 1.4.1): `--text-muted` and `--text-accent` sit
     1.14:1 apart in luminance, so a low-vision or monochrome reader sees eight
     identical dots. The active mark is 12px against the others' 8px, and the
     padding absorbs the difference so every target stays 24x24. */
  :global(.carousel-dot[aria-current='true']) {
    width: 12px;
    height: 12px;
    padding: 6px;
    background-color: var(--text-accent);
  }

  :global(.carousel-dot:focus-visible) {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }
</style>
