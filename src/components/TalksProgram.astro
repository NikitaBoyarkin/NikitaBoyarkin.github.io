---
// The programme panel of the /talks/ dashboard: every talk by day and start time,
// with an in-browser filter. Split out of TalksBoard.astro so the dashboard shell
// stays small enough for the large-file guard; it also keeps the filter's CSS and
// controller next to the markup they touch.
//
// Every row is server-rendered, so without JS the visitor gets the full programme
// and the controls simply do nothing — nothing is lost.
import type { TalksTalk } from '../lib/talks-graph';
import type { TalksCopy } from '../lib/talks-copy';
import { foundLabel } from '../lib/talks-copy';

interface Props {
  copy: TalksCopy;
  dayGroups: { id: number; name: string; date: string; talks: TalksTalk[] }[];
  unassigned: TalksTalk[];
  href: (hash: string) => string;
  label: (name: string) => string;
  title: (talk: { id: number; title: string }) => string;
  timeOf: (talk: { start: string; end: string }) => string;
  searchBlob: (talk: TalksTalk) => string;
}

const { copy, dayGroups, unassigned, href, label, title, timeOf, searchBlob } = Astro.props;
const total = dayGroups.reduce((n, d) => n + d.talks.length, 0) + unassigned.length;
---

<h2 class="talks-h2">{copy.programH2}</h2>
<p class="talks-note">{copy.programNote}</p>

<div class="talks-search" data-talks-search data-tpl={copy.foundTemplate}>
  <div class="talks-search-row">
    <label class="talks-search-label" for="talks-query">{copy.searchLabel}</label>
    <input
      id="talks-query"
      class="talks-search-input"
      type="search"
      data-talks-query
      placeholder={copy.searchPlaceholder}
      autocomplete="off"
    />
    <button type="button" class="talks-chip talks-chip-action" data-talks-reset>
      {copy.reset}
    </button>
  </div>
  <div class="talks-chips" role="group" aria-label={copy.dayFilterLabel}>
    <button type="button" class="talks-chip" data-day-filter="" aria-pressed="true">
      {copy.allDays}
    </button>
    {dayGroups.map((d) => (
      <button type="button" class="talks-chip" data-day-filter={String(d.id)} aria-pressed="false">
        {d.name} <span class="talks-chip-n">{d.talks.length}</span>
      </button>
    ))}
  </div>
  <p class="talks-found" data-talks-found aria-live="polite">
    {foundLabel(copy, total, total)}
  </p>
</div>

{
  [...dayGroups, ...(unassigned.length > 0 ? [{ id: 0, name: copy.allDays, date: '', talks: unassigned }] : [])].map((d) => (
    <section class="talks-day" data-talks-day={d.id === 0 ? '' : String(d.id)}>
      <h3 class="talks-h3">
        <span class="talks-dayname">{d.name}</span>
        <span class="talks-count" data-day-count>{d.talks.length}</span>
        {d.date && <span class="talks-daydate">{d.date}</span>}
      </h3>
      <ol class="talks-program">
        {d.talks.map((talk) => {
          // House pattern (`TalkList.astro`): join only the parts that exist.
          // The hand-assembled `{' · '}` printed «Архангельск · · Сергей Кноль»
          // for a talk without a track.
          const where = [
            talk.hall,
            talk.trackName ? label(talk.trackName) : '',
            talk.lectors.map((l) => l.name).join(', ') || copy.noLector,
          ]
            .filter(Boolean)
            .join(' · ');
          return (
            <li class="talks-row" data-talk-day={d.id === 0 ? '' : String(d.id)} data-search={searchBlob(talk)}>
              <p class="talks-row-head"><span class="talks-time">{timeOf(talk)}</span><span class="talks-where">{where}</span></p>
              <a class="talks-title" href={href(`#t${talk.id}`)}>{title(talk)}</a>
            </li>
          );
        })}
      </ol>
    </section>
  ))
}

<p class="talks-empty" data-talks-empty hidden>{copy.noResults}</p>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-talks-search]');
    if (!root) return;
    var input = root.querySelector('[data-talks-query]');
    var counter = root.querySelector('[data-talks-found]');
    var reset = root.querySelector('[data-talks-reset]');
    var empty = document.querySelector('[data-talks-empty]');
    var chips = Array.prototype.slice.call(root.querySelectorAll('[data-day-filter]'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('[data-talk-day]'));
    var days = Array.prototype.slice.call(document.querySelectorAll('[data-talks-day]'));
    var tpl = root.getAttribute('data-tpl') || '{n} / {total}';
    if (!input || !rows.length) return;

    // `ё` folds into `е` on both sides: the programme spells both ways, and a
    // search for «еще» must find «ещё».
    function norm(value) {
      return String(value || '').toLowerCase().replace(/ё/g, 'е');
    }

    var day = '';

    function setDay(next) {
      chips.forEach(function (chip) {
        chip.setAttribute('aria-pressed', chip.getAttribute('data-day-filter') === next ? 'true' : 'false');
      });
    }

    function apply() {
      var terms = norm(input.value).trim().split(/\s+/).filter(Boolean);
      var shown = 0;
      rows.forEach(function (row) {
        var hay = norm(row.getAttribute('data-search'));
        var match = terms.every(function (t) { return hay.indexOf(t) !== -1; });
        var inDay = !day || row.getAttribute('data-talk-day') === day;
        row.hidden = !(match && inDay);
        if (match && inDay) shown++;
      });
      days.forEach(function (section) {
        var n = section.querySelectorAll('[data-talk-day]:not([hidden])').length;
        section.hidden = n === 0;
        var count = section.querySelector('[data-day-count]');
        if (count) count.textContent = String(n);
      });
      if (counter) {
        counter.textContent = tpl.replace('{n}', String(shown)).replace('{total}', String(rows.length));
      }
      if (empty) empty.hidden = shown > 0;
    }

    input.addEventListener('input', apply);
    input.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      input.value = '';
      day = '';
      setDay('');
      apply();
    });

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        day = chip.getAttribute('data-day-filter') || '';
        setDay(day);
        apply();
      });
    });

    if (reset) {
      reset.addEventListener('click', function () {
        input.value = '';
        day = '';
        setDay('');
        apply();
        input.focus();
      });
    }

    apply();
  })();
</script>

<style>
  .talks-search { display: grid; gap: var(--space-2); margin: var(--space-3) 0 var(--space-4); }
  .talks-search-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .talks-search-label { font-size: 0.8rem; color: var(--text-muted); }
  /* 1rem is the iOS no-zoom floor: below 16px Safari zooms the page on focus
     and drops the visitor into a magnified panel. The basis is 12rem, not
     16.25rem, so label + field + reset chip share one line at 390px instead of
     becoming three stacked blocks; `min-width: 0` keeps it from overflowing
     at 320px. */
  .talks-search-input { flex: 1 1 12rem; min-width: 0; padding: var(--space-2) var(--space-3); font-family: var(--font-sans); font-size: 1rem; color: var(--text-normal); background: var(--background-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-md); }
  .talks-search-input:focus-visible { outline: 2px solid var(--text-accent); outline-offset: 2px; border-color: var(--border-active); }
  /* 44px is the tap-target floor for a thumb; a mouse does not need it. */
  @media (pointer: coarse) {
    .talks-search-input { min-height: 44px; }
  }
  /* `.talks-chip*` live in TalksBoard.astro's global block — global there
     because Astro cannot scope a class used by two components. */
  .talks-found { font-size: 0.8rem; color: var(--text-muted); margin: 0; font-variant-numeric: tabular-nums; }

  /* Day header as ONE line. The name used to be a bare text node inside a flex
     container, so it broke between its own words and the header read as three
     fragments («1» / «день» / chip / date). Each part is now its own
     non-breaking item. Deliberately not sticky: the page already carries the
     nav and, below 768px, the panel strip — a third stacked bar would eat half
     a phone screen. */
  .talks-dayname { white-space: nowrap; }
  .talks-daydate { font-size: 0.75rem; color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* A hairline above each row instead of a 2px left rail: the old border drew
     91 ticks down 13 phone screens and read as a timeline the programme does
     not have. One line between neighbours — so no extra grid gap on top of it
     — and the row itself is the target. */
  .talks-program { list-style: none; padding: 0; margin: var(--space-2) 0 var(--space-4); display: grid; gap: 0; }
  .talks-row {
    position: relative;
    /* Whole row taps: `.talks-title::after` covers it, so the 56px the meta
       block used to waste above the title is part of the hit area. */
    min-height: 56px;
    padding: var(--space-1) 0;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 45%, transparent);
    scroll-margin-top: calc(var(--nav-mobile-h) + var(--space-2));
    -webkit-tap-highlight-color: transparent;
  }
  .talks-row:active { background: color-mix(in srgb, var(--text-accent) 8%, transparent); }
  .talks-row:has(.talks-title:focus-visible) { outline: 2px solid var(--text-accent); outline-offset: 2px; border-radius: var(--radius-sm); }

  /* Meta on one flowing line. It was `flex-wrap: wrap` with a column gap, so
     the `where` span could not shrink below its longest word: the time was
     orphaned on line 1 and every row carried 2–3 lines (56px) of grey text
     before the title. Now it is one line at 0.75rem/1.4. */
  .talks-row-head { display: block; margin: 0 0 var(--space-1); font-size: 0.75rem; line-height: 1.4; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  /* The time is not tappable, so it does not get the accent: `--text-accent`
     is for links (global.css, «The accent is semantic, not decorative»).
     Printing it in accent made every row look like three links. */
  .talks-time { color: var(--text-normal); font-weight: 600; }
  /* Punctuation, so it lives here rather than in `copy` — and it disappears
     when `where` has nothing to print. */
  .talks-where:not(:empty)::before { content: ' · '; }

  /* The title is the content of the row, not a red link. 91 accent + underlined
     titles were a wall of red: nothing stood out, and the colour stopped
     meaning «tappable» because the non-interactive time was accent too. Not
     clamped — a truncated programme title is a lost item (43 of 91 need 3
     lines); the row reads tighter via the meta, not by cutting text. */
  .talks-title { display: block; color: var(--text-normal); text-decoration: none; font-weight: 600; font-size: 1rem; line-height: 1.35; overflow-wrap: break-word; }
  .talks-title::after { content: ''; position: absolute; inset: 0; }
  .talks-row:hover .talks-title { color: var(--text-accent); }

  .talks-day[hidden], .talks-row[hidden] { display: none; }
  .talks-empty { color: var(--text-muted); font-size: 0.9rem; margin: var(--space-3) 0; }
  .talks-empty[hidden] { display: none; }

  /* An anchor jump must clear the nav and, below 768px, the 56px panel strip
     that goes sticky there (`SectionTabs`); the old flat 80px landed the
     target under the bar. */
  /* An anchor jump must clear the nav and, below 768px, the panel strip — and
     at 320px that strip wraps to two rows (~76px), so the offset is the wider
     of the two cases rather than the 390px budget. */
  @media (max-width: 767px) {
    .talks-row { scroll-margin-top: calc(var(--nav-mobile-h) + 84px); }
  }
</style>
