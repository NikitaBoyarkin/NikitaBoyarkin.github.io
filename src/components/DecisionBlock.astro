---
// The judgement behind a case, rendered from frontmatter — not from the prose.
//
// A case study that only lists steps cannot be told apart from any other case
// study, so the four things a reader can check are pulled out of the narrative
// and put above it: the bet, the pre-declared failure bar, the option that was
// rejected and what it cost, and what happened after launch. Every field is
// optional and the block renders nothing when all four are empty — a toolkit or
// a coursework build made no product decision, and inventing one would be worse
// than showing none.
interface Rejected {
  option: string;
  why: string;
  cost: string;
}

interface Props {
  bet?: string;
  failureBar?: string;
  rejected?: Rejected[];
  retro?: string;
  lang?: 'ru' | 'en';
}

const { bet, failureBar, rejected = [], retro, lang = 'ru' } = Astro.props;
const hasDecision = Boolean(bet || failureBar || rejected.length > 0 || retro);

const t =
  lang === 'en'
    ? {
        label: 'The decision behind the case',
        bet: 'The bet',
        failure: 'What counted as failure',
        rejected: 'What was rejected',
        option: 'Option',
        why: 'Why not',
        cost: 'What it cost',
        retro: 'After launch',
      }
    : {
        label: 'Решение за кейсом',
        bet: 'Ставка',
        failure: 'Что считалось провалом',
        rejected: 'Что отклонили',
        option: 'Вариант',
        why: 'Почему нет',
        cost: 'Чем это стоило',
        retro: 'После запуска',
      };
---

{
  hasDecision && (
    <section class="decision" aria-label={t.label}>
      <p class="decision-label">{t.label}</p>
      <div class="decision-grid">
        {bet && (
          <div class="decision-cell">
            <h2 class="decision-term">{t.bet}</h2>
            <p class="decision-text">{bet}</p>
          </div>
        )}
        {failureBar && (
          <div class="decision-cell">
            <h2 class="decision-term">{t.failure}</h2>
            <p class="decision-text">{failureBar}</p>
          </div>
        )}
        {retro && (
          <div class="decision-cell">
            <h2 class="decision-term">{t.retro}</h2>
            <p class="decision-text">{retro}</p>
          </div>
        )}
        {rejected.length > 0 && (
          <div class="decision-cell decision-cell-wide">
            <h2 class="decision-term">{t.rejected}</h2>
            <ul class="decision-rejected">
              {rejected.map((item) => (
                <li>
                  <p class="decision-option">{item.option}</p>
                  <p class="decision-text">
                    <span class="decision-key">{t.why}:</span> {item.why}
                  </p>
                  <p class="decision-text">
                    <span class="decision-key">{t.cost}:</span> {item.cost}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .decision {
    margin: var(--space-6) 0 var(--space-8);
    padding: var(--space-5, 1.25rem);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background-color: var(--card-background);
  }

  .decision-label {
    margin-bottom: var(--space-4);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .decision-grid {
    display: grid;
    gap: var(--space-4);
  }

  .decision-cell-wide {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-color);
  }

  .decision-term {
    margin-bottom: 0.25rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-normal);
  }

  .decision-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .decision-rejected {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision-option {
    margin: 0 0 0.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-normal);
  }

  .decision-key {
    font-weight: 600;
    color: var(--text-normal);
  }
</style>
