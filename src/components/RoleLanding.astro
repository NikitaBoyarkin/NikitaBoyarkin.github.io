---
// Role landing — the shared body of `/hr/`, `/manager/` and `/colleague/`
// (and their `/en/` twins), PRD §8. One component, three section matrices: the
// differences are a role's curation and which optional blocks render. The route
// files stay thin wrappers so the head (`<title>`, canonical, `preloadImage`)
// and the body cannot drift.
import HeroAvatar from './HeroAvatar.astro';
import NextStep from './NextStep.astro';
import ProjectBoard from './ProjectBoard.astro';
import SectionGrid from './SectionGrid.astro';
import StackCard from './StackCard.astro';
import { ROLE_COPY, ROLE_CURATION, type Audience } from '../lib/projects';
import type { SectionKey } from '../lib/sections';

interface Props {
  role: Audience;
  lang?: 'ru' | 'en';
  /** Namespace for every id this body writes. `/hire/` renders all three bodies
   *  as sibling tab panels, so two lists would otherwise collide on `projects`. */
  idPrefix?: string;
  /** Panel headings are `<h2>` (the page owns one `<h1>`); the standalone
   *  landings were `<h1>`. */
  headingLevel?: 1 | 2;
}
const { role, lang = 'ru', idPrefix = '', headingLevel = 1 } = Astro.props;
const p = idPrefix ? `${idPrefix}-` : '';
const Heading = headingLevel === 2 ? 'h2' : 'h1';
const isEn = lang === 'en';
const copy = ROLE_COPY[lang][role];

// Only the colleague version carries the avatar. HR and the manager get the
// compact identity block: a screening reader and a hiring manager both came for
// the work, not the portrait.
const isColleague = role === 'colleague';

/** The colleague lane's five doors, in reading order: the catalogue first, then
 *  the places the method itself lives. Registry keys — an unregistered entry
 *  renders nothing rather than a dead link. */
const COLLEAGUE_SECTIONS: readonly SectionKey[] = [
  'projects',
  'demos',
  'glossary',
  'writing',
  'library',
];

const collection = isEn ? 'projects-en' : 'projects';
const linkPrefix = isEn ? 'en/' : '';

// The closing ask. Same block, three audiences: HR is asked for a vacancy, the
// manager for a task, the colleague for a conversation. The copy is the only
// difference, so it lives here instead of three separate sections.
const nextStep = {
  hr: {
    title: isEn ? 'Send the vacancy' : 'Пришлите вакансию',
    text: isEn
      ? "I'll match the requirements against the cases and say plainly where the experience is backed by numbers and where it needs an interview."
      : 'Сверю требования с кейсами и скажу прямо: где опыт подтверждается цифрами, а где его нужно проверять на интервью.',
    cta: isEn ? 'Open contacts →' : 'Открыть контакты →',
  },
  manager: {
    title: isEn ? 'Send the task' : 'Пришлите задачу',
    text: isEn
      ? "Describe the product and the question — I'll come back with an analysis plan: which metrics to look at, what data it needs, and how long it takes."
      : 'Опишите продукт и вопрос — вернусь с планом разбора: какие метрики смотреть, какие данные нужны и за какой срок.',
    cta: isEn ? 'Discuss a task →' : 'Обсудить задачу →',
  },
  colleague: {
    title: isEn ? 'Working through a similar problem?' : 'Разбираете похожую задачу?',
    text: isEn
      ? "Tell me what you're looking at — I'll swap approach and take a look at your data, no pitch."
      : 'Напишите, что смотрите, — обменяюсь подходом и посмотрю на ваши данные, без питча.',
    cta: isEn ? 'Get in touch →' : 'Написать →',
  },
}[role];

const nextStepSurface = {
  hr: 'role_hr_contact',
  manager: 'role_manager_contact',
  colleague: 'role_colleague_contact',
} as const;
---

<!-- HERO — the identity block. The colleague version adds the avatar; the
     featured-case panel that used to sit beside it was removed on 2026-11-16,
     together with the colleague lane's graph, activity strip and library cell —
     the lane now opens straight onto its section cards. -->
<section id={`${p}intro`} class="intro-section">
  <div class="intro-container">
    <div class="hero-body">
      {isColleague && <HeroAvatar lang={lang} />}
      <Heading class="hero-name">{copy.h1}</Heading>
      <p class="hero-pitch">{copy.lead}</p>

      {/* The stack mosaic is a screening signal: the HR reader matches it against
          a vacancy. The colleague lane stopped carrying it on 2026-11-16 — its
          reader now gets the section cards, which lead to the stack on /about.
          A manager reads impact and decisions (`ROLE_COPY.manager`), so
          `/manager/` opens straight from the pitch into the cases. */}
      {role === 'hr' && <StackCard lang={lang} />}
    </div>
  </div>
</section>

{/* Three readers, two shapes:
      - HR reads a board grouped by publication year: cover, track badge, title
        and the file's `description` on each card — the STAR skeleton lives on
        the case page, where the reader has committed to the case. The year
        grouping says "what shipped when" once per group. `ROLE_CURATION.hr`
        names the membership; the year groups own the order.
      - The manager reads the board, each card previewing Task → Result.
      - The colleague gets a grid of section cards (the same cards `/navigation/`
        renders), not the catalogue: that reader comes to see how the work is put
        together, and 31 rows in one lane hid the sections that carry the method —
        glossary, writing, library, demos. `COLLEAGUE_SECTIONS` fixes the five.
    Both catalogued lanes are `ProjectBoard` (different grouping axis, different
    teaser). The colleague lane left the list on 2026-11-16. */}
{role === 'manager' ? (
  <ProjectBoard
    collection={collection as 'projects' | 'projects-en'}
    linkPrefix={linkPrefix}
    slugs={ROLE_CURATION.manager}
    ordered
    starPreview="task-result"
    idPrefix={idPrefix}
  />
) : role === 'hr' ? (
  <ProjectBoard
    collection={collection as 'projects' | 'projects-en'}
    linkPrefix={linkPrefix}
    slugs={ROLE_CURATION.hr}
    ordered
    groupByYear
    starPreview="none"
    idPrefix={idPrefix}
  />
) : (
  <section id={`${p}projects`} class="reveal" aria-label={isEn ? 'Sections' : 'Разделы'}>
    <SectionGrid keys={COLLEAGUE_SECTIONS} lang={lang} />
  </section>
)}

{/* The closing ask. Before 2026-11-04 all three lanes ended on the project list
    and left the reader to find `/contact/` in the footer; the block links to
    the contact page rather than duplicating the form, so the click stays one
    instrumented hop (`contact_page_click`, surface names the lane). */}
<NextStep
  lang={lang}
  surface={nextStepSurface[role]}
  title={nextStep.title}
  text={nextStep.text}
  cta={nextStep.cta}
/>
