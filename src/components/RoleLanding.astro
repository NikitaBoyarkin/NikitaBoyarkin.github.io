---
// Role landing — the shared body of `/hr/`, `/manager/` and `/colleague/`
// (and their `/en/` twins), PRD §8. One component, three section matrices: the
// differences are a role's curation and which optional blocks render. The route
// files stay thin wrappers so the head (`<title>`, canonical, `preloadImage`)
// and the body cannot drift.
import { getCollection } from 'astro:content';
import HeroAvatar from './HeroAvatar.astro';
import GithubActivity from './GithubActivity.astro';
import KnowledgeGraph from './KnowledgeGraph.astro';
import ProjectBoard from './ProjectBoard.astro';
import ProjectList from './ProjectList.astro';
import ReadingBlock from './ReadingBlock.astro';
import RoleSwitch from './RoleSwitch.astro';
import StackCard from './StackCard.astro';
import { withBase } from '../lib/path';
import { loadFeaturedSources, shelfHref } from '../lib/library';
import { ROLE_COPY, ROLE_CURATION, type Audience } from '../lib/projects';

interface Props {
  role: Audience;
  lang?: 'ru' | 'en';
}
const { role, lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const copy = ROLE_COPY[lang][role];

// Only the colleague version carries the full editorial hero — the avatar, the
// featured case and (via the wrapper) the image preload. HR and the manager get
// the compact identity block: a screening reader and a hiring manager both came
// for the work, not the portrait.
const isColleague = role === 'colleague';

const collection = isEn ? 'projects-en' : 'projects';
const linkPrefix = isEn ? 'en/' : '';
const allProjects = await getCollection(collection, (p) => !p.data.draft);
const featured = allProjects.find((p) => p.id === 'volta') ?? allProjects[0];

const shelf = isColleague ? await loadFeaturedSources(lang, 3) : [];

const t = {
  shelfHeading: isEn ? 'Library' : 'Библиотека',
  shelfLink: isEn ? 'All sources →' : 'Все источники →',
  writing: isEn ? 'Writing' : 'Статьи',
  notes: isEn ? 'Notes' : 'Заметки',
  featuredEyebrow: isEn ? 'Featured case' : 'Избранный кейс',
  caseStudy: isEn ? 'Read the case →' : 'Разбор проекта →',
  demo: isEn ? 'Demo' : 'Демо',
};
---

<RoleSwitch role={role} lang={lang} />

<!-- HERO — editorial split on the colleague version, compact identity otherwise -->
<section id="intro">
  <div class={`intro-container ${isColleague ? 'hero-editorial' : ''}`}>
    <div class="hero-body">
      {isColleague && <HeroAvatar lang={lang} />}
      <h1 class="hero-name">{copy.h1}</h1>
      <p class="hero-pitch">{copy.lead}</p>

      {/* The stack mosaic is a screening signal — the HR reader matches it against
          a vacancy, and the colleague reader wants the toolchain. A manager reads
          impact and decisions (`ROLE_COPY.manager`), so `/manager/` opens straight
          from the pitch into the cases: the mosaic plus its "All projects →" exit
          were a detour between the promise and the proof. */}
      {role !== 'manager' && <StackCard lang={lang} />}
    </div>

    {isColleague && (
      <div class="hero-visual">
        <article class="featured-card featured-card-hero">
          {/* LCP element for the colleague landing (Lighthouse
              largest-contentful-paint-element). It is in the first viewport, so
              it must not be deferred. */}
          <img
            class="featured-card-image"
            src={withBase(featured.data.hero)}
            alt=""
            loading="eager"
            fetchpriority="high"
          />
          <div class="featured-card-body">
            <p class="featured-card-eyebrow">{t.featuredEyebrow}</p>
            <h2 class="featured-card-title">{featured.data.title}</h2>
            <p class="featured-card-description">{featured.data.description}</p>
            <div class="bento-chip-list">
              {featured.data.tools?.slice(0, 5).map((tool: string) => (
                <span class="bento-chip">{tool}</span>
              ))}
            </div>
            <div class="featured-card-actions">
              <a
                class="featured-card-link"
                href={withBase(`${linkPrefix}projects/${featured.id.replace(/\.md$/, '')}/`)}
                data-analytics="featured_project"
              >
                {t.caseStudy}
              </a>
              {featured.data.demo && (
                <a
                  class="featured-card-chip"
                  href={featured.data.demo.startsWith('http') ? featured.data.demo : withBase(featured.data.demo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_demo"
                >
                  {t.demo}
                </a>
              )}
              {featured.data.github && !featured.data.private && (
                <a
                  class="featured-card-chip"
                  href={featured.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_github"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      </div>
    )}
  </div>
</section>

{/* Two readers, two shapes:
      - HR reads a list grouped by year — a screening reader wants the timeline
        — and each row carries the full STAR skeleton (Situation → Task →
        Actions → Result), because that reader is judging the reasoning. The
        category + tool filters let that reader narrow the timeline to a vacancy:
        the stack is the screening signal, the category is the follow-up.
      - The colleague reads a flat list in the curated method-first order, each
        row one `description` line, with the same filter bar over it.
      - The manager reads the board, each card previewing Task → Result.
    The board is the manager's alone now; the list is shared by the two lanes
    that read a sequence (`ProjectList`). */}
{role === 'manager' ? (
  <ProjectBoard
    collection={collection as 'projects' | 'projects-en'}
    linkPrefix={linkPrefix}
    slugs={ROLE_CURATION.manager}
    ordered
    starPreview="task-result"
  />
) : role === 'hr' ? (
  <ProjectList
    collection={collection as 'projects' | 'projects-en'}
    linkPrefix={linkPrefix}
    filterable
  />
) : (
  <ProjectList
    collection={collection as 'projects' | 'projects-en'}
    linkPrefix={linkPrefix}
    variant="summary"
    order={ROLE_CURATION.colleague}
    filterable
  />
)}

{isColleague && (
  <>
    <KnowledgeGraph lang={lang} />
    <GithubActivity lang={lang} />

    <section id="library" class="reveal">
      <div class="bento-grid bento-spaced">
        <div class="bento-cell bento-cell-wide bento-cell-compact">
          <h2 class="bento-cell-title">{t.shelfHeading}</h2>
          <ReadingBlock sources={shelf} lang={lang} variant="cell" />
          <p class="bento-cell-link-row">
            <a class="bento-cell-link" href={shelfHref(lang)} data-analytics="bento_shelf">
              {t.shelfLink}
            </a>
            <a class="bento-cell-link" href={withBase(`${linkPrefix}writing/`)} data-analytics="bento_writing">
              {t.writing}
            </a>
            {!isEn && (
              <a class="bento-cell-link" href={withBase('notes/')} data-analytics="bento_notes">
                {t.notes}
              </a>
            )}
          </p>
        </div>
      </div>
    </section>
  </>
)}

{/* PRD §8 listed ContactForm on all three versions; no role page carries one
    now. Every reader — the screening HR, the hiring manager, the colleague —
    leaves through the footer, which owns `id="contact"` and a route to the
    contact page, so a page-level copy would only duplicate that id and stack a
    second form under the board. The form itself is untouched on `/contact/`. */}
