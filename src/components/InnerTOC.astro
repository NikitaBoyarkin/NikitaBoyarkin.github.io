---
interface Props {
  selector?: string;
  lang?: 'ru' | 'en';
}

const { selector = '#project-content', lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
---

<aside id="inner-toc" aria-label={isEn ? 'Table of contents' : 'Содержание'}>
  <div class="toc-title">{isEn ? 'On this page' : 'На этой странице'}</div>
  <ul id="inner-toc-list"></ul>
</aside>

<script is:inline define:vars={{ selector }}>
  function slugify(text) {
    return text
      .toString()
      .trim()
      .toLowerCase()
      .replace(/[\s]+/g, '-')
      .replace(/[^a-z0-9Ѐ-ӿ\-_]/g, '')
      .replace(/-+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function initTOC() {
    const tocList = document.getElementById('inner-toc-list');
    const container = document.querySelector(selector);
    const tocWrap = document.getElementById('inner-toc');
    if (!tocList || !container) return;

    const inlineList = document.getElementById('inline-toc-list');
    const inlineWrap = document.getElementById('inline-toc');

    const headers = Array.from(container.querySelectorAll('h2, h3'));
    if (!headers.length) {
      if (tocWrap) tocWrap.style.display = 'none';
      inlineWrap?.remove();
      return;
    }

    const used = new Map();
    // Seed with the build ids first: a generated slug must not claim an id a
    // later heading already owns, or the document ends up with two headings on
    // one anchor and both rail entries jump to the first.
    headers.forEach((h) => {
      if (h.id) used.set(h.id, true);
    });
    headers.forEach((h) => {
      const text = h.textContent || '';
      // The build's own id wins. Its slugger and `slugify` disagree on em
      // dashes and on author-set ids, and `InlineTOC` renders its anchors
      // against the build id — deriving a fresh slug here left rail entries
      // pointing at nothing (measured: 11 of 23 on /projects/volta/, 1 of 10 on
      // /projects/ab/).
      let id = h.id;
      if (!id) {
        const idBase = slugify(text) || 'section';
        id = idBase;
        let count = 1;
        while (used.has(id)) {
          id = `${idBase}-${count++}`;
        }
        h.id = id;
      }
      used.set(id, true);

      const li = document.createElement('li');
      li.className = h.tagName.toLowerCase() === 'h3' ? 'toc-h3' : 'toc-h2';
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.dataset.id = id;
      a.textContent = text;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // The inline block mirrors the rail off the same scan, so both lists target
    // the same heading ids and can never disagree about an anchor.
    // `InlineTOC` now renders these at build time. Fill an empty list only, or the
    // block ships a duplicate set and grows on hydration.
    if (inlineList && inlineWrap && !inlineList.children.length) {
      headers.forEach((h) => {
        const li = document.createElement('li');
        li.className = h.tagName.toLowerCase() === 'h3' ? 'toc-h3' : 'toc-h2';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent || '';
        li.appendChild(a);
        inlineList.appendChild(li);
      });
    }

    /** The reader carousel, when this body is one. Slides are flex items in a
     *  single row, so every heading shares one `offsetTop` and only the track's
     *  own scroll offset says which one the reader is looking at. Re-resolved on
     *  every call rather than cached: the same markup is a plain column at the
     *  widths where it does not overflow, and `carousel.ts` swaps the track on
     *  filter refreshes. */
    function slideTrack() {
      // Resolve from a heading that is actually inside a slide: some bodies keep
      // an h2/h3 above the track, and `headers[0]` then has no track ancestor.
      const holder = headers.find((h) => h.closest('.reader-slide')) ?? headers[0];
      const track = holder.closest('[data-carousel-track]');
      if (!track) return null;
      return track.scrollWidth - track.clientWidth > 1 ? track : null;
    }

    function updateActive() {
      const track = slideTrack();
      const pos = window.scrollY + 160;
      let current = '';
      if (track) {
        // Position, not `data-slide`: the intro block is slide 0 but sits at
        // offset 0, so slide numbering and physical order drift apart — on a
        // post whose intro is `data-slide="0"` a "slide 2" lives at 719px.
        const edge = track.scrollLeft + track.clientWidth / 2;
        const base = track.getBoundingClientRect().left - track.scrollLeft;
        for (const h of headers) {
          const slide = h.closest('.reader-slide');
          if (slide) {
            if (slide.getBoundingClientRect().left - base <= edge) current = h.id;
          } else if (h.offsetTop <= pos) {
            // A heading outside the track (the FAQ block below it) still follows
            // the page's vertical scroll.
            current = h.id;
          }
        }
      } else {
        for (const h of headers) if (h.offsetTop <= pos) current = h.id;
      }
      document.querySelectorAll('#inner-toc a').forEach((a) => {
        const isActive = a.dataset.id === current;
        a.classList.toggle('active', isActive);
        // Current-section relationship must reach AT, not just the eye (1.3.1).
        if (isActive) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    }

    updateActive();
    // Capture phase: a horizontal track's `scroll` does not bubble to `window`,
    // so the old window listener never saw the reader move between slides.
    document.addEventListener('scroll', updateActive, { passive: true, capture: true });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const onTocClick = (e) => {
      const a = e.target.closest('a');
      if (!a) return;
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      // In the carousel the horizontal axis is the one that matters, and the
      // browser's own alignment is not usable here: `scrollIntoView` scrolls
      // only far enough to make the heading *visible* (measured: a heading
      // 405px into slide 2 left the track at 719, still showing slide 1), and
      // the native hash does the same. Drive the track to the slide's own
      // offset — that is its snap position — and let the page follow.
      const track = slideTrack();
      if (track) {
        e.preventDefault();
        const behaviour = reduceMotion ? 'auto' : 'smooth';
        const slide = target.closest('.reader-slide');
        if (slide) {
          // Offset from the track, not `offsetLeft`: the slide's offsetParent is
          // `body`, so `offsetLeft` also carries the track's own x position
          // (measured 1124 here where the track-relative offset is 719).
          const left =
            slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
          track.scrollTo({ left, behavior: behaviour });
        }
        const top = window.scrollY + track.getBoundingClientRect().top - 110;
        window.scrollTo({ top: Math.max(0, top), behavior: behaviour });
        history.replaceState(null, '', `#${id}`);
      } else {
        e.preventDefault();
        const offset = 110;
        const top = window.scrollY + target.getBoundingClientRect().top - offset;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
      // Focus moves either way: keyboard/SR users must land on the section, not
      // stay "at" the TOC link (WCAG 2.4.3). `preventScroll` leaves the scroll
      // to the hash, which already knows about the track.
      target.tabIndex = -1;
      target.focus({ preventScroll: true });

      document.querySelectorAll('#inner-toc a').forEach((el) => {
        const isActive = el === a;
        el.classList.toggle('active', isActive);
        if (isActive) el.setAttribute('aria-current', 'location');
        else el.removeAttribute('aria-current');
      });

      // Below this width the rail is hidden, so the inline block is the only
      // TOC — collapse it instead of leaving it over the section just reached.
      if (inlineWrap?.open && window.matchMedia('(max-width: 1100px)').matches) {
        inlineWrap.open = false;
      }
    };

    // One handler for both lists: a jump must behave identically wherever it starts.
    tocWrap?.addEventListener('click', onTocClick);
    inlineWrap?.addEventListener('click', onTocClick);
  }

  document.addEventListener('DOMContentLoaded', initTOC);
</script>
