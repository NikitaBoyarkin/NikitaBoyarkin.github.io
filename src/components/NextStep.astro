---
// The one conversion surface *inside* `<main>`.
//
// Before this block a reader who finished a case or a post had no next step at
// all: the only `/contact/` anchor on the page was the footer, and the drawer
// button is `inert` while the drawer is closed. The audit of 2026-10-25 measured
// it: 262 `/contact/` anchors site-wide, exactly one carrying `data-analytics`.
//
// It links to `/contact/`, not to cal.com. That is the owner's decision of
// 2026-10-24, frozen by `tests/lib/persona.test.ts`: the direct booking link
// fires only from the contact page. Keeping it that way means one instrumented
// hop (`contact_page_click`, attributable to the page it was clicked on) and
// then one booking event, instead of two competing entry points.
//
// `surface` is what makes the event readable: «дочитал кейс и ушёл в контакт»
// must stay separable from a click in the header or the footer.
import { withBase } from '../lib/path';

export interface Props {
  lang: 'ru' | 'en';
  surface:
    | 'case_next_step'
    | 'post_next_step'
    | 'volta_part_next_step'
    | 'projects_index'
    | 'writing_index'
    | 'role_hr_contact'
    | 'role_manager_contact'
    | 'role_colleague_contact';
  /** The shape of the ask, not the layout. After a case the owner is looking
      for a role, and the analysis offer is the second thing, not the first.
      Until 2026-11-04 every one of the 31 cases ended on «Нужен такой же разбор
      на ваших данных?» — a freelancer's ask, which reframed the reader's
      decision from "I want this person on the team" to "I could buy a
      briefing".
      `case` asks for the conversation about a role and names the service
      second; `catalog` is the softer ask after a list of cases; `writing` is
      the same ask after a list of posts, where «кейс» would name the wrong
      thing. */
  variant?: 'case' | 'catalog' | 'writing';
  /** Role landings override the copy: the same block asks HR for a vacancy and
      a colleague for a conversation, and that is a difference in the ask, not
      in the layout. */
  title?: string;
  text?: string;
  cta?: string;
}

const {
  lang,
  surface,
  variant = 'case',
  title: titleProp,
  text: textProp,
  cta: ctaProp,
} = Astro.props;
const isEn = lang === 'en';
const href = withBase(isEn ? 'en/contact/' : 'contact/');

const copy = {
  case: {
    title: isEn ? 'Want an analyst who works like this?' : 'Нужен аналитик, который так работает?',
    text: isEn
      ? 'Tell me the role and the problems in it — I reply within a day. Need this reasoning applied to your data rather than a hire? That works too.'
      : 'Напишите, что за роль и какие в ней задачи — отвечу в течение дня. Нужен разбор на ваших данных, а не найм? Это тоже сюда.',
    cta: isEn ? 'Send a request →' : 'Оставить запрос →',
  },
  catalog: {
    title: isEn ? 'No case matches your task?' : 'Не нашли подходящий кейс?',
    text: isEn
      ? "Tell me the task — I'll point to the closest case and come back with a plan: what data it needs, what we test, and how long it takes."
      : 'Расскажите задачу — подскажу, какой разбор ближе, и вернусь с планом: какие данные нужны, что проверяем и за какой срок.',
    cta: isEn ? 'Discuss a task →' : 'Обсудить задачу →',
  },
  writing: {
    title: isEn ? "Your question isn't covered here?" : 'Не нашли нужный разбор?',
    text: isEn
      ? "Tell me what you're working through — I'll say whether there is a write-up on it, and answer the question itself either way."
      : 'Скажите, какой вопрос разбираете, — отвечу, есть ли разбор по нему, и в любом случае отвечу по существу.',
    cta: isEn ? 'Ask a question →' : 'Задать вопрос →',
  },
}[variant];

const title = titleProp ?? copy.title;
const text = textProp ?? copy.text;
const cta = ctaProp ?? copy.cta;
---

<section class="next-step reveal" aria-label={title}>
  <h2 class="next-step-title">
    {title}
  </h2>
  <p class="next-step-text">
    {text}
  </p>
  <a
    class="button next-step-cta"
    href={href}
    data-analytics="contact_page_click"
    data-analytics-surface={surface}
  >
    {cta}
  </a>
</section>

<style>
  /* The canonical card recipe (`--radius-xl`, the same radius `.project` and
     `.blog-card` carry through `--card-radius`), so this block is not a fourth
     card shape. */
  .next-step {
    margin-top: var(--space-10);
    padding: var(--space-6);
    background: var(--card-background);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
  }

  .next-step-title {
    margin: 0 0 var(--space-3);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-normal);
  }

  .next-step-text {
    margin: 0 0 var(--space-5);
    max-width: 60ch;
    font-size: var(--text-body);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .next-step-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
