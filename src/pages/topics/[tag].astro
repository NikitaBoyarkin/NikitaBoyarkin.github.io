---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';
import { TOPICS } from '../../lib/topics';

// Topic definitions + the route list both come from src/lib/topics.ts — no
// more duplicated TOPIC_MATCH / key list in this file.
export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { tag: t.key } }));
}

const { tag } = Astro.params;
const topic = TOPICS.find((t) => t.key === tag);
if (!topic) {
  return Astro.redirect(withBase('topics/'));
}

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .filter((p) => (p.data.tags ?? []).some((t) => topic.match(t)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Projects matched by topic tags appearing in slug/title/tools/description.
const needle = topic.key.replace('-', ' ');
const projects = (await getCollection('projects', (p) => !p.data.draft))
  .filter((p) => {
    const slug = p.id.replace(/\.md$/, '');
    const hay = `${slug} ${p.data.title} ${(p.data.tools ?? []).join(' ')} ${p.data.description}`.toLowerCase();
    return topic.tags.some((t) => hay.includes(t.replace('-', ' '))) || hay.includes(needle);
  });

// CollectionPage + ItemList over exactly what the page renders — the same
// projects/posts arrays, in the same order, so the markup can never list an
// item the hub does not show. Previously the hub emitted no page-level node at
// all and inherited only the site-wide WebSite, which left the pages AI search
// is most likely to cite without a machine-readable item list.
const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const topicUrl = `${siteUrl}${withBase(`topics/${tag}/`)}`;
const topicItems = [
  ...projects.map((p) => ({ name: p.data.title, path: `projects/${p.id.replace(/\.md$/, '')}/` })),
  ...posts.map((p) => ({ name: p.data.title, path: `posts/${p.id.replace(/\.md$/, '')}/` })),
];
const topicJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${topic.label} | Nikita Boyarkin`,
  description: `Материалы по теме «${topic.label}»: записи и проекты.`,
  url: topicUrl,
  inLanguage: 'ru',
  // Reference, not redeclaration: the WebSite `@id` is published by Base.astro
  // on every page (see the entity-graph note there).
  isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}${withBase('/')}#website` },
  ...(topicItems.length > 0
    ? {
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: topicItems.length,
          itemListElement: topicItems.map((item, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: item.name,
            url: `${siteUrl}${withBase(item.path)}`,
          })),
        },
      }
    : {}),
};
---

<Base
  title={`${topic.label} | Nikita Boyarkin`}
  description={`Материалы по теме «${topic.label}»: записи и проекты.`}
  canonical={withBase(`topics/${tag}/`)}
  activeNav="home"
  lang="ru"
  jsonLd={topicJsonLd}
>
  <section class="container reveal">
    <a class="back" href={withBase('topics/')}>← Все темы</a>
    <h1 class="page-title">{topic.label}</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-8);">
      {posts.length} записей · {projects.length} проектов
    </p>

    {
      projects.length > 0 && (
        <>
          <h2 class="topic-section-title">Проекты</h2>
          <div id="project-list" style="margin-bottom: var(--space-12);">
            {projects.map((project) => (
              <ProjectCard
                slug={project.id.replace(/\.md$/, '')}
                title={project.data.title}
                description={project.data.description}
                image={project.data.hero}
                impact={project.data.impact}
                star={project.data.star}
                tools={project.data.tools}
                github={project.data.github}
              />
            ))}
          </div>
        </>
      )
    }

    {
      posts.length > 0 && (
        <>
          <h2 class="topic-section-title">Записи</h2>
          <div class="blog-list">
            {posts.map((post) => (
<BlogCard
                slug={post.id.replace(/\.md$/, '')}
                title={post.data.title}
                category={post.data.category}
                date={post.data.date}
                image={post.data.image}
                updated={post.data.updated}
                excerpt={post.data.excerpt}
              />
            ))}
          </div>
        </>
      )
    }

    {
      posts.length === 0 && projects.length === 0 && (
        <p style="color: var(--text-muted);">Пока нет материалов по этой теме.</p>
      )
    }
  </section>
</Base>

<style>
  .topic-section-title {
    color: var(--text-accent);
    font-size: 1.3rem;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border-color);
  }
</style>