---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CarouselNav from '../../components/CarouselNav.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';
import { TOPICS, postMatchesTopic, projectMatchesTopic } from '../../lib/topics';

// Topic definitions + the route list both come from src/lib/topics.ts — no
// more duplicated TOPIC_MATCH / key list in this file.
export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { tag: t.key } }));
}

const { tag } = Astro.params;
const topic = TOPICS.find((t) => t.key === tag);
if (!topic) {
  return Astro.redirect(withBase('topics/'));
}

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .filter((p) => postMatchesTopic(topic, p.data.tags))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Projects use the same predicate the hub counts with (`projectMatchesTopic`),
// so a card can never appear here without being counted there, or vice versa.
const projects = (await getCollection('projects', (p) => !p.data.draft)).filter((p) =>
  projectMatchesTopic(topic, p),
);

// Russian plural form for a count: 1 запись / 2 записи / 5 записей. Both the
// visible counter and the meta description render a number, so the noun has to
// agree with it — "1 записей" was shipping on the thin tags.
const pluralRu = (n: number, one: string, few: string, many: string): string => {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return one;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few;
  return many;
};

const postCount = `${posts.length} ${pluralRu(posts.length, 'запись', 'записи', 'записей')}`;
const projectCount = `${projects.length} ${pluralRu(projects.length, 'проект', 'проекта', 'проектов')}`;

// `<title>` used to be `«Сегментация» | Nikita Boyarkin`, byte-identical to
// `/glossary/segmentation/`, so the two pages competed for one SERP slot and
// neither said what kind of page it was. `— тема` marks the hub; the glossary
// keeps the bare term.
const pageTitle = `${topic.label} — тема | Nikita Boyarkin`;

// CollectionPage + ItemList over exactly what the page renders — the same
// projects/posts arrays, in the same order, so the markup can never list an
// item the hub does not show. Previously the hub emitted no page-level node at
// all and inherited only the site-wide WebSite, which left the pages AI search
// is most likely to cite without a machine-readable item list.
const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const topicUrl = `${siteUrl}${withBase(`topics/${tag}/`)}`;
const topicItems = [
  ...projects.map((p) => ({ name: p.data.title, path: `projects/${p.id.replace(/\.md$/, '')}/` })),
  ...posts.map((p) => ({ name: p.data.title, path: `posts/${p.id.replace(/\.md$/, '')}/` })),
];

// Derived from the collections, never per-tag copy: interpolating the label
// alone left «SQL» (42), «Python» (45) and «Карьера» (46) under the 50-char
// floor, because the label is the only thing that varied. The counts are what
// the page actually shows, and they differ page to page.
const topicDescription =
  topicItems.length > 0
    ? `Материалы по теме «${topic.label}»: ${postCount} и ${projectCount} в одном списке — с описанием и ссылками.`
    : `Тема «${topic.label}»: материалы пока собираются — записи и проекты появятся позже.`;

const topicJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: topicDescription,
  url: topicUrl,
  inLanguage: 'ru',
  // Reference, not redeclaration: the WebSite `@id` is published by Base.astro
  // on every page (see the entity-graph note there).
  isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}${withBase('/')}#website` },
  ...(topicItems.length > 0
    ? {
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: topicItems.length,
          itemListElement: topicItems.map((item, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: item.name,
            url: `${siteUrl}${withBase(item.path)}`,
          })),
        },
      }
    : {}),
};
---

<Base
  title={pageTitle}
  description={topicDescription}
  canonical={withBase(`topics/${tag}/`)}
  activeNav="home"
  lang="ru"
  searchType="topic"
  jsonLd={topicJsonLd}
>
  <section class="container reveal">
    <a class="back" href={withBase('topics/')}>← Все темы</a>
    <h1 class="page-title">{topic.label}</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-8);">
      {postCount} · {projectCount}
    </p>

    {
      projects.length > 0 && (
        <>
          <h2 class="topic-section-title">Проекты</h2>
          <div id="project-list" style="margin-bottom: var(--space-12);">
            {projects.map((project) => (
              <ProjectCard
                slug={project.id.replace(/\.md$/, '')}
                title={project.data.title}
                description={project.data.description}
                image={project.data.hero}
                star={project.data.star}
                impact={project.data.impact}
                tools={project.data.tools}
                github={project.data.github}
                dataset={project.data.dataset}
              />
            ))}
          </div>
        </>
      )
    }

    {
      posts.length > 0 && (
        <>
          <h2 class="topic-section-title">Записи</h2>
          <CarouselNav track="articles" label="Записи" />
          <div class="blog-list" data-carousel-track="articles">
            {posts.map((post) => (
<BlogCard
                slug={post.id.replace(/\.md$/, '')}
                title={post.data.title}
                category={post.data.category}
                date={post.data.date}
                updated={post.data.updated}
                excerpt={post.data.excerpt}
              />
            ))}
          </div>
        </>
      )
    }

    {
      posts.length === 0 && projects.length === 0 && (
        <p style="color: var(--text-muted);">Пока нет материалов по этой теме.</p>
      )
    }
  </section>
</Base>

<style>
  .topic-section-title {
    color: var(--text-accent);
    font-size: 1.3rem;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border-color);
  }
</style>