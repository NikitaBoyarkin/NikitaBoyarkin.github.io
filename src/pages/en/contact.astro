---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { withBase } from '../../lib/path';
import { CAL_BOOKING_URL } from '../../lib/contact';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent("Hi! Let's discuss product analytics / analyst roles.")}`;
---

<Base title="Contact | Nikita Boyarkin" description="Get in touch with Nikita Boyarkin — product analytics, A/B testing, collaboration." activeNav="contact" canonical={withBase('en/contact/')} lang="en" counterpartHref={withBase('contact/')}>
  <section class="contact-section reveal">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-text">
      If you want to talk product analytics, A/B testing, or a collaboration format — I'm open to conversations.
      Open to Data / Product Analyst roles.
    </p>

    <ContactForm locale="en" />

    <p class="contact-note">
      By submitting the form you agree to the processing of the data above so I can reply.
      Name, contact and message are stored in a secured database; IP is not kept.
    </p>

    <p style="margin-top: var(--space-6);">
      <a href={CAL_BOOKING_URL} class="button button-secondary" target="_blank" rel="noopener noreferrer" data-analytics="booking_click">Book 15 minutes</a>
    </p>

    <div class="board-card" style="max-width: 60ch; margin-top: var(--space-8);">
      <h2 class="look-title">Other ways to reach me</h2>
      <a href="https://t.me/lofinibo" class="contact-email" data-analytics="telegram_contact" target="_blank" rel="noopener noreferrer">Telegram: @lofinibo</a>
      <p style="margin-top: var(--space-2);">
        <a href={tgDeepLink} data-analytics="telegram_deeplink" target="_blank" rel="noopener noreferrer">Send with context →</a>
      </p>

      <p style="margin-top: var(--space-6);">
        <a href={withBase('en/about/')}>About →</a> ·
        <a href={withBase('en/about/#now')}>What I'm working on →</a> ·
        <a href={withBase('en/about/#who')}>Who I am →</a> ·
        <a href={withBase('en/value/')}>Value →</a> ·
        <a href={withBase('en/about/#work')}>How I work →</a> ·
        <a href={withBase('CV-Nikita-Boyarkin.pdf')} download data-analytics="cv_download_pdf">CV</a> ·
        <a href={withBase('contact/')}>Russian version</a>
      </p>
    </div>

    <div class="board-card look-card" style="max-width: 60ch;">
      <h2 class="look-title">What I'm looking for</h2>
      <dl class="look-grid">
        <div class="look-item">
          <dt>Role</dt>
          <dd>Data / Product Analyst · middle</dd>
        </div>
        <div class="look-item">
          <dt>Stack</dt>
          <dd>SQL · Python · A/B experiments · product metrics</dd>
        </div>
        <div class="look-item">
          <dt>Format</dt>
          <dd>Open to roles — let's discuss the collaboration format</dd>
        </div>
      </dl>
    </div>

    <div class="linkedin-badge">
      <div class="badge-base LI-profile-badge" data-locale="en_US" data-size="medium" data-theme="light" data-type="VERTICAL" data-vanity="nikita-boyarkin" data-version="v1">
        <a class="badge-base__link LI-simple-link" href="https://www.linkedin.com/in/nikita-boyarkin">Nikita Boyarkin</a>
      </div>
    </div>
  </section>

  <style>
    .look-card {
      margin-top: var(--space-6);
      padding: var(--space-6);
    }
    .look-title {
      margin: 0 0 var(--space-4);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .look-grid {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .look-item dt {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: var(--space-1);
    }
    .look-item dd {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-normal);
      line-height: 1.5;
    }
    /* Personal-data note under the form. Deliberately plain text: it names no
       policy page, because there is no `/en/privacy/` route to link to. */
    .contact-note {
      margin: var(--space-3) 0 0;
      max-width: 60ch;
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--text-muted);
    }
  </style>

  <script is:inline>
    // Match LinkedIn badge theme to current site theme before the badge script initializes.
    (function () {
      var badge = document.querySelector('.LI-profile-badge');
      if (!badge) return;
      var theme = document.documentElement.getAttribute('data-theme') || 'dark';
      badge.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <script src="https://platform.linkedin.com/badges/js/profile.js" async defer is:inline></script>
</Base>
