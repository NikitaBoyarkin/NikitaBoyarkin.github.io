---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { withBase } from '../../lib/path';
import { CAL_BOOKING_URL, CONTACT_FORM_ENABLED } from '../../lib/contact';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent("Hi! Let's discuss product analytics / analyst roles.")}`;
const LINKEDIN_URL = 'https://www.linkedin.com/in/nikita-boyarkin';
---

<Base title="Contact | Nikita Boyarkin" description="Get in touch with Nikita Boyarkin — product analytics, A/B testing, collaboration." activeNav="contact" canonical={withBase('en/contact/')} lang="en" counterpartHref={withBase('contact/')}>
  <section class="container reveal">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-text">
      Three ways in: a free slot, Telegram, or LinkedIn. I reply within a day.
    </p>

    <div class="contact-layout">
      {
        CONTACT_FORM_ENABLED && (
          <div class="contact-form-wrap">
            <ContactForm locale="en" />

            <p class="contact-note">
              By submitting the form you agree to the processing of the data above so I can reply.
              Name, contact and message are stored in a secured database; IP is not kept.
            </p>
          </div>
        )
      }

      <div class="cta-row contact-cta">
        <a
          href={CAL_BOOKING_URL}
          class="button"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="booking_click"
          data-analytics-surface="contact_cta">Pick a free slot</a
        >
        <a
          href={tgDeepLink}
          class="button button-secondary"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="telegram_deeplink"
          data-analytics-surface="contact_cta">Send in Telegram →</a
        >
        <a
          href={LINKEDIN_URL}
          class="contact-inline-link"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="linkedin_contact"
          data-analytics-surface="contact_cta">LinkedIn →</a
        >
      </div>

      <div class="board-card look-card">
        <h2 class="look-title">What I'm looking for</h2>
        <dl class="look-grid">
          <div class="look-item">
            <dt>Role</dt>
            <dd>Data / Product Analyst · junior</dd>
          </div>
          <div class="look-item">
            <dt>Stack</dt>
            <dd>SQL · Python · A/B experiments · product metrics</dd>
          </div>
          <div class="look-item">
            <dt>Format</dt>
            <dd>Full-time · Moscow · remote or hybrid</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>
