---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import LinkedInBadge from '../../components/LinkedInBadge.astro';
import { withBase } from '../../lib/path';
import { CAL_BOOKING_URL, CONTACT_FORM_ENABLED } from '../../lib/contact';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent("Hi! Let's discuss product analytics / analyst roles.")}`;
---

<Base title="Contact | Nikita Boyarkin" description="Get in touch with Nikita Boyarkin — product analytics, A/B testing, collaboration." activeNav="contact" canonical={withBase('en/contact/')} lang="en" counterpartHref={withBase('contact/')}>
  <section class="container container-content reveal">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-text">
      If you want to talk product analytics, A/B testing, or a collaboration format — I'm open to conversations.
      Open to Data / Product Analyst roles.
    </p>

    <div class="contact-layout">
      {
        CONTACT_FORM_ENABLED && (
          <div class="contact-form-wrap">
            <ContactForm locale="en" />

            <p class="contact-note">
              By submitting the form you agree to the processing of the data above so I can reply.
              Name, contact and message are stored in a secured database; IP is not kept.
            </p>
          </div>
        )
      }

      <div class="cta-row">
        <a
          href={CAL_BOOKING_URL}
          class="button"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="booking_click">Book 30 minutes</a
        >
        <a
          href={tgDeepLink}
          class="button button-secondary"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="telegram_deeplink">Send in Telegram →</a
        >
      </div>

      <div class="board-card">
        <h2 class="look-title">Other ways to reach me</h2>
        <div class="contact-channels">
          <a
            href="https://t.me/lofinibo"
            class="contact-email"
            data-analytics="telegram_contact"
            target="_blank"
            rel="noopener noreferrer">Telegram: @lofinibo</a
          >
          <a
            href="https://www.linkedin.com/in/nikita-boyarkin"
            class="contact-email"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
        </div>
      </div>

      <div class="board-card look-card">
        <h2 class="look-title">What I'm looking for</h2>
        <dl class="look-grid">
          <div class="look-item">
            <dt>Role</dt>
            <dd>Data / Product Analyst · middle</dd>
          </div>
          <div class="look-item">
            <dt>Stack</dt>
            <dd>SQL · Python · A/B experiments · product metrics</dd>
          </div>
          <div class="look-item">
            <dt>Format</dt>
            <dd>Open to roles — let's discuss the collaboration format</dd>
          </div>
        </dl>
      </div>
    </div>

    <LinkedInBadge lang="en" />
  </section>
</Base>
