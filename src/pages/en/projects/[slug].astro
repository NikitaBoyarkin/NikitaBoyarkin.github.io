---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import InnerTOC from '../../../components/InnerTOC.astro';
import InlineTOC from '../../../components/InlineTOC.astro';
import StarBlock from '../../../components/StarBlock.astro';
import DecisionBlock from '../../../components/DecisionBlock.astro';
import ProjectDemo from '../../../components/ProjectDemo.astro';
import ProjectGraph from '../../../components/ProjectGraph.astro';
import ChartsSection from '../../../components/charts/ChartsSection.astro';
import SectionTabs from '../../../components/SectionTabs.astro';
import SectionPanel from '../../../components/SectionPanel.astro';
import { withBase } from '../../../lib/path';
import { loadChartFile } from '../../../lib/charts';
import { formatDate } from '../../../lib/date';
import { buildGraph, mergePostsForLocale, subgraphAround } from '../../../lib/graph';
import { TOPICS } from '../../../lib/topics';
import { PROJECT_ORDER } from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects-en', (p) => !p.data.draft);
  const allPosts = await getCollection('posts', (p) => !p.data.draft);
  const postsEn = await getCollection('posts-en', (p) => !p.data.draft);
  const allParts = await getCollection('volta-parts-en', (p) => !p.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, allPosts, allProjects: projects, allParts, postsEn },
  }));
}

const { project, allPosts, allProjects, allParts, postsEn } = Astro.props;
const { Content, headings } = await render(project);
const slug = project.id.replace(/\.md$/, '');

// Next / prev within the ordered project list. Order comes from the shared
// PROJECT_ORDER so it can never drift from the home board / headline list.
const rank = (id: string) => {
  const i = PROJECT_ORDER.indexOf(id.replace(/\.md$/, ''));
  return i === -1 ? PROJECT_ORDER.length : i;
};
const ordered = [...allProjects].sort((a, b) => rank(a.id) - rank(b.id));
const idx = ordered.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

// Curated evidence set on the flagship hub (see prd-volta-structure D10).
const HUB_CHART_IDS = [
  'onboarding-funnel',
  'kyc-ab-conversion',
  'cohort-retention-heatmap',
  'retention-pre-post',
  'segmentation-size-vs-revenue',
  'segmentation-pareto-cumulative',
];

// Resolve related paths like /posts/<slug>/ and /projects/<slug>/ into { href, title }.
// Posts stay RU-only (root); project links are EN-prefixed.
const lookup = new Map<string, { kind: string; title: string }>();
[...allPosts, ...allProjects].forEach((x) => {
  const s = x.id.replace(/\.md$/, '');
  const kind = x.collection === 'projects-en' ? 'projects' : 'posts';
  lookup.set(s, { kind, title: x.data.title });
});

const related = (project.data.related ?? [])
  .map((p) => {
    const s = p.replace(/^\//, '').replace(/\/$/, '').replace(/^(posts|projects)\//, '');
    const found = lookup.get(s);
    if (!found) return null;
    const href =
      found.kind === 'projects'
        ? withBase(`en/projects/${s}/`)
        : withBase(`posts/${s}/`);
    return { href, title: found.title };
  })
  .filter((x): x is { href: string; title: string } => x !== null);

// Mini-graph: the 1-hop neighborhood of this project in the full EN graph.
// Posts are merged with a RU fallback so untranslated posts still appear
// (RU title, link to the RU page) — same convention as the EN graph page.
const posts = mergePostsForLocale(allPosts, postsEn);
const graph = buildGraph({ projects: allProjects, posts, parts: allParts, topics: TOPICS, lang: 'en' });
const sub = subgraphAround(graph, `p:${slug}`);

// Dashboard tabs are derived from what actually renders: a tab that opens onto
// nothing is worse than no tab. `loadChartFile` is the same loader ChartsSection
// uses, so the "Analytics" tab and the section under it can never disagree; the
// "Connections" tab mirrors the two `post-related` blocks below.
const chartIds = slug === 'volta' ? HUB_CHART_IDS : undefined;
const chartPayload = loadChartFile(slug);
const hasCharts = Boolean(
  chartPayload &&
    chartPayload.charts.length > 0 &&
    (chartIds ? chartIds.some((id) => chartPayload.charts.some((c) => c.id === id)) : true),
);
const hasConnections = related.length > 0 || sub.nodes.length > 1;

// `demo:` is either an in-repo board path or an absolute third-party URL. Only
// the former earns a panel: an external page would not follow the site's three
// themes, and one sending X-Frame-Options: DENY renders as an empty box. The
// link works for both, so the meta row shows it either way.
const demoRaw = project.data.demo;
const demoExternal = Boolean(demoRaw && /^https?:/.test(demoRaw));
const demoHref = demoRaw ? (demoExternal ? demoRaw : withBase(demoRaw)) : null;
const hasDemo = Boolean(demoHref);

const projectTabs = [
  { id: 'case', label: 'Case study' },
  ...(hasDemo ? [{ id: 'demo', label: 'Dashboard' }] : []),
  ...(hasCharts ? [{ id: 'charts', label: 'Analytics' }] : []),
  ...(hasConnections ? [{ id: 'connections', label: 'Connections' }] : []),
];
const tabbed = projectTabs.length > 1;

// Mirrors the RU template: the authored `faq:` block is what the FAQPage
// JSON-LD advertises, so it renders below the case rather than living only in
// the graph, and its heading joins the TOC.
const faqHeading = { id: 'project-faq', text: 'Frequently asked', level: 2 };
const tocHeadings = [
  ...headings.map((h) => ({ id: h.slug, text: h.text, level: h.depth })),
  ...(project.data.faq.length > 0 ? [faqHeading] : []),
];

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const pageUrl = `${siteUrl}${withBase(`en/projects/${slug}/`)}`;
// Dates: most projects carry `updated` but not an authored `date`. Gating both
// fields on `date` left Article nodes dateless, and copying `date` into
// `dateModified` claimed a modification that never happened. Publish prefers
// the authored `date` and falls back to `updated`; modification prefers
// `updated`. A project with neither emits no date fields (guarded —
// `undefined.toISOString()` would throw at build time). Mirrors the RU template.
const publishedDate = project.data.date ?? project.data.updated;
const modifiedDate = project.data.updated ?? project.data.date;
const projectJsonLd = {
  '@type': 'Article',
  headline: project.data.title,
  description: project.data.description,
  ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
  ...(modifiedDate ? { dateModified: modifiedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  // Organization + logo, not Person: Google's Article rich-result eligibility
  // requires an Organization publisher carrying a logo.
  publisher: {
    '@type': 'Organization',
    name: 'Nikita Boyarkin',
    logo: { '@type': 'ImageObject', url: `${siteUrl}${withBase('favicon.svg')}` },
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  keywords: project.data.tools?.join(', '),
};
const faqJsonLd =
  project.data.faq.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: project.data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${withBase('en/')}` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}${withBase('en/projects/')}` },
    { '@type': 'ListItem', position: 3, name: project.data.title, item: pageUrl },
  ],
};
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': faqJsonLd ? [projectJsonLd, faqJsonLd, breadcrumbJsonLd] : [projectJsonLd, breadcrumbJsonLd],
};
---

<Base
  title={`${project.data.title} | Nikita Boyarkin`}
  description={project.data.description}
  ogType="article"
  activeNav="home"
  canonical={withBase(`en/projects/${slug}/`)}
  lang="en"
  counterpartHref={withBase(`projects/${slug}/`)}
  jsonLd={pageJsonLd}
>
  <InnerTOC lang="en" />

  <div class="container reveal">
    <a class="back" href={withBase('en/')}>← Back to portfolio</a>

    {
      project.data.hero && (
        <img
          id="project-image"
          class="hero-image"
          src={withBase(project.data.hero)}
          alt={`${project.data.title} preview`}
          width="1200"
          height="600"
        />
      )
    }

    <DecisionBlock
      bet={project.data.bet}
      failureBar={project.data.failureBar}
      rejected={project.data.rejected}
      retro={project.data.retro}
      lang="en"
    />

    <div class="project-meta">{project.data.star && (
        <div class="project-meta-group project-meta-star">
          <StarBlock star={project.data.star} lang="en" />
        </div>
      )}

      {
        project.data.tools && project.data.tools.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Stack</span>
            <div class="project-tools project-tools-inline">
              {project.data.tools.map((tool) => (
                <span class="project-tool">{tool}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        !project.data.star && project.data.impact && project.data.impact.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Impact</span>
            <ul class="project-meta-list">
              {project.data.impact.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        demoHref && (
          <div class="project-meta-group">
            <span class="project-meta-label">Demo</span>
            <a
              class="project-meta-link"
              href={demoHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open the dashboard →
            </a>
          </div>
        )
      }

      {
        project.data.github && (
          <div class="project-meta-group">
            <span class="project-meta-label">Source</span>
            <a
              class="project-meta-link"
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub →
            </a>
            {project.data.private && (
              <span class="repo-private-note" style="display:block;font-size:.875rem;color:var(--text-muted);margin-top:.25rem;">Repo is private — available on request</span>
            )}
            {project.data.updated && (
              <span class="repo-updated-note" style="display:block;font-size:.875rem;color:var(--text-muted);margin-top:.25rem;">Updated: {formatDate(project.data.updated)}</span>
            )}
          </div>
        )
      }
    </div>

    <SectionTabs tabs={projectTabs} label="Sections" railId="inner-toc" single={!tabbed}>
      <SectionPanel id="case" active ownsRail tabbed={tabbed}>
        <InlineTOC lang="en" headings={tocHeadings} />

        <article id="project-content" class="prose">
          <Content />

          {
            project.data.faq.length > 0 && (
              <section class="project-faq" aria-labelledby="project-faq">
                <h2 id="project-faq">{faqHeading.text}</h2>
                {project.data.faq.map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </section>
            )
          }
        </article>
      </SectionPanel>

      {
        hasDemo && (
          <SectionPanel id="demo" tabbed={tabbed}>
            <ProjectDemo href={demoHref!} external={demoExternal} lang="en" />
          </SectionPanel>
        )
      }

      {
        hasCharts && (
          <SectionPanel id="charts" tabbed={tabbed}>
            <ChartsSection slug={slug} ids={chartIds} lang="en" />
          </SectionPanel>
        )
      }

      {
        hasConnections && (
          <SectionPanel id="connections" tabbed={tabbed}>
            {related.length > 0 && (
              <section class="post-related reveal reveal-delay-2" aria-label="See also">
                <h2>See also</h2>
                <ul>
                  {related.map((r) => (
                    <li><a href={r.href}>{r.title}</a></li>
                  ))}
                </ul>
              </section>
            )}

            {sub.nodes.length > 1 && (
              <section class="post-related reveal reveal-delay-3" aria-label="Connection map">
                <h2>Connection map</h2>
                <ProjectGraph nodes={sub.nodes} links={sub.links} centerId={`p:${slug}`} lang="en" />
              </section>
            )}
          </SectionPanel>
        )
      }
    </SectionTabs>

    {
      (prev || next) && (
        <nav class="prev-next" aria-label="Other projects">
          {prev && (
            <a class="pn-link pn-prev" href={withBase(`en/projects/${prev.id.replace(/\.md$/, '')}/`)}>
              <span class="pn-dir">← Previous</span>
              <span class="pn-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="pn-link pn-next" href={withBase(`en/projects/${next.id.replace(/\.md$/, '')}/`)}>
              <span class="pn-dir">Next →</span>
              <span class="pn-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</Base>