---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import InnerTOC from '../../../components/InnerTOC.astro';
import ProjectGraph from '../../../components/ProjectGraph.astro';
import ChartsSection from '../../../components/charts/ChartsSection.astro';
import { withBase } from '../../../lib/path';
import { formatDate } from '../../../lib/date';
import { buildGraph, mergePostsForLocale, subgraphAround } from '../../../lib/graph';
import { TOPICS } from '../../../lib/topics';
import { PROJECT_ORDER } from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects-en', (p) => !p.data.draft);
  const allPosts = await getCollection('posts', (p) => !p.data.draft);
  const postsEn = await getCollection('posts-en', (p) => !p.data.draft);
  const allParts = await getCollection('volta-parts-en', (p) => !p.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, allPosts, allProjects: projects, allParts, postsEn },
  }));
}

const { project, allPosts, allProjects, allParts, postsEn } = Astro.props;
const { Content } = await render(project);
const slug = project.id.replace(/\.md$/, '');

// Next / prev within the ordered project list. Order comes from the shared
// PROJECT_ORDER so it can never drift from the home board / headline list.
const rank = (id: string) => {
  const i = PROJECT_ORDER.indexOf(id.replace(/\.md$/, ''));
  return i === -1 ? PROJECT_ORDER.length : i;
};
const ordered = [...allProjects].sort((a, b) => rank(a.id) - rank(b.id));
const idx = ordered.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

// Curated evidence set on the flagship hub (see prd-volta-structure D10).
const HUB_CHART_IDS = [
  'onboarding-funnel',
  'kyc-ab-conversion',
  'cohort-retention-heatmap',
  'retention-pre-post',
  'segmentation-size-vs-revenue',
  'segmentation-pareto-cumulative',
];

// Resolve related paths like /posts/<slug>/ and /projects/<slug>/ into { href, title }.
// Posts stay RU-only (root); project links are EN-prefixed.
const lookup = new Map<string, { kind: string; title: string }>();
[...allPosts, ...allProjects].forEach((x) => {
  const s = x.id.replace(/\.md$/, '');
  const kind = x.collection === 'projects-en' ? 'projects' : 'posts';
  lookup.set(s, { kind, title: x.data.title });
});

const related = (project.data.related ?? [])
  .map((p) => {
    const s = p.replace(/^\//, '').replace(/\/$/, '').replace(/^(posts|projects)\//, '');
    const found = lookup.get(s);
    if (!found) return null;
    const href =
      found.kind === 'projects'
        ? withBase(`en/projects/${s}/`)
        : withBase(`posts/${s}/`);
    return { href, title: found.title };
  })
  .filter((x): x is { href: string; title: string } => x !== null);

// Mini-graph: the 1-hop neighborhood of this project in the full EN graph.
// Posts are merged with a RU fallback so untranslated posts still appear
// (RU title, link to the RU page) — same convention as the EN graph page.
const posts = mergePostsForLocale(allPosts, postsEn);
const graph = buildGraph({ projects: allProjects, posts, parts: allParts, topics: TOPICS, lang: 'en' });
const sub = subgraphAround(graph, `p:${slug}`);

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const pageUrl = `${siteUrl}${withBase(`en/projects/${slug}/`)}`;
const projectJsonLd = {
  '@type': 'Article',
  headline: project.data.title,
  description: project.data.description,
  ...(project.data.date
    ? {
        datePublished: project.data.date.toISOString(),
        dateModified: project.data.date.toISOString(),
      }
    : {}),
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  publisher: { '@type': 'Person', name: 'Nikita Boyarkin' },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  keywords: project.data.tools?.join(', '),
};
const faqJsonLd =
  project.data.faq.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: project.data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${withBase('/')}` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}${withBase('en/')}#projects` },
    { '@type': 'ListItem', position: 3, name: project.data.title, item: pageUrl },
  ],
};
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': faqJsonLd ? [projectJsonLd, faqJsonLd, breadcrumbJsonLd] : [projectJsonLd, breadcrumbJsonLd],
};
---

<Base
  title={`${project.data.title} | Nikita Boyarkin`}
  description={project.data.description}
  ogType="article"
  activeNav="home"
  canonical={withBase(`en/projects/${slug}/`)}
  lang="en"
  counterpartHref={withBase(`projects/${slug}/`)}
  jsonLd={pageJsonLd}
>
  <InnerTOC lang="en" />

  <div class="container reveal">
    <a class="back" href={withBase('en/')}>← Back to portfolio</a>

    {
      project.data.hero && (
        <img
          id="project-image"
          class="hero-image"
          src={withBase(project.data.hero)}
          alt={`${project.data.title} preview`}
          width="1200"
          height="600"
        />
      )
    }

    <div class="project-meta">
      {
        project.data.tools && project.data.tools.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Stack</span>
            <div class="project-tools project-tools-inline">
              {project.data.tools.map((tool) => (
                <span class="project-tool">{tool}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        project.data.impact && project.data.impact.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Impact</span>
            <ul class="project-meta-list">
              {project.data.impact.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        project.data.github && (
          <div class="project-meta-group">
            <span class="project-meta-label">Source</span>
            <a
              class="project-meta-link"
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub →
            </a>
            {project.data.private && (
              <span class="repo-private-note" style="display:block;font-size:.85rem;color:var(--text-normal);opacity:.75;margin-top:.25rem;">Repo is private — available on request</span>
            )}
            {project.data.updated && (
              <span class="repo-updated-note" style="display:block;font-size:.85rem;color:var(--text-normal);opacity:.75;margin-top:.25rem;">Updated: {formatDate(project.data.updated)}</span>
            )}
          </div>
        )
      }
    </div>

    <article id="project-content">
      <Content />
    </article>

    <ChartsSection slug={slug} ids={slug === 'volta' ? HUB_CHART_IDS : undefined} lang="en" />

    {
      (prev || next) && (
        <nav class="prev-next" aria-label="Other projects">
          {prev && (
            <a class="pn-link pn-prev" href={withBase(`en/projects/${prev.id.replace(/\.md$/, '')}/`)}>
              <span class="pn-dir">← Previous</span>
              <span class="pn-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="pn-link pn-next" href={withBase(`en/projects/${next.id.replace(/\.md$/, '')}/`)}>
              <span class="pn-dir">Next →</span>
              <span class="pn-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="post-related reveal reveal-delay-2" aria-label="See also">
          <h2>See also</h2>
          <ul>
            {related.map((r) => (
              <li><a href={r.href}>{r.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      sub.nodes.length > 1 && (
        <section class="post-related reveal reveal-delay-3" aria-label="Connection map">
          <h2>Connection map</h2>
          <ProjectGraph nodes={sub.nodes} links={sub.links} centerId={`p:${slug}`} lang="en" />
        </section>
      )
    }
  </div>
</Base>