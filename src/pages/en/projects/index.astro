---
import Base from '../../../layouts/Base.astro';
import ProjectBoard from '../../../components/ProjectBoard.astro';
import { withBase } from '../../../lib/path';
---

<Base
  title="Projects | Nikita Boyarkin"
  description="Project catalog in product analytics: A/B tests, retention, dashboards. Filter by category and tool, with full-width project sections."
  canonical={withBase('en/projects/')}
  activeNav="projects"
  lang="en"
  counterpartHref={withBase('projects/')}
>
  <div class="projects-page">
    <h1 class="page-title reveal">Projects</h1>

    <p class="reveal page-intro" style="color: var(--text-muted); margin-bottom: var(--space-4); max-width: 60ch;">
      Pick a category to see its projects full-width, and filter by tool.
      Reorder cards inside a category by dragging the three dots (or with ↑/↓) —
      the order is stored locally in your browser.
    </p>

    <ProjectBoard heading="Project catalog" collection="projects-en" linkPrefix="en/" />
  </div>
</Base>