---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectBoard from '../../../components/ProjectBoard.astro';
import { withBase } from '../../../lib/path';
import { sortByProjectOrder } from '../../../lib/projects';

// Catalog-level rich result: the board is a list of projects, so it earns a
// CollectionPage + ItemList. Positions follow the board's visible order
// (PROJECT_ORDER via sortByProjectOrder) so the markup matches what renders.
const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const projects = sortByProjectOrder(await getCollection('projects-en', (p) => !p.data.draft));
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects',
  url: `${siteUrl}${withBase('en/projects/')}`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.data.title,
      url: `${siteUrl}${withBase(`en/projects/${project.id.replace(/\.md$/, '')}/`)}`,
    })),
  },
};
---

<Base
  title="Projects | Nikita Boyarkin"
  description="Project catalog in product analytics: A/B tests, retention, dashboards. Filter by category and tool, with full-width project sections."
  canonical={withBase('en/projects/')}
  activeNav="projects"
  lang="en"
  counterpartHref={withBase('projects/')}
  jsonLd={collectionJsonLd}
>
  <div class="projects-page">
    <h1 class="page-title reveal">Projects</h1>

    <p class="reveal page-intro">
      Pick a category and a tool — drag a card (or use ↑/↓) to reorder.
    </p>

    <ProjectBoard collection="projects-en" linkPrefix="en/" />
  </div>
</Base>