---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import ChartsSection from '../../../../components/charts/ChartsSection.astro';
import InnerTOC from '../../../../components/InnerTOC.astro';
import InlineTOC from '../../../../components/InlineTOC.astro';
import { withBase } from '../../../../lib/path';

export async function getStaticPaths() {
  const parts = await getCollection('volta-parts-en', (p) => !p.data.draft);
  return parts.map((part) => ({
    params: { part: part.data.part },
    props: { part, allParts: parts },
  }));
}

const { part, allParts } = Astro.props;
const { Content } = await render(part);
const slug = part.data.part;

const LAYER_LABELS: Record<string, string> = {
  core: 'Core',
  extended: 'Extended',
  'market-jobs': 'Market & Jobs',
  'rat-v2': 'RAT v2',
  causal: 'Causal',
};
const LAYER_ORDER = ['core', 'extended', 'market-jobs', 'rat-v2', 'causal'];

const ordered = [...allParts].sort((a, b) => a.data.order - b.data.order);
const idx = ordered.findIndex((p) => p.data.part === slug);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx < ordered.length - 1 ? ordered[idx + 1] : null;

const groups = LAYER_ORDER.map((key) => ({
  key,
  label: LAYER_LABELS[key],
  parts: ordered.filter((p) => p.data.layer === key),
})).filter((g) => g.parts.length > 0);

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const partJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: part.data.title,
  description: part.data.description,
  isPartOf: {
    '@type': 'CreativeWork',
    name: 'Volta Neobank — Product Analytics',
    url: `${siteUrl}${withBase('en/projects/volta/')}`,
  },
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  url: `${siteUrl}${withBase(`en/projects/volta/${slug}/`)}`,
  keywords: part.data.tools?.join(', '),
};
---

<Base
  title={`${part.data.title} | Volta | Nikita Boyarkin`}
  description={part.data.description}
  ogType="article"
  activeNav="home"
  canonical={withBase(`en/projects/volta/${slug}/`)}
  lang="en"
  counterpartHref={withBase(`projects/volta/${slug}/`)}
  jsonLd={partJsonLd}
>
  <InnerTOC lang="en" />

  <div class="container reveal">
    <a class="back" href={withBase('en/projects/volta/')}>← Volta Neobank</a>

    <p class="part-layer">
      {LAYER_LABELS[part.data.layer]} · project {part.data.order} of {ordered.length}
    </p>
    <h1>{part.data.title}</h1>

    <p class="part-summary">{part.data.description}</p>

    <div class="project-meta">
      {
        part.data.tools && part.data.tools.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Stack</span>
            <div class="project-tools project-tools-inline">
              {part.data.tools.map((tool) => (
                <span class="project-tool">{tool}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        part.data.impact && part.data.impact.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Impact</span>
            <ul class="project-meta-list">
              {part.data.impact.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        part.data.github && (
          <div class="project-meta-group">
            <span class="project-meta-label">Source</span>
            <a
              class="project-meta-link"
              href={part.data.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub →
            </a>
          </div>
        )
      }
    </div>

    <InlineTOC lang="en" />

    <article id="project-content">
      <Content />
    </article>

    <ChartsSection slug="volta" ids={part.data.charts} lang="en" />

    {
      (prev || next) && (
        <nav class="prev-next" aria-label="Other Volta subprojects">
          {prev && (
            <a class="pn-link pn-prev" href={withBase(`en/projects/volta/${prev.data.part}/`)}>
              <span class="pn-dir">← Previous</span>
              <span class="pn-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="pn-link pn-next" href={withBase(`en/projects/volta/${next.data.part}/`)}>
              <span class="pn-dir">Next →</span>
              <span class="pn-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      <section class="post-related reveal reveal-delay-2" aria-label="Volta project map">
        <h2>Volta project map</h2>
        <a class="part-map-hub" href={withBase('en/projects/volta/')}>Volta overview →</a>
        {groups.map((g) => (
          <div class="part-map-group">
            <h3>{g.label}</h3>
            <ul>
              {g.parts.map((s) =>
                s.data.part === slug ? (
                  <li>
                    <span class="part-map-current" aria-current="page">{s.data.title}</span>
                  </li>
                ) : (
                  <li>
                    <a href={withBase(`en/projects/volta/${s.data.part}/`)}>{s.data.title}</a>
                  </li>
                ),
              )}
            </ul>
          </div>
        ))}
      </section>
    }
  </div>
</Base>

<style>
  .part-layer {
    margin: var(--space-4) 0 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-accent);
  }
  .part-summary {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-normal);
    border-left: 3px solid var(--text-accent);
    padding-left: var(--space-4);
    margin: var(--space-4) 0 var(--space-6);
  }
  .part-map-hub {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: 0.9rem;
    color: var(--text-accent);
    text-decoration: none;
  }
  .part-map-group h3 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: var(--space-4) 0 var(--space-2);
  }
  .part-map-current {
    color: var(--text-muted);
    font-weight: 600;
  }
</style>
