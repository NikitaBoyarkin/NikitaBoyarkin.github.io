---
import Base from '../../layouts/Base.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import { withBase } from '../../lib/path';
import { labelForSection } from '../../lib/graph';
import { getGraphSections } from '../../lib/graph-data';

// One graph per content section (see `src/lib/graph.ts`): the combined graph
// mixed sections of very different density, and 30% of its edges crossed them.
const sections = await getGraphSections('en');
---

<Base
  title="Knowledge graph | Nikita Boyarkin"
  description="A concept graph of product analytics: A/B testing, retention, segmentation, SQL — and how they compose into a product loop."
  canonical={withBase('en/graph/')}
  counterpartHref={withBase('graph/')}
  activeNav="graph"
  lang="en"
  bleed
>
  <section class="graph-board reveal">
    <header class="graph-board-head">
      <h1 class="page-title">Content graph</h1>

      <p class="graph-note">Built from the content collections at build time — always current.</p>
    </header>

    {sections.map((s) => (
      <section class="graph-block" id={`graph-${s.key}`} aria-labelledby={`graph-${s.key}-title`}>
        <h2 class="graph-block-title" id={`graph-${s.key}-title`}>
          {labelForSection(s.key, 'en')}
          <span class="graph-block-count">{s.group.nodes.length}</span>
        </h2>
        <KnowledgeGraph section={s.key} lang="en" bare card />
      </section>
    ))}

    <p class="graph-board-gen">
      Generator — <code>src/lib/graph.ts</code>; edge sources — <code>related</code> in frontmatter,
      post tags and the Volta project's <code>children</code>.
    </p>
  </section>
</Base>

<style>
  .graph-block + .graph-block {
    margin-block-start: var(--space-10);
  }
  .graph-block {
    /* The graphs are cards now, so the block carries the page gutter itself —
       otherwise the card runs edge to edge while the heading above it sits on
       the reading measure. */
    padding-inline: var(--page-pad);
    scroll-margin-top: var(--space-10);
  }
  .graph-block-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block: 0 var(--space-4);
    font-size: var(--text-lg);
  }
  .graph-block-count {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>