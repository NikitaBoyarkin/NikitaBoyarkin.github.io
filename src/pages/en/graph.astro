---
import Base from '../../layouts/Base.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import { withBase } from '../../lib/path';
---

<Base
  title="Knowledge graph | Nikita Boyarkin"
  description="A concept graph of product analytics: A/B testing, retention, segmentation, SQL — and how they compose into a product loop."
  canonical={withBase('en/graph/')}
  counterpartHref={withBase('graph/')}
  activeNav="graph"
  lang="en"
>
  <section class="container container-content reveal">
    <h1 class="page-title">Content graph</h1>
    <p class="graph-intro">
      The portfolio's content graph: projects, posts, topics and the Volta modules, linked by actual
      references (<code>related</code>, tags, Volta's composition).
    </p>

    <dl class="graph-legend">
      <div class="graph-legend-item">
        <dt>Color</dt>
        <dd>project track or post category; the button switches to community</dd>
      </div>
      <div class="graph-legend-item">
        <dt>Size</dt>
        <dd>connection count — hubs are bigger</dd>
      </div>
      <div class="graph-legend-item">
        <dt>Edges</dt>
        <dd>thickness — link strength; solid — explicit links, dashed — thematic and lateral</dd>
      </div>
      <div class="graph-legend-item">
        <dt>Controls</dt>
        <dd>Arrows — link direction; Focus — highlight neighbors on click (Esc clears); Edges — filter by link type; chips “All / Projects / Posts / Topics / Volta” — quick filter by node type; checkboxes — hide groups; wheel — zoom; drag — pan and move nodes; ⛶ — fullscreen; mode, preset, hidden groups and edges are kept in the URL, so views are shareable</dd>
      </div>
    </dl>

    <p class="graph-note">Built from the content collections at build time — always current.</p>

    <KnowledgeGraph lang="en" />

    <p style="color: var(--text-muted); margin-top: var(--space-8); font-size: 0.9rem;">
      Generator — <code>src/lib/graph.ts</code>; edge sources — <code>related</code> in frontmatter,
      post tags and the Volta project's <code>children</code>.
    </p>
  </section>
</Base>