---
import Base from '../../layouts/Base.astro';
import ReadingBlock from '../../components/ReadingBlock.astro';
import { loadSources, shelfHref } from '../../lib/library';

// Same frame as /graph/: the shelf is a grid, so it takes `--content-max` (1180px)
// rather than the 800px prose measure.
const sources = await loadSources('en');
---

<Base
  title="Library | Nikita Boyarkin"
  description="Books, courses and papers the methodology here is built on: Designing Machine Learning Systems, Trustworthy Online Controlled Experiments."
  canonical={shelfHref('en')}
  counterpartHref={shelfHref('ru')}
  activeNav="library"
  lang="en"
>
  <div class="container container-content">
    <ReadingBlock sources={sources} lang="en" standalone />
  </div>
</Base>
