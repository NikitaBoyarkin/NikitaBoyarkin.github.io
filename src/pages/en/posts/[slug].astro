---
import { getCollection, render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { withBase } from '../../../lib/path';
import { getBacklinks } from '../../../lib/link-index-data';

export async function getStaticPaths() {
  const posts = await getCollection('posts-en', (p) => !p.data.draft);
  const ruPosts = await getCollection('posts', (p) => !p.data.draft);
  const ruSlugs = new Set(ruPosts.map((p) => p.id.replace(/\.md$/, '')));
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, allPosts: posts, ruSlugs },
  }));
}

const { post, allPosts, ruSlugs } = Astro.props;
const { Content } = await render(post);

const sorted = [...allPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = sorted.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? sorted[idx - 1] : null;
const older = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;
const prev = older ? { href: withBase(`en/posts/${older.id.replace(/\.md$/, '')}/`), title: older.data.title } : null;
const next = newer ? { href: withBase(`en/posts/${newer.id.replace(/\.md$/, '')}/`), title: newer.data.title } : null;

const allProjects = await getCollection('projects-en', (p) => !p.data.draft);
const lookup = new Map<string, { kind: string; title: string }>();
[...allPosts, ...allProjects].forEach((x) => {
  const slug = x.id.replace(/\.md$/, '');
  const kind = x.collection === 'projects-en' ? 'projects' : 'posts';
  lookup.set(slug, { kind, title: x.data.title });
});

const related = (post.data.related ?? [])
  .map((p) => {
    if (/^https?:\/\//i.test(p)) {
      const host = new URL(p).hostname.replace(/^www\./, '');
      return { href: p, title: host, external: true };
    }
    const slug = p.replace(/^\//, '').replace(/\/$/, '').replace(/^(posts|projects)\//, '');
    const found = lookup.get(slug);
    return found ? { href: withBase(`en/${found.kind}/${slug}/`), title: found.title, external: false } : null;
  })
  .filter((x): x is { href: string; title: string; external: boolean } => x !== null);

const backlinks = await getBacklinks('en', 'post', post.id.replace(/\.md$/, ''));
---

<Post
  title={post.data.title}
  date={post.data.date}
  updated={post.data.updated}
  category={post.data.category}
  excerpt={post.data.excerpt}
  image={post.data.image}
  related={related}
  backlinks={backlinks}
  keywords={post.data.keywords ?? []}
  slug={post.id.replace(/\.md$/, '')}
  prev={prev}
  next={next}
  lang="en"
  counterpartHref={ruSlugs.has(post.id.replace(/\.md$/, '')) ? withBase(`posts/${post.id.replace(/\.md$/, '')}/`) : undefined}
>
  <Content />
</Post>