---
// Glossary index (EN). Mirror of /glossary/ over the `glossary-en` collection.
import Base from '../../../layouts/Base.astro';
import GlossaryFilter from '../../../components/GlossaryFilter.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/path';
import {
  buildTagFacets,
  CATEGORY_LABELS,
  GLOSSARY_CATEGORIES,
  termHref,
} from '../../../lib/glossary';

const terms = await getCollection('glossary-en', (t) => !t.data.draft);
const slugOf = (id: string) => id.replace(/\.md$/, '');

const groups = GLOSSARY_CATEGORIES.map((category) => {
  const items = terms
    .filter((t) => t.data.category === category)
    .map((t) => ({
      slug: slugOf(t.id),
      title: t.data.title,
      description: t.data.description,
    }))
    .sort((a, b) => a.title.localeCompare(b.title, 'en'));
  return { category, label: CATEGORY_LABELS[category].en, items };
}).filter((g) => g.items.length > 0);

// Filter facets: categories come from the (already ordered) groups; tags are
// counted across every term. The client filter data below is pre-formatted so
// the bundled script stays dumb (no withBase/termHref logic in JS).
const categoriesFacet = groups.map((g) => ({ key: g.category, label: g.label }));
const tagFacets = buildTagFacets(terms.map((t) => ({ tags: t.data.tags ?? [] })));

const termsJson = terms
  .map((t) => {
    const slug = slugOf(t.id);
    return {
      slug,
      href: withBase(termHref(slug, 'en')),
      title: t.data.title,
      description: t.data.description,
      category: t.data.category,
      tags: t.data.tags ?? [],
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title, 'en'));

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const glossaryUrl = `${siteUrl}${withBase('en/glossary/')}`;
const definedTermSetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossary',
  url: glossaryUrl,
  hasDefinedTerm: [...terms]
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'))
    .map((t) => ({
      '@type': 'DefinedTerm',
      name: t.data.title,
      url: `${siteUrl}${withBase(termHref(slugOf(t.id), 'en'))}`,
    })),
};
---

<Base
  title="Glossary | Nikita Boyarkin"
  description="Product analytics glossary: A/B testing, statistics, product and business metrics — short definitions with connections."
  canonical={withBase('en/glossary/')}
  activeNav="glossary"
  lang="en"
  counterpartHref={withBase('glossary/')}
  jsonLd={definedTermSetJsonLd}
>
  <section class="container reveal">
    <h1 class="page-title">Glossary</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-4); max-width: 60ch;">
      Short definitions of product analytics terms, grouped by topic; the count is
      the number of terms in the section.
    </p>
    <GlossaryFilter lang="en" categories={categoriesFacet} tags={tagFacets} />
    <div id="glossary-static">
      {
        groups.map((g) => (
          <div class="level-group">
            <div class="level-heading">
              <span class="level-name">{g.label}</span>
              <span class="level-blurb">{g.items.length}</span>
            </div>
            <div class="term-grid">
              {g.items.map((t) => (
                <a class="term-card" href={withBase(termHref(t.slug, 'en'))}>
                  <span class="term-card-inner">
                    <span class="term-label">{t.title}</span>
                    <span class="term-blurb">{t.description}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div id="glossary-results" hidden></div>
    <script
      is:inline
      type="application/json"
      id="glossary-terms-data"
      set:html={JSON.stringify(termsJson).replace(/</g, '\\u003c')}
    />
  </section>
</Base>

<style>
  .level-group {
    margin-bottom: var(--space-8);
  }
  .level-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .level-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-normal);
  }
  .level-blurb {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .term-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .term-card {
    display: block;
    padding: var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--background-secondary);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .term-card:hover {
    border-color: var(--text-accent);
    transform: translateY(-2px);
  }
  .term-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .term-label {
    font-weight: 500;
    color: var(--text-normal);
  }
  .term-blurb {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
