---
// One glossary term (EN). Mirror of /glossary/[slug]/ over `glossary-en`,
// `posts-en` and `projects-en`. The graph merges RU posts as a fallback so the
// EN graph keeps the same node set as /graph-en.json (graph-data.ts).
import { getCollection, render } from 'astro:content';
import Term from '../../../layouts/Term.astro';
import ProjectGraph from '../../../components/ProjectGraph.astro';
import { withBase } from '../../../lib/path';
import {
  computeBacklinks,
  resolveRelated,
  termHref,
  type BacklinkSource,
  type GlossaryCategory,
} from '../../../lib/glossary';
import { buildGraph, mergePostsForLocale, subgraphAround } from '../../../lib/graph';
import { TOPICS } from '../../../lib/topics';

export async function getStaticPaths() {
  const terms = await getCollection('glossary-en', (t) => !t.data.draft);
  const ruTerms = await getCollection('glossary', (t) => !t.data.draft);
  const ruSlugs = new Set(ruTerms.map((t) => t.id.replace(/\.md$/, '')));
  return terms.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, allTerms: terms, ruSlugs },
  }));
}

const { entry, allTerms, ruSlugs } = Astro.props;
const slug = entry.id.replace(/\.md$/, '');
const lang = 'en' as const;
const { Content } = await render(entry);
const slugOf = (id: string) => id.replace(/\.md$/, '');

const [postsEn, projectsEn, partsEn, postsRu, glossaryEn] = await Promise.all([
  getCollection('posts-en', (p) => !p.data.draft),
  getCollection('projects-en', (p) => !p.data.draft),
  getCollection('volta-parts-en', (p) => !p.data.draft),
  getCollection('posts', (p) => !p.data.draft),
  getCollection('glossary-en'),
]);

const related = resolveRelated(entry.data.related, lang, {
  glossary: allTerms.map((t) => ({ slug: slugOf(t.id), title: t.data.title })),
  posts: postsEn.map((p) => ({ slug: slugOf(p.id), title: p.data.title })),
  projects: projectsEn.map((p) => ({ slug: slugOf(p.id), title: p.data.title })),
}).map((r) => ({ ...r, href: withBase(r.href) }));

const sources: BacklinkSource[] = [
  ...postsEn.map((p) => ({
    kind: 'post' as const,
    slug: slugOf(p.id),
    href: `/en/posts/${slugOf(p.id)}/`,
    title: p.data.title,
    body: p.body ?? '',
  })),
  ...projectsEn.map((p) => ({
    kind: 'project' as const,
    slug: slugOf(p.id),
    href: `/en/projects/${slugOf(p.id)}/`,
    title: p.data.title,
    body: p.body ?? '',
  })),
];
const backlinkMap = computeBacklinks(
  allTerms.map((t) => ({ slug: slugOf(t.id), title: t.data.title, aka: t.data.aka ?? [] })),
  sources,
);
const backlinks = (backlinkMap[slug] ?? []).map((s) => ({
  title: s.title,
  href: withBase(s.href),
  kind: s.kind,
}));

const ordered = [...allTerms].sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'));
const idx = ordered.findIndex((t) => t.id === entry.id);
const prev =
  idx > 0
    ? { href: withBase(termHref(slugOf(ordered[idx - 1].id), lang)), title: ordered[idx - 1].data.title }
    : null;
const next =
  idx >= 0 && idx < ordered.length - 1
    ? { href: withBase(termHref(slugOf(ordered[idx + 1].id), lang)), title: ordered[idx + 1].data.title }
    : null;

// Mini-graph: 1-hop neighborhood, mirrored from graph-data.ts (EN).
const postsForGraph = mergePostsForLocale(postsRu, postsEn);
const graph = buildGraph({
  projects: projectsEn,
  posts: postsForGraph,
  parts: partsEn,
  topics: TOPICS,
  lang,
  glossary: glossaryEn,
});
const sub = subgraphAround(graph, `g:${slug}`, 1);
---

<Term
  title={entry.data.title}
  description={entry.data.description}
  slug={slug}
  category={entry.data.category as GlossaryCategory}
  aka={entry.data.aka ?? []}
  updated={entry.data.updated}
  related={related}
  backlinks={backlinks}
  keywords={entry.data.keywords ?? []}
  prev={prev}
  next={next}
  lang={lang}
  counterpartHref={ruSlugs.has(slug) ? withBase(`glossary/${slug}/`) : undefined}
>
  <Content />
  {
    sub.nodes.length > 1 && (
      <section slot="graph" class="post-related reveal reveal-delay-3" aria-label="Connections map">
        <h2>Connections map</h2>
        <ProjectGraph
          nodes={sub.nodes}
          links={sub.links}
          centerId={`g:${slug}`}
          lang={lang}
          caption="Terms, articles and projects connected to this concept. Hover a node to see its name; click to open."
          ariaLabel="Connections of this concept"
        />
      </section>
    )
  }
</Term>
