---
import Base from '../../layouts/Base.astro';
import AboutPage from '../../components/AboutPage.astro';
import { withBase } from '../../lib/path';

// Mirrors the RU ProfilePage; see src/pages/about.astro for the rationale.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Nikita Boyarkin',
    jobTitle: 'Data Analyst / Product Analyst',
    url: 'https://nikitaboyarkin.github.io/en/about/',
    image: 'https://nikitaboyarkin.github.io/images/00_profile.webp',
    description:
      'Data and product analyst. Experiments, retention, segmentation — with code, SQL and a reproducible methodology.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Moscow',
      addressCountry: 'RU',
    },
    knowsAbout: [
      'A/B testing',
      'CUPED',
      'AA-tests',
      'Retention analysis',
      'Cohort analysis',
      'RFM segmentation',
      'SQL',
      'Python',
    ],
    alumniOf: [
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'BSc, Business informatics, 2016–2020' },
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'MSc, Work psychology, 2020–2022' },
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'PhD, Work psychology, 2022–2025' },
    ],
    sameAs: [
      'https://github.com/NikitaBoyarkin',
      'https://www.linkedin.com/in/nikita-boyarkin',
    ],
  },
};
---

<Base
  title="About | Nikita Boyarkin"
  description="About Nikita Boyarkin — Data Analyst / Product Analyst. Who I am, experience and education, stack, what I'm doing now, and how to collaborate."
  canonical={withBase('en/about/')}
  activeNav="about"
  lang="en"
  counterpartHref={withBase('about/')}
  jsonLd={jsonLd}
>
  <AboutPage lang="en" />
</Base>
