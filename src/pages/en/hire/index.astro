---
// `/en/hire/` — see `src/pages/hire/index.astro` for why the three bodies share
// one page and why every id a body writes is namespaced.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import RoleLanding from '../../../components/RoleLanding.astro';
import RoleTabs from '../../../components/RoleTabs.astro';
import { AUDIENCES } from '../../../lib/projects';
import { withBase } from '../../../lib/path';

const lang = 'en' as const;
---

<Base
  title="Hiring | Nikita Boyarkin"
  description="One portfolio, three ways in: HR matches a vacancy, a manager looks for impact, a colleague for method. Switch with the tabs."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Portfolio knowledge graph: projects, posts and topics joined by real links. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('en/hire/')}
  activeNav="hire"
  lang={lang}
  counterpartHref={withBase('hire/')}
>
  <header class="hire-head">
    <h1>Hiring</h1>
    <p class="hire-lead">One portfolio, three ways in. Switch to the one that matches your task.</p>
  </header>

  {/* Same pre-paint contract as the RU page: set `html[data-hire-tab]` before the
      panels are parsed, so the wrong body never paints. */}
  <script is:inline>
    (function () {
      var role = (location.hash || '').replace(/^#/, '');
      var valid = ['hr', 'manager', 'colleague'];
      if (valid.indexOf(role) === -1) {
        try {
          role = window.localStorage.getItem('audience');
        } catch (error) {
          role = null;
        }
      }
      if (valid.indexOf(role) === -1) role = 'colleague';
      document.documentElement.setAttribute('data-hire-tab', role);
    })();
  </script>

  <RoleTabs lang={lang} />

  <aside class="hire-feedback">
    <p>Worked with me? Five questions about where I help and where I get in the way.</p>
    <a class="button" href={withBase('en/feedback/')} data-analytics="feedback_page_click">
      <Icon name="message" size={16} class="btn-icon" />
      Answer five questions
    </a>
  </aside>

  {
    AUDIENCES.map((role) => (
      <section
        id={role}
        data-role-panel={role}
        role="tabpanel"
        aria-labelledby={`role-tab-${role}`}
        tabindex="0"
      >
        <RoleLanding role={role} lang={lang} headingLevel={2} idPrefix={role} />
      </section>
    ))
  }
</Base>

<style>
  /* No wrapper paddings: `<body>` already owns the page gutter and the 1000px
     frame, and every body inside keeps its own `.intro-container` edges. */
  .hire-head {
    padding-top: var(--space-4);
  }

  .hire-head h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .hire-lead {
    max-width: 60ch;
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
  }

  .hire-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .hire-feedback p {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
