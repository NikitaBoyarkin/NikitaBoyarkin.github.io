---
// `/en/` — the gate, see `src/pages/index.astro`.
import Base from '../../layouts/Base.astro';
import PersonaCanvas from '../../components/PersonaCanvas.astro';
import { withBase } from '../../lib/path';

// Person only: the `ItemList` of all projects would no longer describe this
// page (the gate lists no projects), and each role version now owns its own
// canonical URL and its own structured data.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nikita Boyarkin',
  url: 'https://nikitaboyarkin.github.io/en/',
  jobTitle: 'Product Analyst',
  sameAs: [
    'https://github.com/NikitaBoyarkin',
    'https://www.linkedin.com/in/nikita-boyarkin',
  ],
  hasOccupation: { '@type': 'Occupation', name: 'Product Analyst' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'UMC' },
  knowsAbout: [
    'A/B testing',
    'Product analytics',
    'Retention analysis',
    'Customer segmentation (RFM)',
    'SQL',
    'Python',
    'Data visualization',
  ],
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1'] },
};
---

<Base
  title="Nikita Boyarkin | Product Analyst"
  description="Portfolio of Nikita Boyarkin — product analyst. Three versions for three readers: screening, impact, methodology."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Portfolio content graph: projects, articles and topics linked together. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('en/')}
  activeNav="home"
  lang="en"
  counterpartHref={withBase('/')}
  jsonLd={jsonLd}
>
  <PersonaCanvas lang="en" />
</Base>
