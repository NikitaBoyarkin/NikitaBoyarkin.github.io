---
import Base from '../../layouts/Base.astro';
import HeroMetrics from '../../components/HeroMetrics.astro';
import HeroCta from '../../components/HeroCta.astro';
import HeroAvatar from '../../components/HeroAvatar.astro';
import CareerSnapshot from '../../components/CareerSnapshot.astro';
import ReadingBlock from '../../components/ReadingBlock.astro';
import MaterialStrip from '../../components/MaterialStrip.astro';
import HeadlineCases from '../../components/HeadlineCases.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';

const allProjects = await getCollection('projects-en', (p) => !p.data.draft);
const featuredProject =
  allProjects.find((p) => p.id === 'volta') || allProjects[0];

const siteUrl = 'https://nikitaboyarkin.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: `${siteUrl}/`,
      jobTitle: 'Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`en/projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Product Analyst"
  description="Portfolio of Nikita Boyarkin — product analyst. Specialized in A/B testing and retention: SQL, Python, CUPED, and reproducible methodology."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Portfolio content graph: projects, articles and topics linked together. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('en/')}
  activeNav="home"
  lang="en"
  counterpartHref={withBase('/')}
  jsonLd={jsonLd}
>
  <!-- HERO — editorial split: identity left, dataviz panel right -->
  <section id="intro">
    <div class="intro-container hero-editorial">
      <div class="hero-body">
        <HeroAvatar />
        <h1 class="hero-name">Product Analyst</h1>
        <p class="hero-role">A/B Testing &amp; Retention</p>
        <p class="hero-pitch tagline">
          Reproducible analytics: SQL, Python, CUPED and ship-gates. Every conclusion is re-checked in code, not taken on trust.
        </p>
        <p class="hero-phd">
          PhD in work psychology — I measure behaviour and causal effects, not correlations.
        </p>

        <HeroMetrics lang="en" />

        <p class="cta-row">
          <HeroCta lang="en" />
          <a class="button button-secondary" href={withBase('en/contact/')} data-analytics="hero_contact">Get in touch</a>
          <a class="button button-secondary" href={withBase('CV-Nikita-Boyarkin.pdf')} download data-analytics="cv_download_pdf">CV</a>
        </p>
      </div>

      <div class="hero-visual">
        <article class="featured-card featured-card-hero">
          <img
            class="featured-card-image"
            src={withBase(featuredProject.data.hero)}
            alt=""
            loading="lazy"
          />
          <div class="featured-card-body">
            <p class="featured-card-eyebrow">Featured case</p>
            <h3 class="featured-card-title">{featuredProject.data.title}</h3>
            <p class="featured-card-description">{featuredProject.data.description}</p>
            {featuredProject.data.caseStudy && featuredProject.data.caseStudy.metrics.length > 0 && (
              <dl class="featured-card-metrics">
                {featuredProject.data.caseStudy.metrics.slice(0, 3).map((m: { label: string; value: string }) => (
                  <div>
                    <dt>{m.value}</dt>
                    <dd>{m.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="bento-chip-list">
              {featuredProject.data.tools?.slice(0, 5).map((tool: string) => (
                <span class="bento-chip">{tool}</span>
              ))}
            </div>
            <div class="featured-card-actions">
              <a
                class="featured-card-link"
                href={withBase(`en/projects/${featuredProject.id.replace(/\.md$/, '')}/`)}
                data-analytics="featured_project"
              >
                Read the case →
              </a>
              {featuredProject.data.demo && (
                <a
                  class="featured-card-chip"
                  href={featuredProject.data.demo.startsWith('http') ? featuredProject.data.demo : withBase(featuredProject.data.demo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_demo"
                >
                  Demo
                </a>
              )}
              {featuredProject.data.github && !featuredProject.data.private && (
                <a
                  class="featured-card-chip"
                  href={featuredProject.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_github"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- HEADLINE PROOF — three deep case studies + compressed list (PRD v6 S2.6) -->
  <HeadlineCases lang="en" />

  <!-- EDITORIAL TOP — latest writing (with dates) -->
  <MaterialStrip lang="en" />

  <!-- BENTO BOTTOM -->
  <div class="home-layout">
    <!-- Bento bottom — airy, spaced layout -->
    <div class="bento-grid bento-spaced">
      <!-- Career snapshot -->
      <div class="bento-cell bento-cell-full" tabindex="-1">
        <CareerSnapshot lang="en" />
      </div>

      <!-- Stack -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Stack</h3>
        <p class="bento-cell-heading">Tools and technologies</p>
        <div class="stack-groups">
          <div class="stack-group">
            <span class="stack-group-name">Analysis</span>
            <span class="bento-chip">SQL</span>
            <span class="bento-chip">Python</span>
            <span class="bento-chip">pandas</span>
            <span class="bento-chip">DuckDB</span>
          </div>
          <div class="stack-group">
            <span class="stack-group-name">Visualization</span>
            <span class="bento-chip">matplotlib</span>
            <span class="bento-chip">Plotly</span>
            <span class="bento-chip">Astro</span>
          </div>
          <div class="stack-group">
            <span class="stack-group-name">Infra</span>
            <span class="bento-chip">GitHub Actions</span>
            <span class="bento-chip">Supabase</span>
            <span class="bento-chip">PostHog</span>
          </div>
        </div>
        <a class="bento-cell-link" href={withBase('en/projects/')} data-analytics="bento_stack">
          All projects →
        </a>
      </div>

      <!-- Knowledge graph -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Knowledge graph</h3>
        <p class="bento-cell-heading">Explore the connections</p>
        <p class="bento-cell-text">
          All notes, projects, and topics are linked in an interactive graph. Find the path from SQL to A/B testing.
        </p>
        <a class="bento-cell-link" href={withBase('graph/')} data-analytics="bento_graph">
          Open graph →
        </a>
      </div>

      <!-- Notes -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Notes</h3>
        <p class="bento-cell-heading">Product analytics in writing</p>
        <p class="bento-cell-text">
          Methodology breakdowns, checklists, and templates for everyday analyst work.
        </p>
        <a class="bento-cell-link" href={withBase('en/writing/')} data-analytics="bento_notes">
          Read notes →
        </a>
      </div>

      <!-- Reading / library -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <ReadingBlock lang="en" />
      </div>
    </div>
  </div>
</Base>
