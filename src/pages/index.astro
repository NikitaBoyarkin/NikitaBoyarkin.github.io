---
// `/` — the gate (PRD §9): the identity and three paths. The gate always renders
// and never redirects, even for a returning visitor with a stored choice (Q11).
// It is a static, in-flow hero (`HeroGate`), not the pan/zoom canvas: the canvas
// fit measured a zero-height band on this page and pushed the HR route off the
// top of the fold.
import Base from '../layouts/Base.astro';
import HomeNewTab from '../components/HomeNewTab.astro';
import { withBase } from '../lib/path';

// Person only: the `ItemList` of all projects would no longer describe this
// page (the gate lists no projects), and each role version now owns its own
// canonical URL and its own structured data.
const siteUrl = 'https://nikitaboyarkin.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nikita Boyarkin',
  url: `${siteUrl}${withBase('/')}`,
  jobTitle: 'Product Analyst',
  sameAs: [
    'https://github.com/NikitaBoyarkin',
    'https://www.linkedin.com/in/nikita-boyarkin',
  ],
  hasOccupation: { '@type': 'Occupation', name: 'Product Analyst' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'UMC' },
  knowsAbout: [
    'A/B testing',
    'Product analytics',
    'Retention analysis',
    'Customer segmentation (RFM)',
    'SQL',
    'Python',
    'Data visualization',
  ],
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1'] },
};

/**
 * The homepage is a new-tab surface: clock, search, shortcuts. The persona
 * landings (`/hr/`, `/manager/`, `/colleague/`) stay one tap away in the header's
 * `NavRoles` group and in the drawer; the dashboard summary left `/` with the
 * gate — the Explorer surface (`/explorer/`) is the browsable replacement.
 */
---

<Base
  title="Nikita Boyarkin | Продуктовый аналитик"
  description="Портфолио Никиты Бояркина — продуктовый аналитик. Три версии под задачу читателя: скрининг, результат, методология."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Граф контента портфолио: проекты, статьи и темы, связанные реальными ссылками. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <HomeNewTab lang="ru" />
</Base>
