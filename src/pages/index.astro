---
import Base from '../layouts/Base.astro';
import HeroMetrics from '../components/HeroMetrics.astro';
import HeroCta from '../components/HeroCta.astro';
import HeroAvatar from '../components/HeroAvatar.astro';
import CareerSnapshot from '../components/CareerSnapshot.astro';
import ReadingBlock from '../components/ReadingBlock.astro';
import MaterialStrip from '../components/MaterialStrip.astro';
import HeadlineCases from '../components/HeadlineCases.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';

const allProjects = await getCollection('projects', (p) => !p.data.draft);
const featuredProject =
  allProjects.find((p) => p.id === 'volta') || allProjects[0];

const siteUrl = 'https://nikitaboyarkin.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: `${siteUrl}/`,
      jobTitle: 'Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Продуктовый аналитик"
  description="Портфолио Никиты Бояркина — продуктовый аналитик. Специализация — A/B-тесты и retention: SQL, Python, CUPED и воспроизводимая методология."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Граф контента портфолио: проекты, статьи и темы, связанные реальными ссылками. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <!-- HERO — editorial split: identity left, dataviz panel right -->
  <section id="intro">
    <div class="intro-container hero-editorial">
      <div class="hero-body">
        <HeroAvatar lang="ru" />
        <h1 class="hero-name">Продуктовый аналитик</h1>
        <p class="hero-role">A/B-тесты и retention</p>
        <p class="hero-pitch tagline">
          Воспроизводимая аналитика: SQL, Python, CUPED и ship-gates. Каждый вывод перепроверяется кодом, а не принимается на слово.
        </p>
        <p class="hero-phd">
          PhD по психологии труда — измеряю поведение и причинные эффекты, а не корреляции.
        </p>

        <HeroMetrics lang="ru" />

        <p class="cta-row">
          <HeroCta lang="ru" />
          <a class="button button-secondary" href={withBase('contact/')} data-analytics="hero_contact">Связаться</a>
          <a class="button button-secondary" href={withBase('CV-Nikita-Boyarkin.pdf')} download data-analytics="cv_download_pdf">CV</a>
        </p>
      </div>

      <div class="hero-visual">
        <article class="featured-card featured-card-hero">
          <img
            class="featured-card-image"
            src={withBase(featuredProject.data.hero)}
            alt=""
            loading="lazy"
          />
          <div class="featured-card-body">
            <p class="featured-card-eyebrow">Избранный кейс</p>
            <h2 class="featured-card-title">{featuredProject.data.title}</h2>
            <p class="featured-card-description">{featuredProject.data.description}</p>
            {featuredProject.data.caseStudy && featuredProject.data.caseStudy.metrics.length > 0 && (
              <dl class="featured-card-metrics">
                {featuredProject.data.caseStudy.metrics.slice(0, 3).map((m: { label: string; value: string }) => (
                  <div>
                    <dt>{m.value}</dt>
                    <dd>{m.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="bento-chip-list">
              {featuredProject.data.tools?.slice(0, 5).map((tool: string) => (
                <span class="bento-chip">{tool}</span>
              ))}
            </div>
            <div class="featured-card-actions">
              <a
                class="featured-card-link"
                href={withBase(`projects/${featuredProject.id.replace(/\.md$/, '')}/`)}
                data-analytics="featured_project"
              >
                Разбор проекта →
              </a>
              {featuredProject.data.demo && (
                <a
                  class="featured-card-chip"
                  href={featuredProject.data.demo.startsWith('http') ? featuredProject.data.demo : withBase(featuredProject.data.demo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_demo"
                >
                  Демо
                </a>
              )}
              {featuredProject.data.github && !featuredProject.data.private && (
                <a
                  class="featured-card-chip"
                  href={featuredProject.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="featured_github"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- HEADLINE PROOF — three deep case studies + compressed list (PRD v6 S2.6) -->
  <HeadlineCases lang="ru" />

  <!-- EDITORIAL TOP — latest writing (with dates) -->
  <MaterialStrip lang="ru" />

  <!-- BENTO BOTTOM -->
  <div class="home-layout">
    <!-- Bento bottom — airy, spaced layout -->
    <div class="bento-grid bento-spaced">
      <!-- Career snapshot -->
      <div class="bento-cell bento-cell-full" tabindex="-1">
        <CareerSnapshot lang="ru" />
      </div>

      <!-- Stack -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Стек</h3>
        <p class="bento-cell-heading">Инструменты и технологии</p>
        <div class="stack-groups">
          <div class="stack-group">
            <span class="stack-group-name">Анализ</span>
            <span class="bento-chip">SQL</span>
            <span class="bento-chip">Python</span>
            <span class="bento-chip">pandas</span>
            <span class="bento-chip">DuckDB</span>
          </div>
          <div class="stack-group">
            <span class="stack-group-name">Визуализация</span>
            <span class="bento-chip">matplotlib</span>
            <span class="bento-chip">Plotly</span>
            <span class="bento-chip">Astro</span>
          </div>
          <div class="stack-group">
            <span class="stack-group-name">Инфра</span>
            <span class="bento-chip">GitHub Actions</span>
            <span class="bento-chip">Supabase</span>
            <span class="bento-chip">PostHog</span>
          </div>
        </div>
        <a class="bento-cell-link" href={withBase('projects/')} data-analytics="bento_stack">
          Все проекты →
        </a>
      </div>

      <!-- Knowledge graph -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Граф знаний</h3>
        <p class="bento-cell-heading">Исследуй связи</p>
        <p class="bento-cell-text">
          Все заметки, проекты и темы связаны в интерактивный граф. Найди путь от SQL до A/B-теста.
        </p>
        <a class="bento-cell-link" href={withBase('graph/')} data-analytics="bento_graph">
          Открыть граф →
        </a>
      </div>

      <!-- Notes -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <h3 class="bento-cell-title">Заметки</h3>
        <p class="bento-cell-heading">Продуктовая аналитика в заметках</p>
        <p class="bento-cell-text">
          Разборы методологии, чек-листы и шаблоны для повседневной работы аналитика.
        </p>
        <a class="bento-cell-link" href={withBase('writing/')} data-analytics="bento_notes">
          Читать заметки →
        </a>
      </div>

      <!-- Reading / library -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <ReadingBlock lang="ru" />
      </div>
    </div>
  </div>
</Base>
