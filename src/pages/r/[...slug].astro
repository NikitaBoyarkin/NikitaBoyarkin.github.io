---
// Outbound redirect for UTM-tagged links in slide decks (PDF/Marp).
//
// A PDF link cannot report anything on github.com, t.me or linkedin.com, so
// every link in a deck points here first: this page fires one
// `deck_link_click` event and forwards to the destination with the UTM tags
// attached. Without it the campaign dashboard stays at zero for every
// destination except this site.
//
// One static page per allowlisted target — the target list is the allowlist;
// an unknown slug is a 404, never an open redirect.
//
// Two URL shapes, one template:
//   /r/<target>/                      campaign from `?cmp=`, read by JS only
//   /r/<target>/<campaign>/           campaign baked into the path
// The second exists because the no-JS hop cannot read a query string: the
// `meta refresh` and the anchor `href` are rendered at build time, so a
// `?cmp=` value was silently dropped and every script-less click landed
// without `utm_campaign`. Placement stays in `?c=` and falls back to `deck`.
export const prerender = true;

const TARGETS = {
  github: {
    url: "https://github.com/NikitaBoyarkin",
    source: "github",
    medium: "referral",
    label: "GitHub",
  },
  telegram: {
    url: "https://t.me/lofinibo",
    source: "telegram",
    medium: "social",
    label: "Telegram",
  },
  linkedin: {
    url: "https://www.linkedin.com/in/nikita-boyarkin",
    source: "linkedin",
    medium: "social",
    label: "LinkedIn",
  },
  community: {
    url: "https://t.me/nbxplay",
    source: "telegram",
    medium: "social",
    label: "Сообщество",
  },
  site: {
    url: "https://nikitaboyarkin.github.io/",
    source: "site",
    medium: "referral",
    label: "Портфолио",
  },
} as const;

export function getStaticPaths() {
  // Literal, not `Object.keys(TARGETS)`: Astro compiles `getStaticPaths` into
  // its own prerender chunk, where module scope above is not in scope —
  // referencing TARGETS here failed the build with "TARGETS is not defined".
  const targets = ["github", "telegram", "linkedin", "community", "site"];
  // A new deck needs its campaign slug here, or its path-shaped links 404.
  const campaigns = [
    "python_files_json_202611",
    "python_list_comprehensions_202611",
    "python_datetime_202611",
  ];
  return [
    ...targets.map((target) => ({ params: { slug: target } })),
    ...targets.flatMap((target) =>
      campaigns.map((campaign) => ({ params: { slug: `${target}/${campaign}` } })),
    ),
  ];
}

const parts = (Astro.params.slug as string).split("/").filter(Boolean);
const target = parts[0] as keyof typeof TARGETS;
const pathCampaign = parts[1] ?? "";
const destination = TARGETS[target];

// `placement` comes from the query string, `campaign` from the path (or `?cmp=`).
// Build-time values are the fallback for a visitor without JavaScript.
const buildDestination = (placement: string, campaign: string) => {
  const u = new URL(destination.url);
  u.searchParams.set("utm_source", destination.source);
  u.searchParams.set("utm_medium", destination.medium);
  if (campaign) u.searchParams.set("utm_campaign", campaign);
  if (placement) u.searchParams.set("utm_content", placement);
  // Marks the visit as deck-originated: the site runs its own campaigns
  // (`header`, `featured`, …) that also carry utm_campaign, so a campaign-set
  // filter alone cannot separate decks from everything else.
  u.searchParams.set("utm_term", target);
  return u.toString();
};

const fallbackUrl = buildDestination("deck", pathCampaign);
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? "";
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Переход → {destination.label}</title>
    <link rel="canonical" href={destination.url} />
    <meta http-equiv="refresh" content={`0;url=${fallbackUrl}`} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f8f2da;
        color: #2e3440;
        font: 16px/1.5 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      a { color: #0f5b47; font-weight: 600; }
      p { margin: 0; }
    </style>
  </head>
  <body>
    <p>Переходим на <a id="out" href={fallbackUrl}>{destination.label}</a>…</p>
    <script
      is:inline
      define:vars={{
        target,
        label: destination.label,
        base: destination.url,
        source: destination.source,
        medium: destination.medium,
        pathCampaign,
        posthogKey,
        posthogHost,
      }}
    >
      // The PostHog SDK is lazily initialised on first interaction and would
      // never load here — the page leaves immediately. One beacon to the
      // capture endpoint instead, sent before the navigation, which the browser
      // flushes even as the page unloads.
      (function () {
        var params = new URLSearchParams(window.location.search);
        var placement = params.get("c") || "deck";
        var campaign = params.get("cmp") || pathCampaign;

        var url = new URL(base);
        url.searchParams.set("utm_source", source);
        url.searchParams.set("utm_medium", medium);
        if (campaign) url.searchParams.set("utm_campaign", campaign);
        url.searchParams.set("utm_content", placement);
        url.searchParams.set("utm_term", target);
        var dest = url.toString();

        var link = document.getElementById("out");
        if (link) link.setAttribute("href", dest);

        function distinctId() {
          try {
            var k = "nb_anon_id";
            var id = localStorage.getItem(k);
            if (!id) {
              id =
                (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
                String(Date.now()) + Math.random().toString(16).slice(2);
              localStorage.setItem(k, id);
            }
            return id;
          } catch (e) {
            return "anon";
          }
        }

        // Automated runs (Playwright, Lighthouse) must not land in the campaign
        // report: `navigator.webdriver` is true for a controlled browser.
        // `?test=1` is the manual escape hatch for checking a link by hand.
        // Only the event is skipped — the redirect still happens.
        var isTest = params.get("test") === "1" || navigator.webdriver === true;

        if (posthogKey && !isTest) {
          try {
            var payload = JSON.stringify({
              api_key: posthogKey,
              event: "deck_link_click",
              properties: {
                distinct_id: distinctId(),
                target: target,
                label: label,
                placement: placement,
                campaign: campaign,
                destination: dest,
                $current_url: window.location.href,
                $referrer: document.referrer || null,
              },
              timestamp: new Date().toISOString(),
            });
            // text/plain keeps this a CORS-simple request: a JSON content type
            // would trigger a preflight, which a beacon cannot survive.
            navigator.sendBeacon(
              posthogHost.replace(/\/$/, "") + "/i/v0/e/",
              new Blob([payload], { type: "text/plain" }),
            );
          } catch (e) {
            /* analytics must never block the redirect */
          }
        }

        window.location.replace(dest);
      })();
    </script>
    <noscript><p>Нажмите на ссылку выше, если переход не начался.</p></noscript>
  </body>
</html>
