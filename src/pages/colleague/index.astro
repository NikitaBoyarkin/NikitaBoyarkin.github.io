---
// `/colleague/` — the complete version. Unlike the other two it preloads the
// featured case image: this page owns the editorial hero, so the featured card
// is its LCP element (see the note in `RoleLanding.astro`).
import Base from '../../layouts/Base.astro';
import RoleLanding from '../../components/RoleLanding.astro';
import { ROLE_COPY } from '../../lib/projects';
import { withBase } from '../../lib/path';

const lang = 'ru' as const;
const copy = ROLE_COPY[lang].colleague;
---

<Base
  title={copy.title}
  description={copy.description}
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Граф контента портфолио: проекты, статьи и темы, связанные реальными ссылками. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('colleague/')}
  activeNav="home"
  lang={lang}
  counterpartHref={withBase('en/colleague/')}
  preloadImage={withBase('images/volta.svg')}
>
  <RoleLanding role="colleague" lang={lang} />
</Base>
