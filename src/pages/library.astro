---
import Base from '../layouts/Base.astro';
import ReadingBlock from '../components/ReadingBlock.astro';
import { withBase } from '../lib/path';
import { loadSources, shelfHref } from '../lib/library';

// A shelf is a grid, and a grid in the 800px prose measure reads cramped — so the
// index takes the full reading frame (`--content-max`, 1180px) that /graph/ is built
// on, while the per-source pages beneath it narrow to the reading measure, which is
// what prose is for.
const sources = await loadSources('ru');
---

<Base
  title="Библиотека | Nikita Boyarkin"
  description="Книги, курсы и статьи, на которых стоит методология: Designing Machine Learning Systems, Trustworthy Online Controlled Experiments."
  canonical={shelfHref('ru')}
  counterpartHref={shelfHref('en')}
  activeNav="library"
  lang="ru"
>
  <div class="container container-content">
    <ReadingBlock sources={sources} lang="ru" standalone />
  </div>
</Base>
