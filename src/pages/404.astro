---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/path';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', (p) => !p.data.draft)).map((p) => ({
  title: p.data.title,
  href: withBase(`projects/${p.id.replace(/\.md$/, '')}/`),
  kind: 'project',
}));
const posts = (await getCollection('posts', (p) => !p.data.draft)).map((p) => ({
  title: p.data.title,
  href: withBase(`posts/${p.id.replace(/\.md$/, '')}/`),
  kind: 'post',
}));
const index = [...projects, ...posts];
---

<Base
  title="404 | Nikita Boyarkin"
  description="Страница не найдена."
  activeNav="home"
  lang="ru"
>
  <meta slot="scripts" name="robots" content="noindex" />
  <section class="container reveal" style="text-align: center; padding-top: 4rem;">
    <h1 style="font-size: clamp(3rem, 2rem + 8vw, 6rem); margin: 0; line-height: 1; letter-spacing: -0.03em;">
      404
    </h1>
    <p id="nf-sub" style="font-size: 1.2rem; color: var(--text-muted); margin: 1rem 0 2rem;">
      Страница не найдена. Поищите проект или статью:
    </p>
    <input
      id="search404"
      type="search"
      placeholder="Поиск…"
      autocomplete="off"
      aria-label="Поиск по проектам и статьям"
      aria-controls="search-results-404"
      style="width: 100%; max-width: 480px; padding: 0.75rem 1rem; font-size: 1rem; background: var(--background-secondary); color: var(--text-normal); border: 1px solid var(--border-color); border-radius: var(--radius-md);"
    />
    <!-- Own id, not "search-results": Base.astro renders SearchBox.astro, whose
         #search-results panel comes earlier in the DOM, so getElementById here
         used to resolve to the nav's hidden listbox and this page's results were
         written into an invisible panel. -->
    <ul
      id="search-results-404"
      style="list-style: none; padding: 0; margin: 1.5rem auto 0; max-width: 600px; text-align: left;"
    ></ul>
    <p style="margin-top: 2.5rem;">
      <a id="nf-home" class="button" href={withBase('/')}>← На главную</a>
      &nbsp;·&nbsp;
      <a id="nf-writing" href={withBase('writing/')} style="color: var(--text-accent);">Все записи</a>
    </p>
  </section>

  <script is:inline set:html={`const INDEX=${JSON.stringify(index).replace(/</g, '\\u003c')};
(function(){
  var input=document.getElementById('search404');
  var out=document.getElementById('search-results-404');
  function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function render(q){
    var ql=q.trim().toLowerCase();
    var hits=ql?INDEX.filter(function(i){return i.title.toLowerCase().indexOf(ql)>=0;}).slice(0,8):INDEX.slice(0,6);
    out.innerHTML=hits.length?hits.map(function(i){return '<li style="padding:0.5rem 0; border-bottom:1px solid var(--border-color);"><a href="'+esc(i.href)+'" style="color:var(--text-normal);font-weight:500;">'+esc(i.title)+' <span style="color:var(--text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.05em;">'+esc(i.kind)+'</span></a></li>';}).join(''):'<li style="color:var(--text-muted);padding:0.5rem 0;">Ничего не найдено</li>';
  }
  input.addEventListener('input',function(){render(input.value);});
  render('');
})();`} />

  <script is:inline>
    // Lang-aware copy: if the missing page lived under /en/, swap RU strings to EN.
    (function () {
      if (location.pathname.indexOf('/en/') < 0) return;
      document.documentElement.lang = 'en';
      var sub = document.getElementById('nf-sub');
      if (sub) sub.textContent = 'Page not found. Search for a project or article:';
      var input = document.getElementById('search404');
      if (input) {
        input.placeholder = 'Search…';
        input.setAttribute('aria-label', 'Search projects and articles');
      }
      var home = document.getElementById('nf-home');
      if (home) home.textContent = '← Home';
      var writing = document.getElementById('nf-writing');
      if (writing) writing.textContent = 'All writing';
    })();
  </script>
</Base>