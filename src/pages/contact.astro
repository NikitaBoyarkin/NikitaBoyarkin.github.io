---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import LinkedInBadge from '../components/LinkedInBadge.astro';
import { withBase } from '../lib/path';
import { CAL_BOOKING_URL, CONTACT_FORM_ENABLED } from '../lib/contact';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent('Привет! Обсудим продуктовую аналитику / роли аналитика.')}`;
---

<Base title="Контакты | Nikita Boyarkin" description="Связаться с Никитой Бояркиным — продуктовая аналитика, A/B-тестирование, сотрудничество." activeNav="contact" canonical={withBase('contact/')} lang="ru" counterpartHref={withBase('en/contact/')}>
  <section class="container container-content reveal">
    <h1 class="contact-title">Связаться</h1>
    <p class="contact-text">
      Хотите обсудить product-аналитику, A/B-тестирование или формат сотрудничества — я открыт к разговорам.
      Открыт к Data / Product Analyst ролям.
    </p>

    <div class="contact-layout">
      {
        CONTACT_FORM_ENABLED && (
          <div class="contact-form-wrap">
            <ContactForm locale="ru" />

            <p class="contact-note">
              Отправляя форму, вы соглашаетесь на обработку указанных данных для ответа на обращение.
              Имя, контакт и текст сообщения хранятся в защищённой базе; IP не сохраняется.
            </p>
          </div>
        )
      }

      <div class="cta-row">
        <a
          href={CAL_BOOKING_URL}
          class="button"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="booking_click">Записаться на 30 минут</a
        >
        <a
          href={tgDeepLink}
          class="button button-secondary"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="telegram_deeplink">Написать в Telegram →</a
        >
      </div>

      <div class="board-card">
        <h2 class="look-title">Другие способы связи</h2>
        <div class="contact-channels">
          <a
            href="https://t.me/lofinibo"
            class="contact-email"
            data-analytics="telegram_contact"
            target="_blank"
            rel="noopener noreferrer">Telegram: @lofinibo</a
          >
          <a
            href="https://www.linkedin.com/in/nikita-boyarkin"
            class="contact-email"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
        </div>
      </div>

      <div class="board-card look-card">
        <h2 class="look-title">Что я ищу</h2>
        <dl class="look-grid">
          <div class="look-item">
            <dt>Роль</dt>
            <dd>Data / Product Analyst · middle</dd>
          </div>
          <div class="look-item">
            <dt>Стек</dt>
            <dd>SQL · Python · A/B-эксперименты · продуктовые метрики</dd>
          </div>
          <div class="look-item">
            <dt>Формат</dt>
            <dd>Открыт к ролям — формат сотрудничества обсудим</dd>
          </div>
        </dl>
      </div>
    </div>

    <LinkedInBadge lang="ru" />
  </section>
</Base>
