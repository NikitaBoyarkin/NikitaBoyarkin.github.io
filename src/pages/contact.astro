---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { withBase } from '../lib/path';
import { CAL_BOOKING_URL, CONTACT_FORM_ENABLED } from '../lib/contact';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent('Привет! Обсудим продуктовую аналитику / роли аналитика.')}`;
const LINKEDIN_URL = 'https://www.linkedin.com/in/nikita-boyarkin';
---

<Base title="Контакты | Nikita Boyarkin" description="Связаться с Никитой Бояркиным — продуктовая аналитика, A/B-тестирование, сотрудничество." activeNav="contact" canonical={withBase('contact/')} lang="ru" counterpartHref={withBase('en/contact/')}>
  <section class="container reveal">
    <h1 class="contact-title">Связаться</h1>
    <p class="contact-text">
      Три входа: свободный слот, Telegram или LinkedIn. Отвечаю в течение дня.
    </p>

    <div class="contact-layout">
      {
        CONTACT_FORM_ENABLED && (
          <div class="contact-form-wrap">
            <ContactForm locale="ru" />

            <p class="contact-note">
              Отправляя форму, вы соглашаетесь на обработку указанных данных для ответа на обращение.
              Имя, контакт и текст сообщения хранятся в защищённой базе; IP не сохраняется.
            </p>
          </div>
        )
      }

      <div class="cta-row contact-cta">
        <a
          href={CAL_BOOKING_URL}
          class="button"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="booking_click"
          data-analytics-surface="contact_cta">Выбрать свободный слот</a
        >
        <a
          href={tgDeepLink}
          class="button button-secondary"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="telegram_deeplink"
          data-analytics-surface="contact_cta">Написать в Telegram →</a
        >
        <a
          href={LINKEDIN_URL}
          class="contact-inline-link"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="linkedin_contact"
          data-analytics-surface="contact_cta">LinkedIn →</a
        >
      </div>

      <div class="board-card look-card">
        <h2 class="look-title">Что я ищу</h2>
        <dl class="look-grid">
          <div class="look-item">
            <dt>Роль</dt>
            <dd>Data / Product Analyst · junior</dd>
          </div>
          <div class="look-item">
            <dt>Стек</dt>
            <dd>SQL · Python · A/B-эксперименты · продуктовые метрики</dd>
          </div>
          <div class="look-item">
            <dt>Формат</dt>
            <dd>Полная занятость · Москва · удалёнка или гибрид</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>
