---
// `/manager/` — thin wrapper, see `hr/index.astro`.
import Base from '../../layouts/Base.astro';
import RoleLanding from '../../components/RoleLanding.astro';
import { ROLE_COPY } from '../../lib/projects';
import { withBase } from '../../lib/path';

const lang = 'ru' as const;
const copy = ROLE_COPY[lang].manager;
---

<Base
  title={copy.title}
  description={copy.description}
  canonical={withBase('manager/')}
  activeNav="home"
  lang={lang}
  counterpartHref={withBase('en/manager/')}
>
  <RoleLanding role="manager" lang={lang} />
</Base>
