---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AboutPage from '../components/AboutPage.astro';
import { withBase } from '../lib/path';

// Body copy lives in src/content/about/ru.mdx — see AboutPage.astro.
const entry = await getEntry('about', 'ru');
if (!entry) throw new Error('missing src/content/about/ru.mdx');

// ProfilePage rather than a bare Person: the page is the profile. `knowsAbout`
// and `alumniOf` are what turn it into something a knowledge panel can use —
// the same claims the visible page makes (see AboutPage.astro). `image` and
// `jobTitle` repeat what Base's Person node already says (`images/00_profile.jpg`,
// `Product Analyst`): a second declaration that disagrees splits the entity
// instead of reinforcing it. Base still owns the `@id`, so none is set here.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Nikita Boyarkin',
    jobTitle: 'Product Analyst',
    url: 'https://nikitaboyarkin.github.io/about/',
    image: 'https://nikitaboyarkin.github.io/images/00_profile.jpg',
    description:
      'Аналитик данных и продуктовый аналитик. Эксперименты, retention, сегментация — с кодом, SQL и воспроизводимой методологией.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Moscow',
      addressCountry: 'RU',
    },
    knowsAbout: [
      'A/B testing',
      'CUPED',
      'AA-tests',
      'Retention analysis',
      'Cohort analysis',
      'RFM segmentation',
      'SQL',
      'Python',
    ],
    alumniOf: [
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'BSc, Business informatics, 2016–2020' },
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'MSc, Work psychology, 2020–2022' },
      // The doctoral programme, named as a programme: the dissertation is not
      // defended, so this is not a `hasCredential` degree — see PRODUCT.md,
      // «Учёная степень не заявляется».
      { '@type': 'EducationalOrganization', name: 'UMC', description: 'Doctoral programme, Work psychology, 2022–2025' },
    ],
    sameAs: [
      'https://github.com/NikitaBoyarkin',
      'https://www.linkedin.com/in/nikita-boyarkin',
    ],
  },
};
---

<Base
  title="Обо мне | Nikita Boyarkin"
  description="Обо мне — Data Analyst / Product Analyst. Кто я, опыт и образование, стек, что сейчас в работе и как со мной сотрудничать."
  canonical={withBase('about/')}
  activeNav="about"
  lang="ru"
  counterpartHref={withBase('en/about/')}
  jsonLd={jsonLd}
>
  <AboutPage entry={entry} />
</Base>
