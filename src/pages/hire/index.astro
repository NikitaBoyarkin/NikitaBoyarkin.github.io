---
// `/hire/` — one page, three bodies. Until 2026-11-15 this was a hub of three
// cards over three separate routes (`/hire/{hr,manager,colleague}/`); the owner's
// call was to merge them so the reader switches lanes without a navigation.
// The cost is measured and accepted: the three bodies in one document are ~950 KB
// of HTML. All three stay in the served markup (crawler and JS-off reader get the
// whole page); the tab strip only decides which one paints.
//
// The panel ids are namespaced for the same reason: an id is unique per document,
// and the three bodies write `intro`, `projects`, `projects-heading`, the filter
// status span and the year headings. `idPrefix` is what keeps them apart.
import Base from '../../layouts/Base.astro';
import RoleLanding from '../../components/RoleLanding.astro';
import RoleTabs from '../../components/RoleTabs.astro';
import { AUDIENCES } from '../../lib/projects';
import { withBase } from '../../lib/path';

const lang = 'ru' as const;
// The default panel. `RoleTabs` owns the live value (hash → stored → this), but
// the pre-paint script below has to hard-code the same fallback: it runs before
// any module, and a panel that flashes the wrong body is exactly what it exists
// to prevent.
const DEFAULT = 'colleague';
---

<Base
  title="Найм | Nikita Boyarkin"
  description="Одно портфолио, три входа: HR сверяет вакансию, менеджер ищет результат, коллега — метод. Переключение по табам."
  ogImage="/images/og/portfolio-graph-v2.png"
  ogImageAlt="Граф контента портфолио: проекты, статьи и темы, связанные реальными ссылками. Nikita Boyarkin — Product / Data Analyst."
  canonical={withBase('hire/')}
  activeNav="hire"
  lang={lang}
  counterpartHref={withBase('en/hire/')}
  preloadImage={withBase('images/volta.svg')}
>
  <header class="hire-head">
    <h1>Найм</h1>
    <p class="hire-lead">
      Одно портфолио, три входа. Переключитесь на тот, что совпадает с вашей задачей.
    </p>
  </header>

  {/* Before the panels, on purpose: `is:inline` keeps the script in place
      instead of hoisting it to a bundle that loads after the body. It sets the
      attribute the panels' hiding rule keys on, so no wrong body paints. */}
  <script is:inline>
    (function () {
      var role = (location.hash || '').replace(/^#/, '');
      var valid = ['hr', 'manager', 'colleague'];
      if (valid.indexOf(role) === -1) {
        try {
          role = window.localStorage.getItem('audience');
        } catch (error) {
          role = null;
        }
      }
      if (valid.indexOf(role) === -1) role = 'colleague';
      document.documentElement.setAttribute('data-hire-tab', role);
    })();
  </script>

  <RoleTabs lang={lang} />

  {
    AUDIENCES.map((role) => (
      <section
        id={`role-panel-${role}`}
        data-role-panel={role}
        role="tabpanel"
        aria-labelledby={`role-tab-${role}`}
        tabindex="0"
      >
        <RoleLanding role={role} lang={lang} headingLevel={2} idPrefix={role} />
      </section>
    ))
  }
</Base>

<style>
  /* No wrapper paddings: `<body>` already owns the page gutter and the 1000px
     frame, and every body inside keeps its own `.intro-container` edges. */
  .hire-head {
    padding-top: var(--space-4);
  }

  .hire-head h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .hire-lead {
    max-width: 60ch;
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
  }
</style>
