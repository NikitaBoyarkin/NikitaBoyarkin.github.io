---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectBoard from '../../components/ProjectBoard.astro';
import { withBase } from '../../lib/path';
import { sortByProjectOrder } from '../../lib/projects';

// Catalog-level rich result: the board is a list of projects, so it earns a
// CollectionPage + ItemList. Positions follow the board's visible order
// (PROJECT_ORDER via sortByProjectOrder) so the markup matches what renders.
const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const projects = sortByProjectOrder(await getCollection('projects', (p) => !p.data.draft));
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Проекты',
  url: `${siteUrl}${withBase('projects/')}`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.data.title,
      url: `${siteUrl}${withBase(`projects/${project.id.replace(/\.md$/, '')}/`)}`,
    })),
  },
};
---

<Base
  title="Проекты | Nikita Boyarkin"
  description="Каталог проектов по продуктовой аналитике: A/B-тесты, retention, дашборды. Фильтр по категориям и инструментам, проекты на всю ширину страницы."
  activeNav="projects"
  lang="ru"
  canonical={withBase('projects/')}
  counterpartHref={withBase('en/projects/')}
  jsonLd={collectionJsonLd}
>
  <div class="projects-page">
    <h1 class="page-title reveal">Проекты</h1>

    <p class="reveal page-intro" style="color: var(--text-muted); margin-bottom: var(--space-4); max-width: 60ch;">
      Выбери категорию, чтобы увидеть её проекты на всю ширину, и отфильтруй по инструменту.
      Порядок карточек внутри категории можно менять перетаскиванием за три точки (или стрелками ↑/↓) —
      он сохраняется локально в браузере.
    </p>

    <ProjectBoard heading="Каталог проектов" />
  </div>
</Base>