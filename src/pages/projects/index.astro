---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectBoard from '../../components/ProjectBoard.astro';
import ProjectViews from '../../components/ProjectViews.astro';
import NextStep from '../../components/NextStep.astro';
import { withBase } from '../../lib/path';
import { sortByProjectOrder } from '../../lib/projects';
import { scanDemos } from '../../lib/demos';

// Catalog-level rich result: the board is a list of projects, so it earns a
// CollectionPage + ItemList. Positions follow the board's visible order
// (PROJECT_ORDER via sortByProjectOrder) so the markup matches what renders.
const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const projects = sortByProjectOrder(await getCollection('projects', (p) => !p.data.draft));
// The hub's own count, scanned from disk — a literal here would be the drift
// the demos module exists to prevent.
const demoCount = scanDemos().length;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Проекты',
  url: `${siteUrl}${withBase('projects/')}`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.data.title,
      url: `${siteUrl}${withBase(`projects/${project.id.replace(/\.md$/, '')}/`)}`,
    })),
  },
};
---

<Base
  title="Проекты | Nikita Boyarkin"
  description="Каталог проектов по продуктовой аналитике: A/B-тесты, retention, дашборды. Четыре вида: по трекам, реальные данные, свежие, таблица."
  activeNav="projects"
  lang="ru"
  canonical={withBase('projects/')}
  counterpartHref={withBase('en/projects/')}
  jsonLd={collectionJsonLd}
>
  <div class="projects-page">
    <h1 class="page-title reveal">Проекты</h1>

    {/* Four lenses over one catalogue (the owner's Bases file, made a page):
        by track, on real data, freshest, and as a table. The board is the
        default lens and keeps its own filters and sort; `ProjectViews` owns the
        switch and the three extra panels. */}
    <ProjectViews collection="projects" lang="ru">
      <ProjectBoard starPreview="none" grouped sphereFilter />
    </ProjectViews>

    <p class="projects-demos-link">
      <a href={withBase('demos/')}>{demoCount} интерактивных демо →</a>
    </p>

    <NextStep lang="ru" surface="projects_index" variant="catalog" />
  </div>
</Base>

<style>
  .projects-demos-link {
    margin: var(--space-6) 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .projects-demos-link a {
    color: var(--text-accent);
    text-decoration: none;
  }

  .projects-demos-link a:hover {
    color: var(--text-accent-hover);
    text-decoration: underline;
  }

  .projects-demos-link a:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>

