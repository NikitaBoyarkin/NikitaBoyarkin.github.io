---
import Base from '../../layouts/Base.astro';
import ProjectBoard from '../../components/ProjectBoard.astro';
import { withBase } from '../../lib/path';
---

<Base
  title="Проекты | Nikita Boyarkin"
  description="Каталог проектов по продуктовой аналитике: A/B-тесты, retention, дашборды. Фильтр по категориям и инструментам, проекты на всю ширину страницы."
  activeNav="projects"
  lang="ru"
  counterpartHref={withBase('en/projects/')}
>
  <div class="projects-page">
    <h1 class="page-title reveal">Проекты</h1>

    <p class="reveal page-intro" style="color: var(--text-muted); margin-bottom: var(--space-4); max-width: 60ch;">
      Выбери категорию, чтобы увидеть её проекты на всю ширину, и отфильтруй по инструменту.
      Порядок карточек внутри категории можно менять перетаскиванием за три точки (или стрелками ↑/↓) —
      он сохраняется локально в браузере.
    </p>

    <ProjectBoard heading="Каталог проектов" />
  </div>
</Base>