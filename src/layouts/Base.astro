---
import '../styles/global.css';
import '../styles/blog.css';
// Prose layer last, so equal-specificity rules resolve to it.
import '../styles/prose.css';
import 'katex/dist/katex.min.css';
// Dashboard last: its opening block lifts global.css's one-screen lock for the
// homepage that renders the dashboard, and at equal specificity the later file
// wins (the same reason prose.css sits after blog.css).
import '../styles/dashboard.css';
import { BRAND_ICON, ICON } from '../lib/icons';
import { withBase } from '../lib/path';
import Analytics from '../components/Analytics.astro';
import LangSwitch from '../components/LangSwitch.astro';
import NavRoles from '../components/NavRoles.astro';
import SearchBox from '../components/SearchBox.astro';
import SiteTabs from '../components/SiteTabs.astro';
import MorphIcon from 'morphicons/astro';
import BeaconMetrics from '../components/BeaconMetrics.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  relPrev?: string;
  relNext?: string;
  activeNav?:
    | 'writing'
    | 'contact'
    | 'home'
    | 'about'
    | 'projects'
    | 'glossary'
    | 'graph'
    | 'library'
    | 'explorer'
    | 'topics';
  jsonLd?: Record<string, unknown>;
  lang?: 'ru' | 'en';
  counterpartHref?: string;
  /** Above-the-fold image that is the page's LCP element — preloaded in <head>. */
  preloadImage?: string;
  /**
   * Render the page as one full-bleed screen: the canvas spans the whole
   * window and the document is locked to `100dvh` so it never scrolls. Marks
   * <html> with `canvas-fullbleed`, which global.css keys the lock off; the
   * lock is additionally gated on the canvas being live, so a phone or a
   * JavaScript-off visitor still gets the ordinary scrolling document. Only
   * `/` and `/en/` pass it — every other page keeps its reading column.
   */
  canvasFullBleed?: boolean;
  /** Full-width page: lifts the body's own width cap and gutter so a board can
   *  run edge to edge. Unlike `canvasFullBleed` it locks nothing — the document
   *  still scrolls. Only `/graph/` and `/en/graph/` pass it. */
  bleed?: boolean;
  /** Keep the page out of search indexes. Emitted in `<head>` — a `robots` meta
   *  rendered from a body slot is ignored by crawlers, which is how /404/ was
   *  indexable despite carrying one. */
  noindex?: boolean;
}

const {
  title,
  description = 'Nikita Boyarkin — Data Analyst / Product Analyst portfolio. SQL, Python, Visualization, A/B Testing.',
  keywords = [],
  ogType = 'website',
  ogImage = '/images/og/portfolio-banner-v2.png',
  ogImageAlt = 'Nikita Boyarkin — Product / Data Analyst. Portfolio.',
  canonical,
  relPrev,
  relNext,
  activeNav = 'home',
  jsonLd,
  lang = 'ru',
  counterpartHref,
  preloadImage,
  canvasFullBleed = false,
  bleed = false,
  noindex = false,
} = Astro.props;

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const pageUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${withBase(ogImage)}`;
const faviconUrl = withBase('favicon.svg');

// Search-result snippet: clamped to ~160 characters on a word boundary. The
// authored `description:` is 120–200 chars (PRD D12) and stays full for
// og/twitter, but Google truncates near 155–160, so an untruncated long line was
// cut mid-phrase in the results. Only <meta name="description"> is clamped.
const metaDescription = (() => {
  const d = description.trim();
  if (d.length <= 160) return d;
  const cut = d.slice(0, 157);
  const at = cut.lastIndexOf(' ');
  return `${at > 0 ? cut.slice(0, at) : cut}…`;
})();

// i18n: locale-aware nav hrefs + hreflang alternates.
const isEn = lang === 'en';
const homeHref = isEn ? withBase('en/') : withBase('/');
const aboutHref = isEn ? withBase('en/about/') : withBase('about/');
const projectsHref = isEn ? withBase('en/projects/') : withBase('projects/');
const contactHref = isEn ? withBase('en/contact/') : withBase('contact/');
const glossaryHref = isEn ? withBase('en/glossary/') : withBase('glossary/');
const graphHref = isEn ? withBase('en/graph/') : withBase('graph/');
const libraryHref = isEn ? withBase('en/library/') : withBase('library/');
const writingHref = isEn ? withBase('en/writing/') : withBase('writing/');
const explorerHref = isEn ? withBase('en/explorer/') : withBase('explorer/');
// Topics is RU-only — there is no /en/topics/ — so both locales point at the one
// route, exactly as `repoAuditHref` below is shared across locales.
const topicsHref = withBase('topics/');
const repoAuditHref = withBase('repo-audit/');

// Which role landing (if any) this page is, so NavRoles can mark it current
// (`aria-current="page"`) the way the drawer's own links do. Derived from the
// URL because the role routes pass `activeNav="home"`, not their own key.
const activeRole = Astro.url.pathname.match(/^\/(?:en\/)?(hr|manager|colleague)\/?$/)?.[1];

// Which inline/drawer entry the current URL belongs to. The topics and explorer
// routes inherit `activeNav="home"`, so without this their own drawer row would
// never mark itself current — the same reason `activeRole` above derives from
// the pathname instead of trusting the passed prop.
const urlActiveNav = /^\/(?:en\/)?explorer\/?$/.test(Astro.url.pathname)
  ? 'explorer'
  : /^\/topics(?:\/|$)/.test(Astro.url.pathname)
    ? 'topics'
    : null;
const isNavCurrent = (key: string) => activeNav === key || urlActiveNav === key;

// i18n: header / footer chrome labels.
const t = {
  skip: isEn ? 'Skip to content' : 'Перейти к содержимому',
  navHome: isEn ? 'Home' : 'Главная',
  navProjects: isEn ? 'Projects' : 'Проекты',
  navAbout: isEn ? 'About' : 'Обо мне',
  navGlossary: isEn ? 'Glossary' : 'Словарь',
  navGraph: isEn ? 'Graph' : 'Граф',
  navLibrary: isEn ? 'Library' : 'Библиотека',
  navWriting: isEn ? 'Writing' : 'Статьи',
  navRepoAudit: isEn ? 'Repo audit' : 'Аудит репозиториев',
  navExplorer: isEn ? 'Explorer' : 'Обозреватель',
  navTopics: isEn ? 'Topics' : 'Темы',
  navContact: isEn ? 'Contact' : 'Контакты',
  // The footer's own label. «Связаться» reads as an action and matches the
  // /contact/ heading, while the drawer button stays the noun «Контакты».
  footerContact: isEn ? 'Get in touch' : 'Связаться',
  navOpen: isEn ? 'Open menu' : 'Открыть меню',
  navClose: isEn ? 'Close menu' : 'Закрыть меню',
  themeTitle: isEn ? 'Theme: dark / light / cyberpunk' : 'Тема: тёмная / светлая / киберпанк',
  themeLabel: isEn ? 'Theme: ' : 'Тема: ',
  themeCycle: isEn ? '. Click to cycle.' : '. Нажмите для смены.',
};

// The drawer's links, in order, each with a 24×24 stroke glyph. `icon` holds
// only the *inner* markup, so the rows share one <svg> scaffold in the template
// instead of hand-rolled copies that could drift apart. The glyphs themselves
// come from `src/lib/icons.ts` — a component references a NAME, never a path —
// so `set:html` only ever receives a module literal, nothing a visitor controls.
const navLinks = [
  {
    key: 'home',
    href: homeHref,
    label: t.navHome,
    icon: ICON.home,
  },
  {
    key: 'projects',
    href: projectsHref,
    label: t.navProjects,
    icon: ICON.projects,
  },
  {
    key: 'about',
    href: aboutHref,
    label: t.navAbout,
    icon: ICON.about,
  },
  {
    key: 'glossary',
    href: glossaryHref,
    label: t.navGlossary,
    icon: ICON.glossary,
  },
  {
    key: 'graph',
    href: graphHref,
    label: t.navGraph,
    icon: ICON.graph,
  },
  {
    key: 'library',
    href: libraryHref,
    label: t.navLibrary,
    icon: ICON.library,
  },
  {
    key: 'writing',
    href: writingHref,
    label: t.navWriting,
    icon: ICON.writing,
  },
  {
    key: 'explorer',
    href: explorerHref,
    label: t.navExplorer,
    icon: ICON.explorer,
  },
  {
    key: 'topics',
    href: topicsHref,
    label: t.navTopics,
    icon: ICON.topics,
  },
  {
    key: 'repo-audit',
    href: repoAuditHref,
    label: t.navRepoAudit,
    icon: ICON['repo-audit'],
  },
] as const;

// The destination rendered inline in the top bar. It used to be a measured
// cutover over six links; the bar now surfaces exactly one — the way home — and
// everything else lives in the drawer. The six that left the bar are still
// `navLinks` rows, so the drawer keeps every destination reachable; only the
// bar's width budget changed, which is why the breakpoint below dropped with it.
const INLINE_NAV_KEYS = ['home'] as const;
const inlineNavLinks = INLINE_NAV_KEYS.map((key) => navLinks.find((l) => l.key === key)!);

const counterpartUrl = counterpartHref ? `${siteUrl}${counterpartHref}` : null;
const ruAltUrl = isEn ? counterpartUrl : pageUrl;
const enAltUrl = isEn ? pageUrl : counterpartUrl;

// Site-level JSON-LD, emitted on every page. No `SearchAction`: the search box
// is a client-side filter over /search-index.json with no addressable query
// URL, and advertising a template that 404s is worse than advertising none.
//
// Stable `@id`s: the WebSite and Person nodes get absolute fragment ids so other
// pages can reference the same entities instead of redeclaring them, and so a
// crawler merges the Person on /projects/volta/ with the Person here. Every
// property that was here before is kept — `@id`, `image` and `sameAs` are added.
const personId = `${siteUrl}${withBase('/')}#person`;
const websiteId = `${siteUrl}${withBase('/')}#website`;
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'Nikita Boyarkin',
  url: `${siteUrl}${withBase('/')}`,
  inLanguage: isEn ? 'en' : 'ru',
  author: {
    '@type': 'Person',
    '@id': personId,
    name: 'Nikita Boyarkin',
    url: `${siteUrl}${withBase('/')}`,
    image: `${siteUrl}${withBase('images/00_profile.jpg')}`,
    // The three identity links the top bar already ships. Telegram was missing
    // even though it is in that bar and in llms.txt.
    sameAs: [
      'https://github.com/NikitaBoyarkin',
      'https://www.linkedin.com/in/nikita-boyarkin',
      'https://t.me/lofinibo',
    ],
  },
};

// Theme-toggle icons (lucide-style stroke paths, 24×24). Moved to plain
// `d` strings so morphicons can animate between them without a lucide dep.
const THEME_MOON = 'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z';
const THEME_SUN =
  'M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42';
const THEME_CYBER = 'M13 2 3 14 12 14 11 22 21 10 12 10 13 2z';
const NAV_MENU = 'M4 6h16M4 12h16M4 18h16';
const NAV_CLOSE = 'M6 6l12 12M6 18L18 6';
---

{
  /* `canvas-static` marks the canvas as NOT live. It ships in the SSR HTML, so
     with JavaScript off the homepage renders as the static, stacked list the
     canvas rules fall back to (see the canvas block at the end of global.css).
     CanvasStage's synchronous pre-paint script removes it only once it has
     confirmed a wide viewport, which keeps the no-flash property — and the
     module script adds it back if its own initialisation throws.

     `canvas-fullbleed` is a different thing entirely and ships on the homepage
     only: it widens the page past the reading column and locks it to one
     screen. Unlike `canvas-static` it is never removed — it is the static
     marker that tells the stylesheet "this is the board page", so global.css
     can gate the lock on `canvas-static` being absent without losing the page
     identity when it is present. */
}
<!doctype html>
<html
  lang={lang}
  data-theme="dark"
  class:list={['canvas-static', { 'canvas-fullbleed': canvasFullBleed, bleed }]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {canonical && <link rel="canonical" href={pageUrl} />}
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    {ruAltUrl && <link rel="alternate" hreflang="ru" href={ruAltUrl} />}
    {enAltUrl && <link rel="alternate" hreflang="en" href={enAltUrl} />}
    {/* x-default falls back to the page itself: a page with no counterpart is
        still the only version of itself, and emitting nothing tells crawlers
        the page opts out of i18n entirely. */}
    <link rel="alternate" hreflang="x-default" href={ruAltUrl ?? pageUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    {/* iOS ignores SVG here and falls back to a screenshot of the page. The PNG
        is the same mark, generated from `favicon.svg` at 180×180. */}
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={isEn ? 'Nikita Boyarkin — Writing' : 'Nikita Boyarkin — Заметки'}
      href={withBase(isEn ? 'en/rss.xml' : 'rss.xml')}
    />

    {
      /* LCP: preload the font subsets used above the fold so the hero heading
         renders in the final font as early as possible.
         Inter and Cormorant are variable fonts — one woff2 per subset covers
         all weights. Latin is always needed ("Nikita Boyarkin"); add the
         script subset for the active language. crossorigin is required for
         font preloads. */
      [
        'inter-latin.woff2',
        ...(isEn ? ['inter-latin-ext.woff2'] : ['inter-cyrillic.woff2']),
        'cormorant-latin.woff2',
        ...(isEn ? ['cormorant-latin-ext.woff2'] : ['cormorant-cyrillic.woff2']),
      ].map((f) => (
        <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={withBase(`fonts/${f}`)} />
      ))
    }
    {
      /* LCP: the hero image is the largest-contentful element on `/` and `/en/`,
         but it sits deep in a ~75 KB document — without a hint the browser only
         starts fetching it after parsing past the hero copy, which cost ~1.1 s
         between FCP and LCP in prod (2.74 s / 2.97 s vs a ≤2.5 s budget).
         A head preload starts the request with the document instead.
         `href` must match the `<img src>` exactly or the browser fetches twice. */
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
    <meta id="theme-color" name="theme-color" content="#1400c3" />

    <meta property="og:site_name" content="Nikita Boyarkin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
      )
    }
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd).replace(/</g, '\\u003c')} />

    {
      /* No-JS fallback: `.reveal` starts at opacity 0 and only an
         IntersectionObserver adds `.visible`. With scripting off the observer
         never runs and the whole catalog — cards included — stays invisible,
         so restore the revealed state here. `@media (scripting: none)` in
         global.css covers the same case for engines that honour it. */
    }
    <noscript><style>.reveal{opacity:1;transform:none}</style></noscript>

    <script is:inline>
      // Prevent theme flash: apply saved or preferred theme before first paint.
      // Three themes: dark (default), light, cyberpunk.
      (function () {
        const html = document.documentElement;
        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#1400c3', light: '#f4efca', cyberpunk: '#171717' };
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        let theme = prefersDark ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light' || saved === 'cyberpunk') theme = saved;
        } catch (e) {
          // localStorage may be unavailable
        }
        html.setAttribute('data-theme', theme);
        if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
      })();

      // Prevent audience flash: apply the stored persona before the first paint
      // so the role switcher and the board render in the chosen state
      // immediately. Three values, mirrored from `AUDIENCES` in
      // `src/lib/projects.ts` — this script is `is:inline`, so it cannot import
      // them; `tests/lib/projects.test.ts` binds the copy.
      (function () {
        const html = document.documentElement;
        let audience = 'colleague';
        try {
          const saved = localStorage.getItem('audience');
          if (saved === 'hr' || saved === 'manager' || saved === 'colleague') audience = saved;
        } catch (e) {
          // localStorage may be unavailable
        }
        html.setAttribute('data-audience', audience);
      })();
    </script>

    <Analytics />
    <BeaconMetrics />
  </head>

  <body>
    <a href="#main" class="skip-link">{t.skip}</a>

    {
      /* The navigation is an off-canvas drawer, so the trigger has to live
         outside it — a control inside a translated panel scrolls away with the
         panel. The bar carries the brand for the closed state and the drawer
         carries its own copy; both are visible only while the drawer is open,
         and the drawer paints over the bar there. */
    }
    <header class="nav-mobile">
      <a href={aboutHref} class="nav-brand">
        <svg class="nav-brand-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.about} />
        <b>Nikita Boyarkin</b>
      </a>
      {/* The three audience landings, one tap from the top bar. They read as a
          left-hand cluster with the brand ("who" + "viewing as"); the outbound
          chips stay pushed right by their own auto margin. */}
      <NavRoles lang={lang} active={activeRole} />
      {/* Inline site navigation, from the measured cutover (see the <style>
          block). Below that the bar has no room for links *and* the persona group
          *and* the chips, so the drawer stays the sole route and this list is
          `display: none` (out of the a11y tree and the tab order). It carries the
          same `aria-current` contract as the drawer's rows. */}
      <ul class="nav-inline">
        {inlineNavLinks.map((item) => (
          <li>
            <a href={item.href} aria-current={isNavCurrent(item.key) ? 'page' : undefined}>
              <svg
                class="nav-inline-icon"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={item.icon}
              />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      {/* The site's off-site links live in the top bar, next to the brand they
          belong to. The event names keep their `_footer` suffix: PostHog series
          (`github_footer` in the B3 repo-click rate) are read over time, and a
          rename would silently split them. From 1200px up the chips drop their
          visible labels (icon only, name kept visually hidden) to pay for
          `.nav-inline`. */}
      <div class="nav-chips">
        <a class="nav-chip" href="https://github.com/NikitaBoyarkin" data-analytics="github_footer">
          <svg class="chip-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false" set:html={BRAND_ICON.github} />
          <span class="nav-chip-label">GitHub</span></a
        >
        <a class="nav-chip" href="https://www.linkedin.com/in/nikita-boyarkin" data-analytics="linkedin_footer">
          <svg class="chip-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false" set:html={BRAND_ICON.linkedin} />
          <span class="nav-chip-label">LinkedIn</span></a
        >
        <a class="nav-chip" href="https://t.me/lofinibo" data-analytics="telegram_footer">
          <svg class="chip-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false" set:html={BRAND_ICON.telegram} />
          <span class="nav-chip-label">Telegram</span></a
        >
      </div>

      {/* Theme toggle — moved to the always-visible top bar. It is a global
          preference, and the drawer it used to live in is closed by default. */}
      <button id="theme-toggle" class="theme-toggle" aria-label={`${t.themeLabel}dark${t.themeCycle}`} data-theme-label={t.themeLabel} data-theme-cycle={t.themeCycle} type="button" title={t.themeTitle} data-icon-dark={THEME_MOON} data-icon-light={THEME_SUN} data-icon-cyber={THEME_CYBER}>
        <MorphIcon id="theme-icon" icon={THEME_MOON} spring="snappy" reducedMotion="user" size={18} />
      </button>

      <button id="nav-toggle" class="nav-toggle" type="button" aria-label={t.navOpen} aria-expanded="false" aria-controls="nav-links" data-label-open={t.navOpen} data-label-close={t.navClose} data-icon-menu={NAV_MENU} data-icon-close={NAV_CLOSE}>
        <MorphIcon id="nav-icon" icon={NAV_MENU} spring="snappy" reducedMotion="user" size={20} />
      </button>
    </header>

    {/* Browser-style strip of the pages opened this session. In flow, not
        sticky: the drawer, the projects filter bar and the graph overlay all
        pin themselves at `--nav-mobile-h`, and a second sticky row would move
        their offsets out from under them. */}
    <SiteTabs lang={lang} />

    <nav id="site-nav" aria-label={isEn ? 'Main navigation' : 'Основная навигация'}>
      <a href={aboutHref} class="nav-brand">
        <svg class="nav-brand-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.about} />
        <b>Nikita Boyarkin</b>
      </a>
      {/* On phones the top bar yields the persona buttons to this copy (see
          NavRoles.astro) — inside the drawer there is room for the full labels. */}
      <NavRoles lang={lang} variant="menu" active={activeRole} />
      {/* Utilities sit above the primary links: the search dropdown opens
          downward from its toggle, and at the rail's bottom edge there was no
          room for it. Search + language share one row; the theme toggle now
          lives in the top bar, so it is reachable with the drawer closed. */}
      <div class="nav-aux">
        <div class="nav-tools">
          {counterpartHref && <LangSwitch locale={lang} counterpartHref={counterpartHref} />}
          <SearchBox lang={lang} />
        </div>
        <a class="button nav-cta" href={contactHref}>
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={ICON.contact}
          />
          {t.navContact}
        </a>
      </div>

      <ul class="links" id="nav-links">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class={isNavCurrent(item.key) ? 'active' : ''}
                aria-current={isNavCurrent(item.key) ? 'page' : undefined}
              >
                <svg
                  class="link-icon"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  set:html={item.icon}
                />
                <span>{item.label}</span></a
              >
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-scrim" id="nav-scrim"></div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {/* The footer owns a route to contact on every page (it already carried
        `id="contact"`). Every persona landing, project and post used to end with
        no next step at all: the only link to /contact/ was the drawer's button,
        behind a hamburger. A direct booking link deliberately does NOT live here
        — the owner's call, frozen by `tests/lib/persona.test.ts`, is that it
        fires only from /contact; see the note next to `footer p` in global.css. */}
    <footer id="contact">
      <div class="footer-actions">
        <a class="button button-secondary footer-contact" href={contactHref}>
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={ICON.contact}
          />
          {t.footerContact}
        </a>
      </div>
      <p>© {new Date().getFullYear()} Nikita Boyarkin</p>
    </footer>

    <script is:inline>
      // Theme toggle — cycles dark → light → cyberpunk → dark.
      (function () {
        const html = document.documentElement;
        const toggle = document.getElementById('theme-toggle');

        const ICON_PATHS = {
          dark: toggle?.dataset.iconDark,
          light: toggle?.dataset.iconLight,
          cyberpunk: toggle?.dataset.iconCyber,
        };

        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#1400c3', light: '#f4efca', cyberpunk: '#171717' };
        const ORDER = ['dark', 'light', 'cyberpunk'];

        function applyTheme(theme) {
          html.setAttribute('data-theme', theme);
          const themeIcon = document.getElementById('theme-icon');
          if (themeIcon && ICON_PATHS[theme]) themeIcon.icon = ICON_PATHS[theme];
          if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
          if (toggle) {
            const label = (toggle.dataset.themeLabel || 'Theme: ') + theme + (toggle.dataset.themeCycle || '. Click to cycle.');
            toggle.setAttribute('aria-label', label);
          }
        }

        function persistTheme(theme) {
          try {
            localStorage.setItem('theme', theme);
          } catch (e) {
            // ignore storage errors
          }
        }

        // Sync icon with already-applied theme
        const current = html.getAttribute('data-theme') || 'dark';
        applyTheme(current);

        if (toggle) {
          toggle.addEventListener('click', () => {
            const cur = html.getAttribute('data-theme') || 'dark';
            const next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
            applyTheme(next);
            persistTheme(next);
          });
        }

        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', (e) => {
            try {
              if (localStorage.getItem('theme')) return;
            } catch (e) {
              return;
            }
            applyTheme(e.matches ? 'dark' : 'light');
          });
      })();

      // Reveal on scroll
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      })();

      // Navbar scroll shadow
      (function () {
        const nav = document.querySelector('nav');
        if (!nav) return;
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 20);
        });
      })();

      // Off-canvas navigation. The panel is a drawer at every width — hidden by
      // default, sliding in from the left; the toggle lives in the top bar and
      // morphs ☰ → ✕. It is taken out of the a11y tree while it is hidden.
      (function () {
        const toggle = document.getElementById('nav-toggle');
        const links = document.getElementById('nav-links');
        const nav = document.getElementById('site-nav');
        const scrim = document.getElementById('nav-scrim');
        if (!toggle || !links || !nav) return;
        const icon = document.getElementById('nav-icon');
        const MENU = toggle.dataset.iconMenu;
        const CLOSE = toggle.dataset.iconClose;
        const LABEL_OPEN = toggle.dataset.labelOpen || 'Menu';
        const LABEL_CLOSE = toggle.dataset.labelClose || 'Close';

        const isOpen = () => document.body.classList.contains('nav-open');

        // A drawer that is off-screen is still focusable — inert it while
        // closed so keyboard/AT users never tab into translated-away links.
        function syncInert() {
          if (isOpen()) nav.removeAttribute('inert');
          else nav.setAttribute('inert', '');
        }

        function setOpen(open) {
          // Closing makes the drawer `inert`, and an inert subtree cannot hold
          // focus — the browser drops it to <body> and a keyboard user loses
          // their place (WCAG 2.4.3). Read the state *before* `syncInert()` and
          // hand focus back to the trigger, the same contract SearchBox and the
          // AskMe dialog already implement.
          const hadFocusInside = nav.contains(document.activeElement);
          document.body.classList.toggle('nav-open', open);
          links.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? LABEL_CLOSE : LABEL_OPEN);
          if (icon && (open ? CLOSE : MENU)) icon.icon = open ? CLOSE : MENU;
          syncInert();
          // Move focus into the revealed drawer: the links precede the trigger in
          // the DOM, so without this a keyboard user tabs straight past the menu
          // (WCAG 2.4.3 Focus Order).
          if (open) links.querySelector('a')?.focus();
          else if (hadFocusInside) toggle.focus();
        }

        toggle.addEventListener('click', () => setOpen(!isOpen()));
        links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        scrim?.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (e) => {
          // A nested panel (search) handles Escape itself and calls
          // preventDefault. Closing the drawer underneath it left that panel
          // open behind a scrim, announcing aria-expanded="true" on a widget
          // nobody could reach.
          if (e.key === 'Escape' && !e.defaultPrevented && isOpen()) setOpen(false);
        });
        syncInert();
      })();

    </script>

    <script>
      // Theme toggle tracking (REQ-A02): the inline script above owns the theme
      // cycle; this bundled module only emits the event through the shared
      // analytics module, so no component reads the posthog global.
      import { track } from '../lib/analytics';
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        track('theme_change', {
          theme: document.documentElement.getAttribute('data-theme') || 'dark',
        });
      });

    </script>

    <slot name="scripts" />

    <style>
      /* Rail utility block: language / search / theme share one row, and the
         contact CTA spans the rail below it. It no longer pins itself to the
         rail's bottom — the search dropdown had no room to open there.
         `.nav-tools` is also the search dropdown's containing block, so the
         panel is measured against the row, not against the 32px toggle. */
      .nav-aux {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-3);
      }

      .nav-tools {
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }

      /* Inline site navigation. Hidden by default: the drawer is the nav below
         the cutover, and `display: none` keeps these links out of the tab order
         and the a11y tree where they cannot be seen.

         The threshold used to be 1400px — a measured one, for a six-link row
         whose widest pair were «Обозреватель» + «Темы». The bar now surfaces a
         single link (the way home), so that arithmetic pays for nothing and the
         threshold drops to 1200px: the width at which the persona labels come
         back from their own icon-only state (NavRoles.astro), i.e. where the bar
         is at its densest and still has room for this one link. Below it the
         drawer is the sole route. */
      .nav-inline {
        display: none;
      }

      @media (min-width: 1200px) {
        .nav-inline {
          display: flex;
          align-items: center;
          gap: var(--space-3);
          list-style: none;
        }
        /* `inline-flex` + the same gap the other icon+label rows use, so the
           glyph and the word sit on one optical line instead of the svg's
           baseline. */
        .nav-inline a {
          display: inline-flex;
          align-items: center;
          gap: var(--space-2);
          color: var(--text-muted);
          font-size: 0.9rem;
          font-weight: 500;
          text-decoration: none;
          white-space: nowrap;
          transition: color 0.15s ease;
        }
        /* `display: block` removes the inline descender gap under an inline-level
           <svg>; `flex: none` keeps the glyph 16px against a nowrap label. */
        .nav-inline svg {
          display: block;
          flex: none;
        }
        .nav-inline a:hover {
          color: var(--text-accent);
        }
        /* Same contract as the drawer's rows: the current page is marked by
           `aria-current` in the markup and by colour here. Underline as well, so
           the state is not carried by hue alone. */
        .nav-inline a[aria-current='page'] {
          color: var(--text-accent);
          text-decoration: underline;
          text-decoration-thickness: 2px;
          text-underline-offset: 4px;
        }
        .nav-inline a:focus-visible {
          outline: 2px solid var(--border-active);
          outline-offset: 2px;
          border-radius: var(--radius-sm);
        }
        /* Icon-only chips, ≥1200px: the identity glyphs are recognisable on
           their own and the label stays visually hidden, so each anchor keeps
           its accessible name. This rule has always shared `.nav-inline`'s
           breakpoint (it is the same media block) because the icon-only chips
           are what paid for the inline links; with one link the pair moves down
           to 1200px together. */
        .nav-chip-label {
          position: absolute;
          width: 1px;
          height: 1px;
          margin: -1px;
          padding: 0;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
          border: 0;
        }
      }

      /* The row of outbound and download links. A flex group with a real gap, so
         no ` · ` separators in the markup. Compact on purpose, NOT `.button`:
         five full-padding buttons would wrap the drawer several rows deep. */
      .nav-chips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        /* The bar is `space-between` (brand, chips, toggle). An auto start margin
           pulls the chips off the middle and groups them with the toggle: the
           utility cluster reads as one thing at the right edge. */
        margin-inline-start: auto;
      }

      .nav-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--border-active);
        border-radius: var(--radius-md);
        background: transparent;
        color: var(--text-normal);
        font-size: 0.85rem;
        font-weight: 500;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }

      /* The glyph is decorative and drawn in `currentColor`, so it needs no
         palette of its own — it flips with the chip's ink in all three themes.
         `display: block` removes the inline descender gap under an inline-level
         <svg>; without it the chip grows a few px taller than its own line box
         and the label sits off-centre against the icon. */
      .nav-chip svg {
        flex: none;
        display: block;
      }

      .nav-chip:hover {
        color: var(--text-accent);
        border-color: var(--text-accent);
      }

      /* A leading glyph on the two `.button` CTAs (drawer contact, footer
         contact). Same reason as `.nav-chip svg`: `display: block` kills the
         inline descender gap, `flex: none` holds the 16px box while the label
         wraps or the button is squeezed. */
      .btn-icon {
        display: block;
        flex: none;
      }

      /* `--border-active` is the only stroke that clears the 3:1 non-text floor
         in all three themes; `outline-offset` keeps the ring on the drawer
         background. */
      .nav-chip:focus-visible {
        outline: 2px solid var(--border-active);
        outline-offset: 2px;
      }

      /* 34×26 is a comfortable mouse target and a cramped thumb one; the chips
         are the outbound-contact row, so a miss opens the wrong profile. The
         pad is paid only by coarse pointers — a mouse keeps the compact bar. */
      @media (pointer: coarse) {
        .nav-chip {
          min-width: 44px;
          min-height: 44px;
        }
      }

      /* Below the canvas breakpoint the wordmark goes visually hidden — NOT
         `display: none`, which would strip the brand anchor of its accessible
         name, since the logo beside it is `aria-hidden`. */
      @media (max-width: 899px) {
        .nav-mobile .nav-brand b {
          position: absolute;
          width: 1px;
          height: 1px;
          margin: -1px;
          padding: 0;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
          border: 0;
        }
      }

      /* The chips need the wider cutover. With the persona group (≥768px) and the
         theme toggle (every width) now sharing the bar, brand + three labelled
         chips + two controls no longer fit below 1024px, so the chip labels go
         icon-only there. Visually hidden, not `display: none`, so each anchor
         keeps its accessible name (the glyph beside it is `aria-hidden`). */
      @media (max-width: 1023px) {
        .nav-chip-label {
          position: absolute;
          width: 1px;
          height: 1px;
          margin: -1px;
          padding: 0;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
          border: 0;
        }
        .nav-chips {
          gap: var(--space-1);
        }
        .nav-chip {
          padding: var(--space-1) var(--space-2);
        }
      }

      /* Footer: one route to contact plus the copyright. Centred like the
         copyright beneath it, and a `.button-secondary` rather than `.button`
         because the sticky bar above already carries the page's single filled
         action (the CV) — two primaries on one screen is the accent budget
         DESIGN.md forbids. */
      .footer-actions {
        display: flex;
        justify-content: center;
      }

      .footer-actions .button {
        font-size: 0.85rem;
        padding: var(--space-2) var(--space-4);
      }
    </style>
  </body>
</html>
