---
import Base from './Base.astro';
import InnerTOC from '../components/InnerTOC.astro';
import InlineTOC from '../components/InlineTOC.astro';
import { formatDate, estimateReadTime } from '../lib/date';
import { withBase } from '../lib/path';
import { categoryLabel } from '../lib/categories';

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  category: string;
  excerpt: string;
  slug: string;
  image?: string;
  related?: { href: string; title: string; external?: boolean }[];
  keywords?: string[];
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
  lang?: 'ru' | 'en';
  counterpartHref?: string;
}

const { title, date, updated, category, excerpt, slug, image, related = [], keywords = [], prev = null, next = null, lang = 'ru', counterpartHref } = Astro.props;
const rendered = await Astro.slots.render('default');
const readTime = estimateReadTime(rendered.replace(/<[^>]*>/g, ' '));
const categoryDisplay = categoryLabel(category, lang);
const dateModified = updated?.toISOString() ?? date.toISOString();
const minLabel = lang === 'en' ? 'min read' : 'мин чтения';
const backLabel = lang === 'en' ? '← All writing' : '← К статьям';
const relatedLabel = lang === 'en' ? 'See also' : 'Смотрите также';
const prevLabel = lang === 'en' ? '← Previous' : '← Предыдущая';
const nextLabel = lang === 'en' ? 'Next →' : 'Следующая →';

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const langPrefix = lang === 'en' ? 'en/' : '';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: dateModified,
  articleSection: category,
  image: image ? `${siteUrl}${withBase(image)}` : undefined,
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  publisher: { '@type': 'Person', name: 'Nikita Boyarkin' },
  mainEntityOfPage: `${siteUrl}${withBase(`${langPrefix}posts/${slug}/`)}`,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${withBase('/')}` },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${siteUrl}${withBase(`${langPrefix}writing/`)}` },
    { '@type': 'ListItem', position: 3, name: title, item: `${siteUrl}${withBase(`${langPrefix}posts/${slug}/`)}` },
  ],
};
const articleJsonLdGraph = { '@context': 'https://schema.org', '@graph': [articleJsonLd, breadcrumbJsonLd] };
---

<Base
  title={`${title} | Nikita Boyarkin`}
  description={excerpt}
  keywords={keywords}
  ogImage={image}
  ogType="article"
  activeNav="writing"
  canonical={withBase(`${langPrefix}posts/${slug}/`)}
  lang={lang}
  counterpartHref={counterpartHref}
  jsonLd={articleJsonLdGraph}
>
  <InnerTOC selector="#post-content" lang={lang} />

  <div id="reading-progress" aria-hidden="true"></div>

  <article class="post-content">
    <header class="post-header reveal">
      <span class="post-tag">{categoryDisplay}</span>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        {formatDate(date)}
        {updated ? ` · ${lang === 'en' ? 'updated' : 'обновлено'} ${formatDate(updated)}` : ''}
        {' · '}{readTime} {minLabel} · Nikita Boyarkin
      </div>
    </header>

    <InlineTOC lang={lang} />

    <div class="post-body" id="post-content">
      <slot />
    </div>

    {related.length > 0 && (
      <section class="post-related reveal reveal-delay-2" aria-label={relatedLabel}>
        <h2>{relatedLabel}</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a
                href={r.href}
                {...(r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {r.title}
                {r.external && ' ↗'}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(prev || next) && (
      <nav class="prev-next" aria-label="Другие записи">
        {prev && (
          <a class="pn-link pn-prev" href={prev.href}>
            <span class="pn-dir">{prevLabel}</span>
            <span class="pn-title">{prev.title}</span>
          </a>
        )}
        {next && (
          <a class="pn-link pn-next" href={next.href}>
            <span class="pn-dir">{nextLabel}</span>
            <span class="pn-title">{next.title}</span>
          </a>
        )}
      </nav>
    )}

    <a href={withBase(`${lang === 'en' ? 'en/' : ''}writing/`)} class="post-back">{backLabel}</a>
  </article>

  <script is:inline>
    // Reading progress bar (decorative, aria-hidden).
    // Driven by `transform: scaleX()` rather than `width`: scaleX is compositor-only, so
    // each scroll write stops invalidating layout. `width` would re-lay-out the fixed bar
    // on every frame of the read, on a page whose scrollHeight is already being read there.
    // No reduced-motion guard: the bar is a 1:1 map of the reader's own scroll position,
    // not autonomous motion, so suppressing it would remove information rather than motion.
    // No easing either — a spring on a progress indicator makes it lag its own scroll.
    (function () {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;
      const onScroll = () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = h > 0 ? `scaleX(${window.scrollY / h})` : 'scaleX(0)';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    })();
  </script>
</Base>