# Public env vars baked into the static build.
# Copy this file to `.env` for local development, or set them as GitHub
# Actions secrets for CI (see .github/workflows/deploy.yml).

# --- PostHog (product analytics) ---
# Project token (browser-safe, starts with `phc_`).
PUBLIC_POSTHOG_KEY=
# PostHog host. US default; EU cloud uses https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Plausible (optional, privacy-friendly analytics) ---
# Domain of the deployed site, e.g. "nikitaboyarkin.github.io"
# PUBLIC_PLAUSIBLE_DOMAIN=
# Optional custom/self-hosted script URL (default https://plausible.io/js/script.js)
# PUBLIC_PLAUSIBLE_SRC=

# --- Contact form backend (server-side only — never reaches the bundle) ---
# The form's endpoint and the Cal.com link are constants in src/lib/contact.ts,
# deliberately not env vars: a var absent from CI fails *silently*, and this repo
# already has that bug elsewhere. These two are read only by
# scripts/sync-contact-log.mjs (and as Supabase secrets by the Edge Function).
# The service_role key must never carry a PUBLIC_ prefix — it bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=